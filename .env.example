# Kopiere diese Datei nach .env und fülle die Werte aus.

# MongoDB Atlas Verbindungs-URI (Atlas -> Connect -> Drivers)
# Das Passwort am besten nur aus Buchstaben und Zahlen – Sonderzeichen müssen URL-kodiert werden.
MONGODB_URI=mongodb+srv://wettstube_app:<PASSWORD>@rovash-cluster.wki0llj.mongodb.net/wettstube?retryWrites=true&w=majority&appName=Rovash-Cluster

# Langer Zufallswert, z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production
PORT=3100
HOST=127.0.0.1

APP_NAME=BfW Holdings

# Benutzernamen mit Admin-Rechten (kommagetrennt): dürfen jede Wette entscheiden/annullieren
# Achtung: Diese Namen können nicht registriert werden (sonst wäre jeder mit dem Namen sofort Admin).
# Neue Installation: zuerst unter dem gewünschten Namen registrieren, ihn danach hier eintragen und neu starten.
ADMIN_USERNAMES=Szkep

# Spielgeld-Einstellungen (in Euro)
START_BALANCE_EUR=1000
MIN_STAKE_EUR=1

# Gesamtprovision in % vom Topf für Wettersteller und Schiedsrichter (je die Hälfte).
# Beide dürfen bei ihrer Wette nicht mitwetten.
CREATOR_FEE_PERCENT=8

# Lotterie: Lospreis in Euro und tägliche Startzeit (Ziehung jeweils 1 Minute vorher)
LOTTERY_TICKET_EUR=100
LOTTERY_TIME=20:00

# TCG: Preis eines Booster Packs (3 Karten) in Euro
TCG_PACK_EUR=90

# Wetten ohne Ergebnis werden so viele Tage nach Einsatzschluss automatisch annulliert
AUTO_VOID_DAYS=14

# Solange noch kein HTTPS eingerichtet ist, auf false setzen – sonst funktioniert der Login nicht!
COOKIE_SECURE=false

# Anzahl der Reverse-Proxys vor der App (Nginx = 1)
TRUST_PROXY=1

# Manipulationserkennung: Pfad zur Datenbank GeoLite2-ASN (kostenlos nach Anmeldung bei MaxMind:
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data → GeoLite2-ASN.mmdb). Damit wird erkannt, ob eine
# Spiel-Aktion aus einem Rechenzentrum kommt. Leer = diese Prüfung ist aus. Die Datei monatlich erneuern.
GEOIP_ASN_DB=
