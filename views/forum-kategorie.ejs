<%- include('partials/head') %>
<% const link = (p) => '/forum/k/' + cat._id + '?seite=' + p; %>

<div class="forum-page forum-narrow">
<nav class="forum-crumbs" aria-label="Pfad">
  <a href="/forum">Forum</a><span>›</span>
  <% if (parent) { %><a href="/forum/k/<%= parent._id %>"><%= parent.title %></a><span>›</span><% } %>
  <span><%= cat.title %></span>
</nav>

<div class="forum-head">
  <div class="forum-head-text">
    <h1><%= cat.title %><% if (cat.staffOnly) { %> <span class="forum-team">Team</span><% } %></h1>
    <% if (cat.description) { %><span class="forum-head-desc"><%= cat.description %></span><% } %>
  </div>
  <% if (canCreate) { %><a class="btn btn-primary" href="/forum/k/<%= cat._id %>/neu">+ Neues Thema</a><% } %>
</div>

<% if (subs.length) { %>
  <section class="forum-group">
    <div class="forum-group-head forum-label">Unterbereiche</div>
    <ul class="forum-rows">
      <% subs.forEach((c) => { const s = c.stats; %>
        <li class="forum-crow <%= s.unread ? 'is-unread' : 'is-read' %>">
          <span class="forum-trow-main">
            <a class="forum-crow-title forum-stretch" href="/forum/k/<%= c._id %>"><%= c.title %><% if (s.unread) { %><span class="forum-dot" title="Neues für dich"></span><% } %></a>
            <% if (c.description) { %><span class="forum-sub"><%= c.description %></span><% } %>
          </span>
          <span class="forum-count"><%= s.threads %> <%= s.threads === 1 ? 'Thema' : 'Themen' %> · <%= s.posts %> <%= s.posts === 1 ? 'Beitrag' : 'Beiträge' %></span>
          <span class="forum-crow-last">
            <% if (s.last) { %>
              <a class="forum-last" href="/forum/t/<%= s.last._id %>?seite=letzte"><%= s.last.title %></a>
              <span class="forum-sub"><%= s.last.lastPostByName %> · <%= relTime(s.last.lastPostAt) %></span>
            <% } else { %><span class="forum-sub">noch keine Themen</span><% } %>
          </span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section class="forum-group">
  <div class="forum-thead"><span>Thema</span><span>Antworten</span><span>Letzter Beitrag</span></div>
  <% if (!threads.length) { %>
    <p class="forum-empty"><%= subs.length ? 'Direkt in diesem Bereich gibt es noch keine Themen.' : 'Noch keine Themen.' %><%= canCreate ? ' Mach den Anfang!' : '' %></p>
  <% } else { %>
    <ul class="forum-rows"><% threads.forEach((t) => { %><%- include('partials/forum-thread-row', { t }) %><% }) %></ul>
  <% } %>
  <% if (pages > 1) { %>
    <div class="log-pager">
      <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= link(page - 1) %>">← Zurück</a><% } %>
      <span class="muted small">Seite <%= page %> / <%= pages %></span>
      <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="<%= link(page + 1) %>">Weiter →</a><% } %>
    </div>
  <% } %>
</section>

<% if (!canCreate && cat.staffOnly) { %>
  <p class="muted small">In diesem Bereich eröffnen nur Admin und Devs Themen – antworten kannst du trotzdem.</p>
<% } %>

<% if (canManage) { %>
  <details class="card fold">
    <summary><h2>Bereich bearbeiten</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
    <form method="post" action="/forum/bereiche/<%= cat._id %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Name</span><input type="text" name="title" minlength="2" maxlength="60" value="<%= cat.title %>" required></label>
      <label class="field"><span>Beschreibung</span><input type="text" name="description" maxlength="200" value="<%= cat.description %>"></label>
      <label class="field"><span>Reihenfolge (kleinere Zahl = weiter oben)</span><input type="number" name="order" min="0" max="999" value="<%= cat.order %>"></label>
      <% if (canSetStaffOnly) { %><label class="check"><input type="checkbox" name="staffOnly" value="1" <%= cat.staffOnly ? 'checked' : '' %>><span>Team-Bereich: Nur Admin und Devs eröffnen hier Themen.</span></label><% } %>
      <button class="btn btn-primary" type="submit">Speichern</button>
    </form>
    <% if (!cat.key) { %>
      <form method="post" action="/forum/bereiche/<%= cat._id %>" class="forum-cat-delete" data-confirm="Diesen Bereich löschen? Das geht nur, wenn er leer ist.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="action" value="loeschen">
        <button class="btn btn-danger btn-sm" type="submit">Bereich löschen</button>
      </form>
    <% } %>
  </details>
<% } %>

</div>

<%- include('partials/foot') %>
