<%- include('partials/head') %>
<%
  const bal = currentUser.balance;
  const me = String(currentUser._id);
  const pctText = (p) => String(p).replace('.', ',') + ' %';
  const taxSame = taxRates.markt === taxRates.privat && taxRates.privat === taxRates.tausch;
  const rankOf = (id) => { const c = cardInfo(id); return (rarityByKey[c.rarity] || { rank: -1 }).rank; };
  // Seltenste Karte einer Seite – bestimmt Farbe und Filter der Markt-Kachel
  const topLine = (list) => list.reduce((best, l) => (!best || rankOf(l.card) > rankOf(best.card) ? l : best), null);
  const turnCount = incoming.filter((t) => canAccept(t, roleOf(t, me)) || isUnread(t, roleOf(t, me))).length;
  const mineTurn = mine.filter((t) => t.to && (canAccept(t, roleOf(t, me)) || isUnread(t, roleOf(t, me)))).length;
  const tabs = [
    { key: 'markt', label: 'Markt', count: market.length },
    { key: 'an-mich', label: 'An mich', count: incoming.length, badge: turnCount },
    { key: 'meine', label: 'Meine', long: ' Angebote', count: mine.length, badge: mineTurn },
    { key: 'verlauf', label: 'Verlauf', badge: newDeals.length },
  ];
%>

<div class="handel-page hx">
<div class="page-head hx-head">
  <div>
    <h1>Handel</h1>
    <% if (taxSame) { %>
      <span class="muted small">Handelssteuer <strong><%= pctText(taxRates.markt) %></strong><% if (taxRates.markt > 0) { %> · trägt, wer das Geld bekommt<% } %></span>
    <% } else { %>
      <span class="muted small">Steuer: Markt <strong><%= pctText(taxRates.markt) %></strong> · Privat <strong><%= pctText(taxRates.privat) %></strong> · Tausch <strong><%= pctText(taxRates.tausch) %></strong></span>
    <% } %>
  </div>
  <a class="btn btn-primary hx-new" href="/handel/neu">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z"/></svg>
    Neuer Handel
  </a>
</div>

<% { const bm = blackMarket; const left = bm.offers.filter((o) => !o.buyer).length; const cdAt = (bm.open ? bm.closesAt : bm.opensAt).getTime(); %>
<<%= bm.open ? 'details' : 'section' %> class="bm<%= bm.open ? ' is-open' : '' %>" id="blackmarket">
  <<%= bm.open ? 'summary' : 'div' %> class="bm-head">
    <div class="bm-title">
      <div class="bm-title-row">
        <h2>Black Market</h2>
        <% if (bm.open) { %><span class="bm-state bm-state-open"><span class="bm-dot"></span>Geöffnet · noch <%= left %> von <%= bm.offers.length %></span>
        <% } else { %><span class="bm-state">Geschlossen</span><% } %>
      </div>
    </div>
    <div class="bm-cd">
      <span><%= bm.open ? 'Schließt in' : 'Öffnet in' %></span>
      <strong data-countdown-parts="<%= cdAt %>"><span data-cd="h">–</span>:<span data-cd="m">–</span>:<span data-cd="s">–</span></strong>
    </div>
    <% if (bm.open) { %><span class="bm-arrow" aria-hidden="true"></span><% } %>
  </<%= bm.open ? 'summary' : 'div' %>>
  <% if (bm.open) { %>
    <div class="bm-grid">
      <%
        // Angebot: Karte (auch Bosskarte, Seltenheit "boss") oder Gegenstand wie die Folie (card "item:folie", Seltenheit "item");
        // alte Tagesdokumente ohne kind sind Karten
        bm.offers.forEach((o, i) => { const c = cardInfo(o.card); const isItem = o.kind === 'gegenstand' || !!c.isItem; const r = rarityByKey[o.rarity] || { label: o.rarity }; const sold = !!o.buyer; const n = coll.counts[c.id] || 0; const value = isItem ? c.sell || 0 : r.sell || 0;
      %>
        <div class="bm-offer r-<%= o.rarity %><%= sold ? ' is-sold' : '' %><%= isItem ? ' is-item' : '' %>">
          <button type="button" class="bm-card r-<%= o.rarity %>" data-zoom-card data-image="<%= c.image %>" data-name="<%= c.name %>" data-rarity="<%= o.rarity %>" data-rarity-label="<%= r.label %>"
            data-sell-text="<%= euro(value) %>" data-owned="<%= n %>"<% if (isItem) { %> data-meta-text="Gegenstand · Bank zahlt <%= euro(value) %> · landet im Inventar"<% } %> aria-label="<%= c.name %>, <%= r.label %> – vergrößern">
            <img src="<%= c.image %>" alt="" width="720" height="1008">
            <% if (sold) { %><span class="bm-stamp">Verkauft</span><% } %>
          </button>
          <div class="bm-info">
            <span class="bm-rarity"><span class="tcg-dot r-<%= o.rarity %>"></span><span class="bm-rarity-text"><%= r.label %> · <%= c.name %></span><% if (!isItem) { %><span class="own-tag<%= n ? '' : ' own-new' %>"><%= n ? 'Im Besitz' : 'Fehlt dir' %></span><% } %></span>
            <span class="bm-price"><strong><%= euro(o.price) %></strong><span><%= isItem ? 'Bank zahlt' : 'Wert' %> <%= euro(value) %></span></span>
            <% if (sold) { %>
              <span class="muted small">an <%- userLink(o.buyerName) %></span>
            <% } else { %>
              <form method="post" action="/handel/black-market" data-confirm="<%= c.name %> (<%= r.label %>) für <%= euro(o.price) %> kaufen?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="index" value="<%= i %>">
                <button class="bm-buy" type="submit" <%= bal < o.price ? 'disabled' : '' %>>Kaufen</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</<%= bm.open ? 'details' : 'section' %>>
<% } %>

<div class="hx-tabs" role="tablist" aria-label="Bereiche im Handel" data-hx-tabs>
  <% tabs.forEach((x) => { %>
    <a class="hx-tab<%= tab === x.key ? ' active' : '' %>" href="/handel?reiter=<%= x.key %>" role="tab" aria-selected="<%= tab === x.key %>" aria-controls="hx-<%= x.key %>" data-hx-tab="<%= x.key %>">
      <span><%= x.label %><% if (x.long) { %><span class="hx-tab-long"><%= x.long %></span><% } %></span>
      <% if (x.badge) { %><span class="nav-badge nav-badge-inline" title="Am Zug oder neu"><%= x.badge %></span><% } else if (x.count) { %><span class="hx-count"><%= x.count %></span><% } %>
    </a>
  <% }) %>
</div>

<%# ---------- Markt ---------- %>
<section class="hx-pane" id="hx-markt" role="tabpanel" data-hx-pane="markt" <%= tab === 'markt' ? '' : 'hidden' %>>
  <% if (!market.length) { %>
    <div class="hx-empty">
      <p>Auf dem Markt ist gerade nichts im Angebot.</p>
      <a class="btn btn-ghost btn-sm" href="/handel/neu">Selbst etwas anbieten</a>
    </div>
  <% } else { %>
    <%
      // Such-/Filterknopf (partials/mkt-bar): Seltenheit der seltensten Karte, „Fehlt mir noch“ und welche Angebote
      // Kachel zeigt, was angeboten wird – beim Gesuch die gesuchten Karten
      const shown = (t) => (t.give.length ? t.give : t.want);
      const marketRarity = (t) => { const top = topLine(shown(t)); return top ? cardInfo(top.card).rarity : ''; };
      const lacks = (t) => t.give.some((l) => !String(l.card).startsWith('item:') && !(coll.counts[l.card] || 0));
      const mkGroups = [
        { attr: 'mk-rarity', title: 'Seltenheit', missing: market.filter(lacks).length, allCount: market.length,
          opts: [...rarities, rarityByKey.item].map((r) => ({ key: r.key, label: r.label, count: market.filter((t) => marketRarity(t) === r.key).length })).filter((o) => o.count) },
        { attr: 'mk-show', title: 'Angebote', allLabel: 'Alle Angebote', dots: false, opts: [
          { key: 'foil', label: 'Mit folierten Karten', count: market.filter((t) => t.give.some((l) => l.foiledAt)).length },
          { key: 'bundle', label: 'Bündel', count: market.filter((t) => t.give.length > 1).length },
          { key: 'swap', label: 'Tauschangebote', count: market.filter((t) => t.give.length && t.want.length).length },
          { key: 'wanted', label: 'Gesuche', count: market.filter((t) => !t.give.length).length },
          { key: 'afford', label: 'Kann ich annehmen', count: market.filter((t) => perspective(t, 'to').pay <= bal).length },
        ].filter((o) => o.count) },
      ];
    %>
    <div class="mk-tools" data-mk-tools>
      <%- include('partials/mkt-bar', { name: 'mk', placeholder: 'Karte oder Verkäufer suchen', searchAttr: 'mk-search', label: 'Markt filtern', groups: mkGroups }) %>
      <label class="mk-sort"><span class="sr-only">Sortieren</span>
        <select data-mk-sort aria-label="Sortieren">
          <option value="neu">Neueste zuerst</option>
          <option value="preis-auf">Preis aufsteigend</option>
          <option value="preis-ab">Preis absteigend</option>
          <option value="selten">Seltenste zuerst</option>
          <option value="ablauf">Läuft bald ab</option>
        </select>
      </label>
    </div>
    <p class="muted hx-none" data-mk-empty hidden>Kein Angebot passt zu deiner Auswahl.</p>
    <ul class="mk-grid" data-mk-grid>
      <% market.forEach((t) => {
        // Sicht dessen, der annimmt ('to'): was er gibt (Wunschkarten, Geld) und was er bekommt
        const p = perspective(t, 'to');
        const kindKey = t.give.length && t.want.length ? 'swap' : t.give.length ? 'sale' : 'wanted';
        const list = shown(t); const top = topLine(list); const c = cardInfo(top.card); const r = rarityByKey[c.rarity] || { label: '', rank: -1 };
        const single = list.length === 1;
        const missing = t.give.filter((l) => !String(l.card).startsWith('item:') && !(coll.counts[l.card] || 0)).length;
        const foiled = t.give.some((l) => l.foiledAt);
        const value = linesValue(t.give);
        // Habe ich die Wunschkarten frei? (Gegenstände prüft erst der Abschluss)
        const need = {};
        t.want.filter((l) => !String(l.card).startsWith('item:')).forEach((l) => { need[l.card] = (need[l.card] || 0) + 1; });
        const lacking = Object.entries(need).filter(([id, n]) => (coll.free[id] || 0) < n).map(([id]) => cardInfo(id).name);
        const blocked = p.pay > bal ? 'Dein Guthaben reicht nicht' : lacking.length ? 'Dir fehlt frei: ' + lacking.join(', ') : '';
        const action = { sale: 'Kaufen', swap: 'Tauschen', wanted: 'Abgeben' }[kindKey];
        const sideText = (l, cents) => [lineLabel(l), cents > 0 ? euro(cents) : ''].filter(Boolean).join(' + ') || 'nichts';
        const names = [...t.give, ...t.want].map((l) => cardInfo(l.card).name).join(' ').toLowerCase() + ' ' + t.sellerName.toLowerCase(); %>
        <li class="mk-tile mk-<%= kindKey %> r-<%= c.rarity %>" data-mk data-rarity="<%= c.rarity %>" data-rank="<%= r.rank %>" data-name="<%= names %>" data-price="<%= t.price %>"
          data-created="<%= new Date(t.createdAt).getTime() %>" data-expires="<%= new Date(t.expiresAt).getTime() %>" data-missing="<%= missing ? 1 : 0 %>" data-foil="<%= foiled ? 1 : 0 %>"
          data-bundle="<%= t.give.length > 1 ? 1 : 0 %>" data-swap="<%= kindKey === 'swap' ? 1 : 0 %>" data-wanted="<%= kindKey === 'wanted' ? 1 : 0 %>">
          <div class="mk-art">
            <%- include('partials/trade-stack', { list, size: 'md' }) %>
            <% if (kindKey !== 'sale') { %><span class="mk-kind"><%= kindKey === 'swap' ? 'Tausch' : 'Gesucht' %></span><% } else if (!single) { %><span class="mk-bundle"><%= countText(list) %></span><% } %>
          </div>
          <div class="mk-body">
            <span class="mk-name" title="<%= lineLabel(list) %>"><%= single ? c.name : lineLabel(list) %></span>
            <span class="mk-rarity">
              <span class="tcg-dot r-<%= c.rarity %>"></span><%= single ? r.label : 'bis ' + r.label %>
              <% if (single && top.foiledAt) { %><span class="foil-tag" title="Foliert am <%= dayDate(top.foiledAt) %>">Foliert<%= top.grade ? ' · Note ' + top.grade : '' %></span><% } %>
              <% if (kindKey !== 'wanted' && !c.isItem) { %>
                <span class="own-tag<%= missing ? ' own-new' : '' %>"><%= single ? (missing ? 'Fehlt dir' : 'Im Besitz' + ((coll.counts[c.id] || 0) > 1 ? ' ×' + coll.counts[c.id] : '')) : missing ? missing + ' fehlen dir' : 'Alle im Besitz' %></span>
              <% } %>
              <% if (kindKey === 'wanted' && !lacking.length) { %><span class="own-tag own-new">Hast du frei</span><% } %>
            </span>
            <% if (kindKey === 'swap') { %>
              <span class="mk-wants">
                <span class="mk-wants-label">gegen</span>
                <%- include('partials/trade-stack', { list: t.want, size: 'sm', max: 3 }) %>
                <span class="mk-wants-text"><%= sideText(t.want, p.pay) %><% if (p.receive) { %> <span class="pos">+ <%= euro(p.receive) %> für dich</span><% } %></span>
              </span>
              <span class="mk-price mk-price-sub"><span>Wert <%= euro(value) %> gegen <%= euro(linesValue(t.want)) %></span></span>
            <% } else if (kindKey === 'wanted') { %>
              <span class="mk-price"><strong><%= euro(t.price) %></strong><span>zahlt <%= t.sellerName %></span></span>
            <% } else { %>
              <span class="mk-price">
                <strong><%= euro(t.price) %></strong>
                <span class="<%= t.price < value ? 'pos' : '' %>">Wert <%= euro(value) %></span>
              </span>
            <% } %>
            <span class="mk-seller">von <%- userLink(t.sellerName) %> · endet <%= relTime(t.expiresAt) %></span>
            <div class="mk-actions">
              <form method="post" action="/handel/angebot/<%= t._id %>/kaufen" data-confirm="<%= action %>? Du gibst <%= sideText(p.gives, p.pay) %> und bekommst <%= sideText(p.gets, p.receive) %>.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-primary btn-sm" type="submit" <%= blocked ? 'disabled title="' + blocked + '"' : '' %>><%= action %></button>
              </form>
              <% if (t.myOffer) { %>
                <a class="btn btn-ghost btn-sm" href="/handel/angebot/<%= t.myOffer %>">Dein Angebot</a>
              <% } else { %>
                <a class="btn btn-ghost btn-sm" href="/handel/neu?markt=<%= t._id %>">Angebot machen</a>
              <% } %>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%# ---------- An mich ---------- %>
<section class="hx-pane" id="hx-an-mich" role="tabpanel" data-hx-pane="an-mich" <%= tab === 'an-mich' ? '' : 'hidden' %>>
  <% if (!incoming.length) { %>
    <div class="hx-empty"><p>Gerade hat dir niemand ein Angebot gemacht.</p></div>
  <% } else { %>
    <ul class="offer-list">
      <% incoming.forEach((t) => { %><%- include('partials/offer-row', { t, me, balance: bal, reiter: 'an-mich' }) %><% }) %>
    </ul>
  <% } %>
</section>

<%# ---------- Meine Angebote ---------- %>
<section class="hx-pane" id="hx-meine" role="tabpanel" data-hx-pane="meine" <%= tab === 'meine' ? '' : 'hidden' %>>
  <% if (!mine.length) { %>
    <div class="hx-empty">
      <p>Du hast gerade keine offenen Angebote.</p>
      <a class="btn btn-ghost btn-sm" href="/handel/neu">Neuen Handel starten</a>
    </div>
  <% } else { %>
    <ul class="offer-list">
      <% mine.forEach((t) => { %><%- include('partials/offer-row', { t, me, balance: bal, reiter: 'meine' }) %><% }) %>
    </ul>
  <% } %>
</section>

<%# ---------- Verlauf ---------- %>
<section class="hx-pane" id="hx-verlauf" role="tabpanel" data-hx-pane="verlauf" <%= tab === 'verlauf' ? '' : 'hidden' %>>
  <% if (!history.length) { %>
    <div class="hx-empty"><p>Noch keine abgeschlossenen Geschäfte.</p></div>
  <% } else { %>
    <ul class="deal-list">
      <% history.forEach((t) => {
        const role = String(t.seller) === me ? 'seller' : 'to';
        const p = perspective(t, role);
        const partner = role === 'seller' ? t.buyerName || t.toName : t.sellerName;
        const net = p.receive ? p.receive - (t.tax || 0) : -p.pay;
        const verb = p.gives.length && p.gets.length ? 'Getauscht' : p.gives.length ? 'Verkauft' : 'Gekauft'; %>
        <li class="deal-row<%= t.isNew ? ' is-new' : '' %>">
          <%- include('partials/trade-stack', { list: p.gets.length ? p.gets : p.gives, size: 'sm', max: 2 }) %>
          <div class="deal-info">
            <span class="deal-title"><strong><%= verb %></strong>
              <% if (p.gives.length) { %> <%= lineLabel(p.gives) %><% } %>
              <% if (p.gives.length && p.gets.length) { %> gegen <% } else if (p.gets.length) { %> <% } %>
              <% if (p.gets.length) { %><%= lineLabel(p.gets) %><% } %>
              <% if (t.isNew) { %><span class="nav-badge nav-badge-inline">Neu</span><% } %>
            </span>
            <span class="deal-sub"><%= role === 'seller' && !t.toName ? 'Markt · an' : 'mit' %> <%- userLink(partner) %> · <%= date(t.closedAt) %></span>
          </div>
          <span class="deal-money <%= net > 0 ? 'pos' : net < 0 ? 'neg' : 'muted' %>"><%= net > 0 ? '+' + euro(net) : net < 0 ? '−' + euro(-net) : '±0' %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<details class="hx-how">
  <summary>So funktioniert der Handel</summary>
  <ul>
    <li><strong>Markt:</strong> Für alle, <%= marketDays %> Tage lang – Karten für einen Festpreis verkaufen, gegen Wunschkarten tauschen oder ein Gesuch einstellen (Geld für Karten, die dir fehlen). Jeder, der passt, kann sofort annehmen oder ein Gegenangebot machen.</li>
    <li><strong>An ein Mitglied:</strong> Verkaufen, um eine Karte bitten (Kaufanfrage) oder tauschen – auf beiden Seiten bis zu <%= maxLines %> Karten, dazu Geld in eine Richtung. <%= privateHours %> Std. gültig.</li>
    <li><strong>Verhandeln:</strong> In jedem Angebot könnt ihr schreiben und Gegenangebote machen, bis eine Seite annimmt. Annehmen kann immer die Seite, die den letzten Vorschlag nicht gemacht hat.</li>
    <li>Deine angebotenen Karten sind bis dahin gesperrt. Was du dir von anderen wünschst, wird erst beim Annehmen geprüft. <% if (taxSame && !taxRates.markt) { %>Aktuell fällt keine Steuer an.<% } else if (taxSame) { %>Auf Geld fallen <%= pctText(taxRates.markt) %> Steuer an.<% } else { %>Steuer auf Geld: Markt <%= pctText(taxRates.markt) %>, Privat <%= pctText(taxRates.privat) %>, Tausch <%= pctText(taxRates.tausch) %>.<% } %></li>
  </ul>
</details>
</div>

<%- include('partials/card-zoom') %>
<%- include('partials/foil-modal') %>
<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<script src="/js/handel.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
