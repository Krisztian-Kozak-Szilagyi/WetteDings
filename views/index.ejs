<%- include('partials/head') %>

<div class="page-head">
  <h1>Wetten</h1>
  <a class="btn btn-primary" href="/wetten/neu">+ Neue Wette</a>
</div>

<div class="bet-toolbar-row">
  <nav class="tabs" aria-label="Filter" data-live="tabs">
    <% Object.entries(tabs).forEach(([key, label]) => { if (key === 'meine' && !currentUser) return; %>
      <a href="/?tab=<%= key %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="tab <%= tab === key ? 'active' : '' %>">
        <%= label %><span class="tab-count <%= counts[key] ? '' : 'is-zero' %>" aria-label="<%= counts[key] %> Wetten"><%= counts[key] > 99 ? '99+' : counts[key] %></span>
      </a>
    <% }) %>
  </nav>

  <form class="search bet-search" method="get" action="/" role="search">
    <input type="hidden" name="tab" value="<%= tab %>">
    <input type="search" name="q" value="<%= q %>" placeholder="Wetten durchsuchen …" aria-label="Wetten durchsuchen (Enter)" maxlength="100">
  </form>
</div>

<% if (locals.duelInvites && duelInvites.length) { %>
  <div class="card card-accent duel-invites">
    <h2>Herausforderungen an dich <span class="nav-badge nav-badge-inline"><%= duelInvites.length %></span></h2>
    <ul class="duel-invite-list">
      <% duelInvites.forEach((b) => { const asRef = String(b.referee) === String(currentUser._id); %>
        <li>
          <a href="/wetten/<%= b._id %>#duell"><strong><%= b.title %></strong></a>
          <span class="muted small"><%= asRef ? b.creatorName + ' vs. ' + b.duel.opponentName + ' – du sollst Schiedsrichter sein' : b.creatorName + ' fordert dich heraus · ' + euro(b.duel.stake) + ' Einsatz' %> · bis <%= date(b.duel.expiresAt) %></span>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div hidden data-live-root data-live-url="/wetten-stand" data-live-version="<%= liveVersion %>" data-live-signature="<%= tab %>|<%= page %>|<%= q %>"></div>

<div data-live="bet-list">
<% if (!bets.length && !groupBets.length) { %>
  <div class="empty">
    <p><strong>Hier ist noch nichts.</strong></p>
    <p class="muted"><%= q ? 'Keine Wetten passen zu deiner Suche.' : 'In dieser Kategorie gibt es gerade keine Wetten.' %></p>
    <% if (currentUser) { %><a class="btn btn-primary" href="/wetten/neu">Erste Wette aufstellen</a><% } %>
  </div>
<% } else { %>
  <% if (groupBets.length) { %><h2 class="bet-section">Für alle</h2><% } %>
  <% if (bets.length) { %>
    <div class="bet-grid">
      <% bets.forEach((bet) => { %><%- include('partials/bet-card', { bet }) %><% }) %>
    </div>
  <% } else { %>
    <p class="muted bet-section-empty">In dieser Kategorie gibt es gerade keine öffentlichen Wetten.</p>
  <% } %>
  <% if (page > 1 || hasMore) { %>
    <nav class="pager" aria-label="Seiten">
      <% const base = '/?tab=' + tab + (q ? '&q=' + encodeURIComponent(q) : ''); %>
      <% if (page > 1) { %><a class="btn btn-ghost" href="<%= base %>&seite=<%= page - 1 %>">← Zurück</a><% } else { %><span></span><% } %>
      <span class="muted">Seite <%= page %></span>
      <% if (hasMore) { %><a class="btn btn-ghost" href="<%= base %>&seite=<%= page + 1 %>">Weiter →</a><% } else { %><span></span><% } %>
    </nav>
  <% } %>

  <% if (groupBets.length) { %>
    <section class="bet-groups">
      <h2 class="bet-section bet-section-group">In deinen Gruppen <span class="muted small">– nur für Mitglieder sichtbar</span></h2>
      <div class="bet-grid">
        <% groupBets.forEach((bet) => { %><%- include('partials/bet-card', { bet }) %><% }) %>
      </div>
    </section>
  <% } %>
<% } %>
</div>

<%- include('partials/foot') %>
