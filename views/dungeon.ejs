<%- include('partials/head') %>
<%
  const statLine = (c) => c && c.stats ? `⚡${c.stats.speed} · FIA ${c.stats.fia} · FIS ${c.stats.fis} · BWL ${c.stats.bwl}` : '';
  const canLeave = (phase === 'solo' || phase === 'gruppe') && !lockedIn;
  // Lobby: eigene Karten per Klick auf den eigenen Platz wählen (#111) – bis kurz vor dem Start
  const canPick = (phase === 'solo' || phase === 'gruppe') && !lockedIn && !!cards;
  // Karte groß ansehen (partials/card-zoom, public/js/dungeon.js)
  const escAttr = (v) => String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const zoomAttrs = (c) => `data-dg-zoom data-image="${escAttr(c.image)}" data-name="${escAttr(c.name)}" data-rarity="${escAttr(c.rarity)}" data-rarity-label="${escAttr(rarityByKey[c.rarity].label)}" data-meta="${escAttr(statLine(c))}"`;
%>

<div class="dg-page" data-dg-page data-rev="<%= rev %>" data-start="<%= new Date(slot).toISOString() %>" data-lock="<%= lockSeconds %>" data-now="<%= Date.now() %>">
<% if (closedForOthers) { %><p class="muted small">Nur für Admins sichtbar – im Admin-Panel für alle freigeben.</p><% } %>

<%# Bild des Dungeons im Querformat – darin Titel, Termin bzw. der laufende Kampf %>
<div class="dg-hero-wrap">
  <section class="dg-hero">
    <img class="dg-hero-img" src="<%= dg.image %>" alt="" width="1983" height="793">
    <div class="dg-hero-shade"></div>
    <div class="dg-hero-text">
      <span class="kicker">Dungeon<%= phase === 'laeuft' ? ' · läuft' : '' %></span>
      <h1><% if (dg.story) { %><a class="dg-hero-title" href="/dungeon/geschichte/<%= dg.key %>" title="Ganze Geschichte lesen"><%= dg.title %></a><% } else { %><%= dg.title %><% } %></h1>
      <% if (phase === 'laeuft') { %>
        <p class="dg-stage-title" data-dg-fight-title><%= dg.intro %></p>
        <p class="dg-stage-text" data-dg-fight-text></p>
      <% } else { %>
        <p class="dg-hero-sub"><%= dg.intro %></p>
        <p class="dg-when">Start um <strong><%= slotTime %> Uhr</strong> · <span data-dg-countdown>–</span></p>
      <% } %>
    </div>
  </section>

  <% if (phase === 'laeuft') { %>
    <%# Unter dem Bild: links die Kampf-Stationen, darunter Fortschritt und Deadline %>
    <div class="dg-under">
      <div class="dg-under-top">
      <ol class="dg-steps" aria-label="Kämpfe">
        <% dg.fights.forEach((f, i) => { %><li data-dg-step="<%= i %>"><%= f.boss ? 'Boss' : 'Kampf ' + (i + 1) %></li><% }) %>
      </ol>
      <p class="dg-next" data-dg-next hidden></p>
      </div>
      <div class="dg-bars" data-dg-bars hidden>
        <div class="dg-bar is-progress">
          <span class="dg-bar-label">Fortschritt</span>
          <span class="dg-bar-track"><span class="dg-bar-fill" data-dg-hp-bar></span></span>
          <span class="dg-bar-value" data-dg-hp-label></span>
        </div>
        <div class="dg-bar is-time">
          <span class="dg-bar-label">Deadline</span>
          <span class="dg-bar-track"><span class="dg-bar-fill" data-dg-time-bar></span></span>
          <span class="dg-bar-value" data-dg-time-label></span>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%# Einladungen: erst beitreten, die Karten wählt man danach in der Lobby (#111) %>
<% if (phase === 'frei') { %>
  <% invitations.forEach((inv) => { %>
    <form method="post" action="/dungeon/beitreten" class="dg-invitation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="party" value="<%= inv.id %>">
      <span class="dg-invitation-text"><span class="kicker">Einladung</span><strong><%= inv.leader %></strong> lädt dich in die Gruppe ein <span class="muted">(<%= inv.members.join(', ') %>)</span></span>
      <span class="dg-invitation-btns">
        <button class="btn btn-primary" type="submit">Beitreten</button>
        <button class="btn btn-ghost" type="submit" formaction="/dungeon/ablehnen">Ablehnen</button>
      </span>
    </form>
  <% }) %>
<% } %>

<%# Tisch: drei Plätze nebeneinander (vor dem Beitritt: Solo/Party-Kacheln), rechts Chat bzw. Anleitung %>
<section class="dg-table<%= hasChat || phase === 'frei' ? '' : ' no-chat' %>" id="dg-tisch">
  <% if (phase === 'frei') { %>
    <%# Noch nicht entschieden: statt leerer Kartenrahmen zwei Kacheln (wie "Zum Album") – Karten wählt man danach in der Lobby %>
    <form method="post" action="/dungeon/anmelden" class="dg-mode-tiles">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% [['solo', 'Solo Queue', 'Allein beitreten', 'Mitspieler werden beim Start zugelost'], ['gruppe', 'Party gründen', 'Mit Freunden', 'Bis zu zwei Mitglieder einladen, eigener Chat']].forEach(([mode, title, kicker, hint]) => { %>
        <button class="tcg-album-tile dg-mode-tile is-<%= mode %>" type="submit" name="mode" value="<%= mode %>">
          <span class="tcg-fan" aria-hidden="true">
            <% startFans[mode].forEach((f) => { %><img src="<%= f.card.image %>" alt="" width="720" height="1008" loading="lazy" class="<%= f.sample ? 'is-sample' : '' %>"><% }) %>
          </span>
          <span class="tcg-album-foot">
            <span class="tcg-album-text">
              <span class="kicker"><%= kicker %></span>
              <span class="tcg-album-title"><%= title %></span>
              <span class="dg-help-hint"><%= hint %></span>
            </span>
            <span class="tcg-album-arrow" aria-hidden="true">→</span>
          </span>
        </button>
      <% }) %>
      <p class="dg-start-note muted small">Karten wählst du nach dem Beitritt in der Lobby.<% if (!cards.characters.length) { %> <strong>Du hast gerade keine freie Charakterkarte</strong> – ohne sie bist du beim Start nicht dabei.<% } %></p>
    </form>
  <% } else { %>
  <div class="dg-slots">
    <% slots.forEach((s, i) => { %>
      <% if (s.card || (s.choosing && !s.empty && !s.invited)) { %>
        <% const pickMe = s.me && canPick; %>
        <div class="dg-slot<%= s.card ? ' r-' + s.card.rarity : ' is-choosing' %><%= s.me ? ' is-me' : '' %><%= s.bot ? ' is-bot' : '' %>" data-dg-slot="<%= i %>">
          <% if (s.leader) { %><span class="dg-leader" title="Gruppenleiter" aria-label="Gruppenleiter">♛</span><% } %>
          <div class="dg-slot-card">
            <% if (s.card && pickMe) { %>
              <button type="button" class="dg-slot-pick" data-dg-open="card" aria-label="Charakter wechseln (<%= s.card.name %>)"><img src="<%= s.card.image %>" alt="<%= s.card.name %>" width="720" height="1008" loading="lazy"><span class="dg-slot-change">Wechseln</span></button>
            <% } else if (s.card) { %>
              <button type="button" class="dg-slot-zoom" <%- zoomAttrs(s.card) %> aria-label="<%= s.card.name %> vergrößern"><img src="<%= s.card.image %>" alt="<%= s.card.name %>" width="720" height="1008" loading="lazy"></button>
            <% } else if (pickMe) { %>
              <button type="button" class="dg-slot-placeholder dg-slot-choose" data-dg-open="card"><span><b aria-hidden="true">+</b>Charakter wählen</span></button>
            <% } else { %>
              <div class="dg-slot-placeholder"><span><%= s.me ? 'Kein Charakter gewählt' : 'Wählt noch …' %></span></div>
            <% } %>
            <span class="dg-pop-layer" data-dg-pops></span>
          </div>
          <span class="dg-slot-name"><%= s.name %><% if (s.bot) { %> <span class="dg-bot-tag">Bot</span><% } %></span>
          <span class="dg-slot-stats"><%= s.card ? statLine(s.card) : '' %></span>
          <%# Boost-Karte: eigener kleiner Kartenplatz unter dem Charakter, für alle Spieler gleich %>
          <div class="dg-boost<%= s.boost ? ' r-' + s.boost.rarity : ' is-none' %>">
            <span class="dg-boost-label">Boost</span>
            <% if (pickMe) { %>
              <button type="button" class="dg-boost-card dg-boost-pick<%= s.boost ? '' : ' dg-boost-empty' %>" data-dg-open="boost" aria-label="<%= s.boost ? 'Boost wechseln (' + s.boost.name + ')' : 'Boost wählen' %>"><% if (s.boost) { %><img src="<%= s.boost.image %>" alt="" width="720" height="1008" loading="lazy"><% } else { %><b aria-hidden="true">+</b><% } %></button>
              <span class="dg-boost-name<%= s.boost ? '' : ' muted' %>"><%= s.boost ? s.boost.name : 'Boost wählen' %></span>
            <% } else if (s.boost) { %>
              <button type="button" class="dg-boost-card" <%- zoomAttrs(s.boost) %> aria-label="Boost <%= s.boost.name %> vergrößern"><img src="<%= s.boost.image %>" alt="" width="720" height="1008" loading="lazy"></button>
              <span class="dg-boost-name"><%= s.boost.name %></span>
            <% } else { %>
              <span class="dg-boost-card dg-boost-empty"></span>
              <span class="dg-boost-name muted">kein Boost</span>
            <% } %>
          </div>
        </div>
      <% } else if (s.invited) { %>
        <div class="dg-slot is-empty is-invited">
          <div class="dg-slot-card dg-slot-placeholder"><span>Eingeladen</span></div>
          <span class="dg-slot-name"><%= s.name %></span>
          <% if (isLeader && !lockedIn) { %>
            <form method="post" action="/dungeon/einladung-zurueck">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="user" value="<%= s.userId %>">
              <button class="btn btn-ghost btn-sm" type="submit">Zurückziehen</button>
            </form>
          <% } %>
        </div>
      <% } else { %>
        <div class="dg-slot is-empty">
          <div class="dg-slot-card dg-slot-placeholder"><span><%= s.solo ? 'Wird beim Start zugelost' : 'Freier Platz' %></span></div>
          <span class="dg-slot-name muted"><%= s.solo ? 'Mitspieler oder Bot' : '–' %></span>
        </div>
      <% } %>
    <% }) %>
  </div>
  <% } %>

  <% if (hasChat) { %>
    <aside class="dg-chat" data-dg-chat>
      <div class="dg-chat-inner">
      <h2 class="dg-chat-head">Gruppen-Chat</h2>
      <ol class="dg-chat-list" data-dg-chat-list aria-live="polite"></ol>
      <form class="dg-chat-form" data-dg-chat-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="text" maxlength="<%= chatMax %>" placeholder="Nachricht …" autocomplete="off" aria-label="Nachricht an die Gruppe">
        <button class="btn btn-primary btn-sm" type="submit">Senden</button>
      </form>
      </div>
    </aside>
  <% } else if (phase === 'frei') { %>
    <a class="dg-help-tile" href="/dungeon/anleitung">
      <span class="dg-help-art" aria-hidden="true">
        <img src="/img/dungeon/st-ivan-dungeon-banner.webp" alt="" width="1983" height="793" loading="lazy">
      </span>
      <span class="dg-help-foot">
        <span class="dg-help-text">
          <span class="kicker">Dungeon</span>
          <span class="dg-help-title">So funktioniert's</span>
          <span class="dg-help-hint">Ablauf, Boosts und Beute</span>
        </span>
        <span class="tcg-album-arrow" aria-hidden="true">→</span>
      </span>
    </a>
  <% } %>
</section>

<%# ---------- Lobby: Status, Einladen und Verlassen direkt unter den Plätzen ---------- %>
<% if (phase === 'solo' || phase === 'gruppe') { %>
  <% const meSlot = slots.find((s) => s.me); %>
  <section class="dg-lobby-bar">
    <div class="dg-lobby-status">
      <% if (meSlot && meSlot.choosing && !lockedIn) { %>
        <p class="dg-lobby-warn"><strong>Wähle deinen Charakter</strong> – klick oben auf deinen Platz. Ohne Charakter bist du beim Start nicht dabei.</p>
      <% } %>
      <% if (phase === 'solo') { %>
        <p class="muted">Solo Queue: Beim Start wirst du mit anderen Einzelspielern zusammengelost – fehlende Plätze übernehmen Bots.</p>
      <% } else if (isLeader) { %>
        <p class="muted">Du bist <strong>Gruppenleiter</strong>. Lade bis zu zwei Mitglieder ein – freie Plätze übernehmen beim Start Bots.</p>
      <% } else { %>
        <p class="muted">Du bist in der Gruppe von <strong><%= (party.members.find((m) => String(m.user) === String(party.leader)) || {}).name %></strong>. Ihr startet gemeinsam.</p>
      <% } %>
    </div>
    <div class="dg-lobby-actions">
      <% if (phase === 'gruppe' && isLeader && !lockedIn && slots.some((s) => s.empty)) { %>
        <form method="post" action="/dungeon/einladen" class="dg-invite">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="name" placeholder="Name des Mitglieds" required maxlength="40" autocomplete="off" aria-label="Name des Mitglieds">
          <button class="btn btn-primary" type="submit">Einladen</button>
        </form>
      <% } %>
      <form method="post" action="/dungeon/verlassen" data-dg-leave>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-ghost" type="submit" <%= canLeave ? '' : 'disabled' %> title="Bis <%= lockSeconds %> Sekunden vor dem Start möglich"><%= phase === 'solo' ? 'Abmelden' : 'Gruppe verlassen' %></button>
      </form>
    </div>
  </section>
<% } %>

<%# Kartenauswahl in der Lobby: ein Fenster je Platz (Charakter, Boost), öffnet neben dem angeklickten Platz.
    Ein Klick auf eine Karte übernimmt sie sofort (public/js/dungeon.js) – kein Bestätigen, kein Scrollen.
    Je Liste: Suche, Seltenheits-Filter und Seiten (public/js/dungeon.js) %>
<% let dgBarNo = 0; %>
<% const pickList = (kind, list, sel) => { const rars = [...new Set(list.map((c) => c.rarity))].sort((a, b) => rarityByKey[a].rank - rarityByKey[b].rank); %>
  <div class="dg-picklist" data-dg-picklist>
    <% if (list.length) { %>
      <div class="dg-pick-head">
        <%# Suchen + Seltenheit (partials/mkt-bar); Zahl = wählbare Karten dieser Seltenheit %>
        <%- include('partials/mkt-bar', { name: 'dg-' + kind + '-' + (++dgBarNo), placeholder: (kind === 'card' ? 'Charakter' : 'Boost-Karte') + ' suchen', searchAttr: 'dg-search', groups: [{ attr: 'dg-rar', all: '', allCount: list.length, opts: Object.values(rarityByKey).filter((r) => !r.hidden || rars.includes(r.key)).sort((a, b) => a.rank - b.rank).map((r) => ({ key: r.key, label: r.label, count: list.filter((c) => c.rarity === r.key).length })) }] }) %>
      </div>
    <% } %>
    <div class="dg-pick-pager">
      <button type="button" class="dg-page-btn" data-dg-prev aria-label="Vorherige Seite" hidden>‹</button>
      <div class="dg-pick-grid">
        <% if (kind === 'boost') { %>
          <label class="dg-pick dg-pick-none">
            <input type="radio" name="boost" value="" <%= !sel || !sel.boost ? 'checked' : '' %>>
            <span class="dg-slot-placeholder"><span>Ohne Boost</span></span>
          </label>
        <% } %>
        <% list.forEach((c) => { const checked = !!sel && (kind === 'card' ? sel.card === c.id : sel.boost === c.id); %>
          <label class="dg-pick r-<%= c.rarity %>" data-dg-item data-name="<%= c.name.toLowerCase() %>" data-rarity="<%= c.rarity %>" data-count="<%= cards.counts[c.id] || 0 %>">
            <input type="radio" name="<%= kind %>" value="<%= c.id %>" <%= checked ? 'checked' : '' %>>
            <img src="<%= c.image %>" alt="" width="720" height="1008" loading="lazy">
            <button type="button" class="dg-zoom-btn" <%- zoomAttrs(c) %> aria-label="<%= c.name %> ansehen"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/></svg></button>
            <span class="dg-pick-name"><%= c.name %> <span class="muted">(<%= rarityByKey[c.rarity].label %>)</span></span>
            <% if (kind === 'card') { %><span class="dg-pick-stats"><%= statLine(c) %></span><% } %>
          </label>
        <% }) %>
      </div>
      <button type="button" class="dg-page-btn" data-dg-next aria-label="Nächste Seite" hidden>›</button>
    </div>
    <p class="dg-page-info muted small" data-dg-pageinfo></p>
    <p class="muted small" data-dg-empty hidden>Keine passende Karte.</p>
  </div>
<% } %>

<% if (canPick) { %>
  <form method="post" action="/dungeon/karten" data-dg-cards-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% [['card', 'Charakter wählen', cards.characters], ['boost', 'Boost wählen', cards.boosts]].forEach(([kind, title, list]) => { %>
      <dialog class="dg-picker" data-dg-picker="<%= kind %>" aria-labelledby="dg-picker-<%= kind %>">
        <div class="dg-picker-head">
          <h2 id="dg-picker-<%= kind %>"><%= title %></h2>
          <button type="button" class="dg-picker-close" data-dg-picker-close aria-label="Schließen">×</button>
        </div>
        <% if (kind === 'card' && !list.length) { %>
          <p class="muted">Du hast keine freie Charakterkarte. Karten auf einer Quest, im Handel oder foliert können nicht mit.</p>
        <% } else { %>
          <% pickList(kind, list, current) %>
        <% } %>
        <p class="dg-picker-hint muted small"><%= kind === 'card' ? 'Ein Klick auf eine Karte übernimmt sie.' : 'Ein Klick übernimmt den Boost – er wirkt zur Halbzeit jedes Kampfes.' %> Bis <%= lockSeconds %> Sekunden vor dem Start kannst du wechseln.</p>
      </dialog>
    <% }) %>
  </form>
<% } %>

<%# ---------- Laufender Dungeon: Kampfverlauf ---------- %>
<% if (phase === 'laeuft') { %>
  <section class="dg-log card" data-dg-log>
    <h2>Kampfverlauf</h2>
    <ol class="dg-log-list" data-dg-log-list></ol>
  </section>
  <script type="application/json" id="dg-playback"><%- JSON.stringify(playback).replace(/</g, '\\u003c') %></script>
<% } %>

<% if (currentUser.isAdmin && phase !== 'laeuft') { %>
  <form method="post" action="/dungeon/sofort-starten" class="dg-foot">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-ghost btn-sm" type="submit">Admin: alle Anmeldungen jetzt starten</button>
  </form>
<% } %>

<%# Seltene Beute aller Spieler (Folie, Boss-Karte) – gleiche Liste wie "Seltene Ziehungen" im TCG %>
<section class="dg-rare tcg-rare-feed">
  <span class="kicker kicker-muted">Seltene Beute</span>
  <% if (!rareLoot.length) { %>
    <p class="muted small">Noch hat niemand eine Folie oder eine Boss-Karte erbeutet.</p>
  <% } else { %>
    <ul class="tcg-feed">
      <% rareLoot.forEach((l) => { %>
        <li class="<%= l.card ? 'r-' + l.card.rarity : 'dg-rare-foil' %>">
          <span class="tcg-dot"></span>
          <span><strong><%- userLink(l.name) %></strong> erbeutete <%= l.card ? 'die Boss-Karte „' + l.card.name + '“' : '' %><%= l.card && l.foil ? ' und ' : '' %><%= l.foil ? 'eine Folie' : '' %> <span class="muted">(<%= l.dungeon %>)</span></span>
          <span class="muted small nowrap"><%= relTime(l.at) %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
</div>

<%# Beute: nach dem Ende einmal als Fenster – Spieler für Spieler aufgedeckt %>
<% if (loot) { %>
  <dialog class="dg-loot" data-dg-loot aria-labelledby="dg-loot-title">
    <span class="kicker">Beute</span>
    <h2 id="dg-loot-title"><%= loot.success ? 'Boss besiegt!' : 'Rückzug' %></h2>
    <ul class="dg-loot-list">
      <% loot.players.forEach((p) => { %>
        <% const items = []; %>
        <% if (p.reward) items.push({ cls: 'is-money', text: euro(p.reward) }); %>
        <% if (p.foil) items.push({ cls: 'is-foil', text: 'Folie' }); %>
        <% if (p.bossCard) items.push({ cls: 'is-card', text: loot.bossCard ? loot.bossCard.name : 'Boss-Karte' }); %>
        <% if (!items.length) items.push({ cls: 'is-none', text: 'keine Beute' }); %>
        <% items.forEach((it) => { %>
          <li class="dg-loot-row <%= it.cls %><%= p.me ? ' is-me' : '' %>" data-dg-loot-row>
            <span class="dg-loot-name"><%= p.name %><% if (p.bot) { %> <span class="dg-bot-tag">Bot</span><% } %></span>
            <span class="dg-loot-chip <%= it.cls %>"><% if (it.img) { %><img src="<%= it.img %>" alt="" width="18" height="18"><% } %><%= it.text %></span>
          </li>
        <% }) %>
      <% }) %>
    </ul>
    <form data-dg-loot-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="run" value="<%= loot.id %>">
    </form>
    <button class="btn btn-primary" type="button" data-dg-loot-close>Weiter</button>
  </dialog>
<% } %>

<%- include('partials/card-zoom') %>
<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<script src="/js/dungeon.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
