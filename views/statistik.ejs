<%- include('partials/head') %>
<%
  const p = data ? data.period : null;
  const prev = data ? data.previous : null;
  const curRange = range;
  const dd = (d) => d.split('-').reverse().join('.');
  const span = (a) => `${dd(a.from).slice(0, 6)}–${dd(a.to)}`;
  // Das gewählte Mitglied bleibt beim Wechsel des Zeitraums erhalten
  const link = (bereich, tage, block) => '/admin/statistik?' + new URLSearchParams({ bereich, tage: String(tage), ...(bereich === 'mitglied' && member ? { spieler: member.username } : {}) }) + (block ? '#' + block : '');
  const AREA_NAMES = { start: 'Startseite', wetten: 'Wetten', tcg: 'TCG', handel: 'Handel', ihk: 'IHK', coin: 'Coin', lotterie: 'Lotterie', forum: 'Forum', profil: 'Profil & Rangliste', konto: 'Mein Konto', support: 'Support', admin: 'Admin/Dev', info: 'Regeln & Hilfe', sonstiges: 'Sonstiges' };
  const WEEKDAYS = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
  const BUCKET = { tag: 'je Tag', woche: 'je Woche', monat: 'je Monat' };
  const VERDICT = { 'im-rahmen': ['Im Rahmen', 'ok'], 'zu-oft': ['Auffällig oft', 'warn'], 'zu-selten': ['Auffällig selten', 'warn'], 'wenig-daten': ['Zu wenig Daten', 'muted'] };
  const isZero = (c) => !c || (typeof c === 'object' && (c.value === 0 || c.value === null));
  // Tabellenzeilen ohne Daten ausblenden (zeroCols: Spalten, die über "hat Daten" entscheiden)
  const visibleRows = (t) => (t.zeroCols ? t.rows.filter((r) => t.zeroCols.some((i) => !isZero(r[i]))) : t.rows);
  const cellHint = (c) => (c && typeof c === 'object' && c.hint ? c.hint : '');
  const info = (hint) => hint ? `<span class="stats-info" tabindex="0" title="${hint.replace(/"/g, '&quot;')}" aria-label="${hint.replace(/"/g, '&quot;')}">i</span>` : '';
%>

<div class="page-head stats-head">
  <h1>Statistik</h1>
  <% if (data) { %><span class="muted"><%= span(p) %> <span class="small">· verglichen mit <%= span(prev) %></span></span><% } %>
</div>

<div class="stats-filters">
  <nav class="tabs" aria-label="Bereich">
    <% sections.forEach((s) => { %>
      <a class="tab <%= s.key === active ? 'active' : '' %>" href="<%= link(s.key, curRange) %>"><%= s.label %></a>
    <% }) %>
  </nav>
  <nav class="stats-range" aria-label="Zeitraum">
    <% ranges.forEach((r) => { %>
      <a class="<%= r === curRange ? 'active' : '' %>" href="<%= link(active, r) %>" <% if (r === curRange) { %>aria-current="true"<% } %>><%= r === 365 ? '1 Jahr' : r + ' Tage' %></a>
    <% }) %>
  </nav>
</div>

<% if (active === 'mitglied') { %>
  <form method="get" action="/admin/statistik" class="stats-member-pick">
    <input type="hidden" name="bereich" value="mitglied">
    <input type="hidden" name="tage" value="<%= curRange %>">
    <label class="field">
      <span>Mitglied</span>
      <input type="text" name="spieler" list="stats-members" autocomplete="off" placeholder="Benutzername" value="<%= member ? member.username : '' %>" required>
    </label>
    <button class="btn btn-primary" type="submit">Anzeigen</button>
    <% if (member) { %><a class="btn btn-ghost" href="/profil/<%= encodeURIComponent(member.username) %>">Profil öffnen</a><% } %>
  </form>
  <% if (!member) { %>
    <section class="stats-block">
      <header class="stats-block-head">
        <h2>Mitglied auswählen</h2>
        <p class="muted">Suche oben nach einem Namen oder wähle ein Mitglied aus der Rangliste.</p>
      </header>
      <div class="card">
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th class="num">#</th><th>Mitglied</th><th class="num">Gesamtvermögen</th><th class="num hide-sm">Guthaben</th><th class="num hide-sm">Karten & Packs</th></tr></thead>
            <tbody>
              <% members.forEach((m, i) => { %>
                <tr>
                  <td class="num"><%= i + 1 %></td>
                  <td><a href="/admin/statistik?<%= new URLSearchParams({ bereich: 'mitglied', tage: String(curRange), spieler: m.username }) %>"><%= m.username %></a></td>
                  <td class="num"><%= fmt({ value: m.total, unit: 'euro' }) %></td>
                  <td class="num hide-sm"><%= fmt({ value: m.balance, unit: 'euro' }) %></td>
                  <td class="num hide-sm"><%= fmt({ value: m.cardValue, unit: 'euro' }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% } %>
  <datalist id="stats-members"><% members.forEach((m) => { %><option value="<%= m.username %>"><% }) %></datalist>
<% } %>

<% if (data) { %>
<% if (data.markers.length && active !== 'uebersicht') { %>
  <div class="stats-strip" aria-label="Änderungen im Zeitraum">
    <span class="stats-strip-label">Änderungen:</span>
    <% data.markers.forEach((m) => { %>
      <details class="stats-chip stats-chip-<%= m.kind %>">
        <summary><span aria-hidden="true">◆</span> <%= dd(m.day).slice(0, 6) %> <%= m.kind === 'patch' ? 'Patch: ' : '' %><%= m.label %></summary>
        <div class="stats-chip-body">
          <span class="muted small"><%= date(m.at) %><%= m.by ? ' · ' + m.by : '' %></span>
          <% if (m.detail.length) { %><ul><% m.detail.forEach((x) => { %><li><code><%= x %></code></li><% }) %></ul><% } %>
        </div>
      </details>
    <% }) %>
  </div>
<% } %>

<% if (data.blocks.length > 2) { %>
  <nav class="stats-subnav" aria-label="Themen">
    <% data.blocks.forEach((b) => { %><a href="#<%= b.id %>"><%= b.title %></a><% }) %>
  </nav>
<% } %>

<% data.blocks.forEach((b) => { %>
  <section class="stats-block" id="<%= b.id %>">
    <header class="stats-block-head">
      <h2><%= b.title %></h2>
      <p class="muted"><%= b.question %></p>
    </header>

    <% if (b.kpis && b.kpis.length) { %>
      <div class="stats-kpis stats-kpis-<%= b.kpis.length %>">
        <% b.kpis.forEach((k) => { const d = fmtDelta(k); const tag = k.href ? 'a' : 'div'; %>
          <<%= tag %> class="stats-kpi card" <% if (k.href) { %>href="<%= link(k.href.bereich, curRange, k.href.block) %>"<% } %>>
            <span class="stat-label"><%= k.label %> <%- info(k.hint) %></span>
            <span class="stat-value"><%= k.unit === 'text' ? k.value : fmt({ value: k.value, unit: k.unit, signed: k.signed }) %></span>
            <% if (d) { %>
              <span class="stats-delta stats-delta-<%= k.delta.dir %>"><span aria-hidden="true"><%= k.delta.dir === 'up' ? '▲' : k.delta.dir === 'down' ? '▼' : '●' %></span> <%= d %> <span class="muted">ggü. Vorzeitraum</span></span>
            <% } else if (k.compare) { %>
              <span class="stats-delta stats-delta-none">kein Vergleich möglich</span>
            <% } %>
          </<%= tag %>>
        <% }) %>
      </div>
    <% } %>

    <% if (b.warning) { %>
      <p class="small stats-warn">Abgleich: Die Kontostände weichen um <%= fmt({ value: b.warning.diff, unit: 'euro', signed: true }) %> von der Summe aller Buchungen ab (z. B. Konten ohne Startguthaben-Buchung).</p>
    <% } %>

    <% if (b.flow) { const maxFlow = Math.max(1, ...b.flow.sources.map((g) => g.value), ...b.flow.sinks.map((g) => -g.value)); %>
      <div class="card stats-flow">
        <h3>Geldfluss-Bilanz im Zeitraum</h3>
        <div class="stats-flow-cols">
          <% [['Quellen – hier entsteht Geld', b.flow.sources, 'in'], ['Senken – hier verschwindet Geld', b.flow.sinks, 'out']].forEach(([title, list, cls]) => { %>
            <div>
              <h4><%= title %></h4>
              <% if (!list.length) { %><p class="muted small">Keine im Zeitraum.</p><% } %>
              <ul class="stats-hbars">
                <% list.forEach((g) => { %>
                  <li>
                    <span class="stats-hbar-label"><%= g.label %> <%- info(g.hint) %></span>
                    <span class="stats-hbar-track"><span class="stats-hbar stats-hbar-<%= cls %>" style="width: <%= Math.max(1, Math.round((Math.abs(g.value) / maxFlow) * 100)) %>%"></span></span>
                    <span class="stats-hbar-value"><%= fmt({ value: g.value, unit: 'euro', signed: true }) %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (b.pulls) { %>
      <div class="card">
        <p class="muted small"><%= b.pulls.total %> gezogene Karten im Zeitraum. Der Balken zeigt die tatsächliche Häufigkeit im Verhältnis zur eingestellten Chance – die Linie in der Mitte ist genau „wie eingestellt“. Erst ab etwa 5 erwarteten Karten ist eine Aussage möglich.</p>
        <div class="table-wrap">
          <table class="table stats-pulls">
            <thead><tr><th>Seltenheit</th><th class="num">Chance</th><th class="num">Erwartet</th><th class="num">Gezogen</th><th class="hide-sm">Ist ÷ Soll</th><th>Bewertung</th></tr></thead>
            <tbody>
              <% b.pulls.rows.forEach((r) => { const ratio = r.chance && r.share !== null ? r.share / r.chance : null; const v = VERDICT[r.verdict]; %>
                <tr>
                  <td><%= r.label %></td>
                  <td class="num"><%= fmt({ value: r.chance, unit: 'percent', digits: 2 }) %></td>
                  <td class="num"><%= r.expected.toLocaleString('de-DE', { maximumFractionDigits: 1 }) %></td>
                  <td class="num"><%= r.count %></td>
                  <td class="hide-sm">
                    <% if (ratio !== null && r.verdict !== 'wenig-daten') { %>
                      <span class="stats-ratio" title="<%= fmt({ value: ratio, unit: 'percent' }) %> der eingestellten Chance"><span class="stats-ratio-bar stats-ratio-<%= v[1] %>" style="width: <%= Math.min(100, Math.round(ratio * 50)) %>%"></span></span>
                    <% } %>
                  </td>
                  <td><span class="stats-badge stats-badge-<%= v[1] %>"><%= v[0] %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% const charts = b.charts || []; const shown = charts.filter((c) => !c.empty); const empty = charts.filter((c) => c.empty); %>
    <% if (shown.length) { %>
      <div class="stats-charts">
        <% shown.forEach((c) => { %>
          <div class="card stats-chart-card <%= c.wide ? 'is-wide' : '' %>">
            <h3><%= c.title %> <span class="muted small">· <%= BUCKET[data.bucketUnit] %></span></h3>
            <% if (c.note) { %><p class="muted small"><%= c.note %></p><% } %>
            <div class="stats-chart" data-stats-chart="<%= c.id %>"></div>
          </div>
        <% }) %>
      </div>
    <% } %>
    <% if (empty.length) { %>
      <p class="muted small stats-empty-note">Keine Daten im Zeitraum: <%= empty.map((c) => c.title).join(', ') %>.</p>
    <% } %>

    <% if (b.hbars && b.hbars.items.length) { %>
      <div class="card">
        <% if (b.hbars.title) { %><h3><%= b.hbars.title %></h3><% } %>
        <ul class="stats-hbars">
          <% b.hbars.items.forEach((x) => { %>
            <li>
              <span class="stats-hbar-label"><%= x.label || AREA_NAMES[x.key] || x.key %></span>
              <span class="stats-hbar-track"><span class="stats-hbar" style="width: <%= Math.max(1, Math.round((x.share || 0) * 100)) %>%"></span></span>
              <span class="stats-hbar-value"><%= x.text %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (b.heat) { %>
      <div class="card">
        <h3>Wann wird gespielt?</h3>
        <p class="muted small">Wie oft in der jeweiligen Stunde gespielt wurde (Tage mit Aktivität, deutsche Zeit). Dunkler = mehr.</p>
        <div class="table-wrap">
          <table class="stats-heat">
            <thead><tr><th></th><% for (let h = 0; h < 24; h++) { %><th><%= h % 3 === 0 ? h : '' %></th><% } %></tr></thead>
            <tbody>
              <% b.heat.rows.forEach((row, wd) => { %>
                <tr>
                  <th><%= WEEKDAYS[wd] %></th>
                  <% row.forEach((n, h) => { %><td style="--heat: <%= (n / b.heat.max).toFixed(3) %>" title="<%= WEEKDAYS[wd] %> <%= h %>–<%= h + 1 %> Uhr: <%= n %>"><span class="sr-only"><%= n %></span></td><% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% (b.tables || []).forEach((t) => { const rows = visibleRows(t); if (!rows.length) return; %>
      <% if (t.collapsed) { %><details class="card stats-collapsed"><summary><strong><%= t.title %></strong></summary><% } else { %><div class="card"><h3><%= t.title %></h3><% } %>
        <% if (t.note) { %><p class="muted small"><%= t.note %></p><% } %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><% t.head.forEach((h) => { %><th class="<%= h.num ? 'num' : '' %>"><%= h.label || h %></th><% }) %></tr></thead>
            <tbody>
              <% rows.forEach((row) => { %>
                <tr><% row.forEach((c, i) => { %><td class="<%= t.head[i] && t.head[i].num ? 'num' : '' %>" <% if (cellHint(c)) { %>title="<%= cellHint(c) %>"<% } %>><%= fmt(c) %></td><% }) %></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% if (t.collapsed) { %></details><% } else { %></div><% } %>
    <% }) %>

    <% if (b.timeline) { %>
      <div class="card">
        <% if (!data.markers.length) { %>
          <p class="muted">Keine Einstellungsänderungen oder Patchnotes im Zeitraum.</p>
        <% } else { %>
          <ol class="stats-timeline">
            <% data.markers.slice().reverse().forEach((m) => { %>
              <li class="stats-timeline-<%= m.kind %>">
                <span class="stats-badge stats-badge-<%= m.kind === 'patch' ? 'muted' : 'setting' %>"><%= m.kind === 'patch' ? 'Patch' : m.short %></span>
                <div>
                  <strong><%= m.label %></strong> <span class="muted small"><%= date(m.at) %><%= m.by ? ' · ' + m.by : '' %></span>
                  <% if (m.detail.length) { %><ul class="small"><% m.detail.forEach((x) => { %><li><code><%= x %></code></li><% }) %></ul><% } %>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>
    <% } %>

    <% (b.notes || []).forEach((n) => { %><p class="muted small stats-empty-note"><%= n %></p><% }) %>
  </section>
<% }) %>

<script type="application/json" id="stats-data"><%- JSON.stringify(chartData).replace(/</g, '\\u003c') %></script>
<script src="/js/stats.js?v=<%= assetVersion %>" defer></script>
<% } %>
<%- include('partials/foot') %>
