<%- include('partials/head') %>

<div class="page-head">
  <h1>Rangliste</h1>
  <form method="get" action="/rangliste" class="leader-search" role="search">
    <label class="sr-only" for="rang-suche">Mitglied suchen</label>
    <input type="search" id="rang-suche" name="suche" value="<%= q %>" maxlength="30" placeholder="Mitglied suchen …">
    <button class="btn btn-ghost btn-sm" type="submit">Suchen</button>
    <% if (q) { %><a class="btn btn-ghost btn-sm" href="/rangliste">Alle</a><% } %>
  </form>
</div>

<div class="card">
  <% if (!leaders.length) { %>
    <p class="muted"><%= q ? 'Kein Mitglied gefunden.' : 'Noch niemand dabei.' %></p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table leaderboard">
        <thead><tr><th>#</th><th>Name</th><th class="num">Gesamt</th><th class="num hide-sm">Verfügbar</th><th class="num hide-sm">In Wetten</th><th class="num hide-sm">In Coins</th><th class="num hide-sm" title="Verkaufswert der Karten plus ungeöffnete Packs zum Packpreis">In Karten</th></tr></thead>
        <tbody>
          <% leaders.forEach((u, i) => { const me = currentUser && String(currentUser._id) === String(u._id); %>
            <tr class="<%= me ? 'me' : '' %><%= u.rank === 1 ? ' is-top1' : '' %>">
              <td class="rank rank-<%= u.rank %>"><%= u.rank %></td>
              <td><% if (u.rank === 1) { %><a class="flame-name" data-text="<%= u.username %>" href="/profil/<%= encodeURIComponent(u.username) %>"><%= u.username %></a><% } else { %><a href="/profil/<%= encodeURIComponent(u.username) %>"><%= u.username %></a><% } %><%- roleBadge(u.username) %></td>
              <td class="num"><strong><%= euro(u.total) %></strong></td>
              <td class="num hide-sm"><%= euro(u.balance) %></td>
              <td class="num hide-sm"><%= euro(u.inPlay) %></td>
              <td class="num hide-sm"><%= euro(u.coinValue) %></td>
              <td class="num hide-sm"><%= euro(u.cardValue) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/foot') %>
