<%- include('partials/head') %>

<div class="page-head">
  <h1>Rangliste</h1>
  <span class="muted">Gesamt = Kontostand + offene Einsätze + Samantha Coins (aktueller Kurs) + TCG-Karten (Verkaufswert)</span>
</div>

<div class="card">
  <% if (!leaders.length) { %>
    <p class="muted">Noch niemand dabei.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table leaderboard">
        <thead><tr><th>#</th><th>Name</th><th class="num">Gesamt</th><th class="num hide-sm">Verfügbar</th><th class="num hide-sm">In Wetten</th><th class="num hide-sm">In Coins</th><th class="num hide-sm">In Karten</th></tr></thead>
        <tbody>
          <% leaders.forEach((u, i) => { const me = currentUser && String(currentUser._id) === String(u._id); %>
            <tr class="<%= me ? 'me' : '' %>">
              <td class="rank rank-<%= i + 1 %>"><%= i + 1 %></td>
              <td><%= u.username %><%= me ? ' (du)' : '' %></td>
              <td class="num"><strong><%= euro(u.total) %></strong></td>
              <td class="num hide-sm"><%= euro(u.balance) %></td>
              <td class="num hide-sm"><%= euro(u.inPlay) %></td>
              <td class="num hide-sm"><%= euro(u.coinValue) %></td>
              <td class="num hide-sm"><%= euro(u.cardValue) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/foot') %>
