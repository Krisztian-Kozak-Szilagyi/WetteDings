<%- include('partials/head') %>

<div class="forum-page forum-thread">
<nav class="forum-crumbs" aria-label="Pfad">
  <a href="/forum">Forum</a><span>›</span><span>Meldungen</span>
</nav>

<div class="forum-head">
  <div class="forum-head-text">
    <h1>Meldungen</h1>
    <span class="forum-head-desc">Gemeldete Beiträge, die noch niemand geprüft hat</span>
  </div>
</div>

<% if (!reports.length) { %>
  <p class="forum-empty">Keine offenen Meldungen.</p>
<% } else { %>
  <ol class="forum-reports">
    <% reports.forEach((r) => { %>
      <li class="forum-report">
        <div class="forum-report-head">
          <span>Gemeldet von <%- userLink(r.byName) %></span>
          <time><%= dateSec(r.createdAt) %></time>
        </div>
        <% if (r.reason) { %><p class="forum-report-reason">„<%= r.reason %>“</p><% } %>
        <div class="forum-report-post">
          <% if (r.postDoc) { %>
            <span class="forum-label">Beitrag von <%= r.postDoc.authorName %></span>
            <p><%= r.postDoc.deleted ? '(inzwischen gelöscht)' : r.postDoc.body.slice(0, 220) + (r.postDoc.body.length > 220 ? ' …' : '') %></p>
          <% } else { %><p class="forum-sub">Beitrag nicht mehr vorhanden</p><% } %>
        </div>
        <div class="forum-report-actions">
          <a class="btn btn-ghost btn-sm" href="/forum/t/<%= r.thread %>#b-<%= r.post %>">Zum Beitrag</a>
          <form method="post" <%= currentUser.isStaff ? "data-reauth" : "" %> action="/forum/meldungen/<%= r._id %>/erledigt">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary btn-sm" type="submit">Erledigt</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ol>
<% } %>
</div>

<%- include('partials/foot') %>
