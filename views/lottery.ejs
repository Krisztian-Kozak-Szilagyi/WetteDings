<%- include('partials/head') %>
<%
  const myTickets = myEntry ? myEntry.tickets : 0;
  const chance = round.tickets ? myTickets / round.tickets : 0;
%>

<div hidden data-live-root data-live-url="/lotterie/stand" data-live-version="<%= liveVersion %>" data-live-signature="<%= round._id %>|<%= lastDrawn ? lastDrawn._id : '-' %>"></div>

<div class="page-head">
  <h1>Lotterie</h1>
  <span class="muted">Täglich · Ziehung um <%= drawTime %> Uhr · neue Runde ab <%= lotteryTime %> Uhr</span>
</div>

<% if (iWonLast) { %>
  <div class="lotto-winner-banner">
    <strong>Glückwunsch! Du hast die letzte Ziehung gewonnen.</strong>
    <span><%= euro(lastDrawn.pot) %> wurden dir gutgeschrieben (Los Nr. <%= lastDrawn.winningTicket %>).</span>
  </div>
<% } %>

<div class="lotto-layout">
  <section class="lotto-main">
    <div class="card lotto-jackpot">
      <span class="lotto-label">Runde #<%= round.number %> · Jackpot</span>
      <span class="lotto-pot" data-live="pot"><%= euro(round.pot) %></span>
      <div class="lotto-draw">
        <span>Ziehung am <strong><%= date(round.drawAt) %></strong></span>
        <span class="muted">noch <span data-countdown="<%= new Date(round.drawAt).getTime() %>">–</span></span>
      </div>
      <div class="stats stats-3" data-live="round-stats">
        <div class="stat"><span class="stat-label">Verkaufte Lose</span><span class="stat-value"><%= round.tickets %></span></div>
        <div class="stat"><span class="stat-label">Teilnehmende</span><span class="stat-value"><%= round.participants %></span></div>
        <div class="stat"><span class="stat-label">Deine Chance</span><span class="stat-value"><%= myTickets ? (chance * 100).toFixed(chance < 0.1 ? 1 : 0).replace('.', ',') + ' %' : '–' %></span></div>
      </div>
    </div>

    <div class="card" data-live="entries">
      <h2>Teilnehmende dieser Runde</h2>
      <% if (!entries.length) { %>
        <p class="muted">Noch hat niemand ein Los gekauft – der Topf wartet auf dich!</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Name</th><th class="num">Lose</th><th class="num">Chance</th><th class="hide-sm">Losnummern</th></tr></thead>
            <tbody>
              <% entries.forEach((e) => { %>
                <tr class="<%= String(e.user) === String(currentUser._id) ? 'me' : '' %>">
                  <td><%- userLink(e.username) %></td>
                  <td class="num"><%= e.tickets %></td>
                  <td class="num"><%= Math.round((e.tickets / round.tickets) * 100) %> %</td>
                  <td class="hide-sm muted small"><%= e.ranges.map((r) => r.from === r.to ? r.from : r.from + '–' + r.to).join(', ') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card" data-live="history">
      <h2>Letzte Ziehungen</h2>
      <% if (!history.length) { %>
        <p class="muted">Es gab noch keine Ziehung.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Runde</th><th>Ziehung</th><th class="num">Jackpot</th><th>Gewinner</th><th class="num hide-sm">Gewinnlos</th></tr></thead>
            <tbody>
              <% history.forEach((h) => { %>
                <tr class="<%= h.winner && String(h.winner) === String(currentUser._id) ? 'me' : '' %>">
                  <td>#<%= h.number %></td>
                  <td class="nowrap"><%= date(h.drawnAt) %></td>
                  <td class="num"><%= euro(h.pot) %></td>
                  <td><% if (h.winnerName) { %><%- userLink(h.winnerName) %><% } else if (h.tickets > 0) { %>– (Topf verfallen)<% } else { %>– (keine Lose)<% } %></td>
                  <td class="num hide-sm"><%= h.winningTicket ? h.winningTicket + ' / ' + h.tickets : '–' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>

  <aside class="lotto-side">
    <div class="card card-accent">
      <h2>Lose kaufen</h2>
      <p>Ein Los kostet <strong><%= euro(ticketPrice) %></strong>. Der gesamte Topf geht an ein zufällig gezogenes Los.</p>
      <div data-live="my-tickets">
        <% if (myTickets) { %>
          <p class="big">Du hast <%= myTickets %> <%= myTickets === 1 ? 'Los' : 'Lose' %></p>
          <p class="muted small">Losnummern: <%= myEntry.ranges.map((r) => r.from === r.to ? r.from : r.from + '–' + r.to).join(', ') %></p>
        <% } %>
      </div>
      <% if (selling) { %>
        <form method="post" action="/lotterie/kaufen" class="form lotto-form" data-price="<%= ticketPrice %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span>Anzahl Lose</span>
            <input type="number" name="count" min="1" max="<%= maxTickets %>" step="1" value="1" required>
          </label>
          <div class="quick-amounts">
            <% [1, 2, 5, 10].filter((n) => n <= maxTickets).forEach((n) => { %>
              <button type="button" class="chip" data-count="<%= n %>"><%= n %></button>
            <% }) %>
          </div>
          <p class="estimate" data-lotto-cost></p>
          <button class="btn btn-primary btn-block" type="submit" <%= currentUser.balance < ticketPrice ? 'disabled' : '' %>>Lose kaufen</button>
          <p class="muted small">Verfügbar: <span data-live="lotto-balance"><%= euro(currentUser.balance) %></span></p>
        </form>
      <% } else { %>
        <p class="muted">Die Ziehung läuft gerade – die nächste Lotterie startet in Kürze.</p>
      <% } %>
    </div>

    <div class="card">
      <h2>So funktioniert's</h2>
      <ul class="lotto-rules">
        <li>Jeden Tag gibt es eine Lotterie. Lose können bis zur Ziehung gekauft werden.</li>
        <li>Die Ziehung ist am Folgetag um <%= drawTime %> Uhr – 1 Minute bevor um <%= lotteryTime %> Uhr die nächste Lotterie beginnt.</li>
        <li>Jedes Los hat eine Nummer. Gezogen wird eine Nummer per Zufall – wer das Los besitzt, bekommt den gesamten Topf.</li>
        <li>Mehr Lose = höhere Chance. Maximal <%= maxTickets %> Lose pro Kauf.</li>
      </ul>
    </div>
  </aside>
</div>

<%- include('partials/foot') %>
