<%- include('partials/head') %>
<%#
  Karte graden lassen (#204): eigene Karte wählen, Bausteine buchen (Reinigung immer, dazu Bügeln und/oder Benoten + Slab,
  optional Express), Shop wählen – jeder Shop zeigt den Gesamtpreis für die Auswahl (public/js/grading-einreichen.js).
  Darunter die eigenen Aufträge (stornieren, bewerten).
%>
<%
  const STATUS = { wartet: 'Wartet', in_arbeit: 'In Arbeit', fertig: 'Zurück', abgelaufen: 'Abgelaufen – erstattet', storniert: 'Storniert – erstattet' };
  const others = shops.filter((s) => !s.own);
  const svc = Object.fromEntries(services.map((s) => [s.key, s]));
  const cents = (v) => (v / 100).toFixed(2).replace('.', ',');
%>
<div class="gr-page">
  <div class="gr-head">
    <h1>Karte graden lassen</h1>
    <a class="btn btn-ghost btn-sm" href="/grading">Zum eigenen Shop</a>
  </div>
  <p class="muted">Schick eine Karte an den Grading-Shop eines Mitglieds. Du buchst, was er tun soll – jeder Shop hat feste Preise je Baustein. Der Preis wird beim Einreichen abgebucht; arbeitet der Shop nicht rechtzeitig, bekommst du ihn zurück.</p>

  <% if (!others.length) { %>
    <section class="gr-empty"><h2>Noch kein Shop offen</h2><p>Gerade nimmt kein Grading-Shop Karten von Mitgliedern an. Shops ab Stufe 4 (Premium-Labor) erscheinen hier.</p></section>
  <% } else if (!cards.length) { %>
    <section class="gr-empty"><h2>Keine Karte frei</h2><p>Du hast gerade keine Karte, die sich einreichen lässt (Karten im Slab erst aufbrechen; Karten im Handel, auf Quest oder in der Vitrine sind gesperrt).</p></section>
  <% } else { %>
    <form method="post" action="/grading/einreichen" class="gs-form" data-gs-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <section class="gs-step">
        <h2><span class="gs-num">1</span> Karte wählen</h2>
        <p class="small muted gs-risk">🛡️ <b>Mit TCG Sleeve</b> ist die Karte beim Versand geschützt – der Sleeve bleibt dafür beim Shop. <b>Ohne Sleeve</b> besteht ein kleines Risiko (ca. <%= shipRisk %> %), dass sie unterwegs einen Kratzer oder, selten, einen Knick abbekommt.</p>
        <div class="tabs gs-filter" role="group" aria-label="Karten filtern">
          <% [['alle', 'Alle'], ['spuren', 'Mit Spuren'], ['knick', 'Mit Knick'], ['slab', 'Slabs (Zweitprüfung)']].forEach(([k, label], i) => { %>
            <button type="button" class="tab <%= i ? '' : 'active' %>" data-gs-filter="<%= k %>" aria-pressed="<%= i ? 'false' : 'true' %>"><%= label %></button>
          <% }) %>
        </div>
        <div class="tcg-grid gs-cards">
          <% cards.forEach((c) => { const r = rarityByKey[c.rarity] || { label: '' }; const ironable = c.creased && !c.ironed; %>
            <label class="tcg-slot gs-card r-<%= c.rarity %>" data-kind="<%= c.slab ? 'slab' : [c.damaged ? 'spuren' : '', ironable ? 'knick' : ''].join(' ') %>">
              <input type="radio" name="doc" value="<%= c.id %>" data-ironable="<%= ironable ? 1 : 0 %>" data-sleeve="<%= c.foiledAt && !c.slab ? 1 : 0 %>" data-slab="<%= c.slab ? c.slab.code : '' %>" data-name="<%= c.card.name %>" required>
              <% if (c.slab) { %>
                <span class="foil-card foil-card-slot"><%- include('partials/foil-mini', { card: c.card, rarityLabel: r.label, slab: c.slab, id: c.id }) %></span>
              <% } else if (c.foiledAt) { %>
                <span class="foil-card foil-card-slot"><%- include('partials/foil-mini', { card: c.card, rarityLabel: r.label }) %></span>
              <% } else { %>
                <span class="tcg-art">
                  <img src="<%= c.card.image %>" alt="" loading="lazy" width="720" height="1008">
                  <% if (c.creased) { %><span class="tcg-crease-tag"><%= c.ironed ? 'Gebügelt' : 'Knick' %></span><% } %>
                  <% if (c.marks) { %><button type="button" class="hb-loupe"<%- copyViewAttrs(c.card, r.label, c.marks, { note: 'Exemplar' }) %> aria-label="<%= c.card.name %> genau ansehen" title="Genau ansehen">🔍</button><% } %>
                </span>
              <% } %>
              <span class="tcg-slot-label"><span class="tcg-dot"></span><%= c.card.name %><%= c.slab ? ' · Slab ' + c.slab.code + ' ' + c.slab.grade : c.foiledAt ? ' · Sleeve geht an den Shop' : c.damaged ? ' · Spuren' : '' %></span>
            </label>
          <% }) %>
        </div>
      </section>

      <section class="gs-step">
        <h2><span class="gs-num">2</span> Was soll der Shop tun?</h2>
        <div class="gs-svcs">
          <input type="hidden" name="review" value="" data-gs-review-input>
          <label class="gs-svc is-fixed" data-gs-review hidden>
            <input type="checkbox" checked disabled>
            <span><b><%= svc.review.label %></b><small>Der Slab bleibt zu. Ein anderer Shop benotet die Karte blind – gleiche Note: Vermerk „bestätigt“; andere Note: neuer Slab mit seinem Kürzel. Lag der Aussteller deutlich daneben, verliert er Reputation.</small></span>
          </label>
          <label class="gs-svc is-fixed" data-gs-normal>
            <input type="checkbox" checked disabled>
            <span><b><%= svc.base.label %></b><small>Immer dabei – jede Karte wird geputzt.</small></span>
          </label>
          <label class="gs-svc" data-gs-iron data-gs-normal>
            <input type="checkbox" name="iron" value="1" data-gs-svc="iron">
            <span><b><%= svc.iron.label %></b><small data-gs-iron-hint>Nur bei Karten mit Knick, der noch nicht gebügelt ist. Je glatter, desto höher kann die Note werden.</small></span>
          </label>
          <label class="gs-svc" data-gs-normal>
            <input type="checkbox" name="slab" value="1" data-gs-svc="slab" checked>
            <span><b><%= svc.slab.label %></b><small>Der Shop benotet die Karte und versiegelt sie im Slab – mit seinem Kürzel und seiner Note.</small></span>
          </label>
          <label class="gs-svc">
            <input type="checkbox" name="express" value="1" data-gs-svc="express">
            <span><b>Express</b><small>Kommt vor allen anderen dran – der Shop hat <%= expressDays %> <%= expressDays === 1 ? 'Tag' : 'Tage' %> statt <%= orderDays %>.</small></span>
          </label>
        </div>
        <p class="gs-warn" data-gs-none hidden>Wähle mindestens Bügeln oder Benoten + Slab.</p>
      </section>

      <section class="gs-step">
        <h2><span class="gs-num">3</span> Shop wählen</h2>
        <div class="gs-shops">
          <% others.forEach((s, i) => { %>
            <label class="gs-shop" data-prices="<%= JSON.stringify(s.prices) %>" data-code="<%= s.code %>" data-slabs="<%= s.slabs %>">
              <input type="radio" name="shop" value="<%= s.code %>" <%= (pick ? pick === s.code : i === 0) ? 'checked' : '' %> required>
              <span class="gs-shop-head"><b><%= s.name %></b> <span class="gr-shop-code"><%= s.code %></span></span>
              <%- include('partials/grading-rating', { r: s.rating, owner: s.owner }) %>
              <span class="gs-shop-price"><b data-gs-total><%= euro(s.prices.base + s.prices.slab) %></b> für deine Auswahl · <%= s.queue ? s.queue + ' in der Warteschlange' : 'keine Warteschlange' %></span>
              <span class="gs-shop-stock small<%= s.slabs ? ' muted' : ' is-out' %>" data-gs-stock><%= s.slabs ? s.slabs + (s.slabs === 1 ? ' leerer Slab' : ' leere Slabs') + ' auf Lager' : 'Keine leeren Slabs – „Benoten + Slab“ nicht möglich' %></span>
              <span class="gs-shop-list muted small"><% services.forEach((sv, j) => { %><%= j ? ' · ' : '' %><%= sv.short %> <%= euro(s.prices[sv.key]) %><% }) %></span>
              <% if (s.showcase.length) { %>
                <span class="gs-shop-showcase">
                  <% s.showcase.slice(0, 4).forEach((x) => { %><span class="foil-card foil-card-slot"><%- include('partials/foil-mini', { card: x.card, rarityLabel: (rarityByKey[x.rarity] || {}).label || '', slab: x.slab, id: x.id }) %></span><% }) %>
                </span>
              <% } %>
              <a class="small" href="/grading/shop/<%= s.code %>">Shop ansehen →</a>
            </label>
          <% }) %>
        </div>
      </section>

      <div class="gs-submit">
        <p class="gs-summary" data-gs-summary>Wähle eine Karte.</p>
        <button class="btn btn-primary btn-lg gr-glow" type="submit" data-gs-submit disabled>Einreichen</button>
      </div>
    </form>
  <% } %>

  <% if (orders.length) { %>
    <section class="gr-done-wrap gs-orders">
      <h2>Deine Aufträge</h2>
      <ul class="gr-done">
        <% orders.forEach((o) => { const c = o.cardInfo; %>
          <li class="<%= c ? 'r-' + c.rarity : '' %>">
            <span class="gr-done-thumb"><% if (c) { %><img src="<%= c.image %>" alt="" width="36" height="50" loading="lazy"><% } %></span>
            <span class="gr-done-info">
              <span><b><%= c ? c.name : o.card %></b> <span class="gr-dim">bei <a href="/grading/shop/<%= o.shopCode %>"><%= o.shopCode %></a> · <%= euro(o.price) %></span></span>
              <span class="gr-done-meta">
                <%- include('partials/grading-services', { sv: o.services }) %>
                <%= STATUS[o.status] || o.status %>
                <% if (o.status === 'fertig' && o.result) { %><% if (o.services.review) { %> · <%= o.result.changed ? 'neuer Slab ' + o.shopCode + ', Note ' + o.result.grade + ' statt ' + o.result.before : 'Note ' + o.result.grade + ' bestätigt' %><% } else if (o.result.grade != null) { %> · Slab <b><%= o.shopCode %></b>, Note <b><%= o.result.grade %></b><% } else if (o.result.iron != null) { %> · gebügelt, <%= o.result.iron %> % glatt<% } %><% } %>
                <% if (o.status === 'wartet' || o.status === 'in_arbeit') { %> · bis <%= date(o.expiresAt) %><% } %>
                <% if (o.stars) { %> · deine Bewertung <%= '★'.repeat(o.stars) %><% } %>
              </span>
            </span>
            <span class="gs-order-actions">
              <% if (o.status === 'wartet') { %>
                <form method="post" action="/grading/auftrag/<%= o._id %>/storno" data-confirm="Auftrag stornieren? Du bekommst <%= euro(o.price) %> zurück.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-ghost btn-sm" type="submit">Stornieren</button>
                </form>
              <% } else if (o.rateable) { %>
                <form method="post" action="/grading/auftrag/<%= o._id %>/bewerten" class="gs-rate">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <span class="gs-stars" role="radiogroup" aria-label="Sterne">
                    <% for (let s = 5; s >= 1; s--) { %><input type="radio" id="st-<%= o._id %>-<%= s %>" name="stars" value="<%= s %>" required><label for="st-<%= o._id %>-<%= s %>" title="<%= s %> <%= s === 1 ? 'Stern' : 'Sterne' %>">★</label><% } %>
                  </span>
                  <%# Schnell-Tags (#204): erscheinen nach den Sternen – 4–5 Sterne Lob, 1–3 Kritik %>
                  <span class="gs-tags" data-gs-tags data-max="<%= tagMax %>" hidden>
                    <% reviewTags.forEach((t) => { %><label class="gs-tag <%= t.good ? 'is-good' : 'is-bad' %>"><input type="checkbox" name="tags" value="<%= t.key %>"><span><%= t.label %></span></label><% }) %>
                  </span>
                  <button class="btn btn-sm" type="submit">Bewerten</button>
                </form>
              <% } %>
            </span>
          </li>
        <% }) %>
      </ul>
      <p class="muted small">Bewerten kannst du bis <%= rateDays %> Tage nach der Rückgabe – einmal je Auftrag.</p>
    </section>
  <% } %>
</div>

<script src="/js/grading-einreichen.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foil-modal') %>
<%- include('partials/foot') %>
