<%- include('partials/head', { title: 'Taverne', hub: true, pageCss: ['hub'] }) %>
<%
  // Startseite im Stil einer Fantasy-Taverne (Vorlage: Design-Paket „Eclipse TCG – Hub-Redesign“). Daten:
  // dash = dashboardService.load(user). Desktop ist ein One-Pager (ein Bildschirm hoch), mobil eine Spalte.
  // Aufbau: Kopfzeile, Brett mit Logo, Pergament (Vermögen | Dailys | Broker-Kurse) und fünf Kacheln, Tresen.
  // Verhalten (Countdowns, Fenster) in public/js/hub.js, Aussehen in public/css/hub.css.
  const d = dash;
  const w = d.wealth;
  const t = d.today;
  const nav = navModel.buildNav(locals);
  const admin = nav.find((it) => it.href === '/admin');
  const forum = nav.find((it) => it.href === '/forum');
  const tcg = nav.find((it) => it.href === '/tcg');
  const gambling = nav.find((it) => it.group === 'gambling');
  const tcgNews = !!(tcg && (tcg.badges.length || tcg.live));
  const IMG = '/img/taverne/';
  const v = (f) => f + '?v=' + assetVersion;
  const pad = (n) => String(n).padStart(2, '0');
  // Countdown wie in hub.js: Tage nur, wenn es mehr als einen Tag ist
  const clock = (at) => {
    const s = Math.max(0, Math.floor((new Date(at).getTime() - Date.now()) / 1000));
    const days = Math.floor(s / 86400);
    return (days ? pad(days) + 'T ' : '') + pad(Math.floor((s % 86400) / 3600)) + ':' + pad(Math.floor((s % 3600) / 60)) + ':' + pad(s % 60);
  };
  const pct = (x, digits = 2) => (x * 100).toLocaleString('de-DE', { minimumFractionDigits: digits, maximumFractionDigits: digits }) + ' %';
  const signed = (txt, neg) => (neg ? '−' : '+') + txt;

  // Vermögen: Gesamt, Veränderung, Aufteilung (Farben wie in der Vorlage)
  const parts = [
    { label: 'Verfügbar', value: w.balance, color: '#b8862b' },
    { label: 'In Karten', value: w.cardValue || 0, color: '#3f86a6' },
    { label: 'Grading-Shop', value: w.shopValue || 0, color: '#b3453b' },
    { label: 'In Wetten', value: w.inPlay || 0, color: '#6d7f3a' },
    { label: 'In Coins', value: w.coinValue || 0, color: '#8a6f42' },
  ];
  const partSum = parts.reduce((s, p) => s + Math.max(0, p.value), 0) || 1;
  parts.forEach((p) => { p.share = (Math.max(0, p.value) / partSum) * 100; });
  const ch = w.change;
  const neg = ch && ch.diff < 0;
  const deltaText = !ch || !ch.diff ? 'Unverändert' : (neg ? '▼ ' : '▲ ') + signed(euro(Math.abs(ch.diff)), neg) + (ch.pct !== null ? ' · ' + signed(pct(Math.abs(ch.pct)), neg) : '');
  const wv = {
    tag: w.team ? 'Team – nicht in der Wertung' : w.rank ? 'Platz ' + w.rank + ' von ' + w.players : 'Noch ohne Platz',
    total: w.total,
    deltaText,
    deltaShort: !ch || !ch.diff ? 'Unverändert' : (neg ? '▼ ' : '▲ ') + (ch.pct !== null ? signed(pct(Math.abs(ch.pct)), neg) : signed(euro(Math.abs(ch.diff)), neg)),
    deltaCls: !ch || !ch.diff ? '' : neg ? 'is-down' : 'is-up',
    deltaDays: ch && w.days ? w.days + (w.days === 1 ? ' Tag' : ' Tage') : '',
    parts,
    barLabel: 'Verteilung: ' + parts.filter((p) => p.share > 0).map((p) => p.share.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' % ' + p.label).join(', '),
  };
  // Kurs-Ticker (Preis in Euro, kleine Werte mit 4 Nachkommastellen wie im Broker)
  const price = (p) => p.toLocaleString('de-DE', { minimumFractionDigits: p < 10 ? 4 : 2, maximumFractionDigits: p < 10 ? 4 : 2 }) + ' €';
  const ticker = d.ticker.map((c) => ({ ...c, priceText: price(c.price), changeText: (c.change < 0 ? '▼ ' : '▲ ') + signed(pct(Math.abs(c.change)), c.change < 0), cls: c.change < 0 ? 'is-down' : 'is-up' }));
  const cd = Object.fromEntries(d.countdowns.map((c) => [c.key, c]));
  const lotto = t.items.find((i) => i.key === 'lotto');
  const badgesOf = (it) => (it ? navModel.badgesHtml(it) : '');

  // Symbole (Pfade aus der Vorlage)
  const D = {
    rangliste: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3',
    gambling: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8 8h.01M16 8h.01M12 12h.01M8 16h.01M16 16h.01',
    tcg: 'M8 3h9a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM3 7v12a2 2 0 0 0 2 2M12 9l1.2 2.4 2.6.4-1.9 1.8.5 2.6-2.4-1.3-2.4 1.3.5-2.6-1.9-1.8 2.6-.4z',
    handel: 'M4 8h14l-3-3M20 16H6l3 3',
    grading: 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z',
    forum: 'M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1z',
    admin: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z',
    dungeon: 'M14.5 17.5L3 6V3h3l11.5 11.5M13 19l6-6M16 16l4 4M19 21l2-2',
    ihk: 'M9 4h6v3H9zM7 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1M9 14l2 2 4-4',
    tower: 'M8 21V10l4-6 4 6v11M6 21h12M12 13v3M10 10h4',
    coins: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v10M9.5 9.5c0-1 1-1.5 2.5-1.5s2.5.6 2.5 1.7c0 2.2-5 1.2-5 3.6 0 1.1 1.1 1.7 2.5 1.7s2.5-.6 2.5-1.5',
    scroll: 'M5 4h12a2 2 0 0 1 2 2v12a2 2 0 0 0 2 2H7a2 2 0 0 1-2-2zM9 9h6M9 13h6',
    wetten: 'M4 4h16v16H4zM8 9h8M8 13h8M8 17h5',
    broker: 'M4 19h16M6 15l4-5 3 3 5-7',
    lotterie: 'M3 7h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4zM14 7v2M14 11v2M14 15v2',
    clan: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 11l2 2 4-4',
  };
  const icon = (key, size, stroke = 'currentColor', width = 1.7) => '<svg width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="' + stroke + '" stroke-width="' + width + '" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="' + D[key] + '"/></svg>';
  const closeIcon = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
  const pve = d.pve;
  const gamblingItems = gambling ? gambling.items : [];
  const gIcon = { '/wetten': 'wetten', '/broker': 'broker', '/lotterie': 'lotterie' };
  // Kacheln: art/logo = [Datei, Breite, Höhe]. pos = Lage des Schriftzugs in Prozent des Motivs (links, oben, Breite),
  // per Bildabgleich bzw. Überlagerung gemessen. fit: fill = Motiv füllt die Kachel (4:3), wide = Breitbild (3:1) etwas
  // breiter als die Kachel, cover = 16:9 auf volle Höhe. Der SHOP-Schriftzug ist aus dem Motiv selbst ausgeschnitten.
  const tiles = [
    { key: 'shop', label: 'Shop', href: '/inventar/shop', art: ['shop.webp', 800, 600], logo: ['shop-logo.webp', 800, 215], pos: [17.61, 63.72, 62.91], fit: 'fill', alt: 'Shop: ein grinsender Goblin auf einem Sack voller Münzen' },
    { key: 'gambling', label: 'Gambling', open: 'gambling', art: ['gambling.webp', 1000, 333], logo: ['gambling-logo.webp', 800, 267], pos: [13.6, 41.2, 73], fit: 'wide', alt: 'Gambling: eine Schatztruhe auf einem Berg aus Gold und Edelsteinen', dot: !!(gambling && gambling.badges.length) },
    { key: 'tcg', label: 'TCG', href: '/tcg/album', art: ['tcg.webp', 1000, 333], logo: ['tcg-logo.webp', 800, 267], pos: [22.2, 52.5, 55], fit: 'wide', alt: 'TCG: drei Eclipse-Booster-Packs', dot: tcgNews },
    { key: 'pve', label: 'PVE', open: pve.length ? 'pve' : null, art: ['pve-ritter.webp', 900, 507], logo: ['pve-logo.webp', 1000, 333], pos: [25.33, 66.96, 50.83], fit: 'cover', alt: 'PVE: ein goldener Ritter zeigt auf dich' },
    { key: 'rangliste', label: 'Rangliste', href: '/rangliste', art: ['rangliste.webp', 800, 600], logo: ['rangliste-logo.webp', 800, 267], pos: [0.67, 54, 98.67], fit: 'fill', alt: 'Rangliste: ein goldener Thron' },
  ];
%>

<div class="hub" data-hub>
  <div class="hub-glow hub-glow-l" aria-hidden="true"></div>
  <div class="hub-glow hub-glow-r" aria-hidden="true"></div>
  <div class="hub-vignette" aria-hidden="true"></div>
  <div class="hub-beam" aria-hidden="true"></div>

  <%# ---------- Kopfzeile: links Kontostand, rechts (von rechts nach links) Konto, Benachrichtigungen, Forum, Admin ---------- %>
  <header class="hub-head">
    <span class="hub-purse-pill">
      <svg class="hub-purse-coin" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#e8bf6a" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="#5a3a22"/><circle cx="12" cy="12" r="5.5"/><path d="M12 9.5v5" stroke-linecap="round"/></svg>
      <span class="hub-purse-text">
        <span class="hub-purse-name">Kontostand</span>
        <strong class="cin" data-live="balance"><%= euro(currentUser.balance) %></strong>
      </span>
    </span>
    <div class="hub-hud">
      <% if (admin) { %>
        <a class="hub-round hub-hit" href="/admin" aria-label="<%= admin.label %><%= admin.badges.length ? ', ' + admin.badges.map((b) => b.aria).join(', ') : '' %>" title="<%= admin.label %>">
          <%- icon('admin', 24, 'currentColor', 1.8) %>
          <% if (admin.badges.length) { %><span class="hub-badges"><%- badgesOf(admin) %></span><% } %>
        </a>
      <% } %>
      <a class="hub-round hub-hit" href="/forum" aria-label="Forum<%= forum && forum.badges.length ? ', ' + forum.badges.map((b) => b.aria).join(', ') : '' %>" title="Forum">
        <%- icon('forum', 24, 'currentColor', 1.8) %>
        <% if (forum && forum.badges.length) { %><span class="hub-badges"><%- badgesOf(forum) %></span><% } %>
      </a>
      <div class="hub-bell"><%- include('partials/bell') %></div>
      <a class="hub-round hub-avatar hub-hit" href="/profil/<%= encodeURIComponent(currentUser.username) %>" aria-label="Mein Konto" title="Mein Konto"><img src="<%= avatarUrl(currentUser) %>?v=<%= assetVersion %>" alt="" width="46" height="46"></a>
    </div>
  </header>

  <%# ---------- Brett (so breit wie der Tresen), das Logo liegt mittig auf der Oberkante ---------- %>
  <div class="hub-scene">
    <section class="hub-board" aria-label="Brett">
      <h1 class="hub-logo-wrap"><img class="hub-logo" src="<%= v(IMG + 'logo.webp') %>" alt="Eclipse TCG" width="900" height="300"></h1>
      <div class="hub-board-in">
        <%# ein durchgehendes Pergament: Vermögen | Dailys | Broker-Kurse %>
        <div class="hub-scroll hub-strip">
          <section class="hub-strip-sec hub-wealth" aria-label="Vermögen"><%- include('partials/hub-wealth', { v: wv }) %></section>
          <section class="hub-strip-sec hub-today" aria-label="Dailys">
            <div class="hub-today-in">
              <div class="hub-note-head">
                <span class="cin hub-kicker">DAILYS</span>
                <span class="cin hub-seal" title="<%= t.done %> von <%= t.total %> erledigt"><%= t.done %>/<%= t.total %></span>
              </div>
              <div class="hub-fit hub-quests"><%- include('partials/hub-quests', { today: t, clock }) %></div>
              <% if (d.dungeonAt) { %>
                <button type="button" class="hub-spot hub-next" data-hub-open="pve">
                  <span class="cin hub-next-label">NÄCHSTER DUNGEON</span>
                  <span class="cin hub-next-time" data-hub-at="<%= d.dungeonAt.toISOString() %>"><%= clock(d.dungeonAt) %></span>
                </button>
              <% } %>
            </div>
          </section>
          <section class="hub-strip-sec hub-kurse" aria-label="Broker-Kurse">
            <div class="hub-note-head">
              <span class="cin hub-kicker">BROKER-KURSE</span>
              <a class="hub-tag hub-kurse-all" href="/broker">Zum Broker</a>
            </div>
            <div class="hub-fit hub-kurse-list">
              <% ticker.forEach((c) => { %>
                <a class="hub-kurs" href="<%= c.href %>">
                  <span class="cin hub-kurs-sym"><%= c.symbol %></span>
                  <span class="hub-kurs-price"><%= c.priceText %></span>
                  <span class="hub-kurs-ch <%= c.cls %>"><%= c.changeText %></span>
                </a>
              <% }) %>
            </div>
          </section>
        </div>

        <%# fünf gleich große Kacheln: Motiv, darüber der Schriftzug, der beim Darüberfahren in seiner Form aufleuchtet %>
        <nav class="hub-tiles" aria-label="Bereiche">
          <% tiles.forEach((k) => {
            const style = '--ar: ' + k.art[1] + ' / ' + k.art[2] + '; --l: ' + k.pos[0] + '%; --t: ' + k.pos[1] + '%; --w: ' + k.pos[2] + '%; --lar: ' + k.logo[1] + ' / ' + k.logo[2] + '; --mask: url(' + v(IMG + k.logo[0]) + ')';
            const tag = k.href ? 'a' : k.open ? 'button' : 'div';
            const attrs = k.href ? ' href="' + k.href + '"' : k.open ? ' type="button" data-hub-open="' + k.open + '"' : ''; %>
            <div class="hub-tile hub-tile-<%= k.key %> is-<%= k.fit %>" style="<%= style %>">
              <<%= tag %> class="hub-tile-hit"<%- attrs %> aria-label="<%= k.label %>"<%- k.dot ? ' aria-describedby="hub-dot-' + k.key + '"' : '' %>>
                <span class="hub-tile-stage">
                  <img class="hub-tile-art" src="<%= v(IMG + k.art[0]) %>" alt="<%= k.alt %>" width="<%= k.art[1] %>" height="<%= k.art[2] %>" loading="eager">
                  <span class="hub-tile-glow" aria-hidden="true"><img src="<%= v(IMG + k.logo[0]) %>" alt="" width="<%= k.logo[1] %>" height="<%= k.logo[2] %>"></span>
                  <span class="hub-tile-logo" aria-hidden="true"><img src="<%= v(IMG + k.logo[0]) %>" alt="" width="<%= k.logo[1] %>" height="<%= k.logo[2] %>"></span>
                </span>
              </<%= tag %>>
              <% if (k.dot) { %><span class="hub-dot" id="hub-dot-<%= k.key %>" role="img" aria-label="Neues: <%= k.label %>"></span><% } %>
              <% if (k.key === 'pve') { %>
                <%# Clan (bisher eSports): rechts oben mit Teambild und Kürzel des eigenen Clans – ohne Clan „Beitreten“ %>
                <% if (d.clan !== undefined) { const cl = d.clan; %>
                  <a class="hub-pve-clan" href="/esports"<%- cl && cl.color ? ' style="--clan: ' + cl.color + '"' : '' %> title="<%= cl ? 'Clan: ' + cl.name : 'Clan' %>" aria-label="<%= cl ? 'Clan ' + cl.name + ', Kürzel ' + cl.ticker : 'Clan' %>">
                    <span class="hub-pve-clan-logo"><% if (cl && cl.avatar) { %><img src="<%= cl.avatar %>?v=<%= assetVersion %>" alt="" width="40" height="40"><% } else { %><%- icon('clan', 18, '#e8bf6a', 1.8) %><% } %></span>
                    <span class="cin hub-pve-clan-tag"><%= cl ? cl.ticker : 'Clan' %></span>
                  </a>
                <% } %>
                <% if (d.dungeonAt) { %>
                  <button type="button" class="hub-spot hub-pve-timer" data-hub-open="pve">
                    <span class="hub-pve-timer-label">DUNGEON</span>
                    <span class="cin" data-hub-at="<%= d.dungeonAt.toISOString() %>"><%= clock(d.dungeonAt) %></span>
                  </button>
                <% } %>
              <% } %>
            </div>
          <% }) %>
        </nav>
      </div>
    </section>
  </div>

  <%# ---------- Tresen, darauf die Pflicht-Links (statt der Fußzeile) ---------- %>
  <section class="hub-tresen" aria-label="Tresen">
    <div class="hub-tresen-top"></div>
    <div class="hub-tresen-front">
      <nav class="hub-legal" aria-label="Rechtliches">
        <a href="/regeln">Regeln</a><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><a href="/patchnotes">Patchnotes<% if (patchNew) { %> <span class="nav-badge" aria-label="<%= patchNew %> neue Patchnotes"><%= patchNew > 99 ? '99+' : patchNew %></span><% } %></a>
      </nav>
    </div>
  </section>

  <%# ---------- Fenster: Desktop als Pergament über der Taverne, mobil als Sheet von unten ---------- %>
  <%# PVE: Fenster wie Gambling – Termine, darunter je Bereich eine Schaltfläche mit dem Stand von heute %>
  <% if (pve.length) { %>
    <dialog class="hub-dlg hub-dlg-area" id="hub-pve" aria-labelledby="hub-pve-title">
      <div class="hub-dlg-head">
        <span class="hub-dlg-ico"><%- icon('dungeon', 30, '#e8bf6a', 1.6) %></span>
        <div class="hub-dlg-titles">
          <span class="hub-dlg-sub">ABENTEUER</span>
          <h2 class="cin" id="hub-pve-title">PVE</h2>
        </div>
        <button type="button" class="hub-round hub-hit" data-hub-close aria-label="Schließen"><%- closeIcon %></button>
      </div>
      <div class="hub-dlg-body">
        <% pve.filter((p) => p.at).forEach((p) => { %>
          <div class="hub-extra"><span class="hub-extra-label"><%= p.key === 'dungeon' ? 'NÄCHSTER DUNGEON' : p.label.toUpperCase() + ' FERTIG IN' %></span><span class="cin hub-extra-value" data-hub-at="<%= new Date(p.at).toISOString() %>" data-hub-days><%= clock(p.at) %></span></div>
        <% }) %>
        <div class="hub-links">
          <% pve.forEach((p) => { %>
            <a class="hub-link" href="<%= p.href %>">
              <span class="hub-slot-ico"><%- icon(p.key, 22, '#e8bf6a') %></span>
              <span class="hub-link-text"><span class="cin"><%= p.label %></span><% if (p.text) { %><span class="hub-link-sub"><%= p.text %></span><% } %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </dialog>
  <% } %>

  <dialog class="hub-dlg hub-dlg-area" id="hub-gambling" aria-labelledby="hub-gambling-title">
    <div class="hub-dlg-head">
      <span class="hub-dlg-ico"><%- icon('gambling', 30, '#e8bf6a', 1.6) %></span>
      <div class="hub-dlg-titles">
        <span class="hub-dlg-sub">GLÜCKSSPIEL</span>
        <h2 class="cin" id="hub-gambling-title">Gambling</h2>
      </div>
      <button type="button" class="hub-round hub-hit" data-hub-close aria-label="Schließen"><%- closeIcon %></button>
    </div>
    <div class="hub-dlg-body">
      <% [lotto ? { label: 'TAGES-LOTTERIE', at: lotto.at } : null, cd.woche ? { label: 'WOCHEN-LOTTERIE', at: cd.woche.at } : null, cd.monat ? { label: 'MONATS-LOTTERIE', at: cd.monat.at } : null].filter(Boolean).forEach((x) => { %>
        <div class="hub-extra"><span class="hub-extra-label"><%= x.label %></span><span class="cin hub-extra-value" data-hub-at="<%= x.at.toISOString() %>" data-hub-days><%= clock(x.at) %></span></div>
      <% }) %>
      <div class="hub-links">
        <% gamblingItems.forEach((it) => { %>
          <a class="hub-link" href="<%= it.href %>"><span class="hub-slot-ico"><%- icon(gIcon[it.href], 22, '#e8bf6a') %></span><span class="cin"><%= it.label %></span><%- badgesOf(it) %></a>
        <% }) %>
      </div>
    </div>
  </dialog>
</div>

<script src="/js/hub.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot', { hub: true }) %>
