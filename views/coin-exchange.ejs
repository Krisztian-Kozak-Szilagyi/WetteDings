<%- include('partials/head') %>
<%
  const up = snap.change24h >= 0;
  const pl = value - holding.costCents;
  const eventLabels = { anstieg: 'Kurssprung', einbruch: 'Kurseinbruch', pump: 'Pump', crash: 'Crash' };
%>

<div class="coin-head">
  <div class="coin-id">
    <%- include('partials/coin-sam') %>
    <div>
      <h1><%= snap.name %> <span class="muted coin-symbol"><%= snap.symbol %></span></h1>
      <span class="live"><span class="live-dot"></span> Live · Kurs alle <%= snap.tickMs / 1000 %> Sekunden</span>
    </div>
  </div>
  <div class="coin-price-box">
    <div class="coin-price" data-live-price><%= coinPrice(snap.price) %></div>
    <div class="coin-change <%= up ? 'pos' : 'neg' %>" data-live-change><%= signedPercent(snap.change24h) %> <span class="muted">24 h</span></div>
  </div>
</div>

<div class="coin-layout">
  <section class="coin-main">
    <div class="card chart-card">
      <div class="range-tabs" role="tablist" aria-label="Zeitraum">
        <% [['1h', '1 Std.'], ['24h', '24 Std.'], ['7d', '7 Tage'], ['30d', '30 Tage'], ['all', 'Alles']].forEach(([key, label]) => { %>
          <button type="button" class="chip <%= key === '24h' ? 'active' : '' %>" data-range="<%= key %>" role="tab" aria-selected="<%= key === '24h' %>"><%= label %></button>
        <% }) %>
        <span class="chart-range-change muted small" data-range-change></span>
      </div>
      <div class="chart" id="coin-chart" data-range="24h">
        <svg class="chart-svg" aria-label="Kursverlauf" role="img"></svg>
        <div class="chart-tip" hidden></div>
        <p class="chart-loading muted small">Kursverlauf wird geladen …</p>
      </div>
    </div>

    <div class="stats stats-4 coin-stats">
      <div class="stat card"><span class="stat-label">24 h Hoch</span><span class="stat-value stat-value-sm" data-live-high><%= coinPrice(snap.high24h) %></span></div>
      <div class="stat card"><span class="stat-label">24 h Tief</span><span class="stat-value stat-value-sm" data-live-low><%= coinPrice(snap.low24h) %></span></div>
      <div class="stat card"><span class="stat-label">Allzeithoch</span><span class="stat-value stat-value-sm" data-live-ath><%= coinPrice(snap.ath) %></span></div>
      <div class="stat card"><span class="stat-label">Dein Bestand</span><span class="stat-value stat-value-sm"><%= coinAmount(holding.units) %></span></div>
    </div>

    <div class="card">
      <h2>Marktereignisse</h2>
      <% if (!events.length) { %>
        <p class="muted">Bisher keine großen Kursbewegungen.</p>
      <% } else { %>
        <ul class="event-list">
          <% events.forEach((e) => { %>
            <li class="event event-<%= e.type %>">
              <span class="event-type"><%= eventLabels[e.type] || e.type %></span>
              <span class="<%= e.change >= 0 ? 'pos' : 'neg' %>"><%= signedPercent(e.change) %></span>
              <span class="muted small">auf <%= coinPrice(e.price) %> · <%= relTime(e.at) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h2>Deine letzten Trades</h2>
      <% if (!trades.length) { %>
        <p class="muted">Du hast noch nicht gehandelt.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Zeit</th><th>Art</th><th class="num">Menge</th><th class="num">Kurs</th><th class="num">Betrag</th></tr></thead>
            <tbody>
              <% trades.forEach((t) => { %>
                <tr>
                  <td class="nowrap"><%= date(t.createdAt) %></td>
                  <td><span class="pill <%= t.side === 'kauf' ? 'c-ja' : 'c-nein' %>"><%= t.side === 'kauf' ? 'Kauf' : 'Verkauf' %></span></td>
                  <td class="num"><%= coinAmount(t.units) %></td>
                  <td class="num"><%= coinPrice(t.price) %></td>
                  <td class="num"><%= euro(t.cents) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>

  <aside class="coin-side">
    <div class="card card-accent">
      <h2>Dein Depot</h2>
      <p class="big"><%= coinAmount(holding.units) %></p>
      <dl class="depot">
        <div><dt>Aktueller Wert</dt><dd data-live-value><%= euro(value) %></dd></div>
        <div><dt>Einstand</dt><dd><%= euro(holding.costCents) %><% if (avgPrice) { %> <span class="muted small">(Ø <%= coinPrice(avgPrice) %>)</span><% } %></dd></div>
        <div><dt>Gewinn / Verlust</dt><dd class="<%= pl > 0 ? 'pos' : pl < 0 ? 'neg' : '' %>" data-live-pl><%= holding.units ? (pl > 0 ? '+' : '') + euro(pl) : '–' %></dd></div>
        <div><dt>Verfügbares Guthaben</dt><dd><%= euro(currentUser.balance) %></dd></div>
      </dl>
    </div>

    <div class="card trade-card"
         data-price="<%= snap.price %>" data-units="<%= holding.units %>" data-cost="<%= holding.costCents %>" data-balance="<%= currentUser.balance %>">
      <div class="trade-tabs" role="tablist">
        <button type="button" class="trade-tab active" data-trade-tab="kaufen" role="tab" aria-selected="true">Kaufen</button>
        <button type="button" class="trade-tab" data-trade-tab="verkaufen" role="tab" aria-selected="false">Verkaufen</button>
      </div>

      <form method="post" action="/coin-exchange/kaufen" class="trade-form" data-trade-form="kaufen" data-confirm-trade="kaufen">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field">
          <span>Betrag in €</span>
          <input type="number" name="amount" inputmode="decimal" min="<%= minBuy / 100 %>" max="<%= currentUser.balance / 100 %>" step="0.01" required data-min-buy data-min-trade="<%= minTrade %>" data-min-share="<%= minBuyShare %>">
        </label>
        <div class="quick-amounts">
          <button type="button" class="chip" data-set-amount="10">10 €</button>
          <button type="button" class="chip" data-set-amount="50">50 €</button>
          <button type="button" class="chip" data-set-amount="100">100 €</button>
          <button type="button" class="chip" data-set-amount="<%= currentUser.balance / 100 %>">Alles</button>
        </div>
        <p class="muted small">Mindestens 10 % des aktuellen Kurses: <strong data-min-buy-text><%= euro(minBuy) %></strong></p>
        <p class="estimate" data-trade-preview></p>
        <button class="btn btn-ja btn-block" type="submit" <%= currentUser.balance < minBuy ? 'disabled' : '' %>>Samantha Coin kaufen</button>
      </form>

      <form method="post" action="/coin-exchange/verkaufen" class="trade-form" data-trade-form="verkaufen" data-confirm-trade="verkaufen" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="all" value="0">
        <label class="field">
          <span>Betrag in €</span>
          <input type="number" name="amount" inputmode="decimal" min="<%= minTrade / 100 %>" step="0.01">
        </label>
        <div class="quick-amounts">
          <button type="button" class="chip" data-sell-fraction="0.25">25 %</button>
          <button type="button" class="chip" data-sell-fraction="0.5">50 %</button>
          <button type="button" class="chip" data-sell-fraction="1">Alles</button>
        </div>
        <p class="estimate" data-trade-preview></p>
        <button class="btn btn-nein btn-block" type="submit" <%= holding.units <= 0 ? 'disabled' : '' %>>Samantha Coin verkaufen</button>
      </form>
      <p class="muted small">Ausgeführt wird zum Kurs im Moment des Absendens – er kann sich bis dahin noch bewegen.</p>
    </div>
  </aside>
</div>

<script src="/js/coin.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
