<%- include('partials/head') %>
<% const link = (p) => '/forum/t/' + thread._id + '?seite=' + p; %>

<div class="forum-page forum-thread">
<nav class="forum-crumbs" aria-label="Pfad">
  <a href="/forum">Forum</a><span>›</span>
  <% if (parent) { %><a href="/forum/k/<%= parent._id %>"><%= parent.title %></a><span>›</span><% } %>
  <% if (cat) { %><a href="/forum/k/<%= cat._id %>"><%= cat.title %></a><% } %>
</nav>

<div class="forum-head forum-thread-head">
  <div class="forum-head-text">
    <h1><%= thread.title %></h1>
    <div class="forum-thread-meta">
      <% if (thread.pinned) { %><span class="forum-pin"><%- include('partials/forum-icon', { name: 'pin', size: 13 }) %>Angepinnt</span><% } %>
      <% if (thread.locked) { %><span><%- include('partials/forum-icon', { name: 'lock', size: 12 }) %>Geschlossen</span><% } %>
      <span>von <%- userLink(thread.authorName) %> · <%= date(thread.createdAt) %> · <%= thread.replyCount %> <%= thread.replyCount === 1 ? 'Antwort' : 'Antworten' %></span>
    </div>
  </div>
  <form method="post" action="/forum/t/<%= thread._id %>/upvote">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="forum-upvote <%= upvoted ? 'is-on' : '' %>" type="submit" aria-pressed="<%= upvoted %>"><%- include('partials/forum-icon', { name: 'up' }) %>Upvote · <%= thread.upvotes.length %></button>
  </form>
</div>

<% if (currentUser.canModerate) { %>
  <div class="forum-modbar">
    <span class="forum-modbar-label">Moderation</span>
    <form method="post" action="/forum/t/<%= thread._id %>/moderation">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost btn-sm" type="submit" name="action" value="<%= thread.pinned ? 'loesen' : 'anpinnen' %>"><%= thread.pinned ? 'Nicht mehr anpinnen' : 'Anpinnen' %></button>
      <button class="btn btn-ghost btn-sm" type="submit" name="action" value="<%= thread.locked ? 'oeffnen' : 'schliessen' %>"><%= thread.locked ? 'Wieder öffnen' : 'Schließen' %></button>
    </form>
    <form method="post" action="/forum/t/<%= thread._id %>/moderation" data-confirm="Dieses Thema samt allen Beiträgen entfernen?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="entfernen">
      <button class="btn btn-ghost btn-sm forum-danger" type="submit">Thema entfernen</button>
    </form>
    <% if (moveTargets.length) { %>
      <form method="post" action="/forum/t/<%= thread._id %>/verschieben" class="forum-move">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="sr-only" for="verschieben-ziel">Verschieben nach</label>
        <select id="verschieben-ziel" name="category" required>
          <option value="">Verschieben nach …</option>
          <% moveTargets.forEach((c) => { %><option value="<%= c._id %>"><%= c.label %></option><% }) %>
        </select>
        <button class="btn btn-ghost btn-sm" type="submit">Verschieben</button>
      </form>
    <% } %>
  </div>
<% } %>

<% if (poll) { %>
  <%# Umfrage: Ergebnis erst nach der eigenen Stimme oder wenn sie vorbei ist %>
  <section class="forum-poll" id="umfrage" aria-labelledby="umfrage-frage">
    <div class="forum-poll-head">
      <span class="forum-label">Umfrage<%= poll.closed ? ' · beendet' : poll.endsAt ? ' · bis ' + date(poll.endsAt) : '' %></span>
      <% if (poll.canRemove) { %>
        <form method="post" action="/forum/t/<%= thread._id %>/umfrage/entfernen" data-confirm="Diese Umfrage samt allen Stimmen entfernen?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-btn forum-del" type="submit">Umfrage entfernen</button>
        </form>
      <% } %>
    </div>
    <h2 id="umfrage-frage"><%= poll.question %></h2>
    <% if (poll.canVote) { %>
      <form method="post" action="/forum/t/<%= thread._id %>/umfrage" class="forum-poll-vote">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% poll.options.forEach((o) => { %>
          <label class="check"><input type="radio" name="option" value="<%= o.key %>" required><span><%= o.label %></span></label>
        <% }) %>
        <div class="forum-poll-foot">
          <button class="btn btn-primary btn-sm" type="submit">Abstimmen</button>
          <span class="muted small"><%= poll.total %> <%= poll.total === 1 ? 'Stimme' : 'Stimmen' %> bisher – das Ergebnis siehst du nach deiner Stimme.</span>
        </div>
      </form>
    <% } else if (poll.rows) { %>
      <ol class="forum-poll-results">
        <% poll.rows.forEach((r) => { %>
          <li class="<%= r.key === poll.myVote ? 'is-mine' : '' %> <%= r.leading ? 'is-leading' : '' %>">
            <span class="forum-poll-label"><%= r.label %><% if (r.key === poll.myVote) { %> <span class="muted small">(deine Stimme)</span><% } %></span>
            <span class="forum-poll-num"><%= r.percent %> % · <%= r.count %></span>
            <span class="forum-poll-bar" aria-hidden="true"><span style="width: <%= r.percent %>%"></span></span>
          </li>
        <% }) %>
      </ol>
      <p class="muted small"><%= poll.total %> <%= poll.total === 1 ? 'Stimme' : 'Stimmen' %></p>
    <% } %>
  </section>
<% } %>

<ol class="forum-posts">
  <% posts.forEach((p) => { %>
    <li class="forum-post <%= p.isNew ? 'is-new' : '' %> <%= p.mine ? 'is-mine' : '' %> <%= p.deleted ? 'is-deleted' : '' %>" id="b-<%= p._id %>">
      <img class="forum-avatar" src="/img/avatar-placeholder.svg?v=<%= assetVersion %>" alt="" width="40" height="40">
      <div class="forum-post-body">
        <div class="forum-post-head">
          <span class="forum-post-name"><%- userLink(p.authorName) %></span>
          <% if (p.authorName === thread.authorName) { %><span class="forum-op">Ersteller</span><% } %>
          <% if (p.isNew) { %><span class="forum-new">Neu</span><% } %>
          <time datetime="<%= new Date(p.createdAt).toISOString() %>" title="<%= date(p.createdAt) %>"><%= relTime(p.createdAt) %></time>
        </div>
        <% if (p.deleted) { %>
          <p class="forum-post-gone"><em>Nachricht gelöscht<%= p.deletedByRole && p.deletedByRole !== 'autor' ? ' (von der Moderation)' : '' %>.</em></p>
          <% if (p.originalHtml) { %>
            <details class="forum-original">
              <summary>Original ansehen (nur Admin/Dev)</summary>
              <div class="pn-body prose"><%- p.originalHtml %></div>
            </details>
          <% } %>
        <% } else { %>
          <div class="pn-body prose"><%- p.html %></div>
          <% const shown = p.canReact ? p.reactions : p.reactions.filter((r) => r.count); %>
          <% if (shown.length) { %>
            <%# Reaktionen: ein Klick setzt, der zweite nimmt zurück; im Tooltip steht, wer reagiert hat %>
            <form method="post" action="/forum/b/<%= p._id %>/reaktion" class="forum-reactions">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="seite" value="<%= page %>">
              <% shown.forEach((r) => { const tip = r.label + (r.who ? ': ' + r.who : ''); %>
                <% if (p.canReact) { %>
                  <button class="forum-react <%= r.mine ? 'is-on' : '' %> <%= r.count ? '' : 'is-zero' %>" type="submit" name="reaction" value="<%= r.key %>" title="<%= tip %>" aria-pressed="<%= r.mine %>" aria-label="<%= r.label %>: <%= r.count %><%= r.mine ? ' (deine Reaktion)' : '' %>"><span aria-hidden="true"><%= r.emoji %></span><% if (r.count) { %><span class="forum-react-n"><%= r.count %></span><% } %></button>
                <% } else { %>
                  <span class="forum-react <%= r.mine ? 'is-on' : '' %>" title="<%= tip %>" aria-label="<%= r.label %>: <%= r.count %>"><span aria-hidden="true"><%= r.emoji %></span><span class="forum-react-n"><%= r.count %></span></span>
                <% } %>
              <% }) %>
            </form>
          <% } %>
          <div class="forum-post-foot">
            <span class="forum-post-actions">
              <% if (canReply) { %><a href="#antwort">Antworten</a><% } %>
              <% if (p.canEdit) { %><a href="/forum/b/<%= p._id %>/bearbeiten">Bearbeiten</a><% } %>
              <% if (p.canDelete) { %>
                <form method="post" action="/forum/b/<%= p._id %>/loeschen" data-confirm="Diesen Beitrag löschen? Er wird durch „Nachricht gelöscht“ ersetzt.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="link-btn forum-del" type="submit">Löschen</button>
                </form>
              <% } %>
              <% if (!p.mine) { %>
                <details class="forum-report-fold">
                  <summary class="link-btn link-btn-muted">Melden</summary>
                  <form method="post" action="/forum/b/<%= p._id %>/melden" class="forum-report-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="sr-only" for="grund-<%= p._id %>">Grund der Meldung</label>
                    <input class="input" type="text" id="grund-<%= p._id %>" name="reason" maxlength="<%= reasonMax %>" required placeholder="Grund (Pflicht), z. B. Beleidigung, Spam …">
                    <button class="btn btn-ghost btn-sm" type="submit">An die Moderation melden</button>
                  </form>
                </details>
              <% } %>
            </span>
            <% if (p.modEdited) { %><span class="forum-edited role-mod-text">von einem Mod bearbeitet</span><% } else if (p.editedAt) { %><span class="forum-edited">bearbeitet <%= relTime(p.editedAt) %></span><% } %>
          </div>
        <% } %>
      </div>
    </li>
  <% }) %>
</ol>

<% if (pages > 1) { %>
  <div class="log-pager">
    <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= link(page - 1) %>">← Zurück</a><% } %>
    <span class="muted small">Seite <%= page %> / <%= pages %></span>
    <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="<%= link(page + 1) %>">Weiter →</a><% } %>
  </div>
<% } %>

<section class="forum-reply" id="antwort">
  <% if (canReply) { %>
    <h2>Antworten</h2>
    <form method="post" action="/forum/t/<%= thread._id %>/antwort" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="sr-only" for="antwort-text">Deine Antwort</label>
        <%- include('partials/forum-editor', { id: 'antwort-text', rows: 5, max: bodyMax, myTags, placeholder: 'Schreib etwas dazu …' }) %>
      </div>
      <button class="btn btn-primary" type="submit">Antwort senden</button>
    </form>
  <% } else { %>
    <p class="forum-empty">Dieses Thema ist geschlossen – es kann nicht mehr geantwortet werden.</p>
  <% } %>
</section>

</div>

<%- include('partials/foot') %>
