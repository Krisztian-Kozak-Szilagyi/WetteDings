<%#
  Suchen und Filtern in einem Knopf (Handel, Album, Sammlungen, Tausch, Dungeon, IHK, Broker). Eine Hälfte überfahren
  oder antippen → sie klappt auf. Anzeige „Filtern nach“ und Markierung: public/js/app.js (letzter IIFE);
  gefiltert wird im Skript der Seite über die Daten-Attribute.
  name = Präfix für die Feld-ID, placeholder = Beschreibung fürs Suchfeld (Screenreader; sichtbar steht nur „Suchen“),
  searchAttr = Daten-Attribut des Suchfelds (Standard: "<name>-search"), label = Beschriftung des Filterknopfs.
  groups = [{ attr, all = 'all', allLabel = 'Alle', allCount?, missing?, title?, dots = true, opts: [{ key, label, count? }] }]
  Ohne groups (Handel): eine Gruppe aus opts / missing / allCount mit attr "<name>-rarity".
  missing = Anzahl für „Fehlt mir noch“ (ganz oben).
%>
<%
  const barGroups = locals.groups || [{ attr: name + '-rarity', opts, missing: locals.missing, allCount: locals.allCount }];
  const searchAttr = locals.searchAttr || name + '-search';
  const barLabel = locals.label || 'Nach Seltenheit filtern';
%>
<div class="mkt-bar" data-mkt-bar>
  <div class="mkt-bar-search">
    <label class="mkt-bar-label" for="<%= name %>-search">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm4.8 11.3L20 20"/></svg>
      Suchen
    </label>
    <input id="<%= name %>-search" type="search" class="mkt-bar-input" data-<%= searchAttr %> maxlength="40" placeholder="Suchen" aria-label="<%= placeholder %>" autocomplete="off">
    <span class="mkt-bar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm4.8 11.3L20 20"/></svg></span>
  </div>
  <div class="mkt-bar-filter">
    <button type="button" class="mkt-bar-toggle" aria-haspopup="listbox" aria-label="<%= barLabel %>">
      <span class="mkt-bar-word">Filter</span>
      <span class="mkt-bar-current"><span class="muted">Filtern nach:</span> <strong data-mkt-current>Alle</strong></span>
      <svg class="mkt-bar-arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M4 8h16l-8 9Z"/></svg>
    </button>
    <%# .mkt-bar-drop: unsichtbare Brücke zwischen Knopf und Liste, damit die Maus auf dem Weg nach unten nicht "rausfällt" %>
    <div class="mkt-bar-drop">
    <div class="mkt-bar-menu">
      <% barGroups.forEach((g) => { const all = g.all !== undefined ? g.all : 'all'; const dot = g.dots !== false; %>
        <div class="mkt-group" role="listbox" aria-label="<%= g.title || barLabel %>">
          <% if (g.title && barGroups.length > 1) { %><span class="mkt-group-title" aria-hidden="true"><%= g.title %></span><% } %>
          <% if (g.missing !== undefined) { %>
            <button type="button" class="mkt-opt" data-<%= g.attr %>="missing" data-label="Fehlt mir noch" role="option" aria-selected="false"><span class="tcg-dot tcg-dot-missing"></span>Fehlt mir noch<span class="mkt-opt-count"><%= g.missing %></span></button>
          <% } %>
          <button type="button" class="mkt-opt active" data-<%= g.attr %>="<%= all %>" data-mkt-all data-label="<%= g.allLabel || 'Alle' %>" role="option" aria-selected="true"><% if (dot) { %><span class="tcg-dot tcg-dot-all"></span><% } %><%= g.allLabel || 'Alle' %><% if (g.allCount) { %><span class="mkt-opt-count"><%= g.allCount %></span><% } %></button>
          <% g.opts.forEach((o) => { %>
            <button type="button" class="mkt-opt<%= dot ? ' r-' + o.key : '' %>" data-<%= g.attr %>="<%= o.key %>" data-label="<%= o.label %>" role="option" aria-selected="false"><% if (dot) { %><span class="tcg-dot"></span><% } %><%= o.label %><% if (o.count) { %><span class="mkt-opt-count"><%= o.count %></span><% } %></button>
          <% }) %>
        </div>
      <% }) %>
    </div>
    </div>
  </div>
</div>
