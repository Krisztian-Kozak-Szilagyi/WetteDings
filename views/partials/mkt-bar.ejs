<%#
  Suchen und Filtern in einem Knopf (Handel: Markt und Sammlung). Eine Hälfte überfahren oder antippen → sie klappt
  auf; gefiltert wird in public/js/handel.js. name = Präfix der Daten-Attribute ("market" | "coll"),
  opts = [{ key, label, count? }] (ohne "Alle"), placeholder = Beschreibung fürs Suchfeld (Screenreader; sichtbar steht nur „Suchen“), allCount = Zahl bei "Alle".
%>
<div class="mkt-bar" data-mkt-bar>
  <div class="mkt-bar-search">
    <label class="mkt-bar-label" for="<%= name %>-search">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm4.8 11.3L20 20"/></svg>
      Suchen
    </label>
    <input id="<%= name %>-search" type="search" class="mkt-bar-input" data-<%= name %>-search maxlength="40" placeholder="Suchen" aria-label="<%= placeholder %>">
    <span class="mkt-bar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm4.8 11.3L20 20"/></svg></span>
  </div>
  <div class="mkt-bar-filter">
    <button type="button" class="mkt-bar-toggle" aria-haspopup="listbox" aria-label="Nach Seltenheit filtern">
      <span class="mkt-bar-word">Filter</span>
      <span class="mkt-bar-current"><span class="muted">Filtern nach:</span> <strong data-mkt-current>Alle</strong></span>
      <svg class="mkt-bar-arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M4 8h16l-8 9Z"/></svg>
    </button>
    <%# .mkt-bar-drop: unsichtbare Brücke zwischen Knopf und Liste, damit die Maus auf dem Weg nach unten nicht "rausfällt" %>
    <div class="mkt-bar-drop">
    <div class="mkt-bar-menu" role="listbox" aria-label="Seltenheit">
      <button type="button" class="mkt-opt active" data-<%= name %>-rarity="all" data-label="Alle" role="option" aria-selected="true"><span class="tcg-dot tcg-dot-all"></span>Alle<% if (locals.allCount) { %><span class="mkt-opt-count"><%= allCount %></span><% } %></button>
      <% opts.forEach((o) => { %>
        <button type="button" class="mkt-opt r-<%= o.key %>" data-<%= name %>-rarity="<%= o.key %>" data-label="<%= o.label %>" role="option" aria-selected="false"><span class="tcg-dot"></span><%= o.label %><% if (o.count) { %><span class="mkt-opt-count"><%= o.count %></span><% } %></button>
      <% }) %>
    </div>
    </div>
  </div>
</div>
