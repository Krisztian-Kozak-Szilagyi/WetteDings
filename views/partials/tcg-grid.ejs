<%
  // Kartenraster für Album, Handel, Tausch und fremde Sammlungen.
  // mode: 'album' – Zoom-Dialog mit Verkaufen/Schützen/Favorit (public/js/tcg.js)
  //       'view'  – nur ansehen; mit linkFor(cardId) öffnet ein Klick die Großansicht mit "Angebot machen"
  // showMissing: fehlende Karten als "?" zeigen (Standard: ja)
  // lockedByCard: gesperrte Exemplare; ganz gesperrte Karten tragen ein Schild (z. B. „Auf Quest“). Im Album lassen sie sich
  //   trotzdem öffnen (ansehen, schützen, Favorit) – nur Verkaufen fehlt, weil kein freies Exemplar da ist.
  // c.unreleased: noch nicht erhältliche Karte – immer "?", Seltenheit verdeckt
  // seenIds: schon einmal besessene Karten – fehlen sie, werden sie grau statt als "?" gezeigt
  // data-album-card: eigene Karten (auch gesperrte) – Sprungziel für /tcg/album#karte-<id> (public/js/tcg.js)
  const seenIds = locals.seenIds || new Set();
  const showMissing = locals.showMissing !== false;
  const locks = locals.lockedByCard || {};
  const foiledBy = locals.foiledByCard || {};
  const foiledCopies = locals.foiledCopies || {};
  const favoriteIds = locals.favoriteIds || new Set();
  const isAlbum = mode === 'album';
  // Effekte je Seltenheit: Glanzstreifen, Regenbogen, Glitch
  const fxFor = (rarity) => ({ bfwler: 'shine', gold: 'shine', icon: 'shine', sith: 'shine', holo: 'holo', bockhaber: 'bock', glitch: 'glitch' })[rarity] || '';
  const art = (c, extra) => {
    const fx = fxFor(c.rarity);
    let h = '<img src="' + c.image + '" alt="' + (extra && extra.alt ? extra.alt : '') + '" loading="lazy" width="720" height="1008">';
    if (fx === 'glitch') h += '<img class="tcg-glitch-a" src="' + c.image + '" alt="" loading="lazy" width="720" height="1008"><img class="tcg-glitch-b" src="' + c.image + '" alt="" loading="lazy" width="720" height="1008">';
    if (fx) h += '<span class="tcg-fx tcg-fx-' + fx + '"></span>';
    return h;
  };
%>
<div class="tcg-grid<%= isAlbum ? ' tcg-album' : '' %>">
  <% cards.forEach((c, idx) => { const r = rarityByKey[c.rarity]; %>
    <% const foiledN = foiledBy[c.id] || (foiledCopies[c.id] || []).length; const n = Math.max(0, (counts[c.id] || 0) - foiledN); %>
    <% if (!n && !showMissing && !(foiledCopies[c.id] || []).length) return; %>
    <% const lk = locks[c.id]; const lockedPlain = lk ? Math.max(0, lk.n - foiledN) : 0; const lockLabel = lk && lk.reason === 'handel' ? 'Im Handel' : lk && lk.reason === 'duell' ? 'Im Duell' : lk && lk.reason === 'dungeon' ? 'Im Dungeon' : 'Auf Quest'; %>
    <% const freeN = n - lockedPlain; const allLocked = n > 0 && freeN <= 0; %>
    <% const prot = isAlbum && protectedIds.has(c.id); const fav = isAlbum && favoriteIds.has(c.id); %>
    <% if (allLocked && !isAlbum) { %>
      <div class="tcg-slot tcg-in-exam r-<%= c.rarity %>" data-album-card="<%= c.id %>" data-rarity="<%= c.rarity %>" data-name="<%= c.name %>" title="Diese Karte ist gerade gesperrt (<%= lockLabel %>)">
        <span class="tcg-art">
          <img src="<%= c.image %>" alt="<%= c.name %>, <%= r.label %> – <%= lockLabel %>" loading="lazy" width="720" height="1008">
          <span class="tcg-exam-badge"><%= lockLabel %></span>
          <% if (n > 1) { %><span class="tcg-count">×<%= n %></span><% } %>
        </span>
        <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
      </div>
    <% } else if (n) { %>
      <% const inner = () => { %>
        <span class="tcg-art">
          <%- art(c) %>
          <% if (prot || fav) { %>
            <span class="tcg-marks">
              <% if (prot) { %><span class="tcg-mark tcg-mark-lock" title="Geschützt"><svg viewBox="0 0 256 256" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96Z"/></svg></span><% } %>
              <% if (fav) { %><span class="tcg-mark tcg-mark-fav" title="Favorit"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21.2l1.4-7L2 9.4l7-.8L12 2Z"/></svg></span><% } %>
            </span>
          <% } %>
          <% if (allLocked) { %><span class="tcg-exam-badge"><%= lockLabel %></span><% } %>
          <% if (n > 1) { %><span class="tcg-count">×<%= n %></span><% } %>
        </span>
        <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
      <% } %>
      <% if (isAlbum) { %>
        <%# data-count = freie Exemplare (Verkaufen), data-locked = gesperrte (Anzeige im Fenster, z. B. „1× Auf Quest“) %>
        <button type="button" class="tcg-slot<%= allLocked ? ' tcg-in-exam' : '' %> r-<%= c.rarity %>" data-album-card="<%= c.id %>" data-rarity="<%= c.rarity %>"
          data-tcg-card="<%= c.id %>" data-name="<%= c.name %>" data-rarity-label="<%= r.label %>" data-rank="<%= r.rank %>" data-no="<%= String(idx + 1).padStart(2, '0') %>"
          data-image="<%= c.image %>" data-count="<%= Math.max(0, freeN) %>" data-sell="<%= r.sell %>" data-sell-text="<%= euro(r.sell) %>"<%- r.noBank ? ' data-no-bank="1"' : '' %>
          data-protected="<%= prot ? 1 : 0 %>" data-favorite="<%= fav ? 1 : 0 %>" data-foiled="<%= foiledBy[c.id] || 0 %>"
          <% if (lockedPlain) { %>data-locked="<%= lockedPlain %>" data-lock-label="<%= lockLabel %>"<% } %>
          <% if (allLocked) { %>title="Diese Karte ist gerade gesperrt (<%= lockLabel %>)"<% } %>
          aria-label="<%= c.name %>, <%= r.label %>, <%= n %> Stück<%= lockedPlain ? ', ' + lockedPlain + ' davon ' + lockLabel : '' %><%= prot ? ', geschützt' : '' %><%= fav ? ', Favorit' : '' %> – vergrößern">
          <% inner() %>
        </button>
      <% } else if (locals.linkFor) { %>
        <%# Fremde Sammlung: erst groß ansehen (public/js/handel.js), dort führt "Angebot machen" zu linkFor %>
        <button type="button" class="tcg-slot r-<%= c.rarity %>" data-zoom-card
          data-image="<%= c.image %>" data-name="<%= c.name %>" data-rarity="<%= c.rarity %>" data-rarity-label="<%= r.label %>"
          data-sell-text="<%= euro(r.sell || 0) %>" data-owned="<%= (locals.ownedCounts || {})[c.id] || 0 %>" data-trade-href="<%= linkFor(c.id) %>"
          aria-label="<%= c.name %>, <%= r.label %> – vergrößern">
          <% inner() %>
        </button>
      <% } else { %>
        <div class="tcg-slot r-<%= c.rarity %>" data-rarity="<%= c.rarity %>" data-name="<%= c.name %>" title="<%= c.name %>">
          <% inner() %>
        </div>
      <% } %>
    <% } else if (!showMissing) { %>
    <% } else if (seenIds.has(c.id)) { %>
      <% if (isAlbum) { %>
        <button type="button" class="tcg-slot tcg-seen r-<%= c.rarity %>" data-rarity="<%= c.rarity %>" title="<%= c.name %> – früher besessen"
          data-tcg-card="<%= c.id %>" data-name="<%= c.name %>" data-rarity-label="<%= r.label %>" data-rank="<%= r.rank %>" data-no="<%= String(idx + 1).padStart(2, '0') %>"
          data-image="<%= c.image %>" data-count="0" data-former="1" aria-label="<%= c.name %>, <%= r.label %> – früher besessen, vergrößern">
          <span class="tcg-art"><img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008"></span>
          <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
        </button>
      <% } else { %>
        <div class="tcg-slot tcg-locked tcg-seen r-<%= c.rarity %>" data-rarity="<%= c.rarity %>" data-name="<%= c.name %>" title="<%= c.name %> – früher besessen">
          <span class="tcg-art"><img src="<%= c.image %>" alt="<%= c.name %>, <%= r.label %> – früher besessen" loading="lazy" width="720" height="1008"></span>
          <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
        </div>
      <% } %>
    <% } else { %>
      <%# Unveröffentlicht: eine Farbe für alle (.tcg-soon), Seltenheit nicht verraten %>
      <div class="tcg-slot tcg-locked <%= c.unreleased ? 'tcg-soon' : 'r-' + c.rarity %>" data-rarity="<%= c.unreleased ? 'soon' : c.rarity %>" title="<%= c.unreleased ? 'Noch nicht erhältlich' : 'Noch nicht gezogen' %>">
        <div class="tcg-locked-inner"><span>?</span></div>
        <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.hidden || c.unreleased ? '???' : r.label %></span>
      </div>
    <% } %>
    <%# Folierte Exemplare: eigener Platz je Exemplar (Album: auch als Favorit wählbar; fremde Sammlung: ansehen und Angebot machen) %>
    <% if (isAlbum || mode === 'view') { (foiledCopies[c.id] || []).forEach((f) => { const favKey = 'f:' + f.id; const favOn = isAlbum && favoriteIds.has(favKey); %>
      <button type="button" class="tcg-slot foil-slot r-<%= c.rarity %>"<%- foilViewAttrs(c, r.label, f.foiledAt, isAlbum ? { fav: favKey, favOn, grade: f.grade, center: f.center } : { trade: locals.linkFor ? linkFor(favKey) : null, grade: f.grade, center: f.center }) %>
        aria-label="<%= c.name %>, <%= r.label %>, foliert am <%= dayDate(f.foiledAt) %><%= favOn ? ', Favorit' : '' %> – ansehen">
        <span class="foil-card foil-card-slot"><%- include('foil-mini', { card: c, rarityLabel: r.label, grade: f.grade, center: f.center }) %></span>
        <% if (favOn) { %><span class="tcg-marks"><span class="tcg-mark tcg-mark-fav" title="Favorit"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21.2l1.4-7L2 9.4l7-.8L12 2Z"/></svg></span></span><% } %>
        <span class="tcg-slot-label"><span class="tcg-dot"></span>Foliert · <%= dayDate(f.foiledAt) %></span>
      </button>
    <% }) } %>
  <% }) %>
</div>
