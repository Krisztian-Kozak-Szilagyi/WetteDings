<%#
  Großansicht für Karten im Sleeve, im Slab und einzelne Exemplare (public/js/foil-view.js) – einmal pro Seite einbinden.
  Aufbau wie die reguläre Großansicht (partials/card-zoom): Karte links, rechts Seltenheit, Name, Status und Aktionen.
  favForm: true im Album und auf dem Dashboard – Favorit; im Album dazu „Im Handel anbieten“ (Ziel "f:<Exemplar>") und
    Sleeve abziehen bzw. Slab aufbrechen. An die Bank lassen sich Karten in Sleeve oder Slab nicht verkaufen.
  vitrine: true am Grading-Schreibtisch – „Austauschen“ und „Aus Vitrine entfernen“ für Slabs der editierbaren Vitrine (data-vit-id).
  trade: true in fremden Sammlungen – dann führt "Angebot machen" ins Handelsfenster (data-trade-href).
%>
<dialog class="foil-modal" data-foil-modal aria-label="Karte ansehen">
  <button type="button" class="tcg-close" data-foil-close aria-label="Schließen">×</button>
  <div class="foil-modal-body">
    <div class="foil-modal-stage" data-foil-stage></div>
    <div class="tcg-modal-info foil-modal-info" data-foil-info>
      <span class="tcg-modal-rarity"><span class="tcg-dot" data-foil-dot></span><span data-foil-rarity></span></span>
      <h2 data-foil-name></h2>
      <p class="tcg-modal-status" data-foil-status></p>
      <p class="tcg-modal-note" data-foil-note role="status" hidden></p>
      <div class="tcg-modal-actions">
        <% if (locals.favForm) { %>
          <form method="post" action="/tcg/favorit" data-foil-fav hidden>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="card" value="">
            <button class="btn btn-ghost btn-block" type="submit">☆ Als Favorit zeigen</button>
          </form>
          <a class="btn btn-primary btn-block" href="/handel" data-foil-sell hidden>Im Handel anbieten</a>
          <%# Slab steht in der Vitrine: dort ansehen oder wieder herausnehmen (Album) %>
          <a class="btn btn-primary btn-block" href="/grading?reiter=vitrine" data-foil-vitrine hidden>In der Vitrine ansehen</a>
          <form method="post" action="/grading/vitrine/entfernen" data-foil-vitrine-out hidden>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="doc" value="">
            <button class="btn btn-ghost btn-block" type="submit">Aus der Vitrine nehmen</button>
          </form>
          <%# Sleeve abziehen (kommt zurück ins Inventar) bzw. Slab aufbrechen – Text und Rückfrage setzt foil-view.js %>
          <form method="post" action="/tcg/huelle-abziehen" data-foil-unwrap hidden>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="copy" value="">
            <button class="btn btn-ghost btn-block" type="submit"></button>
          </form>
        <% } %>
        <% if (locals.trade) { %><a class="btn btn-primary btn-block" data-foil-trade hidden>Angebot machen</a><% } %>
        <%# Vitrine am Schreibtisch: Slab tauschen oder entfernen (foil-view.js meldet es per „vit:act“ an grading-desk.js) %>
        <% if (locals.vitrine) { %>
          <button type="button" class="btn btn-primary btn-block" data-foil-vit="swap" hidden>Austauschen</button>
          <button type="button" class="btn btn-danger btn-block" data-foil-vit="remove" hidden>Aus Vitrine entfernen</button>
        <% } %>
        <a class="btn btn-ghost btn-block" data-foil-cert hidden>Zertifikat ansehen →</a>
      </div>
    </div>
  </div>
</dialog>
<script src="/js/foil-view.js?v=<%= assetVersion %>" defer></script>
