<%#
  Bewertungen eines Grading-Shops im Google-Stil (#204): große Durchschnittsnote, Sterne, Verteilung 5→1 und
  Bewertungskarten (Avatar, Name, Sterne, „vor 2 Tagen“, Schnell-Tags, Karte mit Note). Schreibtisch und Shop-Seite.
  r = reputation.ratingOf(shop), histogram = [5★ … 1★], reviews = orderService.shopReviews
%>
<% const total = histogram.reduce((a, b) => a + b, 0); const avg = r.stars; const row = (v) => { const n = Math.round(v || 0); return '★'.repeat(n) + '☆'.repeat(5 - n); }; %>
<div class="gd-gr">
  <div class="gd-gr-head">
    <div class="gd-gr-score">
      <b><%= avg != null ? avg.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '–' %></b>
      <span class="gd-stars" aria-label="<%= avg != null ? avg.toLocaleString('de-DE', { maximumFractionDigits: 1 }) + ' von 5 Sternen' : 'Noch keine Bewertung' %>"><%= row(avg) %></span>
      <small><%= total %> Bewertung<%= total === 1 ? '' : 'en' %></small>
    </div>
    <ul class="gd-gr-hist" aria-label="Verteilung der Sterne">
      <% histogram.forEach((n, i) => { %>
        <li><span><%= 5 - i %></span><span class="gd-gr-bar"><span style="width: <%= total ? Math.round((n / total) * 100) : 0 %>%"></span></span><small><%= n %></small></li>
      <% }) %>
    </ul>
  </div>
  <% if (reviews.length) { %>
    <ul class="gd-gr-list">
      <% reviews.forEach((v) => { const name = v.owner ? v.owner.username : 'Ehemaliges Mitglied'; %>
        <li class="gd-gr-item">
          <span class="gd-gr-who">
            <img class="avatar" src="<%= avatarUrl(v.owner) %>" alt="" width="36" height="36" loading="lazy">
            <span><b><%= name %></b><small><%= relTime(v.ratedAt) %></small></span>
          </span>
          <span class="gd-gr-stars"><span class="gd-stars" aria-label="<%= v.stars %> von 5 Sternen"><%= row(v.stars) %></span></span>
          <% if (v.tags.length) { %><span class="gd-gr-tags"><% v.tags.forEach((t) => { %><span class="<%= t.good ? 'is-good' : 'is-bad' %>"><%= t.label %></span><% }) %></span><% } %>
          <% if (v.card) { %>
            <span class="gd-gr-card r-<%= v.card.rarity %>">
              <img src="<%= v.card.image %>" alt="" width="28" height="39" loading="lazy">
              <span><%= v.card.name %><% if (v.result && v.result.grade != null) { %> · <b><%= v.shopCode %> <%= v.result.grade %></b><% } else if (v.services.iron) { %> · gebügelt<% } %></span>
            </span>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="gd-empty"><span aria-hidden="true">💬</span> Noch keine Bewertung</p>
  <% } %>
</div>
