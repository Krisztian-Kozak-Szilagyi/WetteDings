<%#
  Kassenzettel (#204): ein erledigter Auftrag als Thermobon – Fenster „Bons“ am Kassenzettel-Spieß.
  b = { card (Katalog oder null), title, who, at, lines: [[Bezeichnung, Cent]], total (Cent oder null), note, void }
%>
<li class="gd-bon<%= b.void ? ' is-void' : '' %><%= b.card ? ' r-' + b.card.rarity : '' %>">
  <span class="gd-bon-head">
    <% if (b.card) { %><img src="<%= b.card.image %>" alt="" width="36" height="50" loading="lazy"><% } %>
    <span><b><%= b.title %></b><small><%= b.who %> · <%= b.at ? date(b.at) : '' %></small></span>
  </span>
  <% if (b.lines.length) { %>
    <span class="gd-bon-lines"><% b.lines.forEach(([label, cents]) => { %><span><span><%= label %></span><span><%= euro(cents) %></span></span><% }) %></span>
  <% } %>
  <% if (b.note) { %><span class="gd-bon-note"><%= b.note %></span><% } %>
  <span class="gd-bon-total"><span>SUMME</span><b><%= b.total != null ? euro(b.total) : '–' %></b></span>
</li>
