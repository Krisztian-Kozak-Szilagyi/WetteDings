<%# Chat unten rechts (public/js/chat.js, src/routes/chat.js): Gesprächsliste ↔ Gespräch. Inhalt baut das Skript. %>
<div class="chat" data-chat-root data-csrf="<%= csrfToken %>" data-me="<%= currentUser.username %>">
  <button type="button" class="chat-fab" data-chat-toggle aria-expanded="false" aria-controls="chat-panel" aria-label="Chat öffnen">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-4.4 3.5A1 1 0 0 1 3 20.7V6a2 2 0 0 1 1-2Zm1 2v12.6L8.3 16H20V6H5Zm3 3h8v2H8V9Zm0 3h5v2H8v-2Z"/></svg>
    <span class="chat-badge" data-chat-badge hidden></span>
  </button>
  <section class="chat-panel" id="chat-panel" data-chat-panel hidden aria-label="Chat">
    <%# Gesprächsliste %>
    <div class="chat-view" data-chat-list-view>
      <header class="chat-head">
        <strong class="chat-head-title">Chat</strong>
        <button type="button" class="chat-icon-btn" data-chat-new title="Neues Gespräch" aria-label="Neues Gespräch">+</button>
        <button type="button" class="chat-icon-btn" data-chat-close aria-label="Chat schließen">×</button>
      </header>
      <form class="chat-new" data-chat-new-form hidden>
        <input type="text" name="name" maxlength="40" placeholder="Name des Mitglieds" aria-label="Name des Mitglieds" autocomplete="off" required>
        <button type="submit" class="btn btn-primary btn-sm">Schreiben</button>
      </form>
      <p class="chat-error" data-chat-list-error hidden></p>
      <ul class="chat-list" data-chat-list></ul>
      <p class="chat-empty muted" data-chat-empty hidden>Noch keine Gespräche. Mit + schreibst du jemandem – oder über „Nachricht“ auf einem Profil.</p>
      <details class="chat-blocked" data-chat-blocked hidden>
        <summary>Blockiert</summary>
        <ul data-chat-blocked-list></ul>
      </details>
    </div>
    <%# Ein Gespräch %>
    <div class="chat-view" data-chat-conv-view hidden>
      <header class="chat-head">
        <button type="button" class="chat-icon-btn" data-chat-back aria-label="Zurück zur Liste">‹</button>
        <span class="chat-head-title" data-chat-title></span>
        <button type="button" class="chat-icon-btn chat-block-btn" data-chat-block hidden></button>
        <button type="button" class="chat-icon-btn" data-chat-close aria-label="Chat schließen">×</button>
      </header>
      <div class="chat-log" data-chat-log aria-live="polite"></div>
      <p class="chat-note" data-chat-note hidden></p>
      <p class="chat-error" data-chat-error hidden></p>
      <form class="chat-form" data-chat-form>
        <textarea name="text" rows="1" maxlength="1000" placeholder="Nachricht …" aria-label="Nachricht" required></textarea>
        <button type="submit" class="btn btn-primary btn-sm">Senden</button>
      </form>
    </div>
  </section>
</div>
<script src="/js/chat.js?v=<%= assetVersion %>" defer></script>
