<%#
  Ein Exemplar im Sleeve oder Slab als eigener Platz (Album, Slab-Regal im Album, fremde Sammlungen).
  c = Karte, r = Seltenheit, f = Exemplar ({ id, foiledAt, slab, center, value, lock }), isAlbum, favoriteIds (Set),
  no (Kartennummer in der Season), linkFor (fremde Sammlung: Angebot machen), highlight (Exemplar-ID, das sich in 3D öffnet: public/js/foil-view.js)
  Album: Menü unter der Karte – Wert, Favorit, „Im Handel anbieten“, Sleeve abziehen bzw. Slab aufbrechen.
  data-sell-off: warum Anbieten gerade nicht geht (steht schon im Handel, auf Quest, im Duell)
%>
<%
  const favKey = 'f:' + f.id;
  const favOn = isAlbum && favoriteIds.has(favKey);
  const sellOff = f.lock === 'handel' ? 'Steht schon im Handel.' : f.lock ? 'Gerade gesperrt (' + (f.lock === 'quest' ? 'auf Quest' : f.lock === 'duell' ? 'im Duell' : f.lock === 'dungeon' ? 'im Dungeon' : f.lock === 'vitrine' ? 'in deiner Vitrine' : f.lock) + ').' : '';
  const isNew = isAlbum && locals.highlight === f.id;
  const popSt = f.slab && locals.popStatsOf ? popStatsOf(c.id, f.slab.grade) : null; // Zertifikatsschild wie in der Vitrine
%>
<button type="button" id="f-<%= f.id %>" class="tcg-slot foil-slot r-<%= c.rarity %><%= isNew ? ' is-new' : '' %><%= f.slab ? ' is-slab' : ' is-sleeve' %>"<%- foilViewAttrs(c, r.label, f.foiledAt, isAlbum ? { fav: favKey, favOn, slab: f.slab, id: f.id, center: f.center, no: locals.no } : { trade: locals.linkFor ? linkFor(favKey) : null, slab: f.slab, id: f.id, center: f.center, no: locals.no }) %><% if (f.slab && (isAlbum || locals.popStatsOf)) { %> data-plaque<% } %><% if (isAlbum && f.lock === 'vitrine') { %> data-in-vitrine<% } %><% if (popSt) { %> data-pop-stats="<%= JSON.stringify(popSt) %>"<% } %>
  <% if (isAlbum) { %>data-album-foil data-sell-text="<%= euro(f.value) %>" data-base-text="<%= euro(r.sell || 0) %>"<% if (sellOff) { %> data-sell-off="<%= sellOff %>"<% } %><% } %>
  aria-label="<%= c.name %>, <%= r.label %>, <%= f.slab ? 'Slab ' + f.slab.code + ' Note ' + f.slab.grade : 'im Sleeve' %> seit <%= dayDate(f.foiledAt) %><%= favOn ? ', Favorit' : '' %> – ansehen">
  <span class="foil-card foil-card-slot"><%- include('foil-mini', { card: c, rarityLabel: r.label, slab: f.slab, id: f.id, center: f.center }) %></span>
  <% if (favOn) { %>
    <span class="tcg-marks">
      <span class="tcg-mark tcg-mark-fav" title="Favorit"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21.2l1.4-7L2 9.4l7-.8L12 2Z"/></svg></span>
    </span>
  <% } %>
  <span class="tcg-slot-label"><span class="tcg-dot"></span><%= f.slab ? 'Slab ' + f.slab.code + ' · Note ' + f.slab.grade : 'Im Sleeve · ' + dayDate(f.foiledAt) %></span>
</button>
