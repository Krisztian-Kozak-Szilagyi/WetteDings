<%
  const st = statusInfo(bet);
  const pick = locals.myPicks ? myPicks[String(bet._id)] : null; // eigener Tipp auf diese Wette
  // die eigene Option immer anzeigen, auch wenn sie nicht unter den ersten drei ist
  let shown = bet.options.slice(0, 3);
  if (pick && !shown.some((o) => o.key === pick.side)) shown = [...bet.options.slice(0, 2), findOption(bet, pick.side)].filter(Boolean);
%>
<a class="bet-card <%= pick ? 'has-pick ' + optClass(bet, pick.side) : '' %>" href="/wetten/<%= bet._id %>">
  <div class="bet-card-top">
    <span class="badge badge-<%= st.key %>"><%= st.label %></span>
    <span class="muted small"><%= bet.participants %> <%= bet.participants === 1 ? 'Teilnehmer' : 'Teilnehmende' %><% if (bet.commentCount) { %> · <%= bet.commentCount %> <%= bet.commentCount === 1 ? 'Kommentar' : 'Kommentare' %><% } %></span>
  </div>
  <h3 class="bet-card-title"><%= bet.title %></h3>
  <p class="muted small">von <%- userLink(bet.creatorName, { nested: true }) %><%= bet.type === 'optionen' ? ' · ' + bet.options.length + ' Optionen' : '' %></p>
  <%- include('bar', { bet }) %>
  <ul class="opt-list">
    <% shown.forEach((o) => { %>
      <li class="opt-row <%= optClass(bet, o.key) %> <%= bet.outcome === o.key ? 'is-winner' : '' %> <%= pick && pick.side === o.key ? 'is-mine' : '' %>">
        <span class="opt-dot"></span>
        <span class="opt-label"><%= o.label %></span>
        <span class="opt-meta"><%= share(bet, o) %> % · <%= quote(bet, o) %></span>
      </li>
    <% }) %>
    <% if (bet.options.length > shown.length) { %>
      <li class="muted small">+ <%= bet.options.length - shown.length %> weitere Optionen</li>
    <% } %>
  </ul>
  <% if (pick) { %>
    <p class="my-pick">Dein Tipp: <strong><%= optionLabel(bet, pick.side) %></strong> · <%= euro(pick.amount) %></p>
  <% } %>
  <% if (bet.resultAt && bet.status === 'offen') { %>
    <p class="muted small card-result-date">Auswertung: <%= date(bet.resultAt) %></p>
  <% } %>
  <div class="bet-card-foot">
    <span>Topf <strong><%= euro(pool(bet)) %></strong></span>
    <span class="muted small">
      <% if (st.key === 'offen') { %>endet <%= relTime(bet.deadline) %>
      <% } else if (st.key === 'wartend') { %>Schluss <%= relTime(bet.deadline) %>
      <% } else { %><%= relTime(bet.resolvedAt) %><% } %>
    </span>
  </div>
</a>
