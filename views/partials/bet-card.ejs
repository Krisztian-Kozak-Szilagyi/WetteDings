<%
  const st = statusInfo(bet);
  const pick = locals.myPicks ? myPicks[String(bet._id)] : null; // eigener Tipp auf diese Wette
  // die eigene Option immer anzeigen, auch wenn sie nicht unter den ersten drei ist
  let shown = bet.options.slice(0, 3);
  if (pick && !shown.some((o) => o.key === pick.side)) shown = [...bet.options.slice(0, 2), findOption(bet, pick.side)].filter(Boolean);
%>
<a class="bet-card <%= pick ? 'has-pick ' + optClass(bet, pick.side) : '' %><%= bet.duel ? ' is-duel' : '' %>" href="/wetten/<%= bet._id %>">
  <div class="bet-card-top">
    <span class="bet-card-tags">
      <span class="badge badge-<%= st.key %>"><%= st.label %></span>
      <% if (bet.duel) { %><span class="tag tag-duel" title="Duell: zwei treten gegeneinander an, der Schiedsrichter entscheidet – Zuschauer setzen auf einen der beiden">⚔ Duell</span><% } %>
      <% if (bet.groupName) { %><span class="tag tag-group" title="Nur für Mitglieder dieser Gruppe sichtbar"><%= bet.groupName %></span><% } %>
    </span>
    <span class="bet-card-when">
      <% if (st.key === 'offen') { %>endet <%= relTime(bet.deadline) %>
      <% } else if (st.key === 'wartend') { %>Schluss <%= relTime(bet.deadline) %>
      <% } else { %><%= relTime(bet.resolvedAt) %><% } %>
    </span>
  </div>
  <h3 class="bet-card-title"><%= bet.title %></h3>
  <% if (bet.duel) { %>
    <p class="bet-card-sub"><%- userLink(bet.creatorName, { nested: true }) %> vs. <%- userLink(bet.duel.opponentName, { nested: true }) %> · <%= duelStakeText(bet) %></p>
  <% } %>
  <div class="bet-chips">
    <% shown.forEach((o) => { %>
      <span class="bet-chip <%= optClass(bet, o.key) %> <%= bet.outcome === o.key ? 'is-winner' : '' %> <%= pick && pick.side === o.key ? 'is-mine' : '' %>"<%- pick && pick.side === o.key ? ' title="Dein Tipp: ' + euro(pick.amount) + '"' : '' %>><%= o.label %><span><%= share(bet, o) %> %</span></span>
    <% }) %>
    <% if (bet.options.length > shown.length) { %><span class="bet-chip-more">+<%= bet.options.length - shown.length %></span><% } %>
  </div>
  <div class="bet-card-foot">
    <span class="bet-card-pot">Topf <strong><%= euro(pool(bet)) %></strong></span>
    <span><% if (pick) { %><span class="bet-card-mine">Dein Einsatz <%= euro(pick.amount) %></span> · <% } %><%= bet.participants %> <%= bet.participants === 1 ? 'Teilnehmer' : 'Teilnehmende' %></span>
  </div>
</a>
