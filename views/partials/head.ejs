<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.title ? title + ' · ' : '' %><%= appName %></title>
  <meta name="description" content="<%= appName %> – Wetten unter Freunden mit Spielgeld. Stelle eigene Wetten mit Ja/Nein oder eigenen Optionen auf und wette mit.">
  <meta name="theme-color" content="#161826">
  <link rel="icon" href="/favicon.svg?v=<%= assetVersion %>" type="image/svg+xml">
  <%# Als App installierbar (manifest + public/sw.js); Knopf „App herunterladen“ im Profil-Menü, Logik am Ende von app.js %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="<%= appName %>">
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
  <% if (deviceProbe) { %><script src="/js/device.js?v=<%= assetVersion %>" defer data-csrf="<%= csrfToken %>"></script><% } %>
  <% if (locals.actionToken) { %><meta name="bfw-at" content="<%= actionToken %>"><script src="/js/guard.js?v=<%= assetVersion %>" defer></script><% } %>
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  <% if (locals.actionToken) { %><%# Falle für Skripte, die Seiten auslesen: unsichtbar, nicht erreichbar per Tastatur oder Vorlesefunktion (moderation/requestSignals.js) %><a class="hp-link" href="/tcg/gratis-packs" tabindex="-1" aria-hidden="true" rel="nofollow">Gratis-Packs abholen</a><% } %>
  <%
    // Menüpunkte samt Abzeichen – einmal aufgebaut, oben in der Leiste und (Handy/Tablet) im Profil-Menü gezeigt
    const cap = (n) => (n > 99 ? '99+' : n);
    const navItems = [];
    const navGroup = (key, label, items) => {
      const sum = {};
      items.forEach((it) => it.badges.forEach((bd) => {
        if (!sum[bd.cls]) sum[bd.cls] = { n: 0, cls: bd.cls, title: [], aria: [] };
        sum[bd.cls].n += bd.n; sum[bd.cls].title.push(it.label + ': ' + bd.title); sum[bd.cls].aria.push(bd.aria);
      }));
      const badges = Object.values(sum).map((bd) => ({ n: bd.n, cls: bd.cls, title: bd.title.join(' · '), aria: bd.aria.join(', ') }));
      const live = items.filter((it) => it.live).map((it) => it.live).join(' · ');
      return { group: key, label, items, badges, live, active: items.some((it) => it.active) };
    };
    if (currentUser) {
      // Abzeichen: neue Gruppen-Wetten (eigene Farbe) haben Vorrang vor neuen öffentlichen; fehlende eigene Stimmen zählen immer
      const betRed = betVotePending + (betNewGroup ? 0 : betNewPublic);
      const betBadges = [];
      if (betNewGroup) betBadges.push({ n: betNewGroup, cls: 'nav-badge-group', title: 'Neue Wetten in deinen Gruppen', aria: betNewGroup + ' neue Wetten in deinen Gruppen' });
      if (betRed) betBadges.push({ n: betRed, cls: '', title: betVotePending ? 'Wetten, in denen deine Stimme zum Ergebnis fehlt' + (betNewGroup || !betNewPublic ? '' : ', und neue Wetten') : 'Neue Wetten', aria: betRed + ' Wetten: neu oder deine Stimme fehlt' });
      navItems.push({ href: '/rangliste', label: 'Rangliste', active: currentPath === '/rangliste', badges: [] });
      // Wetten, Broker und Lotterie stecken im Aufklappmenü "Gambling"; seine Abzeichen = Summe der Unterpunkte (je Farbe)
      const gambling = [
        { href: '/wetten', label: 'Wetten', active: currentPath === '/wetten' || currentPath.startsWith('/wetten/'), badges: betBadges },
        { href: '/broker', label: 'Broker', active: currentPath === '/broker' || currentPath.startsWith('/broker/'), badges: [] },
        { href: '/lotterie', label: 'Lotterie', active: currentPath === '/lotterie' || currentPath.startsWith('/lotterie/'), badges: [] },
      ];
      if (esportsOpen(currentUser)) gambling.splice(2, 0, { href: '/esports', label: 'eSports', active: currentPath === '/esports', badges: [] });
      navItems.push(navGroup('gambling', 'Gambling', gambling));
      navItems.push({ href: '/tcg', label: 'TCG', active: currentPath.startsWith('/tcg') || currentPath.startsWith('/inventar'), badges: newPacks ? [{ n: newPacks, cls: '', title: 'Neue Booster Packs im Inventar', aria: newPacks + ' neue Booster Packs' }] : [], live: newItems ? 'Neuer Gegenstand im Inventar' : '' });
      const tradeBadges = [];
      if (tradeMarketNew) tradeBadges.push({ n: tradeMarketNew, cls: 'nav-badge-market', title: 'Neu auf dem Markt', aria: tradeMarketNew + ' neue Markt-Angebote' });
      if (tradeIncoming) tradeBadges.push({ n: tradeIncoming, cls: '', title: 'Angebote, Verhandlungen und abgeschlossene Geschäfte für dich', aria: tradeIncoming + ' Angebote und Verhandlungen für dich' });
      navItems.push({ href: '/handel', label: 'Handel', active: currentPath === '/handel', badges: tradeBadges, live: blackMarketOpen() ? 'Black Market geöffnet' : '' });
      if (ihkOpen() || currentUser.isAdmin) navItems.push({ href: '/ihk', label: 'IHK', active: currentPath === '/ihk', badges: [] });
      if (dungeonOpen() || currentUser.isAdmin) navItems.push({ href: '/dungeon', label: 'Dungeon', active: currentPath === '/dungeon', badges: [] });
      if (gradingOpen() || currentUser.isAdmin) navItems.push({ href: '/grading', label: 'Grading', active: currentPath === '/grading', badges: [] });
      const forumBadges = [];
      if (forumOther) forumBadges.push({ n: forumOther, cls: 'nav-badge-market', title: 'Neues im Forum', aria: forumOther + ' Themen mit neuen Beiträgen' });
      if (forumMine) forumBadges.push({ n: forumMine, cls: '', title: 'Neues in deinen Themen', aria: forumMine + ' deiner Themen mit neuen Beiträgen' });
      navItems.push({ href: '/forum', label: 'Forum', active: currentPath.startsWith('/forum'), badges: forumBadges });
      if (currentUser.isStaff) {
        const adminBadges = [];
        if (betDisputes) adminBadges.push({ n: betDisputes, cls: 'nav-badge-dispute', title: 'Strittige Wetten, die ein Dev entscheiden muss', aria: betDisputes + ' strittige Wetten' });
        if (tradeAlerts) adminBadges.push({ n: tradeAlerts, cls: 'nav-badge-suspicious', title: 'Handel zwischen Mehrfach-Konten', aria: tradeAlerts + ' Geschäfte zwischen Mehrfach-Konten' });
        if (deviceAlerts) adminBadges.push({ n: deviceAlerts, cls: 'nav-badge-device', title: 'Konten, die dasselbe Gerät benutzen', aria: deviceAlerts + ' Hinweise auf Mehrfach-Konten' });
        if (suspicionAlerts) adminBadges.push({ n: suspicionAlerts, cls: 'nav-badge-suspicion', title: 'Auffälligkeiten: Spieler mit Verdacht auf Skript oder Wertverschiebung', aria: suspicionAlerts + ' verdächtige Spieler' });
        if (packLogNew) adminBadges.push({ n: packLogNew, cls: '', title: 'Neue Vergaben und entfernte Karten (Vergabe-Log)', aria: packLogNew + ' neue Einträge im Vergabe-Log' });
        navItems.push({ href: '/admin', label: currentUser.isAdmin ? 'Admin' : 'Dev', active: currentPath.startsWith('/admin'), badges: adminBadges });
      }

    }
    const navBadges = (it) => {
      let h = '';
      it.badges.forEach((b) => { h += '<span class="nav-badge ' + b.cls + '" title="' + b.title + '" aria-label="' + b.aria + '">' + cap(b.n) + '</span>'; });
      if (it.live) h += '<span class="nav-live" title="' + it.live + '" aria-label="' + it.live + '"></span>';
      return h;
    };
    // Leiste: Gruppe = Aufklappmenü (details, Animation in style.css, Hover/Schließen in app.js)
    const navTop = (it) => {
      if (!it.group) return navLink(it);
      let h = '<details class="nav-group' + (it.active ? ' active' : '') + '" data-nav-group>'
        + '<summary' + (it.active ? ' class="active"' : '') + '>' + it.label + navBadges(it)
        + '<svg class="nav-group-chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>'
        + '<div class="nav-group-panel">';
      return h + it.items.map(navLink).join('') + '</div></details>';
    };
    // Profil-Menü (Handy/Tablet): Gruppe = kleine Überschrift + Unterpunkte
    const navMenu = (it) => {
      if (!it.group) return navLink(it);
      return '<div class="menu-nav-group"><span class="menu-nav-head">' + it.label + '</span>' + it.items.map(navLink).join('') + '</div>';
    };
    const navLink = (it) => {
      let h = '<a href="' + it.href + '"' + (it.active ? ' class="active" aria-current="page"' : '') + '>' + it.label;
      return h + navBadges(it) + '</a>';
    };
  %>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <%- include('logo') %>
      </a>

      <% if (currentUser) { %>
        <nav id="hauptnavigation" class="nav" aria-label="Hauptmenü">
          <% navItems.forEach((it) => { %><%- navTop(it) %><% }) %>
        </nav>
      <% } %>

      <div class="nav-user">
        <% if (currentUser) { %>
          <%# Glocke: persönliche Benachrichtigungen; bleiben ungelesen, bis man sie anklickt oder als gelesen markiert.
              Die Formulare schickt app.js im Hintergrund ([data-bell-form]), ohne JavaScript lädt die Seite neu. %>
          <details class="bell" data-dropdown data-bell>
            <summary class="bell-btn" title="Benachrichtigungen" aria-label="Benachrichtigungen<%= bellUnread ? ' (' + bellUnread + ' ungelesen)' : '' %>">
              <svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M221.8,175.94C216.25,166.38,208,139.33,208,104a80,80,0,1,0-160,0c0,35.34-8.26,62.38-13.81,71.94A16,16,0,0,0,48,200H88.81a40,40,0,0,0,78.38,0H208a16,16,0,0,0,13.8-24.06ZM128,216a24,24,0,0,1-22.62-16h45.24A24,24,0,0,1,128,216ZM48,184c7.7-13.24,16-43.92,16-80a64,64,0,1,1,128,0c0,36.05,8.28,66.73,16,80Z"/></svg>
              <span class="bell-count" data-bell-count<%= bellUnread ? '' : ' hidden' %>><%= cap(bellUnread) %></span>
            </summary>
            <div class="bell-panel">
              <div class="bell-head">
                <span>Benachrichtigungen</span>
                <form method="post" action="/benachrichtigungen/alle-gelesen" data-bell-form data-bell-all<%= bellUnread ? '' : ' hidden' %>>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="zurueck" value="<%= currentPath %>">
                  <button type="submit" class="bell-readall">Alle gelesen</button>
                </form>
              </div>
              <div class="bell-list">
                <% if (!bellNotes.length) { %>
                  <p class="bell-empty">Noch keine Benachrichtigungen.</p>
                <% } %>
                <% bellNotes.forEach((n) => { %>
                  <div class="bell-row<%= n.readAt ? '' : ' is-unread' %>" data-bell-row>
                    <a class="bell-item" href="/benachrichtigungen/<%= n._id %>">
                      <span class="bell-dot"></span>
                      <span class="bell-body">
                        <span class="bell-meta"><span class="bell-area"><%= n.area %></span><span class="bell-when"><%= relTime(n.at) %></span></span>
                        <span class="bell-text"><%= n.text %></span>
                      </span>
                    </a>
                    <% if (!n.readAt) { %>
                      <form method="post" action="/benachrichtigungen/<%= n._id %>/gelesen" class="bell-mark" data-bell-form>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="zurueck" value="<%= currentPath %>">
                        <button type="submit" title="Als gelesen markieren" aria-label="Als gelesen markieren">
                          <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"/></svg>
                        </button>
                      </form>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          </details>

          <%# Profil-Menü: Klick auf Name, Kontostand oder Bild klappt es auf (schließt bei Klick daneben, siehe app.js).
              Auf Handy/Tablet stehen hier auch die Menüpunkte der Leiste. %>
          <details class="user-menu" data-user-menu>
            <summary class="balance-chip" title="Mein Konto" data-live="balance">
              <span class="balance-text">
                <span class="balance-name"><%= currentUser.username %></span>
                <strong><%= euro(currentUser.balance) %></strong>
              </span>
              <img class="avatar" src="<%= avatarUrl(currentUser) %>?v=<%= assetVersion %>" alt="" width="34" height="34">
              <% if (navItems.some((it) => it.badges.length)) { %><span class="menu-dot" aria-hidden="true"></span><% } %>
            </summary>
            <div class="user-menu-list" role="menu">
              <div class="menu-nav">
                <% navItems.forEach((it) => { %><%- navMenu(it) %><% }) %>
              </div>
              <a role="menuitem" href="/profil/<%= encodeURIComponent(currentUser.username) %>">Profil ansehen</a>
              <a role="menuitem" href="/inventar">Inventar</a>
              <a role="menuitem" href="/konto">Statistiken</a>
              <a role="menuitem" href="/konto/wetten">Meine Wetten</a>
              <a role="menuitem" href="/konto/auszug">Kontoauszug</a>
              <a role="menuitem" href="/konto/gruppen">Wett-Gruppen</a>
              <a role="menuitem" href="/konto/einstellungen">Konto-Einstellungen</a>
              <button role="menuitem" type="button" class="app-install" data-app-install hidden>App herunterladen</button>
              <form method="post" action="/abmelden">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button role="menuitem" type="submit">Abmelden</button>
              </form>
            </div>
          </details>
        <% } else { %>
          <a class="btn btn-ghost btn-sm" href="/anmelden">Anmelden</a>
          <a class="btn btn-primary btn-sm" href="/registrieren">Registrieren</a>
        <% } %>
      </div>
    </div>
  </header>

  <main id="inhalt" class="container">
    <div data-flash-area>
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status">
        <span><%= flash.message %></span>
        <button type="button" class="flash-close" aria-label="Hinweis schließen">×</button>
      </div>
    <% } %>
    </div>
