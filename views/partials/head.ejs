<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.title ? title + ' · ' : '' %><%= appName %></title>
  <meta name="description" content="<%= appName %> – Wetten unter Freunden mit Spielgeld. Stelle eigene Wetten mit Ja/Nein oder eigenen Optionen auf und wette mit.">
  <meta name="theme-color" content="#161826">
  <link rel="icon" href="/favicon-32.png?v=<%= assetVersion %>" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-64.png?v=<%= assetVersion %>" sizes="64x64" type="image/png">
  <%# Als App installierbar (manifest + public/sw.js); Knopf „App herunterladen“ im Profil-Menü, Logik am Ende von app.js %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="<%= appName %>">
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <%# Seiten-CSS im head (nicht am Ende des body) – sonst blitzt die Seite kurz ungestylt auf (Dashboard: schwarzes Vermögens-Diagramm) %>
  <% (locals.pageCss || []).forEach((f) => { %><link rel="stylesheet" href="/css/<%= f %>.css?v=<%= assetVersion %>"><% }) %>
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
  <% if (deviceProbe) { %><script src="/js/device.js?v=<%= assetVersion %>" defer data-csrf="<%= csrfToken %>"></script><% } %>
  <% if (locals.actionToken) { %><meta name="bfw-at" content="<%= actionToken %>"><script src="/js/guard.js?v=<%= assetVersion %>" defer></script><% } %>
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  <% if (locals.actionToken) { %><%# Falle für Skripte, die Seiten auslesen: unsichtbar, nicht erreichbar per Tastatur oder Vorlesefunktion (moderation/requestSignals.js) %><a class="hp-link" href="/tcg/gratis-packs" tabindex="-1" aria-hidden="true" rel="nofollow">Gratis-Packs abholen</a><% } %>
  <%
    // Menüpunkte samt Abzeichen – einmal aufgebaut (src/lib/navModel.js), oben in der Leiste und (Handy/Tablet) im
    // Profil-Menü gezeigt; dieselben Einträge nutzt das HUD der Taverne (views/hub.ejs)
    const navItems = navModel.buildNav(locals);
  %>
  <% if (!locals.hub) { %>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <%- include('logo') %>
      </a>

      <% if (currentUser) { %>
        <nav id="hauptnavigation" class="nav" aria-label="Hauptmenü">
          <% navItems.forEach((it) => { %><%- navModel.topHtml(it) %><% }) %>
        </nav>
      <% } %>

      <div class="nav-user">
        <% if (currentUser) { %>
          <%- include('bell') %>

          <%- include('user-menu', { navItems }) %>
        <% } else { %>
          <a class="btn btn-ghost btn-sm" href="/anmelden">Anmelden</a>
          <a class="btn btn-primary btn-sm" href="/registrieren">Registrieren</a>
        <% } %>
      </div>
    </div>
  </header>
  <% } %>

  <%# hub: Startseite im Taverne-Stil (views/hub.ejs) – eigenes HUD statt der Leiste, volle Breite statt container %>
  <main id="inhalt" class="<%= locals.hub ? 'hub-main' : 'container' %>">
    <div data-flash-area>
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status">
        <span><%= flash.message %></span>
        <button type="button" class="flash-close" aria-label="Hinweis schließen">×</button>
      </div>
    <% } %>
    </div>
