<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.title ? title + ' · ' : '' %><%= appName %></title>
  <meta name="description" content="<%= appName %> – Wetten unter Freunden mit Spielgeld. Stelle eigene Wetten mit Ja/Nein oder eigenen Optionen auf und wette mit.">
  <meta name="theme-color" content="#0f766e">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <%- include('logo') %>
        <span><%= appName %></span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation" aria-label="Menü öffnen">
        <span></span><span></span><span></span>
      </button>

      <nav id="hauptnavigation" class="nav">
        <% if (currentUser) { %>
          <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Wetten</a>
          <a href="/rangliste" class="<%= currentPath === '/rangliste' ? 'active' : '' %>">Rangliste</a>
          <a href="/coin-exchange" class="<%= currentPath === '/coin-exchange' ? 'active' : '' %>">Coin Exchange</a>
          <a href="/lotterie" class="<%= currentPath === '/lotterie' ? 'active' : '' %>">Lotterie</a>
        <% } %>
        <a href="/regeln" class="<%= currentPath === '/regeln' ? 'active' : '' %>">Regeln</a>
        <% if (currentUser && currentUser.isAdmin) { %>
          <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">Admin</a>
        <% } %>
        <div class="nav-user">
          <% if (currentUser) { %>
            <a class="balance-chip" href="/konto" title="Mein Konto" data-live="balance">
              <span class="balance-name"><%= currentUser.username %></span>
              <strong><%= euro(currentUser.balance) %></strong>
            </a>
            <form method="post" action="/abmelden">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-ghost btn-sm" type="submit">Abmelden</button>
            </form>
          <% } else { %>
            <a class="btn btn-ghost btn-sm" href="/anmelden">Anmelden</a>
            <a class="btn btn-primary btn-sm" href="/registrieren">Registrieren</a>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <main id="inhalt" class="container">
    <div data-flash-area>
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status">
        <span><%= flash.message %></span>
        <button type="button" class="flash-close" aria-label="Hinweis schließen">×</button>
      </div>
    <% } %>
    </div>
