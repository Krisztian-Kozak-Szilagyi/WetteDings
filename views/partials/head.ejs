<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.title ? title + ' · ' : '' %><%= appName %></title>
  <meta name="description" content="<%= appName %> – Wetten unter Freunden mit Spielgeld. Stelle eigene Wetten mit Ja/Nein oder eigenen Optionen auf und wette mit.">
  <meta name="theme-color" content="#0f766e">
  <link rel="icon" href="/favicon.svg?v=<%= assetVersion %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
  <% if (deviceProbe) { %><script src="/js/device.js?v=<%= assetVersion %>" defer data-csrf="<%= csrfToken %>"></script><% } %>
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <%- include('logo') %>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation" aria-label="Menü öffnen">
        <span></span><span></span><span></span>
      </button>

      <nav id="hauptnavigation" class="nav">
        <% if (currentUser) { %>
          <%# Abzeichen: neue Gruppen-Wetten (eigene Farbe) haben Vorrang vor neuen öffentlichen (rot); fehlende eigene Stimmen zählen immer rot %>
          <% const betRed = betVotePending + (betNewGroup ? 0 : betNewPublic); %>
          <a href="/" class="nav-badge-link <%= currentPath === '/' ? 'active' : '' %>">Wetten<% if (betNewGroup || betRed) { %><span class="nav-badges"><% if (betNewGroup) { %><span class="nav-badge nav-badge-group" title="Neue Wetten in deinen Gruppen" aria-label="<%= betNewGroup %> neue Wetten in deinen Gruppen"><%= betNewGroup > 99 ? '99+' : betNewGroup %></span><% } %><% if (betRed) { %><span class="nav-badge" title="<%= betVotePending ? 'Wetten, in denen deine Stimme zum Ergebnis fehlt' + (betNewGroup || !betNewPublic ? '' : ', und neue Wetten') : 'Neue Wetten' %>" aria-label="<%= betRed %> Wetten: neu oder deine Stimme fehlt"><%= betRed > 99 ? '99+' : betRed %></span><% } %></span><% } %></a>
          <a href="/rangliste" class="<%= currentPath === '/rangliste' ? 'active' : '' %>">Rangliste</a>
          <a href="/coin-exchange" class="<%= currentPath === '/coin-exchange' ? 'active' : '' %>">Coin Exchange</a>
          <a href="/lotterie" class="<%= currentPath === '/lotterie' ? 'active' : '' %>">Lotterie</a>
          <a href="/tcg" class="nav-badge-link <%= currentPath.startsWith('/tcg') ? 'active' : '' %>">TCG<% if (newPacks) { %><span class="nav-badges"><span class="nav-badge" title="Neue Booster Packs" aria-label="<%= newPacks %> neue Booster Packs"><%= newPacks > 99 ? '99+' : newPacks %></span></span><% } %></a>
          <a href="/handel" class="nav-badge-link <%= currentPath === '/handel' ? 'active' : '' %>">Handel<% if (tradeMarketNew || tradeIncoming) { %><span class="nav-badges"><% if (tradeMarketNew) { %><span class="nav-badge nav-badge-market" title="Neu auf dem Markt" aria-label="<%= tradeMarketNew %> neue Markt-Angebote"><%= tradeMarketNew > 99 ? '99+' : tradeMarketNew %></span><% } %><% if (tradeIncoming) { %><span class="nav-badge" title="Angebote, Verhandlungen und abgeschlossene Geschäfte für dich" aria-label="<%= tradeIncoming %> Angebote und Verhandlungen für dich"><%= tradeIncoming > 99 ? '99+' : tradeIncoming %></span><% } %></span><% } %></a>
          <% if (ihkOpen() || currentUser.isAdmin) { %><a href="/ihk" class="<%= currentPath === '/ihk' ? 'active' : '' %>">IHK</a><% } %>
          <% if (gradingOpen() || currentUser.isAdmin) { %><a href="/grading" class="<%= currentPath === '/grading' ? 'active' : '' %>">Grading</a><% } %>
          <a href="/forum" class="nav-badge-link <%= currentPath.startsWith('/forum') ? 'active' : '' %>">Forum<% if (forumMine || forumOther) { %><span class="nav-badges"><% if (forumOther) { %><span class="nav-badge nav-badge-market" title="Neues im Forum" aria-label="<%= forumOther %> Themen mit neuen Beiträgen"><%= forumOther > 99 ? '99+' : forumOther %></span><% } %><% if (forumMine) { %><span class="nav-badge" title="Neues in deinen Themen" aria-label="<%= forumMine %> deiner Themen mit neuen Beiträgen"><%= forumMine > 99 ? '99+' : forumMine %></span><% } %></span><% } %></a>
        <% } %>
        <% if (currentUser && currentUser.isStaff) { %>
          <a href="/admin" class="nav-badge-link <%= currentPath.startsWith('/admin') ? 'active' : '' %>"><%= currentUser.isAdmin ? 'Admin' : 'Dev' %><% if (packLogNew || betDisputes || deviceAlerts || tradeAlerts) { %><span class="nav-badges"><% if (betDisputes) { %><span class="nav-badge nav-badge-dispute" title="Strittige Wetten, die ein Dev entscheiden muss" aria-label="<%= betDisputes %> strittige Wetten"><%= betDisputes > 99 ? '99+' : betDisputes %></span><% } %><% if (tradeAlerts) { %><span class="nav-badge nav-badge-suspicious" title="Handel zwischen Mehrfach-Konten" aria-label="<%= tradeAlerts %> Geschäfte zwischen Mehrfach-Konten"><%= tradeAlerts > 99 ? '99+' : tradeAlerts %></span><% } %><% if (deviceAlerts) { %><span class="nav-badge nav-badge-device" title="Konten, die dasselbe Gerät benutzen" aria-label="<%= deviceAlerts %> Hinweise auf Mehrfach-Konten"><%= deviceAlerts > 99 ? '99+' : deviceAlerts %></span><% } %><% if (packLogNew) { %><span class="nav-badge" title="Neue Vergaben und entfernte Karten (Vergabe-Log)" aria-label="<%= packLogNew %> neue Einträge im Vergabe-Log"><%= packLogNew > 99 ? '99+' : packLogNew %></span><% } %></span><% } %></a>
        <% } %>
        <div class="nav-user">
          <% if (currentUser) { %>
            <%# Profil-Menü: Klick auf Name, Kontostand oder Bild klappt es auf (schließt bei Klick daneben, siehe app.js) %>
            <details class="user-menu" data-user-menu>
              <summary class="balance-chip" title="Mein Konto" data-live="balance">
                <span class="balance-text">
                  <span class="balance-name"><%= currentUser.username %></span>
                  <strong><%= euro(currentUser.balance) %></strong>
                </span>
                <%# Platzhalter für das Profilbild (noch nicht änderbar) %>
                <img class="avatar" src="/img/avatar-placeholder.svg?v=<%= assetVersion %>" alt="" width="34" height="34">
              </summary>
              <div class="user-menu-list" role="menu">
                <a role="menuitem" href="/profil/<%= encodeURIComponent(currentUser.username) %>">Profil ansehen</a>
                <a role="menuitem" href="/konto">Statistiken</a>
                <a role="menuitem" href="/konto/wetten">Meine Wetten</a>
                <a role="menuitem" href="/konto/auszug">Kontoauszug</a>
                <a role="menuitem" href="/konto/gruppen">Wett-Gruppen</a>
                <a role="menuitem" href="/konto/einstellungen">Konto-Einstellungen</a>
                <form method="post" action="/abmelden">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button role="menuitem" type="submit">Abmelden</button>
                </form>
              </div>
            </details>
            <%# Im aufgeklappten Hamburger-Menü (schmale Bildschirme) stehen die Konto-Punkte direkt in der Liste –
                ohne zweites Aufklappmenü: erst die Links, dann Name/Kontostand/Bild, ganz unten "Abmelden" %>
            <div class="nav-account">
              <a href="/profil/<%= encodeURIComponent(currentUser.username) %>" class="<%= currentPath.toLowerCase() === '/profil/' + encodeURIComponent(currentUser.username).toLowerCase() ? 'active' : '' %>">Profil ansehen</a>
              <a href="/konto" class="<%= currentPath === '/konto' ? 'active' : '' %>">Statistiken</a>
              <a href="/konto/wetten" class="<%= currentPath === '/konto/wetten' ? 'active' : '' %>">Meine Wetten</a>
              <a href="/konto/auszug" class="<%= currentPath === '/konto/auszug' ? 'active' : '' %>">Kontoauszug</a>
              <a href="/konto/gruppen" class="<%= currentPath === '/konto/gruppen' ? 'active' : '' %>">Wett-Gruppen</a>
              <a href="/konto/einstellungen" class="<%= currentPath === '/konto/einstellungen' ? 'active' : '' %>">Konto-Einstellungen</a>
              <div class="nav-account-who" data-live="balance-mobile">
                <img class="avatar" src="/img/avatar-placeholder.svg?v=<%= assetVersion %>" alt="" width="34" height="34">
                <span class="balance-text">
                  <span class="balance-name"><%= currentUser.username %></span>
                  <strong><%= euro(currentUser.balance) %></strong>
                </span>
              </div>
              <form method="post" action="/abmelden">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-ghost btn-block" type="submit">Abmelden</button>
              </form>
            </div>
          <% } else { %>
            <a class="btn btn-ghost btn-sm" href="/anmelden">Anmelden</a>
            <a class="btn btn-primary btn-sm" href="/registrieren">Registrieren</a>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <main id="inhalt" class="container">
    <div data-flash-area>
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status">
        <span><%= flash.message %></span>
        <button type="button" class="flash-close" aria-label="Hinweis schließen">×</button>
      </div>
    <% } %>
    </div>
