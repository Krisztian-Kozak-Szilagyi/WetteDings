<%#
  Vorschaubild(er) eines Angebots: a = angebotene Karte, b = Wunschkarte bei einem Tausch.
  Jedes Bild ist ein Knopf, der die Karte groß zeigt (Zoom-Dialog auf /handel, public/js/handel.js).
%>
<%
  const ownCounts = locals.coll ? coll.counts : locals.ownedCounts || {};
  const owned = (c) => ownCounts[c.id] || 0;
  const thumb = (c) => { const r = rarityByKey[c.rarity] || { label: '', sell: 0 }; %>
    <button type="button" class="trade-thumb r-<%= c.rarity %>" data-zoom-card
      data-image="<%= c.image %>" data-name="<%= c.name %>" data-rarity="<%= c.rarity %>" data-rarity-label="<%= r.label %>"
      data-sell-text="<%= euro(r.sell || 0) %>" data-owned="<%= owned(c) %>" aria-label="<%= c.name %>, <%= r.label %> – vergrößern">
      <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008">
    </button>
<% }; %>
<% if (locals.b) { %>
  <div class="trade-thumbs">
    <% thumb(a) %>
    <svg class="trade-swap-icon" viewBox="0 0 24 24" width="16" height="16" aria-label="gegen"><path fill="currentColor" d="M7 7h11l-3-3 1.4-1.4L21.8 8l-5.4 5.4L15 12l3-3H7V7Zm10 10H6l3 3-1.4 1.4L2.2 16l5.4-5.4L9 12l-3 3h11v2Z"/></svg>
    <% thumb(b) %>
  </div>
<% } else { %>
  <% thumb(a) %>
<% } %>
