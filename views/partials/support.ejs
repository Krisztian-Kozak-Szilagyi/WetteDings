<div class="support" data-support data-csrf="<%= csrfToken %>" data-name="<%= currentUser.username %>">
  <button type="button" class="support-fab" data-support-toggle aria-expanded="false" aria-controls="support-panel" aria-label="Support-Chat öffnen">
    <span class="support-fab-avatar" aria-hidden="true">WB<span class="support-fab-dot"></span></span>
    <span class="support-fab-text" aria-hidden="true"><strong>Support</strong><small>Warren hilft dir</small></span>
  </button>
  <section class="support-panel" id="support-panel" data-support-panel hidden aria-label="Support-Chat mit Warren Buffett">
    <header class="support-head">
      <span class="support-avatar" aria-hidden="true">WB</span>
      <div class="support-title">
        <strong>Warren Buffett</strong>
        <span>Support-Bot · Fragen zu <%= appName %></span>
      </div>
      <button type="button" class="support-icon-btn" data-support-reset title="Neues Gespräch" aria-label="Neues Gespräch">↺</button>
      <button type="button" class="support-icon-btn" data-support-close aria-label="Chat schließen">×</button>
    </header>
    <div class="support-log" data-support-log aria-live="polite"></div>
    <form class="support-form" data-support-form>
      <textarea name="message" rows="1" maxlength="500" placeholder="Frag mich etwas zur Seite …" aria-label="Deine Frage" required></textarea>
      <button type="submit" class="btn btn-primary btn-sm" aria-label="Senden">Senden</button>
    </form>
    <p class="support-note">KI-Antworten können Fehler enthalten. Bitte keine persönlichen Daten eingeben.</p>
  </section>
</div>
<script src="/js/support.js?v=<%= assetVersion %>" defer></script>
