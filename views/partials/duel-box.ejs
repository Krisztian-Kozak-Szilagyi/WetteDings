<%
  // Duell-Kasten auf der Wett-Seite: wer gegen wen, Einsatz, Zusagen – und für die Beteiligten Annehmen/Ablehnen
  const d = bet.duel;
  const pending = d.state === 'angefragt' && bet.status === 'offen';
  const mustAnswer = pending && ((duelRole === 'opponent' && !d.opponentAcceptedAt) || (duelRole === 'referee' && !d.refereeAcceptedAt));
%>
<div class="duel-box" id="duell">
  <div class="duel-vs">
    <span class="duel-name"><%- userLink(bet.creatorName) %></span>
    <span class="duel-sep">VS</span>
    <span class="duel-name"><%- userLink(d.opponentName) %></span>
  </div>
  <p class="duel-line">Einsatz: <strong><%= euro(d.stake) %></strong> pro Person · Schiedsrichter <strong><%- userLink(bet.refereeName) %></strong></p>
  <% if (pending) { %>
    <ul class="duel-steps">
      <li class="<%= d.opponentAcceptedAt ? 'is-done' : '' %>"><%= d.opponentName %>: <%= d.opponentAcceptedAt ? 'angenommen ✓' : 'Antwort steht aus' %></li>
      <li class="<%= d.refereeAcceptedAt ? 'is-done' : '' %>">Schiedsrichter <%= bet.refereeName %>: <%= d.refereeAcceptedAt ? 'zugesagt ✓' : 'Antwort steht aus' %></li>
    </ul>
    <p class="muted small">Annehmen bis <%= date(d.expiresAt) %> – sonst bekommt <%= bet.creatorName %> den Einsatz zurück. Bis dahin sehen nur die drei Beteiligten dieses Duell.</p>
    <% if (mustAnswer) { %>
      <div class="duel-actions">
        <form method="post" action="/wetten/<%= bet._id %>/duell/annehmen" data-confirm="<%= duelRole === 'opponent' ? 'Herausforderung annehmen? Dein Einsatz von ' + euro(d.stake) + ' wird sofort abgebucht.' : 'Als Schiedsrichter zusagen? Du entscheidest dann allein, wer gewinnt.' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary" type="submit" <%= duelRole === 'opponent' && currentUser.balance < d.stake ? 'disabled title="Guthaben reicht nicht"' : '' %>><%= duelRole === 'opponent' ? 'Annehmen (' + euro(d.stake) + ')' : 'Als Schiedsrichter zusagen' %></button>
        </form>
        <form method="post" action="/wetten/<%= bet._id %>/duell/absagen" data-confirm="Wirklich ablehnen? Das Duell findet dann nicht statt.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-ghost" type="submit">Ablehnen</button>
        </form>
      </div>
    <% } else if (duelRole === 'challenger') { %>
      <form method="post" action="/wetten/<%= bet._id %>/duell/absagen" class="duel-actions" data-confirm="Herausforderung zurückziehen? Du bekommst deinen Einsatz zurück.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-ghost" type="submit">Herausforderung zurückziehen</button>
      </form>
    <% } %>
  <% } %>
  <% if (d.state === 'aktiv') { %>
    <div class="duel-tip-area">
      <p class="duel-tip-head">Tipps der Zuschauer <span class="muted small">(ohne Einsatz)</span></p>
      <%- include('duel-tips', { bet, big: true }) %>
      <% if (locals.canTip) { %>
        <form method="post" action="/wetten/<%= bet._id %>/duell/tipp" class="duel-tip-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% [['o1', bet.creatorName], ['o2', d.opponentName]].forEach(([k, name]) => { %>
            <button class="btn btn-sm btn-opt <%= optClass(bet, k) %><%= locals.myTip === k ? ' is-picked' : '' %>" type="submit" name="side" value="<%= k %>" <%= locals.myTip === k ? 'disabled' : '' %>><%= locals.myTip === k ? 'Dein Tipp: ' : 'Ich tippe auf ' %><%= name %></button>
          <% }) %>
        </form>
      <% } else if (locals.myTip) { %>
        <p class="muted small">Dein Tipp: <%= locals.myTip === 'o1' ? bet.creatorName : d.opponentName %></p>
      <% } %>
    </div>
  <% } %>
</div>
