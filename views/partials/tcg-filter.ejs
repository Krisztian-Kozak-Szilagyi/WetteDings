<%# Seltenheits-Filter für das Kartenraster in derselben .card (public/js/tcg.js); Zahl = eigene / alle Karten der Seltenheit %>
<%
  const fOwned = (list) => list.filter((c) => counts[c.id]).length;
  const fVisible = cards.filter((c) => !(rarityByKey[c.rarity] || {}).hidden || counts[c.id]);
%>
<div class="tcg-filter" role="tablist" aria-label="Nach Seltenheit filtern">
  <button type="button" class="chip active" data-tcg-filter="all" role="tab" aria-selected="true"><span class="tcg-dot tcg-dot-all"></span>Alle<span class="chip-count"><%= fOwned(fVisible) %>/<%= fVisible.length %></span></button>
  <% rarities.forEach((r) => { const list = cards.filter((c) => c.rarity === r.key); %>
    <button type="button" class="chip r-<%= r.key %>" data-tcg-filter="<%= r.key %>" role="tab" aria-selected="false"><span class="tcg-dot"></span><%= r.label %><span class="chip-count"><%= fOwned(list) %>/<%= list.length %></span></button>
  <% }) %>
</div>
