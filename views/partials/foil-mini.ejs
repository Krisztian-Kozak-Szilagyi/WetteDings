<%# Kleine folierte Karte (Vorderseite mit Grading-Etikett, immer Note 10): card, rarityLabel %>
<span class="foil-inner">
  <span class="foil-face foil-front">
    <img src="<%= card.image %>" alt="" loading="lazy" width="720" height="1008">
    <span class="foil-sheen" aria-hidden="true"></span>
    <span class="foil-ticket"><span class="gr-slab-info"><strong>BfW GRADING</strong><span><%= card.name %> · <%= rarityLabel %></span><span class="gr-slab-word">GEM MINT</span></span><span class="gr-slab-grade">10</span></span>
  </span>
</span>
