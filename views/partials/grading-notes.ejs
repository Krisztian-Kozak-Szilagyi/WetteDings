<%# Notizzettel neben der Werkbank (public/js/grading-notes.js): Mängel beim Untersuchen abhaken und daraus die Note
    ausrechnen – wie im Ablauf beim Benoten (src/grading/condition.js): Obergrenze (Knick, Zentrierung) minus 1 je Mangel.
    Nur, was man selbst einträgt; der Zettel weiß nichts über die Karte. Bleibt beim Neuladen erhalten (je Auftrag). %>
<aside class="gr-notes" data-gr-notes data-job="<%= jobData.id %>" aria-label="Notizzettel für die Benotung">
  <div class="gr-notes-paper">
    <span class="gr-notes-tape" aria-hidden="true"></span>
    <div class="gr-notes-head">
      <h2>Notizen</h2>
      <span class="gr-notes-card"><%= jobData.card ? jobData.card.name + ' · ' + jobData.card.rarityLabel : 'Karte' %></span>
    </div>

    <section class="gr-notes-sec">
      <h3>① Obergrenze <small>der niedrigste Wert zählt</small></h3>
      <fieldset class="gr-notes-field">
        <legend>Knick</legend>
        <label class="gr-notes-check"><input type="radio" name="gn-crease" value="none" checked> kein Knick</label>
        <label class="gr-notes-check"><input type="radio" name="gn-crease" value="4"> Knick → <b>4</b></label>
        <label class="gr-notes-check"><input type="radio" name="gn-crease" value="ironed"> gebügelt → <b data-gn-ironed-cap>4</b></label>
        <%# Hilfe für gebügelte Knicke: Stücke abzählen statt schätzen (src/grading/condition.js: ironCap) %>
        <div class="gr-notes-iron" data-gn-ironhelp>
          <span class="gr-notes-iron-q">Wie viele der 10 Knick-Stücke sind glatt?</span>
          <div class="gr-notes-pieces" role="group" aria-label="Glatte Knick-Stücke">
            <% for (let i = 1; i <= 10; i++) { %><button type="button" class="gr-notes-piece" data-gn-piece="<%= i %>" aria-label="<%= i %> Stück<%= i === 1 ? '' : 'e' %> glatt" aria-pressed="false"></button><% } %>
          </div>
          <span class="gr-notes-iron-a"><b data-gn-pieces>0</b> glatt → Obergrenze <b data-gn-pieces-cap>4</b></span>
          <table class="gr-notes-iron-table">
            <caption>je 2 glatte Stücke = 1 Note mehr</caption>
            <tr><th>glatt</th><td>0–1</td><td>2–3</td><td>4–5</td><td>6–7</td><td>8–9</td><td>10</td></tr>
            <tr><th>max.</th><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td></tr>
          </table>
          <span class="gr-notes-iron-tip">Tipp: Karte flach ins Licht drehen und von links nach rechts zählen – glatte Stücke sind kaum noch zu sehen. Brandflecken auf dem Knick zählen als Kratzer.</span>
        </div>
      </fieldset>
      <fieldset class="gr-notes-field">
        <legend>Zentrierung <small>links/rechts</small></legend>
        <div class="gr-notes-center" role="radiogroup" aria-label="Zentrierung">
          <% centeringScale.forEach((c) => { %>
            <label class="gr-notes-pill" title="<%= c.fromLabel %> bis <%= c.toLabel %>"><input type="radio" name="gn-center" value="<%= c.cap %>" <%= c.cap === 10 ? 'checked' : '' %>><span><b><%= c.cap %></b><small><%= c.toLabel %></small></span></label>
          <% }) %>
        </div>
        <button type="button" class="gr-notes-link" data-gn-measure>📏 Messung übernehmen</button>
        <span class="gr-notes-measured" data-gn-measured aria-live="polite"></span>
      </fieldset>
    </section>

    <section class="gr-notes-sec">
      <h3>② Mängel <small>je −1</small></h3>
      <div class="gr-notes-count">
        <span>Kratzer</span>
        <button type="button" class="gr-notes-btn" data-gn-dec="scratches" aria-label="Einen Kratzer weniger">−</button>
        <b data-gn-val="scratches">0</b>
        <button type="button" class="gr-notes-btn" data-gn-inc="scratches" aria-label="Einen Kratzer mehr">+</button>
      </div>
      <div class="gr-notes-corners">
        <span>Bestoßene Ecken</span>
        <div class="gr-notes-mini" role="group" aria-label="Ecken der Karte">
          <% [['tl', 'oben links'], ['tr', 'oben rechts'], ['bl', 'unten links'], ['br', 'unten rechts']].forEach(([k, label]) => { %>
            <label class="gr-notes-corner gr-notes-corner-<%= k %>" title="Ecke <%= label %>"><input type="checkbox" data-gn-corner="<%= k %>" aria-label="Ecke <%= label %> bestoßen"><span></span></label>
          <% }) %>
        </div>
      </div>
      <div class="gr-notes-count">
        <span>Kantenmacken</span>
        <button type="button" class="gr-notes-btn" data-gn-dec="edges" aria-label="Eine Kantenmacke weniger">−</button>
        <b data-gn-val="edges">0</b>
        <button type="button" class="gr-notes-btn" data-gn-inc="edges" aria-label="Eine Kantenmacke mehr">+</button>
      </div>
    </section>

    <label class="gr-notes-free">
      <span>Sonstiges</span>
      <textarea data-gn-text rows="2" maxlength="300" placeholder="z. B. Kratzer oben rechts – nochmal im Licht prüfen"></textarea>
    </label>

    <div class="gr-notes-sum" aria-live="polite">
      <span data-gn-calc>Obergrenze 10 − 0 Mängel</span>
      <strong>= Note <span data-gn-grade>10</span></strong>
    </div>
    <div class="gr-notes-actions">
      <button type="button" class="btn btn-primary btn-sm" data-gn-pick>Note übernehmen</button>
      <button type="button" class="gr-notes-link" data-gn-reset>Zettel leeren</button>
    </div>
    <p class="gr-notes-hint" data-gn-hint>Übernehmen wählt die Note nur aus – abgegeben wird erst mit „Note abgeben“.</p>
  </div>
</aside>
