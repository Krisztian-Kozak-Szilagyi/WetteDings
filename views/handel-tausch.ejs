<%- include('partials/head') %>
<% const canOffer = mine.cardCount > 0 && theirs.cardCount > 0; %>
<%
  // Mehrfach-Tausch (#76): je Seite 1–maxCards Karten; counter = Gegenvorschlag in einer laufenden Verhandlung
  const foilPick = (f, name, sel) => { %>
    <label class="tcg-slot tcg-pick r-<%= f.card.rarity %>" data-rarity="<%= f.card.rarity %>" data-name="<%= f.card.name %>" title="Foliert am <%= dayDate(f.foiledAt) %> · Wert <%= euro(f.value) %>">
      <input type="checkbox" name="<%= name %>" value="f:<%= f.id %>" <%= sel.foils.has('f:' + f.id) ? 'checked' : '' %> aria-label="<%= f.card.name %>, <%= f.rarity.label %>, foliert am <%= dayDate(f.foiledAt) %>">
      <span class="tcg-art"><img src="<%= f.card.image %>" alt="" loading="lazy" width="720" height="1008"><span class="foil-sheen" aria-hidden="true"></span></span>
      <span class="tcg-slot-label"><span class="foil-tag">Foliert · <%= dayDate(f.foiledAt) %></span></span>
    </label>
<% }; %>

<p><a class="btn btn-ghost btn-sm" href="<%= backUrl %>">← <%= counter ? 'Zurück zur Verhandlung' : pickCard ? 'Anderes Mitglied wählen' : 'Zurück zum Profil' %></a></p>

<div class="page-head">
  <div class="ihk-title">
    <h1><%= counter ? 'Gegenvorschlag an' : 'Tausch mit' %> <%= partner.username %></h1>
  </div>
  <span class="muted">Wähle je Seite 1 bis <%= maxCards %> Karten – z. B. drei Karten gegen eine.</span>
</div>

<form method="post" action="<%= counter ? '/handel/verhandlung/' + counter.id + '/karten' : '/handel/tausch' %>" class="trade-swap-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (counter) { %>
    <input type="hidden" name="version" value="<%= counter.version %>">
  <% } else { %>
    <input type="hidden" name="to" value="<%= partner.username %>">
  <% } %>

  <div class="trade-swap-grids">
    <div class="card">
      <div class="tcg-coll-head">
        <h2>1. Deine Karten</h2>
        <%- include('partials/tcg-filter', { counts: mine.counts, barName: 'tausch-mine' }) %>
      </div>
      <% if (!mine.cardCount) { %>
        <p class="muted">Du hast noch keine Karten zum Tauschen.</p>
      <% } else { %>
        <%- include('partials/tcg-grid', { mode: 'pick', pickName: 'card', pickCounts: mySel.counts, pickMax: maxCards, showMissing: false, counts: mine.counts, lockedByCard: mine.lockedByCard, foiledByCard: mine.foiledByCard }) %>
      <% if (myFoiled.length) { %>
        <h3 class="trade-foil-head">Folierte Karten</h3>
        <div class="tcg-grid tcg-pick-grid">
          <% myFoiled.forEach((f) => { foilPick(f, 'card', mySel); }) %>
        </div>
      <% } %>
      <% } %>
    </div>

    <div class="card">
      <div class="tcg-coll-head">
        <h2>2. Karten von <%= partner.username %></h2>
        <%- include('partials/tcg-filter', { counts: theirs.counts, barName: 'tausch-theirs' }) %>
      </div>
      <% if (!theirs.cardCount) { %>
        <p class="muted"><%= partner.username %> hat noch keine Karten.</p>
      <% } else { %>
        <p class="muted small">Gesperrte Karten kannst du trotzdem wählen. Angenommen werden kann erst, wenn alle Karten frei sind.</p>
        <%- include('partials/tcg-grid', { mode: 'pick', pickName: 'want', pickCounts: theirSel.counts, pickMax: maxCards, showMissing: false, counts: Object.fromEntries(Object.entries(theirs.counts).map(([k, n]) => [k, n - (theirs.foiledByCard[k] || 0)])), lockedByCard: {} }) %>
      <% if (theirFoiled.length) { %>
        <h3 class="trade-foil-head">Folierte Karten von <%= partner.username %></h3>
        <div class="tcg-grid tcg-pick-grid">
          <% theirFoiled.forEach((f) => { foilPick(f, 'want', theirSel); }) %>
        </div>
      <% } %>
      <% } %>
    </div>
  </div>

  <div class="card card-accent trade-swap-submit">
    <h2>3. Aufpreis (optional)</h2>
    <div class="trade-swap-extra">
      <label class="field">
        <span>Aufpreis in €</span>
        <input type="text" name="price" inputmode="decimal" placeholder="0" value="<%= pickPrice %>">
      </label>
      <fieldset class="field trade-extra-from">
        <legend>Wer zahlt den Aufpreis?</legend>
        <label><input type="radio" name="extra" value="ich" <%= pickFrom !== 'partner' ? 'checked' : '' %>> Ich lege drauf</label>
        <label><input type="radio" name="extra" value="partner" <%= pickFrom === 'partner' ? 'checked' : '' %>> <%= partner.username %> legt drauf</label>
      </fieldset>
    </div>
    <% if (!counter) { %>
      <label class="field trade-swap-message">
        <span>Nachricht an <%= partner.username %> (optional)</span>
        <textarea name="message" rows="2" maxlength="500" placeholder="z. B. warum der Tausch für beide passt"></textarea>
      </label>
    <% } %>
    <p class="muted small"><%= counter ? 'Danach ist ' + partner.username + ' am Zug und kann annehmen oder wieder einen Vorschlag machen. Das Angebot läuft dann wieder ' + privateHours + ' Std.' : 'Nach dem Senden könnt ihr auf der Verhandlungsseite schreiben und Karten oder Aufpreis per Gegenvorschlag ändern, bis eine Seite annimmt. Das Angebot gilt ' + privateHours + ' Std.' %> Die Karten werden erst beim Annehmen geprüft – dann müssen alle frei sein. <% if (taxPercent > 0) { %>Auf den Aufpreis fallen <%= String(taxPercent).replace('.', ',') %> % Steuer an, die der Empfänger des Geldes trägt.<% } %></p>
    <button class="btn btn-primary" type="submit" <%= canOffer ? '' : 'disabled' %>><%= counter ? 'Vorschlag senden' : 'Tauschangebot senden' %></button>
  </div>
</form>

<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
