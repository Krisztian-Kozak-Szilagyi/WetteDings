<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · <%= appName %></title>
  <meta name="theme-color" content="#0d0b14">
  <link rel="icon" href="/favicon.svg?v=<%= assetVersion %>" type="image/svg+xml">
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/bossfight.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/raid.css?v=<%= assetVersion %>">
</head>
<%# Raid „The Gambit of Shadows“ gegen Lucky Dio – Vollbild wie der Bosskampf (views/bossfight.ejs): die Stadt bei Nacht als Hintergrund, Dio als Figur
    (public/js/raid-boss.js), darüber dieselbe Oberfläche (public/js/bossfight-hud.js im Raid-Modus: Züge gehen an den Server).
    Esc = zurück zur Raid-Seite %>
<body class="bf-body raid-body" data-raid="1" data-csrf="<%= csrfToken %>">
  <div class="bf-stage raid-stage">
    <div class="raid-boss" data-raid-boss>
      <img src="/img/raid/lucky-dio.webp?v=<%= assetVersion %>" alt="Lucky Dio mit Handarmbrust und Dolch" width="720" height="1008" draggable="false">
    </div>
  </div>

  <div class="bf-hud">
    <section class="bf-boss" aria-label="Boss">
      <div class="bf-boss-name">Lucky Dio</div>
      <div class="bf-hp bf-hp-boss" data-bf-hp="boss" data-max="<%= bossHp %>">
        <span class="bf-hp-lag"></span><span class="bf-hp-fill"></span>
        <span class="bf-hp-text"></span>
      </div>
      <%# Ankündigung: was Dio als Nächstes tut (Regeln: public/js/bossfight-regeln.js, Werte: Admin-Panel → Raid) %>
      <div class="bf-intent" data-bf-intent aria-live="polite"></div>
    </section>

    <section class="bf-player" aria-label="Spieler">
      <div class="bf-effects" data-bf-effects aria-label="Laufende Effekte"></div>
      <img class="bf-avatar" src="<%= avatarUrl(currentUser) %>?v=<%= assetVersion %>" alt="" width="84" height="84">
      <div class="bf-player-name"><%= currentUser.username %></div>
      <div class="bf-hp bf-hp-player" data-bf-hp="player" data-max="<%= spielerHp %>">
        <span class="bf-hp-lag"></span><span class="bf-hp-fill"></span>
        <span class="bf-hp-text"></span>
      </div>
    </section>
    <section class="bf-gear" data-bf-gear aria-label="Ausrüstung"></section>
    <%# Spielfeld: permanente Karten bleiben hier liegen, bis sie zerstört werden (public/js/bossfight-regeln.js) %>
    <section class="bf-feld" data-bf-feld data-leer aria-label="Spielfeld"></section>

    <section class="bf-turn">
      <span class="bf-round" data-bf-round>Runde 1</span>
      <span class="bf-energy" data-bf-energy title="Energie für deine Karten, jede Runde wieder voll"></span>
      <button type="button" class="bf-end" data-bf-end>Runde beenden</button>
    </section>

    <%# Exil: Karten, die das Spielfeld verlassen haben (aus dem Spiel genommen) %>
    <section class="bf-exil" data-bf-exil data-leer aria-label="Exil">
      <img alt="" draggable="false" hidden>
      <span class="bf-exil-name">Exil</span>
      <span class="bf-deck-count" data-bf-exil-count>0</span>
    </section>

    <section class="bf-deck" data-bf-deck aria-label="Deck">
      <span class="bf-deck-card"></span><span class="bf-deck-card"></span><span class="bf-deck-card"></span>
      <span class="bf-deck-count" data-bf-deck-count></span>
    </section>

    <div class="bf-hand" data-bf-hand></div>
    <div class="bf-result" data-bf-result hidden></div>

    <%# Aufgeben: zweimal klicken (ohne Browser-Dialog), zählt als Niederlage %>
    <form method="post" action="/raid/aufgeben" class="raid-quit" data-raid-quit>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="raid-quit-btn">Aufgeben</button>
    </form>
  </div>

  <script src="/js/raid-boss.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/bossfight-fx.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/bossfight-regeln.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/bossfight-hud.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
