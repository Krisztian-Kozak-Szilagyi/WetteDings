<%- include('partials/head') %>
<%
  // mode: 'neu' (Markt oder Mitglied), 'markt' (Gegenangebot auf ein Markt-Angebot), 'gegen' (Gegenangebot in einer Verhandlung)
  const isMarket = mode === 'neu' && !partner; // eigenes Markt-Angebot: nur Karten gegen einen Preis
  const pctText = (p) => String(p).replace('.', ',') + ' %';
  const money = (c) => (c ? (c / 100).toFixed(2).replace('.', ',') : '');
  const action = mode === 'gegen' ? '/handel/angebot/' + offer._id + '/gegenangebot' : '/handel/angebot';
  const backUrl = mode === 'gegen' ? '/handel/angebot/' + offer._id : '/handel' + (mode === 'markt' ? '?reiter=markt' : '');
  const title = mode === 'gegen' ? 'Gegenangebot' : mode === 'markt' ? 'Angebot machen' : 'Neuer Handel';
  // eigene folierte Exemplare der Vorauswahl – gehen beim Wechsel des Ziels mit
  const presetCopies = [...give.copies].map((id) => 'f:' + id);
  const poolSize = (pool) => (pool ? pool.cards.length + pool.foiled.length + pool.goods.length : 0);
  const showTheirs = !fixedGets; // auf dem Markt: Wunschkarten aus allen Karten
  const showMine = !fixedGives;
  const swapIcon = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 7h11l-3-3 1.4-1.4L21.8 8l-5.4 5.4L15 12l3-3H7V7Zm10 10H6l3 3-1.4 1.4L2.2 16l5.4-5.4L9 12l-3 3h11v2Z"/></svg>';
%>

<div class="hb" data-hb data-mode="<%= mode %>" data-market="<%= isMarket ? 1 : 0 %>" data-balance="<%= balance %>"
  data-tax-markt="<%= taxRates.markt %>" data-tax-privat="<%= taxRates.privat %>" data-tax-tausch="<%= taxRates.tausch %>" data-listing="<%= mode === 'markt' || (offer && offer.listing) ? 1 : 0 %>" data-max-lines="<%= maxLines %>">

  <header class="hb-top">
    <a class="hb-back" href="<%= backUrl %>">← <%= mode === 'gegen' ? 'Zur Verhandlung' : 'Handel' %></a>
    <h1><%= title %><% if (partner && mode !== 'neu') { %> <span class="hb-top-partner">an <%= partner.username %></span><% } %></h1>
    <p class="muted">
      <% if (mode === 'neu') { %>Verkaufen, tauschen oder Karten suchen – auf dem Markt für alle oder direkt mit einem Mitglied, auch mehrere Karten auf einmal.<% } %>
      <% if (mode === 'markt') { %>Zum Markt-Angebot von <%= partner.username %> (<%= euro(listing.price) %>): anderer Preis, eigene Karten oder beides.<% } %>
      <% if (mode === 'gegen') { %>Ändere, was beide Seiten geben. Danach ist <%= partner.username %> am Zug.<% } %>
    </p>
  </header>

  <% if (mode === 'neu') { %>
    <%# Wohin geht das Angebot? Ein Wechsel lädt die Seite mit der Sammlung des Mitglieds (die eigene Auswahl bleibt) %>
    <form method="get" action="/handel/neu" class="hb-target" data-hb-target>
      <div class="hb-seg" role="radiogroup" aria-label="Wohin geht das Angebot?">
        <a class="hb-seg-opt<%= isMarket ? ' active' : '' %>" href="/handel/neu" role="radio" aria-checked="<%= isMarket %>" data-hb-to-market>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 4h16l-1.5 6.5A3 3 0 0 1 15.6 13H8.4a3 3 0 0 1-2.9-2.5L4 4Zm2.5 2 1 4.1c.1.5.5.9 1 .9h7.1c.5 0 .9-.4 1-.9l1-4.1H6.5ZM6 15h12v2H6v-2Zm1 3h10v2H7v-2Z"/></svg>
          <span><strong>Markt</strong><small>für alle · <%= marketDays %> Tage</small></span>
        </a>
        <label class="hb-seg-opt hb-seg-member<%= isMarket ? '' : ' active' %>" role="radio" aria-checked="<%= !isMarket %>">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-3.3 0-8 1.7-8 5v1h16v-1c0-3.3-4.7-5-8-5Z"/></svg>
          <input type="text" name="an" list="hb-users" autocomplete="off" maxlength="30" placeholder="An ein Mitglied …" value="<%= partner ? partner.username : '' %>" aria-label="Mitglied">
          <button class="hb-seg-go" type="submit" aria-label="Mitglied wählen">→</button>
        </label>
      </div>
      <% Object.entries(give.counts).forEach(([id, n]) => { for (let i = 0; i < n; i++) { %><input type="hidden" name="gib" value="<%= id %>" data-hb-carry><% } }) %>
      <% presetCopies.forEach((v) => { %><input type="hidden" name="gib" value="<%= v %>" data-hb-carry><% }) %>
      <datalist id="hb-users"><% users.forEach((u) => { %><option value="<%= u.username %>"><% }) %></datalist>
    </form>
  <% } %>

  <form method="post" action="<%= action %>" class="hb-form" data-hb-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (mode === 'neu' && partner) { %><input type="hidden" name="to" value="<%= partner.username %>"><% } %>
    <% if (mode === 'markt') { %><input type="hidden" name="markt" value="<%= listing._id %>"><% } %>
    <% if (mode === 'gegen') { %><input type="hidden" name="version" value="<%= offer.termsVersion || 0 %>"><% } %>

    <%# ---------- Das Handelsfenster: beide Seiten im Überblick ---------- %>
    <section class="hb-window" aria-label="Dein Angebot">
      <div class="hb-side" data-hb-side-box="gib">
        <button type="button" class="hb-side-head" data-hb-open="gib" <%= showMine ? '' : 'disabled' %>>
          <span class="hb-side-label">Du gibst</span>
          <span class="hb-side-value" data-hb-sum="gib"></span>
        </button>
        <% if (fixedGives) { %>
          <div class="hb-fixed" data-hb-fixed="gib" data-value="<%= linesValue(fixedGives) %>" data-count="<%= fixedGives.length %>">
            <%- include('partials/trade-stack', { list: fixedGives, size: 'sm', ownedCounts: mine.counts }) %>
            <span><strong><%= lineLabel(fixedGives) %></strong><small class="muted">dein Markt-Angebot, steht fest</small></span>
          </div>
        <% } else { %>
          <ul class="hb-tray" data-hb-tray="gib" aria-live="polite"><li class="hb-tray-empty">Tippe unten Karten aus deiner Sammlung an.</li></ul>
        <% } %>
        <label class="hb-money"><span>+ Geld</span><input type="text" name="geld_gib" inputmode="decimal" placeholder="0,00" value="<%= money(pay) %>" data-hb-money="gib" aria-label="Geld, das du zahlst"><span class="hb-money-unit">€</span></label>
      </div>

      <div class="hb-swap">
        <span class="hb-swap-icon"><%- swapIcon %></span>
        <span class="hb-balance" data-hb-balance hidden></span>
      </div>

      <div class="hb-side hb-side-get" data-hb-side-box="will">
        <% if (isMarket) { %>
          <button type="button" class="hb-side-head" data-hb-open="will">
            <span class="hb-side-label">Du bekommst<span class="hb-side-from"> von wem auch immer</span></span>
            <span class="hb-side-value" data-hb-sum="will"></span>
          </button>
          <label class="hb-price">
            <span class="sr-only">Preis</span>
            <input type="text" name="geld_will" inputmode="decimal" placeholder="Preis" value="<%= money(receive) %>" data-hb-money="will"><span class="hb-money-unit">€</span>
          </label>
          <ul class="hb-tray hb-tray-wish" data-hb-tray="will" aria-live="polite"><li class="hb-tray-empty">Oder statt Geld: Wunschkarten unten im Reiter „Wunschkarten“ – dann wird getauscht.</li></ul>
          <p class="hb-price-note muted small">Jeder kann sofort annehmen oder dir ein Gegenangebot machen.</p>
        <% } else { %>
          <button type="button" class="hb-side-head" data-hb-open="will" <%= showTheirs ? '' : 'disabled' %>>
            <span class="hb-side-label">Du bekommst<span class="hb-side-from"> von <%= partner.username %></span></span>
            <span class="hb-side-value" data-hb-sum="will"></span>
          </button>
          <% if (fixedGets) { %>
            <div class="hb-fixed" data-hb-fixed="will" data-value="<%= linesValue(fixedGets) %>" data-count="<%= fixedGets.length %>">
              <%- include('partials/trade-stack', { list: fixedGets, size: 'sm', ownedCounts: mine.counts }) %>
              <span><strong><%= lineLabel(fixedGets) %></strong><small class="muted">aus dem Markt-Angebot, steht fest</small></span>
            </div>
          <% } else { %>
            <ul class="hb-tray" data-hb-tray="will" aria-live="polite"><li class="hb-tray-empty">Wähle unten Karten aus der Sammlung von <%= partner.username %>.</li></ul>
          <% } %>
          <label class="hb-money"><span>+ Geld</span><input type="text" name="geld_will" inputmode="decimal" placeholder="0,00" value="<%= money(receive) %>" data-hb-money="will" aria-label="Geld, das <%= partner.username %> zahlt"><span class="hb-money-unit">€</span></label>
        <% } %>
      </div>
    </section>

    <%# ---------- Sammlungen: eine zur Zeit ---------- %>
    <section class="hb-browser">
      <% if (showMine && showTheirs) { %>
        <div class="hb-tabs" role="tablist" aria-label="Sammlung">
          <button type="button" class="hb-tab active" role="tab" aria-selected="true" data-hb-tab="gib">Deine Sammlung <span class="hb-tab-count"><%= poolSize(mine) %></span></button>
          <button type="button" class="hb-tab" role="tab" aria-selected="false" data-hb-tab="will"><%= isMarket ? 'Wunschkarten' : 'Sammlung von ' + partner.username %> <span class="hb-tab-count"><%= isMarket ? 'alle' : poolSize(theirs) %></span></button>
        </div>
      <% } else { %>
        <h2 class="hb-browser-title"><%= showMine ? 'Deine Sammlung' : 'Sammlung von ' + partner.username %></h2>
      <% } %>
      <% if (showMine) { %>
        <div class="hb-pane" data-hb-pane="gib" role="tabpanel">
          <%- include('partials/trade-picker', { side: 'gib', pool: mine, preset: give, own: true, partnerName: '' }) %>
        </div>
      <% } %>
      <% if (showTheirs) { %>
        <div class="hb-pane" data-hb-pane="will" role="tabpanel">
          <%- include('partials/trade-picker', { side: 'will', pool: theirs, preset: get, own: false, wish: isMarket, partnerName: partner ? partner.username : '' }) %>
        </div>
      <% } %>
    </section>

    <%# ---------- Zusammenfassung und Absenden ---------- %>
    <div class="hb-bar" data-hb-bar>
      <div class="hb-bar-summary">
        <span class="hb-bar-line" data-hb-summary><%= isMarket ? 'Wähle Karten und einen Preis.' : 'Wähle aus, was beide Seiten geben.' %></span>
        <span class="hb-bar-note" data-hb-note>
          <% if (isMarket) { %><%= marketDays %> Tage gültig · deine Karten sind bis dahin gesperrt.<% } else { %><%= privateHours %> Std. gültig · deine Karten sind bis dahin gesperrt.<% } %>
        </span>
      </div>
      <% if (!isMarket && mode !== 'gegen') { %>
        <label class="hb-message"><span class="sr-only">Nachricht an <%= partner.username %></span>
          <input type="text" name="nachricht" maxlength="500" placeholder="Nachricht an <%= partner.username %> (optional)" autocomplete="off">
        </label>
      <% } %>
      <button class="btn btn-primary hb-submit" type="submit" data-hb-submit><%= isMarket ? 'Auf den Markt stellen' : mode === 'gegen' ? 'Gegenangebot senden' : 'Angebot senden' %></button>
    </div>
  </form>
</div>

<%- include('partials/card-zoom') %>
<%- include('partials/foil-modal') %>
<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<script src="/js/handel.js?v=<%= assetVersion %>" defer></script>
<script src="/js/handel-neu.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
