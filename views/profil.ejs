<%- include('partials/head') %>
<% const decided = stats.won + stats.lost; %>

<div class="page-head">
  <div class="ihk-title">
    <h1><%= profile.username %><%- roleBadge(profile.username) %><%= isMe ? ' (du)' : '' %></h1>
    <a class="btn btn-ghost btn-sm" href="/rangliste">← Zur Rangliste</a>
  </div>
  <span class="muted">Mitglied seit <%= date(profile.createdAt) %></span>
</div>
<% if (ban) { %>
  <p class="ban-note"><%= ban.active ? (ban.forever ? 'Dauerhaft gesperrt' : 'Gesperrt bis ' + date(ban.until)) : 'War gesperrt bis ' + date(ban.until) %> · von <%= ban.by || '–' %> am <%= date(ban.at) %><%= ban.reason ? ' · Grund: ' + ban.reason : '' %></p>
<% } %>
<% if (canBan) { const back = '/profil/' + encodeURIComponent(profile.username); %>
  <details class="card fold" id="sperren">
    <summary><h2><%= ban && ban.active ? 'Sperre ändern' : 'Mitglied sperren' %></h2><span class="fold-arrow" aria-hidden="true"></span></summary>
    <p class="muted">Das Mitglied wird sofort abgemeldet und kann sich nicht mehr anmelden – auch nicht von seinen Geräten aus mit einem anderen Konto. Guthaben, Karten, Wetten und Angebote bleiben unverändert.</p>
    <form method="post" action="/admin/sperren" class="form admin-tcg-form" data-confirm="<%= profile.username %> und alle Geräte des Kontos wirklich sperren?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="user" value="<%= profile._id %>">
      <input type="hidden" name="zurueck" value="<%= back %>">
      <label class="field admin-tcg-pack">
        <span>Dauer</span>
        <select name="duration" required>
          <% banDurations.forEach((d) => { %><option value="<%= d.key %>" <%= d.key === '7' ? 'selected' : '' %>><%= d.label %></option><% }) %>
        </select>
      </label>
      <label class="field">
        <span>Grund <em>(freiwillig – steht danach im Profil und beim Anmeldeversuch)</em></span>
        <input type="text" name="reason" maxlength="200">
      </label>
      <button class="btn btn-danger" type="submit">Sperren</button>
    </form>
    <% if (ban) { %>
      <form method="post" action="/admin/sperren/<%= profile._id %>/aufheben" class="ban-lift" data-confirm="Sperre von <%= profile.username %> aufheben? Der Vermerk im Profil verschwindet dann auch.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="zurueck" value="<%= back %>">
        <button class="btn btn-ghost" type="submit"><%= ban.active ? 'Sperre aufheben' : 'Vermerk entfernen' %></button>
      </form>
    <% } %>
  </details>
<% } %>

<div class="stats stats-4">
  <div class="stat card"><span class="stat-label">Karten</span><span class="stat-value"><%= cardCount %></span></div>
  <div class="stat card"><span class="stat-label">Sammlung</span><span class="stat-value"><%= uniqueOwned %> / <%= totalCards %></span></div>
  <div class="stat card"><span class="stat-label">Wert der Karten</span><span class="stat-value"><%= euro(cardValue) %></span></div>
  <div class="stat card">
    <span class="stat-label">Wetten richtig</span>
    <span class="stat-value"><%= decided ? Math.round((stats.won / decided) * 100) + ' %' : '–' %></span>
    <span class="muted small"><%= stats.won %> gewonnen · <%= stats.lost %> verloren</span>
  </div>
</div>

<div class="card">
  <div class="tcg-coll-head">
    <h2>Favoriten</h2>
    <div class="profil-actions">
      <a class="btn btn-ghost btn-sm" href="/profil/<%= encodeURIComponent(profile.username) %>/sammlung">Sammlung ansehen</a>
      <% if (!isMe) { %><a class="btn btn-primary btn-sm" href="/handel/tausch?an=<%= encodeURIComponent(profile.username) %>">Tausch vorschlagen</a><% } %>
    </div>
  </div>
  <% if (!favorites.length) { %>
    <p class="muted"><%= isMe ? 'Du zeigst noch keine Favoriten. Wähle sie in deinem Album aus.' : profile.username + ' zeigt noch keine Favoriten.' %></p>
  <% } else { %>
    <div class="tcg-grid tcg-favs">
      <% favorites.forEach((c) => { const r = rarityByKey[c.rarity]; %>
        <button type="button" class="tcg-slot r-<%= c.rarity %>" data-zoom-card
          data-image="<%= c.image %>" data-name="<%= c.name %>" data-rarity="<%= c.rarity %>" data-rarity-label="<%= r.label %>"
          data-sell-text="<%= euro(r.sell || 0) %>" data-owned="<%= ownedCounts[c.id] || 0 %>" aria-label="<%= c.name %>, <%= r.label %> – vergrößern">
          <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008">
          <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
        </button>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/card-zoom') %>
<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<script src="/js/handel.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
