<%- include('partials/head') %>
<% const left = Math.max(0, limit - used); const canStart = phase === 'offer' && left && cards.length; %>

<div class="ihk-page">
<section class="ihk-hero">
  <div class="ihk-hero-text">
    <span class="kicker">IHK · Auftragsbrett</span>
    <h1>Quests</h1>
    <p class="ihk-hero-sub">Drei Aufträge, eine Karte, ein Boost – und die Frage, ob die Fachrichtung passt.</p>
  </div>
  <div class="ihk-hero-side">
    <div class="ihk-day">
      <% if (limit <= 12) { %>
        <span class="ihk-day-pips" aria-hidden="true"><% for (let i = 0; i < limit; i++) { %><span class="ihk-pip<%= i < used ? ' is-done' : '' %>"></span><% } %></span>
      <% } %>
      <span class="ihk-day-text">Heute <strong><%= used %> / <%= limit %></strong> Quests</span>
    </div>
    <a class="btn btn-ghost btn-sm" href="/ihk/anleitung">So funktioniert's</a>
  </div>
</section>
<% if (closedForOthers) { %><p class="muted small">Nur für Admins sichtbar – im Admin-Panel für alle freigeben.</p><% } %>

<%# Eigenes Formular außerhalb des Start-Formulars (keine verschachtelten Forms) – der Button verweist per form-Attribut darauf %>
<form id="ihk-reroll" method="post" action="/ihk/neu-wuerfeln" hidden>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<% if (canStart) { %>
<form method="post" action="/ihk/start" data-ihk-pick>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="card" value="">
  <input type="hidden" name="boost" value="">
  <input type="hidden" name="boost2" value="">
  <input type="hidden" name="offer" value="">
<% } %>

<div class="ihk-stage">
  <div class="ihk-col ihk-player">
    <span class="ihk-col-label">Deine Karte</span>
    <div class="ihk-slot ihk-slot-card" <%- canStart ? 'data-ihk-drop="card"' : '' %>
      <% if (runCard) { %>data-zoom="<%= runCard.image %>" data-zoom-title="<%= runCard.name %>"<% } %>>
      <% if (runCard) { %>
        <img src="<%= runCard.image %>" alt="<%= runCard.name %>" width="720" height="1008" draggable="false">
      <% } else { %>
        <span class="ihk-slot-empty">Karte hierher ziehen</span>
      <% } %>
    </div>
    <div class="ihk-boosts">
      <% [{ key: 'boost', card: runBoost, label: 'Boost' }, { key: 'boost2', card: runBoost2, label: 'Boost 2' }].forEach((b) => { %>
        <% if (b.key === 'boost' || b.card || canStart) { %>
          <div class="ihk-slot ihk-slot-item<%= b.key === 'boost2' && canStart ? ' is-disabled' : '' %>" <%- canStart ? 'data-ihk-drop="' + b.key + '"' : '' %> data-empty-label="<%= b.label %>"
            <% if (b.card) { %>data-zoom="<%= b.card.image %>" data-zoom-title="<%= b.card.name %>"<% } %>>
            <% if (b.card) { %>
              <img src="<%= b.card.image %>" alt="<%= b.card.name %>" width="720" height="1008" draggable="false">
            <% } else { %>
              <span class="ihk-slot-empty"><%= b.label %><br><small><%= b.key === 'boost2' ? 'nur bei Hybrid-Quests' : 'optional' %></small></span>
            <% } %>
          </div>
        <% } %>
      <% }) %>
    </div>
  </div>

  <div class="ihk-col ihk-center">
    <% if (quest) { %>
      <span class="ihk-vs" aria-hidden="true">VS</span>
      <div class="ihk-quest r-<%= quest.level.toLowerCase() %>">
        <div class="ihk-quest-head"><h2><%= quest.title %></h2><span class="ihk-quest-dur"><%= quest.duration %> Min.</span></div>
        <p><%= quest.text %></p>
        <div class="ihk-quest-meta">
          <span>Ziel <strong><%= quest.required %> Punkte</strong> <span class="ihk-level r-<%= quest.level.toLowerCase() %>">(<%= quest.level %>)</span></span>
          <% if (quest.hybrid) { %><span class="ihk-hybrid">Hybrid</span><% } %>
          <span>Lohn <strong><%= euro(quest.reward) %></strong></span>
        </div>
      </div>
    <% } else { %>
      <div class="ihk-offers">
        <% offers.forEach((o, i) => { %>
          <div class="ihk-quest ihk-offer r-<%= o.level.toLowerCase() %>" tabindex="0" data-drag="offer" data-value="<%= i %>" data-image="<%= o.image %>"<%- o.hybrid ? ' data-hybrid="1"' : '' %>
            data-zoom="<%= o.image %>" data-zoom-title="<%= o.title %>" data-zoom-text="<%= o.text %>" data-zoom-level="<%= o.level %>" data-zoom-level-key="<%= o.level.toLowerCase() %>"<%- o.hybrid ? ' data-zoom-hybrid="1"' : '' %>>
            <img class="ihk-offer-thumb" src="<%= o.image %>" alt="" width="720" height="1008" draggable="false">
            <div>
              <div class="ihk-quest-head"><h2><%= o.title %></h2><span class="ihk-quest-dur"><%= o.duration %> Min.</span></div>
              <p><%= o.text %></p>
              <div class="ihk-quest-meta">
                <span>Ziel <strong><%= o.required %> Punkte</strong> <span class="ihk-level r-<%= o.level.toLowerCase() %>">(<%= o.level %>)</span></span>
                <% if (o.hybrid) { %><span class="ihk-hybrid" title="Zwei Fachrichtungen, zwei Fortschrittsbalken, zwei Boost-Slots">Hybrid</span><% } %>
                <span>Lohn <strong><%= euro(o.reward) %></strong></span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (phase === 'offer' && left) { %>
        <div class="ihk-reroll">
          <% if (canReroll) { %>
            <button class="btn btn-ghost btn-sm" type="submit" form="ihk-reroll">Quests neu würfeln <small>(1× pro Tag)</small></button>
          <% } else { %>
            <span class="muted small">Heute schon neu gewürfelt – morgen wieder möglich.</span>
          <% } %>
        </div>
      <% } %>
    <% } %>

    <% if (phase === 'running') { %>
      <div class="ihk-timer">
        <span>Quest läuft … noch <strong data-ihk-countdown="<%= new Date(run.endsAt).getTime() %>">–</strong></span>
      </div>
    <% } else if (phase === 'result') { %>
      <div class="ihk-fight" data-ihk-fight='<%= JSON.stringify({ hybrid: quest.hybrid && run.total2 != null, ticks: run.ticks, required: run.required, workTime: workTime, success: run.success, freeze: run.freeze || 0, abilities: run.abilities || [], imgs: runImages, base: runCard && runCard.stats ? [runCard.stats.speed, runCard.stats.fia, runCard.stats.fis, runCard.stats.bwl] : null }) %>'>
        <% const twoBars = quest.hybrid && run.total2 != null; %>
        <div class="ihk-bar-label"><span>Fortschritt<%= twoBars ? ' 1' : '' %></span><span data-ihk-points>0 / <%= run.required %></span></div>
        <div class="ihk-bar"><span class="ihk-bar-fill ihk-bar-progress" data-ihk-progress></span></div>
        <% if (twoBars) { %>
          <div class="ihk-bar-label"><span>Fortschritt 2</span><span data-ihk-points2>0 / <%= run.required %></span></div>
          <div class="ihk-bar"><span class="ihk-bar-fill ihk-bar-progress ihk-bar-progress2" data-ihk-progress2></span></div>
        <% } %>
        <div class="ihk-bar-label"><span>Deadline</span><span data-ihk-time></span></div>
        <div class="ihk-bar"><span class="ihk-bar-fill ihk-bar-time" data-ihk-timebar></span></div>
        <div class="ihk-floaters" data-ihk-floaters aria-hidden="true"></div>
        <div class="ihk-fight-foot"><button type="button" class="btn btn-ghost btn-sm ihk-skip" data-ihk-skip>Überspringen</button></div>
        <div class="ihk-result <%= run.success ? 'is-win' : 'is-fail' %>" data-ihk-result hidden>
          <strong><%= run.success ? 'Geschafft!' : 'Emotional damage!' %></strong>
          <p><%= run.success ? quest.success : quest.fail %></p>
          <form method="post" action="/ihk/abholen">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary" type="submit"><%= run.success ? 'Lohn abholen' : 'Weiter' %></button>
          </form>
        </div>
      </div>
    <% } else if (!left) { %>
      <p class="ihk-info">Für heute hast du alle Quests erledigt. Morgen gibt es neue Aufträge!</p>
    <% } else if (!cards.length) { %>
      <p class="ihk-info">Du brauchst mindestens eine Charakterkarte. Öffne ein Booster Pack im <a href="/tcg">TCG</a>!</p>
    <% } %>
  </div>

  <div class="ihk-col ihk-enemy">
    <span class="ihk-col-label is-enemy">Quest</span>
    <div class="ihk-slot ihk-slot-card ihk-slot-enemy" <%- canStart ? 'data-ihk-drop="offer"' : '' %>
      <% if (quest) { %>data-zoom="<%= quest.image %>" data-zoom-title="<%= quest.title %>" data-zoom-text="<%= quest.text %>" data-zoom-level="<%= quest.level %>" data-zoom-level-key="<%= quest.level.toLowerCase() %>"<%- quest.hybrid ? ' data-zoom-hybrid="1"' : '' %><% } %>>
      <% if (quest) { %>
        <img src="<%= quest.image %>" alt="<%= quest.title %>" width="720" height="1008" draggable="false">
      <% } else { %>
        <span class="ihk-slot-empty">Quest hierher ziehen</span>
      <% } %>
    </div>
  </div>
</div>

<% if (canStart) { %>
  <section class="ihk-pick">
    <div class="ihk-pick-head">
      <div>
        <span class="kicker kicker-muted">Team aufstellen</span>
        <h2>Deine Karten</h2>
      </div>
      <%# Großer Start-Knopf im Stil der Album-Kachel (TCG): Auftragsmappe mit Stempel, der beim Darüberfahren aufsetzt %>
      <button class="ihk-start-tile" type="submit" data-ihk-start disabled>
        <span class="ihk-start-art" aria-hidden="true">
          <svg class="ihk-start-doc" width="54" height="64" viewBox="0 0 54 64"><rect x="1" y="1" width="52" height="62" rx="6"/><path d="M11 16h32M11 25h32M11 34h20"/></svg>
          <span class="ihk-start-stamp">IHK</span>
        </span>
        <span class="ihk-start-text">
          <span class="kicker">Auftrag annehmen</span>
          <span class="ihk-start-title">Quest starten</span>
          <span class="ihk-start-hint">Wähle eine Quest und eine Karte</span>
        </span>
        <span class="ihk-start-arrow" aria-hidden="true">→</span>
      </button>
    </div>
    <div class="ihk-pick-grid">
      <% cards.forEach((c) => { %>
        <div class="ihk-pick-card r-<%= c.rarity %>" tabindex="0" data-drag="card" data-value="<%= c.id %>" data-image="<%= c.image %>"<%- canBoost(c) ? ' data-boostable="1"' : '' %>
          data-zoom="<%= c.image %>" data-zoom-title="<%= c.name %> (<%= rarityByKey[c.rarity].label %>)" aria-label="<%= c.name %>, <%= rarityByKey[c.rarity].label %>">
          <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008" draggable="false">
          <span class="ihk-pick-stats">
            <span title="Speed">⚡<%= c.stats.speed %></span><span>FIA <%= c.stats.fia %></span><span>FIS <%= c.stats.fis %></span><span>BWL <%= c.stats.bwl %></span>
          </span>
        </div>
      <% }) %>
    </div>
    <% if (items.length) { %>
      <h3 class="ihk-pick-sub">Boost-Karten</h3>
      <div class="ihk-pick-grid">
        <% items.forEach((c) => { %>
          <div class="ihk-pick-card r-<%= c.rarity %>" tabindex="0" data-drag="boost" data-value="<%= c.id %>" data-image="<%= c.image %>"
            data-zoom="<%= c.image %>" data-zoom-title="<%= c.name %> (<%= rarityByKey[c.rarity].label %>)" aria-label="<%= c.name %>, <%= rarityByKey[c.rarity].label %>">
            <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008" draggable="false">
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</form>
<% } %>
</div>

<dialog class="tcg-modal ihk-zoom" data-ihk-zoom aria-label="Vergrößerte Ansicht">
  <button type="button" class="tcg-close" data-ihk-zoom-close aria-label="Schließen">×</button>
  <div class="ihk-zoom-body">
    <img alt="" data-ihk-zoom-img>
    <div class="ihk-zoom-info">
      <h2 data-ihk-zoom-title></h2>
      <p data-ihk-zoom-text></p>
      <p class="ihk-zoom-meta" data-ihk-zoom-meta hidden></p>
      <button type="button" class="btn btn-primary btn-block" data-ihk-zoom-pick hidden></button>
      <button type="button" class="btn btn-ghost btn-block" data-ihk-zoom-boost hidden>Als Boost wählen</button>
      <button type="button" class="btn btn-ghost btn-block" data-ihk-zoom-remove hidden>Aus dem Feld nehmen</button>
    </div>
  </div>
</dialog>

<script src="/js/ihk.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
