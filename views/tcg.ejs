<%- include('partials/head') %>
<%
  const pct = (w) => {
    const p = (w / totalWeight) * 100;
    return (p >= 10 ? p.toFixed(0) : p >= 1 ? p.toFixed(1) : p.toFixed(2)).replace('.', ',') + ' %';
  };
  // Chance, dass mindestens eine Karte dieser Seltenheit im Pack ist -> "1 in X Packs"
  const packOdds = (w) => {
    const p = 1 - Math.pow(1 - w / totalWeight, cardsPerPack);
    const n = 1 / p;
    return n < 1.5 ? 'fast jedes' : '1 in ' + (n < 10 ? n.toFixed(1).replace('.', ',') : Math.round(n));
  };
  const canAfford = currentUser.balance >= packPrice;
%>

<div class="page-head">
  <h1>Trading Cards</h1>
  <span class="muted"><%= cardsPerPack %> Karten pro Booster Pack · <%= euro(packPrice) %></span>
</div>

<div class="tcg-layout">
  <section class="tcg-main">
    <div class="card tcg-shop">
      <form method="post" action="/tcg/oeffnen" class="tcg-shop-form" data-tcg-open>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="tcg-pack-btn" type="submit" <%= canAfford ? '' : 'disabled' %> aria-label="Booster Pack für <%= euro(packPrice) %> kaufen und öffnen">
          <img src="<%= packImage %>" alt="" width="800" height="1280">
        </button>
        <div class="tcg-shop-info">
          <h2>BfW Holdings Booster Pack</h2>
          <p class="muted">Enthält <%= cardsPerPack %> zufällige Karten – von Crumpled bis Glitch. Jede Karte kannst du später wieder verkaufen.</p>
          <button class="btn btn-primary btn-block" type="submit" <%= canAfford ? '' : 'disabled' %>>Pack öffnen · <%= euro(packPrice) %></button>
          <p class="muted small">Verfügbar: <span data-tcg-balance><%= euro(currentUser.balance) %></span></p>
          <% if (!canAfford) { %><p class="small neg">Dein Guthaben reicht gerade für kein Pack.</p><% } %>
        </div>
      </form>
    </div>

    <div class="stats stats-4">
      <div class="stat card"><span class="stat-label">Packs geöffnet</span><span class="stat-value"><%= stats.packs %></span></div>
      <div class="stat card"><span class="stat-label">Karten</span><span class="stat-value"><%= cardCount %></span></div>
      <div class="stat card"><span class="stat-label">Sammlung</span><span class="stat-value"><%= uniqueOwned %> / <%= cards.length %></span></div>
      <div class="stat card"><span class="stat-label">Verkaufswert</span><span class="stat-value"><%= euro(collectionValue) %></span></div>
    </div>

    <div class="card" id="sammlung">
      <div class="tcg-coll-head">
        <h2>Meine Sammlung</h2>
        <div class="tcg-filter" role="tablist" aria-label="Nach Seltenheit filtern">
          <button type="button" class="chip active" data-tcg-filter="all" role="tab" aria-selected="true">Alle</button>
          <% rarities.forEach((r) => { %>
            <button type="button" class="chip" data-tcg-filter="<%= r.key %>" role="tab" aria-selected="false"><%= r.label %></button>
          <% }) %>
        </div>
      </div>
      <% if (!cardCount) { %>
        <p class="muted">Du hast noch keine Karten. Öffne dein erstes Booster Pack!</p>
      <% } %>
      <div class="tcg-grid">
        <% cards.forEach((c) => { const n = counts[c.id] || 0; const r = rarityByKey[c.rarity]; %>
          <% if (n) { %>
            <button type="button" class="tcg-slot r-<%= c.rarity %>" data-rarity="<%= c.rarity %>"
              data-tcg-card="<%= c.id %>" data-name="<%= c.name %>" data-rarity-label="<%= r.label %>" data-rank="<%= r.rank %>"
              data-image="<%= c.image %>" data-count="<%= n %>" data-sell="<%= r.sell %>" data-sell-text="<%= euro(r.sell) %>"
              aria-label="<%= c.name %>, <%= r.label %>, <%= n %> Stück – vergrößern">
              <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008">
              <% if (n > 1) { %><span class="tcg-count">×<%= n %></span><% } %>
              <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
            </button>
          <% } else { %>
            <div class="tcg-slot tcg-locked r-<%= c.rarity %>" data-rarity="<%= c.rarity %>" title="Noch nicht gezogen">
              <div class="tcg-locked-inner"><span>?</span></div>
              <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>
  </section>

  <aside class="tcg-side">
    <div class="card">
      <h2>Drop-Raten</h2>
      <p class="muted small">Chance pro Karte. Jede Karte wird unabhängig gezogen.</p>
      <div class="table-wrap">
        <table class="table tcg-odds">
          <thead><tr><th>Seltenheit</th><th class="num">Chance</th><th class="num">Packs</th><th class="num">Wert</th></tr></thead>
          <tbody>
            <% rarities.forEach((r) => { %>
              <tr class="r-<%= r.key %>">
                <td><span class="tcg-dot"></span> <%= r.label %></td>
                <td class="num"><%= pct(r.weight) %></td>
                <td class="num nowrap"><%= packOdds(r.weight) %></td>
                <td class="num nowrap"><%= euro(r.sell) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small">„Packs“ = wie oft im Schnitt mindestens eine Karte dieser Seltenheit in einem Pack steckt. „Wert“ = Verkaufspreis.</p>
    </div>

    <div class="card">
      <h2>Seltene Ziehungen</h2>
      <% if (!rarePulls.length) { %>
        <p class="muted">Noch hat niemand eine Holo oder seltener gezogen.</p>
      <% } else { %>
        <ul class="tcg-feed">
          <% rarePulls.forEach((o) => {
               const bestCard = o.cards.slice().sort((a, b) => (rarityByKey[b.rarity] || { rank: 0 }).rank - (rarityByKey[a.rarity] || { rank: 0 }).rank)[0];
               const info = cardById[bestCard.card]; const r = rarityByKey[bestCard.rarity]; %>
            <li class="r-<%= bestCard.rarity %>">
              <span class="tcg-dot"></span>
              <span><strong><%= o.username %></strong> zog <strong><%= info ? info.name : bestCard.card %></strong> (<%= r ? r.label : bestCard.rarity %>)</span>
              <span class="muted small nowrap"><%= relTime(o.createdAt) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card">
      <h2>Duplikate verkaufen</h2>
      <% if (!dupCount) { %>
        <p class="muted">Du hast keine doppelten Karten.</p>
      <% } else { %>
        <p>Du hast <strong><%= dupCount %></strong> doppelte <%= dupCount === 1 ? 'Karte' : 'Karten' %> im Wert von <strong><%= euro(dupValue) %></strong>. Von jeder Karte behältst du eine.</p>
      <% } %>
      <form method="post" action="/tcg/duplikate-verkaufen" data-confirm="<%= dupCount %> doppelte <%= dupCount === 1 ? 'Karte' : 'Karten' %> für <%= euro(dupValue) %> verkaufen? Von jeder Karte bleibt eine übrig.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary btn-block" type="submit" <%= dupCount ? '' : 'disabled' %>>Alle Duplikate verkaufen<%= dupCount ? ' · ' + euro(dupValue) : '' %></button>
      </form>
    </div>
  </aside>
</div>

<!-- Karte vergrößern -->
<dialog class="tcg-modal" data-tcg-modal aria-label="Karte ansehen">
  <button type="button" class="tcg-close" data-tcg-close aria-label="Schließen">×</button>
  <div class="tcg-modal-body">
    <div class="tcg-zoom" data-tcg-tilt>
      <div class="tcg-card-3d">
        <img alt="" data-tcg-modal-img width="720" height="1008">
        <span class="tcg-shine"></span>
      </div>
    </div>
    <div class="tcg-modal-info">
      <h2 data-tcg-modal-name></h2>
      <p><span class="tcg-badge" data-tcg-modal-rarity></span> <span class="muted" data-tcg-modal-count></span></p>
      <form method="post" action="/tcg/verkaufen" data-tcg-sell-one>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="card" value="">
        <input type="hidden" name="mode" value="eins">
        <button class="btn btn-primary btn-block" type="submit">1 verkaufen · <span data-tcg-sell-text></span></button>
      </form>
      <form method="post" action="/tcg/verkaufen" data-tcg-sell-dupes>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="card" value="">
        <input type="hidden" name="mode" value="duplikate">
        <button class="btn btn-ghost btn-block" type="submit"></button>
      </form>
    </div>
  </div>
</dialog>

<!-- Pack-Öffnung -->
<div class="tcg-reveal" data-tcg-reveal hidden>
  <div class="tcg-reveal-stage">
    <p class="tcg-reveal-hint" data-tcg-hint></p>
    <button type="button" class="tcg-reveal-pack" data-tcg-pack aria-label="Pack aufreißen">
      <img src="<%= packImage %>" alt="" width="800" height="1280">
    </button>
    <div class="tcg-reveal-cards" data-tcg-cards></div>
    <div class="tcg-reveal-actions" data-tcg-actions hidden>
      <button type="button" class="btn btn-ghost" data-tcg-flip-all>Alle aufdecken</button>
      <button type="button" class="btn btn-primary" data-tcg-again>Nochmal · <%= euro(packPrice) %></button>
      <button type="button" class="btn btn-ghost" data-tcg-done>Zur Sammlung</button>
    </div>
  </div>
</div>

<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
