<%- include('partials/head') %>
<%
  const pct = (w) => {
    const p = (w / totalWeight) * 100;
    return (p >= 10 ? p.toFixed(0) : p >= 1 ? p.toFixed(1) : p.toFixed(2)).replace('.', ',') + ' %';
  };
  // Chance, dass mindestens eine Karte dieser Seltenheit im Pack ist -> "1 in X Packs"
  const packOdds = (w) => {
    const p = 1 - Math.pow(1 - w / totalWeight, cardsPerPack);
    const n = 1 / p;
    return n < 1.5 ? 'fast jedes' : '1 in ' + (n < 10 ? n.toFixed(1).replace('.', ',') : Math.round(n));
  };
  const canAfford = currentUser.balance >= packPrice;
%>

<div class="page-head">
  <h1>Trading Cards</h1>
  <span class="muted"><%= cardsPerPack %> Karten pro Booster Pack · <%= euro(packPrice) %></span>
</div>

<div class="tcg-layout">
  <section class="tcg-main">
    <div class="card tcg-shop">
      <form method="post" action="/tcg/kaufen" class="tcg-shop-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="type" value="<%= packType %>">
        <button class="tcg-pack-btn" type="submit" <%= canAfford ? '' : 'disabled' %> aria-label="Booster Pack für <%= euro(packPrice) %> kaufen">
          <img src="<%= packImage %>" alt="" width="800" height="1280">
        </button>
        <div class="tcg-shop-info">
          <h2>BfW Holdings Booster Pack</h2>
          <p class="muted">Enthält <%= cardsPerPack %> zufällige Karten – von Crumpled bis Icon. Gekaufte Packs landen bei „Meine Packs“ und können dort geöffnet werden.</p>
          <% const maxBuy = Math.min(maxPacksPerPurchase, Math.floor(currentUser.balance / packPrice)); %>
          <div class="tcg-qty" data-tcg-qty data-price="<%= packPrice %>" data-max="<%= Math.max(1, maxBuy) %>">
            <span class="tcg-qty-label">Anzahl</span>
            <button type="button" class="btn btn-ghost btn-sm" data-qty-step="-1" aria-label="Ein Pack weniger" <%= canAfford ? '' : 'disabled' %>>−</button>
            <input type="number" name="count" value="1" min="1" max="<%= Math.max(1, maxBuy) %>" step="1" inputmode="numeric" aria-label="Anzahl Packs" required <%= canAfford ? '' : 'disabled' %>>
            <button type="button" class="btn btn-ghost btn-sm" data-qty-step="1" aria-label="Ein Pack mehr" <%= canAfford ? '' : 'disabled' %>>+</button>
            <button type="button" class="btn btn-ghost btn-sm" data-qty-max <%= canAfford ? '' : 'disabled' %>>Max</button>
          </div>
          <button class="btn btn-primary btn-block" type="submit" data-qty-submit <%= canAfford ? '' : 'disabled' %>>Pack kaufen · <%= euro(packPrice) %></button>
          <p class="muted small">Verfügbar: <span data-tcg-balance><%= euro(currentUser.balance) %></span></p>
          <% if (!canAfford) { %><p class="small neg">Dein Guthaben reicht gerade für kein Pack.</p><% } %>
        </div>
      </form>
    </div>

    <div class="card" id="packs">
      <h2>Meine Packs</h2>
      <% if (!packs.length) { %>
        <p class="muted">Du hast keine ungeöffneten Packs.</p>
      <% } else { %>
        <ul class="tcg-packs">
          <% packs.forEach((p) => { %>
            <li class="tcg-pack-item">
              <img src="<%= p.image %>" alt="" width="800" height="1280" loading="lazy">
              <div>
                <strong><%= p.label %></strong>
                <span class="muted">×<span data-tcg-pack-count="<%= p.key %>"><%= p.count %></span></span>
              </div>
              <form method="post" action="/tcg/oeffnen" data-tcg-open data-image="<%= p.image %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="type" value="<%= p.key %>">
                <button class="btn btn-primary btn-sm" type="submit">Öffnen</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="stats stats-4">
      <div class="stat card"><span class="stat-label">Packs geöffnet</span><span class="stat-value"><%= stats.packs %></span></div>
      <div class="stat card"><span class="stat-label">Karten</span><span class="stat-value"><%= cardCount %></span></div>
      <div class="stat card"><span class="stat-label">Sammlung</span><span class="stat-value"><%= uniqueOwned %> / <%= cards.length %></span></div>
      <div class="stat card"><span class="stat-label">Verkaufswert</span><span class="stat-value"><%= euro(collectionValue) %></span></div>
    </div>

    <div class="card" id="favoriten">
      <div class="tcg-coll-head">
        <h2>Meine Favoriten</h2>
        <a class="btn btn-primary btn-sm" href="/tcg/album">Zum Album</a>
      </div>
      <% if (!cardCount) { %>
        <p class="muted">Du hast noch keine Karten. Kauf und öffne dein erstes Booster Pack!</p>
      <% } else if (!favorites.length) { %>
        <p class="muted">Zeig hier bis zu <%= maxFavorites %> Lieblingskarten: Öffne dein Album, tippe eine Karte an und wähle „Als Favorit zeigen“.</p>
      <% } %>
      <div class="tcg-grid tcg-favs">
        <% favorites.forEach((c) => { const r = rarityByKey[c.rarity]; %>
          <a class="tcg-slot r-<%= c.rarity %>" href="/tcg/album" aria-label="<%= c.name %>, <%= r.label %> – zum Album">
            <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008">
            <span class="tcg-slot-label"><span class="tcg-dot"></span><%= r.label %></span>
          </a>
        <% }) %>
        <% for (let i = favorites.length; i < maxFavorites && cardCount; i++) { %>
          <a class="tcg-slot tcg-locked" href="/tcg/album" aria-label="Freier Favoriten-Platz – zum Album"><div class="tcg-locked-inner"><span>+</span></div></a>
        <% } %>
      </div>
    </div>
  </section>

  <aside class="tcg-side">
    <div class="card">
      <h2>Drop-Raten</h2>
      <div class="table-wrap">
        <table class="table tcg-odds">
          <thead><tr><th>Seltenheit</th><th class="num">Chance</th><th class="num">Packs</th><th class="num">Wert</th></tr></thead>
          <tbody>
            <% rarities.forEach((r) => { %>
              <tr class="r-<%= r.key %>">
                <td><span class="tcg-dot"></span> <%= r.label %></td>
                <td class="num"><%= pct(r.weight) %></td>
                <td class="num nowrap"><%= packOdds(r.weight) %></td>
                <td class="num nowrap"><%= euro(r.sell) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>Seltene Ziehungen</h2>
      <% if (!rarePulls.length) { %>
        <p class="muted">Noch hat niemand eine Holo oder seltener gezogen.</p>
      <% } else { %>
        <ul class="tcg-feed">
          <% rarePulls.forEach((o) => {
               const bestCard = o.cards.slice().sort((a, b) => (rarityByKey[b.rarity] || { rank: 0 }).rank - (rarityByKey[a.rarity] || { rank: 0 }).rank)[0];
               const info = cardById[bestCard.card]; const r = rarityByKey[bestCard.rarity]; %>
            <li class="r-<%= bestCard.rarity %>">
              <span class="tcg-dot"></span>
              <span><strong><%= o.username %></strong><%- roleBadge(o.username) %> zog <strong><%= info ? info.name : bestCard.card %></strong> (<%= r ? r.label : bestCard.rarity %>)</span>
              <span class="muted small nowrap"><%= relTime(o.createdAt) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </aside>
</div>

<!-- Pack-Öffnung -->
<div class="tcg-reveal" data-tcg-reveal hidden>
  <div class="tcg-reveal-stage">
    <p class="tcg-reveal-hint" data-tcg-hint></p>
    <button type="button" class="tcg-reveal-pack" data-tcg-pack aria-label="Pack aufreißen">
      <img src="<%= packImage %>" alt="" width="800" height="1280">
    </button>
    <div class="tcg-reveal-cards" data-tcg-cards></div>
    <div class="tcg-reveal-actions" data-tcg-actions hidden>
      <button type="button" class="btn btn-ghost" data-tcg-flip-all>Alle aufdecken</button>
      <button type="button" class="btn btn-primary" data-tcg-again>Nächstes Pack öffnen</button>
      <button type="button" class="btn btn-ghost" data-tcg-done>Zur Sammlung</button>
    </div>
  </div>
</div>

<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
