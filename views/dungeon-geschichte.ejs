<%- include('partials/head') %>

<%# Ganze Geschichte eines Dungeons im Original (Englisch), oben dasselbe Banner wie auf der Dungeon-Seite %>
<div class="dg-story-page">
  <section class="dg-hero dg-story-hero">
    <img class="dg-hero-img" src="<%= dg.image %>" alt="" width="1983" height="793">
    <div class="dg-hero-shade"></div>
    <div class="dg-hero-text">
      <span class="kicker">Dungeon · Geschichte</span>
      <h1><%= dg.title %></h1>
    </div>
  </section>

  <div class="dg-story" lang="en">
    <% dg.story.forEach((p) => { %><p><%= p %></p><% }) %>
  </div>

  <a class="ihk-start-tile dg-start-tile" href="/dungeon">
    <span class="dg-start-emblem" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24"><path d="M14.5 17.5 3 6V3h3l11.5 11.5"/><path d="M13 19l6-6"/><path d="M16 16l4 4"/><path d="M19 21l2-2"/></svg>
    </span>
    <span class="ihk-start-text">
      <span class="kicker">Der Ruf ist ergangen</span>
      <span class="ihk-start-title">Zurück zum Dungeon</span>
    </span>
    <span class="ihk-start-arrow" aria-hidden="true">→</span>
  </a>
</div>

<%- include('partials/foot') %>
