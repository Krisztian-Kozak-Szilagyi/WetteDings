<%- include('partials/head') %>
<%
  const st = statusInfo(bet);
  const total = pool(bet);
  const settled = bet.status !== 'offen';
  const isJaNein = bet.type !== 'optionen';
  const feePct = bet.creatorFeePercent || 0;
  const legacyCreatorBet = !!bet.creatorSide; // alte Wetten: Ersteller hat noch mitgewettet
  const edits = bet.edits || [];
  const descEdited = edits.some((e) => e.field === 'description');
  const totals = {};
  bet.options.forEach((o) => { totals[o.key] = o.total; });
  // Schiedsrichter-Verfahren: Stimmen von Ersteller und Schiedsrichter müssen übereinstimmen
  const creatorVote = voteOf(bet, 'creator');
  const refereeVote = voteOf(bet, 'referee');
  const votes = (bet.votes || []).filter((v) => v.role === 'creator' || v.role === 'referee');
  const devVote = voteOf(bet, 'dev');
  const myRoleLabel = role === 'creator' ? 'Wettersteller' : role === 'referee' ? 'Schiedsrichter' : currentUser && currentUser.isAdmin ? 'Admin' : 'Dev';
  // Genau eine der beiden Stimmen liegt vor – dann wird auf die andere Seite gewartet
  const pendingVote = bet.referee && !!creatorVote !== !!refereeVote ? creatorVote || refereeVote : null;
  const waitingFor = pendingVote ? (pendingVote.role === "creator" ? bet.refereeName : bet.creatorName) : null;
  // Die bereits abgegebene Stimme der anderen Seite – der Indikator für meine eigene Entscheidung
  const otherVote = role === 'creator' ? refereeVote : role === 'referee' ? creatorVote : null;
  const otherName = role === 'creator' ? bet.refereeName : bet.creatorName;
  const fees = feeSplit(bet);
%>

<div hidden data-live-root data-live-url="/wetten/<%= bet._id %>/stand" data-live-version="<%= liveVersion %>"
     data-live-signature="<%= bet.status %>|<%= accepting ? 1 : 0 %>|<%= myPosition ? myPosition.side : '-' %>|<%= edits.length %>|<%= perms.resolve ? 1 : 0 %>|<%= perms.edit ? 1 : 0 %>|<%= votes.length %>|<%= bet.disputed ? 1 : 0 %>"></div>

<div class="bet-toolbar">
  <div class="toolbar-actions">
    <% if (perms.edit) { %>
      <a class="btn btn-ghost btn-sm" href="/wetten/<%= bet._id %>/bearbeiten">Bearbeiten</a>
    <% } %>
    <% if (perms.remove) { %>
      <form method="post" action="/wetten/<%= bet._id %>/loeschen" class="bet-delete" data-confirm="Diese Wette vollständig löschen? Sie verschwindet überall, auch aus dem Archiv, samt Kommentaren.<%= bet.status === 'offen' ? ' Alle Einsätze werden erstattet.' : ' Bereits erfolgte Auszahlungen bleiben bestehen.' %> Das kann nicht rückgängig gemacht werden.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-danger btn-sm" type="submit">Löschen</button>
      </form>
    <% } %>
    <button type="button" class="btn btn-ghost btn-sm share-btn" data-share>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
      <span data-share-label>Teilen</span>
    </button>
  </div>
</div>

<div class="bet-layout">
  <section class="bet-main">
    <div class="card">
      <div data-live="bet-head">
      <div class="bet-card-top">
        <span class="badge badge-<%= st.key %>"><%= st.label %></span>
        <span class="muted small">von <strong><%- userLink(bet.creatorName) %></strong> · <%= date(bet.createdAt) %></span>
      </div>
      <h1 class="bet-title"><%= bet.title %></h1>
      <% if (bet.duel) { %><%- include('partials/duel-box', { bet, duelRole, canTip, myTip }) %><% } %>
      <% if (bet.groupName) { %><p class="bet-group-note"><span class="tag tag-group">Gruppe: <%= bet.groupName %></span> <span class="muted small">Diese Wette sehen nur die Mitglieder der Gruppe.</span></p><% } %>
      <% if (bet.description) { %>
        <p class="bet-desc"><%= bet.description %></p>
        <% if (descEdited) { %><p class="muted small edited-hint">Beschreibung nachträglich bearbeitet – siehe Änderungsverlauf.</p><% } %>
      <% } %>

      <% if (!bet.duel) { %>
      <p class="muted small">
        <% if (isJaNein) { %>Ja/Nein-Wette.<% } else { %>Wette mit <%= bet.options.length %> Optionen.<% } %>
        <% if (legacyCreatorBet) { %>
          <%= bet.creatorName %> setzt auf <strong class="opt-text <%= optClass(bet, bet.creatorSide) %>"><%= optionLabel(bet, bet.creatorSide) %></strong>.
        <% } else if (bet.referee) { %>
          Wettersteller <%= bet.creatorName %> und Schiedsrichter <%= bet.refereeName %> setzen nicht mit<% if (feePct) { %> und teilen sich <%= feePct %> % vom Topf als Provision<% } %>.
        <% } else { %>
          Wettersteller <%= bet.creatorName %> setzt nicht mit<% if (feePct) { %> und erhält <%= feePct %> % vom Topf als Provision<% } %>.
        <% } %>
      </p>

      <% if (bet.referee) { %>
        <p class="muted small referee-line">
          Schiedsrichter: <strong><%- userLink(bet.refereeName) %></strong> – bestätigt das Ergebnis gemeinsam mit <%= bet.creatorName %>.
          Nur wenn beide dasselbe eintragen, wird ausgezahlt; sonst entscheidet ein Dev.
        </p>
      <% } else { %>
        <p class="muted small referee-line">Wette ohne Schiedsrichter (vor Einführung des Verfahrens aufgestellt) – hier entscheidet der Wettersteller allein.</p>
      <% } %>
      <% } %>

      <div class="dates">
        <% if (!bet.duel) { %>
        <div class="date-box <%= st.key === 'offen' ? 'is-next' : 'is-past' %>">
          <span class="date-label">Einsatzschluss</span>
          <span class="date-value"><%= date(bet.deadline) %></span>
          <span class="muted small"><%= st.key === 'offen' ? 'Setzen möglich bis ' + relTime(bet.deadline) : 'Keine Einsätze mehr möglich' %></span>
        </div>
        <% } %>
        <div class="date-box <%= !settled && st.key !== 'offen' ? 'is-next' : '' %> <%= settled ? 'is-past' : '' %>">
          <span class="date-label">Auswertung</span>
          <% if (bet.resultAt) { %>
            <span class="date-value"><%= date(bet.resultAt) %></span>
            <span class="muted small">
              <% if (settled) { %>Ausgewertet am <%= date(bet.resolvedAt) %><% } else if (new Date(bet.resultAt) > new Date()) { %>Ergebnis <%= relTime(bet.resultAt) %><% } else { %>Ergebnis wird erwartet<% } %>
            </span>
          <% } else { %>
            <span class="date-value">–</span>
            <span class="muted small"><%= settled ? 'Ausgewertet am ' + date(bet.resolvedAt) : 'Kein Termin angegeben' %></span>
          <% } %>
        </div>
      </div>

      <div class="stats stats-2">
        <div class="stat"><span class="stat-label">Topf</span><span class="stat-value"><%= euro(total) %></span></div>
        <div class="stat"><span class="stat-label">Teilnehmende</span><span class="stat-value"><%= bet.participants %></span></div>
      </div>

      <div class="pool">
        <% bet.options.forEach((o) => { %>
          <div class="pool-side <%= optClass(bet, o.key) %> <%= bet.outcome === o.key ? 'winner' : '' %>">
            <span class="pool-label"><%= o.label %><% if (bet.outcome === o.key) { %> ✓<% } %></span>
            <span class="pool-amount"><%= euro(o.total) %></span>
            <span class="pool-quote"><%= share(bet, o) %> % · Quote <%= quote(bet, o) %></span>
          </div>
        <% }) %>
      </div>
      <%- include('partials/bar', { bet, big: true }) %>
      <% if (!total && !settled) { %><p class="muted small">Noch keine Einsätze – sei die erste Person, die setzt!</p><% } %>

      <%
        // Wie das Ergebnis zustande kam (alte Wetten ohne resolvedVia: Ersteller bzw. Admin)
        const viaText = {
          einstimmig: 'einstimmig bestätigt von Wettersteller und Schiedsrichter',
          dev: 'entschieden von einem Dev, weil Wettersteller und Schiedsrichter sich nicht einig waren',
          system: 'automatisch eingetragen, weil kein Ergebnis gemeldet wurde',
          ersteller: 'eingetragen vom Wettersteller',
          schiedsrichter: 'entschieden vom Schiedsrichter',
        }[bet.resolvedVia] || 'eingetragen';
      %>
      <% if (bet.status === 'entschieden') { %>
        <div class="result result-win">
          <strong>Ergebnis: <%= optionLabel(bet, bet.outcome) %></strong>
          <span><%= viaText %> · <%- userLink(bet.resolvedByName) %> · <%= date(bet.resolvedAt) %></span>
          <% if (bet.resolutionNote) { %><span class="result-note"><b>Begründung:</b> <%= bet.resolutionNote %></span><% } %>
          <% if (bet.refunded) { %><span>Da es keine Gegenseite gab, wurden alle Einsätze erstattet.</span><% } %>
          <% if (bet.creatorFee || bet.refereeFee) { %>
            <% if (bet.duel) { %><span>Provision (<%= feePct %> % vom Topf): <%= euro(bet.refereeFee) %> an <%= bet.refereeName %></span>
            <% } else { %><span>Provision (<%= feePct %> % vom Topf): <%= euro(bet.creatorFee) %> an <%= bet.creatorName %><% if (bet.refereeFee) { %>, <%= euro(bet.refereeFee) %> an <%= bet.refereeName %><% } %></span><% } %>
          <% } %>
        </div>
      <% } else if (bet.status === 'annulliert') { %>
        <div class="result result-void">
          <strong>Annulliert – alle Einsätze wurden erstattet.</strong>
          <span><%= viaText %> · <%- userLink(bet.resolvedByName) %> · <%= date(bet.resolvedAt) %></span>
          <% const why = bet.resolutionNote || bet.voidReason; if (why) { %><span class="result-note"><b>Begründung:</b> <%= why %></span><% } %>
        </div>
      <% } else if (bet.disputed) { %>
        <div class="result result-dispute">
          <strong>Strittig: Wettersteller und Schiedsrichter sind sich nicht einig.</strong>
          <span><%= bet.creatorName %> hat für „<%= voteLabel(bet, creatorVote.outcome) %>“ gestimmt, <%= bet.refereeName %> für „<%= voteLabel(bet, refereeVote.outcome) %>“.</span>
          <span>Solange das so bleibt, wird nicht ausgezahlt. Ein Dev entscheidet mit seiner Stimme – oder eine der beiden Seiten ändert ihre Stimme.</span>
        </div>
      <% } else if (pendingVote) { %>
        <div class="result result-wait">
          <strong><%= pendingVote.byName %> hat für „<%= voteLabel(bet, pendingVote.outcome) %>“ gestimmt.</strong>
          <span>Es fehlt die Bestätigung von <%= waitingFor %>. Erst wenn beide dasselbe eintragen, wird ausgezahlt. Einsätze sind nicht mehr möglich.</span>
        </div>
      <% } else if (st.key === 'wartend') { %>
        <div class="result result-wait">
          <strong><%= bet.duel ? 'Das Duell läuft.' : 'Einsatzschluss erreicht.' %></strong>
          <span>Wartet darauf, dass <%= bet.duel ? 'Schiedsrichter ' + bet.refereeName + ' das Ergebnis einträgt' : bet.referee ? bet.creatorName + ' und ' + bet.refereeName + ' das Ergebnis eintragen' : bet.creatorName + ' das Ergebnis einträgt' %><% if (bet.resultAt) { %> – geplant für <%= date(bet.resultAt) %><% } %>.</span>
        </div>
      <% } %>

      <% if (votes.length) { %>
        <div class="votes-box">
          <h3 class="votes-title">Stimmen zum Ergebnis</h3>
          <%- include('partials/votes', { bet }) %>
          <% if (devVote) { %>
            <p class="muted small">Entschieden hat am Ende <strong><%- userLink(devVote.byName) %></strong> als Dev.</p>
          <% } %>
        </div>
      <% } %>
      </div>

      <% if (edits.length) { %>
        <details class="history">
          <summary>Änderungsverlauf (<%= edits.length %>)</summary>
          <ol class="history-list">
            <% edits.slice().reverse().forEach((e) => { %>
              <li>
                <div class="muted small"><%= date(e.at) %> · <strong><%= e.byName %></strong> hat <%= editFieldLabels[e.field] %> geändert</div>
                <div class="diff">
                  <div class="diff-old"><span class="diff-tag">vorher</span><%= e.oldValue || '(leer)' %></div>
                  <div class="diff-new"><span class="diff-tag">nachher</span><%= e.newValue || '(leer)' %></div>
                </div>
              </li>
            <% }) %>
          </ol>
        </details>
      <% } %>
    </div>

    <div class="card" data-live="participants">
      <h2>Teilnehmende</h2>
      <% if (!positions.length) { %>
        <p class="muted">Noch hat niemand gesetzt.</p>
      <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Name</th><th>Option</th><th class="num">Einsatz</th><th class="num"><%= settled ? 'Auszahlung' : 'Anteil' %></th></tr>
          </thead>
          <tbody>
            <% positions.forEach((p) => { const optTotal = totals[p.side] || 0; %>
              <tr class="<%= myPosition && String(p._id) === String(myPosition._id) ? 'me' : '' %>">
                <td><%- userLink(p.username) %><% if (String(p.user) === String(bet.creator)) { %> <span class="tag">Ersteller</span><% } %></td>
                <td><span class="pill <%= optClass(bet, p.side) %>"><%= optionLabel(bet, p.side) %></span></td>
                <td class="num"><%= euro(p.amount) %></td>
                <td class="num">
                  <% if (settled) { %>
                    <span class="<%= p.payout > p.amount ? 'pos' : (p.payout === 0 ? 'neg' : '') %>"><%= euro(p.payout) %></span>
                  <% } else { %>
                    <%= optTotal ? Math.round(p.amount / optTotal * 100) : 0 %> %
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <div class="card" id="kommentare">
      <h2>Kommentare <span class="muted" data-live="comment-count">(<%= bet.commentCount || 0 %>)</span></h2>
      <div data-live="comments">
      <% if (!comments.length) { %>
        <p class="muted">Noch keine Kommentare. Schreib den ersten!</p>
      <% } else { %>
        <ol class="comments">
          <% comments.forEach((c) => {
               const side = sideByUser[String(c.user)];
               const mine = currentUser && String(c.user) === String(currentUser._id);
               const canDelete = !c.deleted && currentUser && (mine || currentUser.canModerate); %>
            <li class="comment <%= c.deleted ? 'is-deleted' : '' %> <%= mine ? 'is-mine' : '' %>" id="k-<%= c._id %>">
              <div class="comment-head">
                <strong><%- userLink(c.username) %></strong>
                <% if (String(c.user) === String(bet.creator)) { %><span class="tag">Wettersteller</span><% } %>
                <% if (side) { %><span class="pill <%= optClass(bet, side) %>"><%= optionLabel(bet, side) %></span><% } %>
                <time class="muted small" datetime="<%= new Date(c.createdAt).toISOString() %>" title="<%= date(c.createdAt) %>"><%= relTime(c.createdAt) %></time>
                <% if (canDelete) { %>
                  <form method="post" action="/wetten/<%= bet._id %>/kommentare/<%= c._id %>/loeschen" class="comment-delete" data-confirm="Kommentar wirklich löschen?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="link-btn">Löschen</button>
                  </form>
                <% } %>
              </div>
              <% if (c.deleted) { %>
                <p class="comment-text muted"><em><%= c.deletedByName ? 'Von einem Admin entfernt.' : 'Kommentar gelöscht.' %></em></p>
              <% } else { %>
                <p class="comment-text"><%= c.text %></p>
              <% } %>
            </li>
          <% }) %>
        </ol>
      <% } %>
      </div>

      <% if (currentUser) { %>
        <form method="post" action="/wetten/<%= bet._id %>/kommentare" class="comment-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="sr-only" for="kommentar-text">Kommentar</label>
          <textarea id="kommentar-text" name="text" rows="3" maxlength="<%= commentMax %>" required placeholder="Schreib etwas zu dieser Wette …"></textarea>
          <div class="comment-form-foot">
            <span class="muted small" data-count-for="kommentar-text">0 / <%= commentMax %></span>
            <button class="btn btn-primary btn-sm" type="submit">Kommentar senden</button>
          </div>
        </form>
      <% } else { %>
        <p class="muted"><a href="/anmelden?weiter=<%= encodeURIComponent('/wetten/' + bet._id + '#kommentare') %>">Melde dich an</a>, um mitzudiskutieren.</p>
      <% } %>
    </div>
  </section>

  <aside class="bet-side">
    <% if (isOwner && !legacyCreatorBet && !bet.duel) { %>
      <div class="card card-accent" data-live="owner-card">
        <h2>Deine Wette</h2>
        <% if (settled) { %>
          <p>Deine Provision: <strong class="<%= bet.creatorFee ? 'pos' : '' %>"><%= euro(bet.creatorFee || 0) %></strong></p>
        <% } else { %>
          <p>Du bist Wettersteller und kannst nicht selbst mitsetzen.</p>
          <% if (bet.referee) { %>
            <p class="muted">Das Ergebnis trägst du gemeinsam mit <strong><%- userLink(bet.refereeName) %></strong> ein – ausgezahlt wird nur, wenn ihr dasselbe eintragt.</p>
          <% } %>
          <% if (feePct) { %>
            <p class="muted">Dein Provisionsanteil nach aktuellem Stand: bis zu <strong><%= euro(fees.creator) %></strong><% if (bet.referee) { %> (die Hälfte von <%= feePct %> % des Topfes, die andere Hälfte geht an <%= bet.refereeName %>)<% } else { %> (<%= feePct %> % vom Topf)<% } %>, höchstens die Einsätze der Verlierer. Ausgezahlt wird sie, wenn das Ergebnis feststeht – nicht bei Annullierung oder wenn es keine Gegenseite gibt.</p>
          <% } %>
        <% } %>
      </div>
    <% } %>

    <% if (isReferee) { %>
      <div class="card card-accent" data-live="referee-card">
        <h2>Du bist Schiedsrichter</h2>
        <% if (settled) { %>
          <p>Deine Provision: <strong class="<%= bet.refereeFee ? 'pos' : '' %>"><%= euro(bet.refereeFee || 0) %></strong></p>
        <% } else if (bet.duel) { %>
          <p>Du entscheidest dieses Duell allein: Hat <strong><%= bet.creatorName %></strong> recht oder <strong><%= bet.duel.opponentName %></strong>?</p>
          <p class="muted">Dafür bekommst du <%= feePct %> % vom Topf (<strong><%= euro(fees.referee) %></strong>) – nicht bei Annullierung.</p>
        <% } else { %>
          <p>Du bestätigst gemeinsam mit <strong><%- userLink(bet.creatorName) %></strong>, was eingetreten ist.</p>
          <p class="muted">Du kannst hier nicht mitsetzen<% if (feePct) { %>, bekommst aber nach aktuellem Stand bis zu <strong><%= euro(fees.referee) %></strong> Provision (die Hälfte von <%= feePct %> % des Topfes)<% } %>. Ausgezahlt wird nur, wenn ihr beide dasselbe Ergebnis eintragt – sonst entscheidet ein Dev.</p>
        <% } %>
      </div>
    <% } %>

    <% if (myPosition) { %>
      <div class="card card-accent" data-live="my-position">
        <h2>Dein Einsatz</h2>
        <p class="big"><%= euro(myPosition.amount) %> auf <span class="opt-text <%= optClass(bet, myPosition.side) %>"><%= optionLabel(bet, myPosition.side) %></span></p>
        <% if (settled) { %>
          <p>Auszahlung: <strong class="<%= myPosition.payout > myPosition.amount ? 'pos' : (myPosition.payout === 0 ? 'neg' : '') %>"><%= euro(myPosition.payout) %></strong>
            (<%= myPosition.payout - myPosition.amount >= 0 ? '+' : '' %><%= euro(myPosition.payout - myPosition.amount) %>)</p>
        <% } else {
             const mine = totals[myPosition.side] || 0;
             const other = total - mine;
             // Provision höchstens so hoch wie die Einsätze der anderen Optionen -> nie weniger als der Einsatz
             const estFee = Math.min(total * feePct / 100, other);
             const est = other > 0 && mine > 0 ? Math.floor(myPosition.amount * (total - estFee) / mine) : myPosition.amount; %>
          <p class="muted">Wenn „<%= optionLabel(bet, myPosition.side) %>“ eintritt, bekämst du nach aktuellem Stand <strong><%= euro(est) %></strong>.
            <% if (!other) { %>Noch hat niemand anders gesetzt – ohne Gegenseite gibt es nur den Einsatz zurück.<% } %></p>
        <% } %>
      </div>
    <% } %>

    <% if (perms.stake) { %>
      <div class="card">
        <h2><%= myPosition ? 'Einsatz erhöhen' : 'Jetzt setzen' %></h2>
        <form method="post" action="/wetten/<%= bet._id %>/setzen" class="stake-form" data-live-attrs="stake-form"
              data-totals="<%= JSON.stringify(totals) %>" data-fee="<%= feePct %>"
              data-my-side="<%= myPosition ? myPosition.side : '' %>" data-my-amount="<%= myPosition ? myPosition.amount : 0 %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <fieldset class="side-picker <%= bet.options.length > 2 ? 'side-picker-many' : '' %>">
            <legend class="sr-only">Option wählen</legend>
            <% bet.options.forEach((o) => {
                 const locked = myPosition && myPosition.side !== o.key;
                 const checked = myPosition ? myPosition.side === o.key : (legacyCreatorBet && isJaNein && o.key !== bet.creatorSide);
                 let sub = '';
                 if (legacyCreatorBet) sub = o.key === bet.creatorSide ? (isJaNein ? 'Mitgehen' : 'Tipp von ' + bet.creatorName) : (isJaNein ? 'Dagegenhalten' : ''); %>
              <label class="side-option <%= optClass(bet, o.key) %> <%= locked ? 'locked' : '' %>">
                <input type="radio" name="side" value="<%= o.key %>" data-label="<%= o.label %>" <%= checked ? 'checked' : '' %> <%= locked ? 'disabled' : '' %> required>
                <span class="side-option-title"><%= o.label %></span>
                <% if (sub) { %><span class="side-option-sub"><%= sub %></span><% } %>
                <span class="side-option-quote" data-live="quote-<%= o.key %>"><%= quote(bet, o) %></span>
              </label>
            <% }) %>
          </fieldset>

          <label class="field">
            <span>Einsatz in €</span>
            <input type="number" name="amount" inputmode="decimal" min="<%= minStake / 100 %>" max="<%= currentUser.balance / 100 %>" step="0.01" value="<%= Math.min(10, currentUser.balance / 100) %>" required>
          </label>
          <div class="quick-amounts">
            <button type="button" class="chip" data-add="5">+5</button>
            <button type="button" class="chip" data-add="10">+10</button>
            <button type="button" class="chip" data-add="50">+50</button>
            <button type="button" class="chip" data-add="100">+100</button>
            <button type="button" class="chip" data-set="<%= currentUser.balance / 100 %>">Alles</button>
          </div>
          <p class="estimate" aria-live="polite"></p>
          <button class="btn btn-primary btn-block" type="submit" <%= currentUser.balance < minStake ? 'disabled' : '' %>>Einsatz platzieren</button>
          <p class="muted small">Verfügbar: <span data-live="stake-balance"><%= euro(currentUser.balance) %></span>. Die Quote kann sich bis zum Einsatzschluss noch ändern.<% if (feePct) { %> <%= feePct %> % des Topfes gehen als Provision an <%= bet.referee ? 'Wettersteller und Schiedsrichter' : 'den Wettersteller' %>.<% } %></p>
        </form>
      </div>
    <% } else if (!currentUser && accepting) { %>
      <div class="card">
        <h2>Mitwetten?</h2>
        <p>Melde dich an, um auf diese Wette zu setzen. Neue Mitglieder bekommen <%= euro(startBalance) %> Spielgeld.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/registrieren">Registrieren</a>
          <a class="btn btn-ghost" href="/anmelden?weiter=<%= encodeURIComponent('/wetten/' + bet._id) %>">Anmelden</a>
        </div>
      </div>
    <% } %>

    <% if (perms.resolve || perms.void || perms.close) { %>
      <div class="card card-manage">
        <h2>Wette verwalten</h2>

        <% if (perms.resolve) { %>
          <form method="post" action="/wetten/<%= bet._id %>/entscheiden" class="resolve-form"
                data-confirm-resolve="<%= decidesAlone ? 'Ergebnis „%s“ festlegen und auszahlen? Das kann nicht rückgängig gemacht werden.' : 'Stimme für „%s“ abgeben? Ausgezahlt wird, sobald die andere Seite dasselbe einträgt.' %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <p><strong><%= decidesAlone ? 'Ergebnis eintragen' : 'Deine Stimme zum Ergebnis' %></strong></p>
            <% if (bet.duel && duelRole === 'referee') { %>
              <p class="muted small">Als Schiedsrichter entscheidest du dieses Duell allein. Das Ergebnis wird sofort ausgezahlt und kann nicht rückgängig gemacht werden.</p>
            <% } else if (decidesAlone && role === 'dev') { %>
              <p class="muted small">Als <%= myRoleLabel %> gibst du die entscheidende Stimme ab – auch dann, wenn Wettersteller und Schiedsrichter sich nicht einig sind. Die Wette wird sofort geschlossen und ausgezahlt.</p>
            <% } else if (decidesAlone) { %>
              <p class="muted small">Diese Wette hat keinen Schiedsrichter. Du kannst jederzeit festlegen, was eingetreten ist – die Wette wird dann sofort geschlossen und ausgezahlt.</p>
            <% } else { %>
              <p class="muted small">
                Als <%= myRoleLabel %> gibst du eine von zwei Stimmen ab. Ausgezahlt wird erst, wenn
                <strong><%= role === 'creator' ? bet.refereeName : bet.creatorName %></strong> dasselbe Ergebnis einträgt.
                Bei Uneinigkeit entscheidet ein Dev.
                <% if (accepting) { %><br><strong>Achtung:</strong> Deine Stimme beendet sofort die Einsatzphase.<% } %>
              </p>
            <% } %>
            <% if (otherVote) { %>
              <div class="vote-indicator">
                <div class="vote-indicator-head">
                  <span class="vote-indicator-label"><%= otherName %> hat gestimmt für</span>
                  <span class="pill <%= otherVote.outcome === 'annulliert' ? 'c-nein' : optClass(bet, otherVote.outcome) %>"><%= voteLabel(bet, otherVote.outcome) %></span>
                </div>
                <% if (otherVote.note) { %><p class="vote-note"><%= otherVote.note %></p><% } %>
                <p class="muted small">Trägst du dasselbe ein, wird sofort ausgezahlt. Bei einer anderen Stimme wird die Wette strittig und ein Dev entscheidet.</p>
              </div>
            <% } else if (role === 'dev' && votes.length) { %>
              <div class="vote-indicator">
                <span class="vote-indicator-label">Bereits abgegebene Stimmen</span>
                <%- include('partials/votes', { bet }) %>
              </div>
            <% } %>
            <% if (myVote) { %>
              <p class="muted small">Deine aktuelle Stimme: <span class="pill <%= myVote.outcome === 'annulliert' ? 'c-nein' : optClass(bet, myVote.outcome) %>"><%= voteLabel(bet, myVote.outcome) %></span> – du kannst sie bis zum Abschluss noch ändern.</p>
            <% } %>
            <fieldset class="side-picker <%= bet.options.length > 2 ? 'side-picker-many' : '' %>">
              <legend class="sr-only">Eingetretene Option</legend>
              <% bet.options.forEach((o) => {
                   // Wer bisher für diese Option gestimmt hat – der Indikator direkt an der Auswahl
                   const by = [];
                   if (myVote && myVote.outcome === o.key) by.push('Deine Stimme');
                   if (creatorVote && creatorVote.outcome === o.key && role !== 'creator') by.push('Stimme von ' + bet.creatorName);
                   if (refereeVote && refereeVote.outcome === o.key && role !== 'referee') by.push('Stimme von ' + bet.refereeName); %>
                <label class="side-option side-option-sm <%= optClass(bet, o.key) %> <%= by.length ? 'is-voted' : '' %>">
                  <input type="radio" name="outcome" value="<%= o.key %>" data-label="<%= o.label %>" <%= myVote && myVote.outcome === o.key ? 'checked' : '' %> required>
                  <span class="side-option-title"><%= o.label %></span>
                  <% if (by.length) { %><span class="side-option-sub"><%= by.join(' · ') %></span><% } %>
                </label>
              <% }) %>
            </fieldset>
            <label class="field">
              <span>Begründung <em class="muted">(Pflicht, für alle sichtbar)</em></span>
              <textarea name="note" rows="3" minlength="<%= noteMin %>" maxlength="<%= noteMax %>" required></textarea>
            </label>
            <button class="btn btn-primary btn-block" type="submit">
              <%= decidesAlone ? 'Ergebnis festlegen & auszahlen' : (myVote ? 'Stimme ändern' : 'Stimme abgeben') %>
            </button>
          </form>
        <% } %>

        <% if (perms.close) { %>
          <form method="post" action="/wetten/<%= bet._id %>/schliessen" class="close-form" data-confirm="Einsatzschluss jetzt setzen? Danach kann niemand mehr setzen.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-block" type="submit">Nur Einsatzschluss jetzt (Ergebnis später)</button>
          </form>
        <% } %>

        <% if (perms.void) { %>
          <details class="void-box">
            <summary>Wette annullieren</summary>
            <form method="post" action="/wetten/<%= bet._id %>/annullieren"
                  data-confirm="<%= decidesAlone ? 'Wette wirklich annullieren? Alle bekommen ihren Einsatz zurück.' : 'Für eine Annullierung stimmen? Erstattet wird erst, wenn die andere Seite zustimmt.' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (otherVote && otherVote.outcome === 'annulliert') { %>
                <p class="small"><strong><%= otherName %> hat bereits für eine Annullierung gestimmt.</strong> Mit deiner Zustimmung werden alle Einsätze sofort erstattet.</p>
              <% } else if (!decidesAlone) { %>
                <p class="muted small">Auch die Annullierung braucht beide Stimmen – <%= otherName %> muss zustimmen<% if (otherVote) { %>, hat aber für „<%= voteLabel(bet, otherVote.outcome) %>“ gestimmt<% } %>.</p>
              <% } %>
              <label class="field">
                <span>Begründung <em class="muted">(Pflicht)</em></span>
                <textarea name="note" rows="2" minlength="<%= noteMin %>" maxlength="300" required></textarea>
              </label>
              <button class="btn btn-danger btn-block" type="submit"><%= decidesAlone ? 'Annullieren & erstatten' : 'Für Annullierung stimmen' %></button>
            </form>
          </details>
        <% } %>
        <% if (role === 'dev') { %><p class="muted small">Du siehst diese Optionen als <%= myRoleLabel %> – deine Stimme entscheidet auch Streitfälle.</p><% } %>
      </div>
    <% } %>
  </aside>
</div>

<%- include('partials/foot') %>
