<%- include('partials/head') %>
<%#
  Grading-Shop (#204): ohne Job das Stellenangebot, mit Job der Schreibtisch – Holzplatte von oben mit Namensschild,
  Glasvitrine, Schneidematte (genau eine Hauptaktion) und Objekten, die je ein Fenster öffnen (public/js/grading-desk.js).
  Erklärungen stehen in der Tour (public/js/grading-tour.js), nicht auf dem Tisch.
%>
<% const locked = active && shop.lockedUntil && new Date(shop.lockedUntil) > new Date(); %>
<% const tabInput = (t) => `<input type="hidden" name="reiter" value="${t}">`; %>

<div class="gr-page<%= active ? ' gd-page' : '' %>">
<% if (closedForOthers) { %><p class="muted small">Nur für Admins sichtbar – im Admin-Panel für alle freigeben.</p><% } %>

<% if (!active) { %>
  <div class="gr-head">
    <h1>Grading-Shop</h1>
    <a class="btn btn-ghost btn-sm gr-submit-link" href="/grading/einreichen">Eigene Karte graden lassen →</a>
  </div>
  <%# ---------- Noch kein Job: Vorstellung und Vertrag ---------- %>
  <section class="gr-hero">
    <div class="gr-hero-text">
      <p class="gr-kicker">Stellenangebot</p>
      <h2>Karten putzen, benoten, versiegeln.</h2>
      <p class="gr-lead">Sammler schicken dir ihre Karten. Du drehst sie unter der Lampe, wischst jeden Fleck weg, findest Kratzer und bestoßene Ecken – und schickst sie perfekt verpackt zurück. Je weiter du deinen Shop ausbaust, desto mehr Arbeitsschritte und desto mehr Lohn.</p>
      <ul class="gr-terms">
        <li><b>Kein Tagesbonus</b>, solange du hier arbeitest – dafür Lohn für jeden Auftrag</li>
        <li><b><%= contractDays %> Tage Vertrag</b> – so lange keine Kündigung</li>
        <li>Deine Ausbaustufe bleibt nach einer Kündigung erhalten</li>
      </ul>
      <form method="post" action="/grading/annehmen" class="gr-hire" data-confirm="Job im Grading-Shop annehmen? <%= contractDays %> Tage kein Tagesbonus und keine Kündigung.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check"><input type="checkbox" name="confirm" value="1" required> <span>Verstanden: <%= contractDays %> Tage gebunden, kein Tagesbonus.</span></label>
        <button class="btn btn-primary btn-lg gr-glow" type="submit">Job annehmen</button>
      </form>
    </div>
    <div class="gr-hero-card" aria-hidden="true">
      <% if (heroCard) { %>
        <%# Versiegelte Karte im Slab – wie nach einem Auftrag (Etikett oben, Note 10) %>
        <div class="gr-hero-slab">
          <div class="gr-hero-slab-label">
            <div class="gr-slab-info"><strong><%= locals.shopCode || 'BfW' %></strong><span><%= heroCard.name %> · <%= heroCard.rarityLabel %></span></div>
            <div class="gr-slab-score"><span class="gr-slab-word">GEM MINT</span><span class="gr-slab-grade">10</span></div>
          </div>
          <span class="tcg-slot gr-hero-slab-slot r-<%= heroCard.rarity %>">
            <span class="tcg-art">
              <img src="<%= heroCard.image %>" alt="" width="720" height="1008">
              <% if (heroCard.rarity === 'glitch') { %><img class="tcg-glitch-a" src="<%= heroCard.image %>" alt="" width="720" height="1008"><img class="tcg-glitch-b" src="<%= heroCard.image %>" alt="" width="720" height="1008"><span class="tcg-fx tcg-fx-glitch"></span><% } %>
            </span>
          </span>
          <span class="gr-hero-slab-shine"></span>
        </div>
      <% } %>
    </div>
  </section>
<% } else { %>
  <%
    const shown = showcase.filter((s) => s.shown);
    const r = rating;
    const fmtStars = (v) => (v != null ? v.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '–');
    const starRow = (v) => { const n = Math.round(v || 0); return '★'.repeat(n) + '☆'.repeat(5 - n); };
    const tier = r && r.tier;
    const repPct = tier ? (tier.next ? Math.min(100, Math.round(((r.reputation - tier.min) / (tier.next - tier.min)) * 100)) : 100) : 0;
    const sheetHead = (key, title) => `<header class="gd-sheet-head"><span class="gd-sheet-grip" aria-hidden="true"></span><h2 id="gd-${key}-t">${title}</h2><button type="button" class="gd-sheet-help" data-tour-info="${key}" aria-label="Kurz erklärt">?</button><button type="button" class="gd-sheet-close" data-gd-close aria-label="Schließen">×</button></header>`;
    // Kassenzettel: NPC-Lohn je Schritt bzw. gebuchte Bausteine eines Mitglieds
    const npcLabels = { clean: 'Reinigung', iron: 'Bügeln', grade: 'Benoten', slab: 'Versiegeln', extra: 'Zuschlag' };
    const svcLabels = Object.fromEntries(services.map((s) => [s.key, s.label]));
    const linesOf = (parts, player) => Object.entries(parts || {}).filter(([k, v]) => v && (player ? svcLabels : npcLabels)[k]).map(([k, v]) => [(player ? svcLabels : npcLabels)[k], v]);
    const bonNote = (j) => [
      j.guess !== null && j.source === 'spieler' ? `Slab ${j.shopCode || ''} · Note ${j.guess}` : j.guess !== null ? `Note ${j.guess}${j.guess === j.grade ? ' ✓' : ' · richtig ' + j.grade}` : j.source === 'spieler' ? 'gebügelt' : '',
      j.foilFound ? '+ 1 Folie' : '',
    ].filter(Boolean).join(' · ');
    const bons = doneCards.map((j) => ({ card: j.cardInfo, title: j.cardInfo ? j.cardInfo.name : j.card, who: j.customer, at: j.doneAt, lines: linesOf(j.parts, j.source === 'spieler'), total: j.pay, note: bonNote(j) }));
    const nextOrder = waiting && playerUsed < playerLimit ? queue[0] : null;
    const canTake = used < limit || !!nextOrder;
    const ownedTools = tools.filter((t) => t.owned).length;
    const milesDone = milestones.filter((m) => m.done).length;
    // Tour (public/js/grading-tour.js): die Erklärungen, die nicht auf dem Tisch stehen – je Objekt (data-tour) eine
    // Station; sheet = Fenster, dessen ?-Knopf denselben Text zeigt. Fehlt ein Objekt, wird die Station übersprungen.
    const tour = [
      { key: 'schild', title: 'Dein Shop', text: 'Name, Kürzel und Stufe. Der Balken zeigt deine Reputation – sie wächst mit sauberer Arbeit und guten Bewertungen. Rechts: heute verdient und wie viele Aufträge heute noch gehen.' },
      { key: 'matte', title: 'Hier wird gearbeitet', text: 'Nimm den nächsten Auftrag an – ab an die Werkbank: putzen, bügeln, benoten, versiegeln. Je sauberer und genauer, desto mehr Lohn.' },
      { key: 'vitrine', sheet: 'vitrine', title: 'Deine Vitrine', text: 'Stell deine besten Slabs aus: je seltener und besser benotet, desto schneller wächst deine Reputation. Tippe einen Slab an, um ihn zu bewundern – ✎ räumt ein. Ausgestellte Slabs lassen sich nicht handeln.' },
      { key: 'eingang', sheet: 'auftraege', title: 'Eingang', text: players ? `Karten von Mitgliedern zu deinen Festpreisen – Express zuerst, dann die ältesten. Du hast ${orderDays} Tage, mit Express ${expressDays}, sonst geht die Karte samt Geld zurück. Die echte Note bleibt geheim: auf den Slab kommt deine.` : `Ab Stufe ${orderLevel} schicken dir auch Mitglieder ihre Karten – zu deinen Preisen.` },
      { key: 'spiess', sheet: 'bons', title: 'Kassenzettel', text: 'Jeder erledigte Auftrag landet als Bon auf dem Spieß – mit allen Posten. Unten steht, was du heute verdient hast.' },
      { key: 'handy', sheet: 'bewertungen', title: 'Bewertungen', text: 'Kunden geben Sterne und Stichworte. Gute Bewertungen bringen Reputation – und neue Kunden.' },
      { key: 'preise', sheet: 'preise', title: 'Preisliste', text: players ? 'Deine Festpreise je Baustein, im Rahmen aus dem Admin-Panel. Neue Preise gelten für neue Aufträge, offene behalten ihren Preis. Günstig füllt die Warteschlange, gute Bewertungen rechtfertigen mehr.' : `Ab Stufe ${orderLevel} legst du hier deine Preise für Mitglieder fest.` },
      { key: 'werkstatt', sheet: 'werkstatt', title: 'Werkstatt', text: 'Ausbauen bringt neue Arbeitsschritte und mehr Lohn, Werkzeuge machen die Arbeit am Tisch bequemer. Hier änderst du auch Name und Kürzel.' },
      { key: 'buegeln', sheet: 'buegeln', title: 'Eigene Karten bügeln', text: 'Karten mit Knick aus Quests, Dungeon und Turm. Je glatter, desto höher die Obergrenze der Note (bis 9) – Vorsicht vor Brandflecken. Ein Versuch je Karte.' },
      { key: 'meilensteine', sheet: 'meilensteine', title: 'Erfolge', text: 'Meilensteine rund ums Grading – mit dem Fortschritt bis zum nächsten.' },
      { key: 'karton', title: 'Selbst einreichen', text: 'Lass eigene Karten bei einem anderen Shop graden – so kommst du an Slabs für deine Vitrine.' },
    ];
  %>
  <script type="application/json" data-gd-tour><%- JSON.stringify(tour) %></script><%# feste Texte ohne Nutzereingaben %>
  <div class="gd-desk" data-gd-desk<% if (tab) { %> data-gd-start="<%= tab %>"<% } %><% if (shop.code && !shop.tourSeenAt) { %> data-gd-tour-auto<% } %>>
    <%# ---------- Namensschild: Shop, Stufe, Reputation, heute ---------- %>
    <header class="gd-plate" data-tour="schild">
      <div class="gd-plate-id">
        <h1><%= shop.name || 'Dein Grading-Shop' %></h1>
        <% if (shop.code) { %><span class="gd-stamp" aria-label="Kürzel <%= shop.code %>"><%= shop.code %></span><% } %>
        <% if (shop.codeRequest) { %><span class="gd-seal" aria-label="Neues Kürzel <%= shop.codeRequest.code %> beantragt">⏳ <%= shop.codeRequest.code %></span><% } %>
      </div>
      <div class="gd-plate-meta">
        <span class="gd-level" aria-label="Stufe <%= info.level %> von <%= levels.length %>: <%= info.name %>"><% levels.forEach((l) => { %><i class="<%= l.level <= info.level ? 'is-on' : '' %>"></i><% }) %><b><%= info.name %></b></span>
        <% if (tier && shop.code) { %>
          <span class="gd-rep" aria-label="<%= tier.label %>, Reputation <%= Math.round(r.reputation) %><%= tier.next ? ' von ' + tier.next : '' %>"><b><%= tier.label %></b><span class="gh-bar" aria-hidden="true"><span style="width: <%= repPct %>%"></span></span></span>
        <% } %>
      </div>
      <div class="gd-plate-today">
        <span class="gd-coins" data-gd-coins aria-label="Heute verdient: <%= euro(earnedToday) %>"><i></i><i></i><i></i><b><%= euro(earnedToday) %></b></span>
        <span class="gd-quota" aria-label="Aufträge heute: <%= used %> von <%= limit %>"><span aria-hidden="true">✉</span><span class="gr-pips" aria-hidden="true"><% for (let i = 0; i < limit; i++) { %><span class="<%= i < used ? 'is-on' : '' %>"></span><% } %></span></span>
        <% if (players) { %><span class="gd-quota" aria-label="Aufträge von Mitgliedern heute: <%= playerUsed %> von <%= playerLimit %>"><span aria-hidden="true">👤</span><span class="gr-pips" aria-hidden="true"><% for (let i = 0; i < playerLimit; i++) { %><span class="<%= i < playerUsed ? 'is-on' : '' %>"></span><% } %></span></span><% } %>
      </div>
      <button type="button" class="gd-help" data-tour-start aria-label="Tour: So funktioniert dein Shop">?</button>
    </header>

    <%# ---------- Glasvitrine ---------- %>
    <% if (shop.code) { %>
      <%- include('partials/grading-desk/vitrine', { items: shown, max: showcaseMax, editHref: hubUrl('vitrine') }) %>
    <% } %>

    <%# ---------- Schneidematte: genau eine Hauptaktion ---------- %>
    <section class="gd-mat <%= openJob ? 'is-work' : !shop.code ? 'is-name' : canTake ? 'is-mail' : 'is-closed' %>" data-tour="matte" aria-label="Werkbank">
      <% if (openJob) { %>
        <% if (openJob.card) { %><img class="gd-mat-card r-<%= openJob.card.rarity %>" src="<%= openJob.card.image %>" alt="" width="120" height="168"><% } %>
        <div class="gd-mat-text">
          <h2><%= openJob.card ? openJob.card.name : 'Karte' %></h2>
          <span class="gd-mat-who">für <%= openJob.customer %></span>
          <% if (openJob.services) { %><%- include('partials/grading-services', { sv: openJob.services }) %><% } %>
        </div>
        <a class="gd-go" href="/grading/werkbank">▶ Weiter</a>
      <% } else if (!shop.code) { %>
        <form method="post" action="/grading/name" class="gd-namecard">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h2>Wie heißt dein Shop?</h2>
          <label class="field"><span>Name</span><input type="text" name="name" minlength="3" maxlength="30" placeholder="Günthers Kartenklinik" required></label>
          <label class="field"><span>Kürzel – steht auf jedem Slab</span><input type="text" name="code" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" autocomplete="off" placeholder="GKK" required></label>
          <button class="gd-go" type="submit">▶ Shop eröffnen</button>
        </form>
      <% } else if (canTake) { %>
        <span class="gd-envelope<%= nextOrder && nextOrder.services.express ? ' is-express' : '' %>" aria-hidden="true">
          <% if (nextOrder && nextOrder.cardInfo) { %><img src="<%= nextOrder.cardInfo.image %>" alt="" width="60" height="84"><% } %>
          <span class="gd-envelope-flap"></span>
          <% if (nextOrder && nextOrder.services.express) { %><span class="gd-envelope-stamp">EXPRESS</span><% } %>
        </span>
        <div class="gd-mat-text">
          <% if (nextOrder) { %>
            <h2><%= nextOrder.cardInfo ? nextOrder.cardInfo.name : nextOrder.card %></h2>
            <span class="gd-mat-who">von <%= nextOrder.ownerName %> · <b>+<%= euro(nextOrder.price) %></b></span>
            <%- include('partials/grading-services', { sv: nextOrder.services }) %>
          <% } else { %>
            <h2>Neuer Auftrag</h2>
            <span class="gd-mat-who">noch <%= limit - used %> heute</span>
          <% } %>
        </div>
        <form method="post" action="/grading/auftrag">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="gd-go" type="submit">▶ Annehmen</button>
        </form>
      <% } else { %>
        <span class="gd-mug" aria-hidden="true"><span></span></span>
        <div class="gd-mat-text">
          <h2>Feierabend</h2>
          <span class="gd-mat-who">Neue Aufträge ab <%= bonusTime %> Uhr<% if (waiting) { %> · <%= waiting %> ✉ warten<% } %></span>
        </div>
      <% } %>
    </section>

    <%# ---------- Objekte auf dem Tisch ---------- %>
    <a class="gd-obj gd-tray<%= players ? '' : ' is-locked' %>" href="<%= hubUrl('auftraege') %>" data-gd-open="auftraege" data-tour="eingang" aria-label="Eingang: <%= players ? queue.length + ' Karten von Mitgliedern warten' : 'ab Stufe ' + orderLevel %>">
      <span class="gd-tray-box">
        <% queue.slice(0, 4).forEach((o, i) => { %><span class="gd-tray-mail<%= o.services.express ? ' is-express' : '' %>" style="--i: <%= i %>"></span><% }) %>
        <% if (!players) { %><span class="gd-lock" aria-hidden="true">🔒</span><% } %>
      </span>
      <% if (queue.length) { %><span class="gd-badge"><%= queue.length %></span><% } %>
      <span class="gd-tag">Eingang</span>
    </a>

    <a class="gd-obj gd-spike" href="<%= hubUrl('bons') %>" data-gd-open="bons" data-tour="spiess" aria-label="Kassenzettel: heute <%= bons.length %> Aufträge, <%= euro(earnedToday) %>">
      <span class="gd-spike-stack" data-gd-spike>
        <% bons.slice(0, 5).reverse().forEach((b, i, arr) => { %><span class="gd-spike-bon" style="--i: <%= i %>; --r: <%= ((i * 37) % 13) - 6 %>deg"><% if (i === arr.length - 1) { %><b>+<%= euro(b.total) %></b><% } %></span><% }) %>
        <span class="gd-spike-nail" aria-hidden="true"></span>
      </span>
      <span class="gd-spike-base"><%= euro(earnedToday) %></span>
      <span class="gd-tag">Bons</span>
    </a>

    <a class="gd-obj gd-phone" href="<%= hubUrl('bewertungen') %>" data-gd-open="bewertungen" data-tour="handy" aria-label="Bewertungen: <%= r && r.stars != null ? fmtStars(r.stars) + ' Sterne aus ' + r.starCount : 'noch keine' %><%= newReviews ? ', ' + newReviews + ' neu' : '' %>">
      <span class="gd-phone-body"><span class="gd-phone-screen">
        <b><%= r ? fmtStars(r.stars) : '–' %></b>
        <span class="gd-stars" aria-hidden="true"><%= starRow(r && r.stars) %></span>
        <small>(<%= r ? r.starCount : 0 %>)</small>
        <% if (reviews[0] && reviews[0].tags.length) { %><span class="gd-phone-quote">„<%= reviews[0].tags.map((t) => t.label).join(', ') %>“</span><% } %>
      </span></span>
      <% if (newReviews) { %><span class="gd-badge" data-gd-new-reviews><%= newReviews %></span><% } %>
      <span class="gd-tag">Bewertungen</span>
    </a>

    <a class="gd-obj gd-clip<%= players ? '' : ' is-locked' %>" href="<%= hubUrl('preise') %>" data-gd-open="preise" data-tour="preise" aria-label="Preisliste<%= players ? '' : ': ab Stufe ' + orderLevel %>">
      <span class="gd-clip-board"><span class="gd-clip-clamp" aria-hidden="true"></span><span class="gd-clip-paper">
        <% if (players) { %>
          <% services.forEach((sv) => { %><span><span><%= sv.short %></span><b><%= euro(shopPrices[sv.key]) %></b></span><% }) %>
        <% } else { %><span class="gd-lock" aria-hidden="true">🔒</span><% } %>
      </span></span>
      <span class="gd-tag">Preise</span>
    </a>

    <div class="gd-shelf">
      <a class="gd-obj gd-roll" href="<%= hubUrl('werkstatt') %>" data-gd-open="werkstatt" data-tour="werkstatt" aria-label="Werkstatt: Stufe <%= info.level %>, <%= ownedTools %> von <%= tools.length %> Werkzeugen<%= attention.upgrade || attention.tool ? ' – etwas ist bezahlbar' : '' %>">
        <span class="gd-roll-body" aria-hidden="true"><i>🔧</i><i>🧽</i><i>📐</i><i>🔦</i></span>
        <% if (attention.upgrade || attention.tool) { %><span class="gd-badge is-dot">!</span><% } %>
        <span class="gd-tag">Werkstatt</span>
      </a>
      <% if (ironable.length) { %>
        <a class="gd-obj gd-iron" href="<%= hubUrl('buegeln') %>" data-gd-open="buegeln" data-tour="buegeln" aria-label="Eigene Karten bügeln: <%= ironable.length %> mit Knick">
          <svg class="gd-iron-svg" viewBox="0 0 64 44" aria-hidden="true"><path d="M6 36 C6 22 16 12 34 12 L58 12 L58 36 Z" fill="#c9ccd6"/><path d="M6 36 L58 36 L58 40 L6 40 Z" fill="#8b8f9c"/><path d="M26 12 C26 4 50 4 50 12" fill="none" stroke="#3f424d" stroke-width="5" stroke-linecap="round"/><circle cx="44" cy="24" r="4" fill="#f87171"/></svg>
          <span class="gd-badge"><%= ironable.length %></span>
          <span class="gd-tag">Bügeln</span>
        </a>
      <% } %>
      <% if (milestones.length) { %>
        <a class="gd-obj gd-cup" href="<%= hubUrl('meilensteine') %>" data-gd-open="meilensteine" data-tour="meilensteine" aria-label="Meilensteine: <%= milesDone %> von <%= milestones.length %>">
          <svg class="gd-cup-svg" viewBox="0 0 48 52" aria-hidden="true"><path d="M12 4 H36 V18 C36 26 30 31 24 31 C18 31 12 26 12 18 Z" fill="#e3b341"/><path d="M12 8 H5 C5 18 9 21 13 21 M36 8 H43 C43 18 39 21 35 21" fill="none" stroke="#e3b341" stroke-width="3"/><rect x="21" y="30" width="6" height="9" fill="#c99a2e"/><rect x="13" y="39" width="22" height="7" rx="2" fill="#6b4a2b"/></svg>
          <span class="gd-cup-count"><%= milesDone %>/<%= milestones.length %></span>
          <span class="gd-tag">Erfolge</span>
        </a>
      <% } %>
      <a class="gd-obj gd-box" href="/grading/einreichen" data-tour="karton" aria-label="Eigene Karte bei einem anderen Shop graden lassen">
        <span class="gd-box-body" aria-hidden="true"><span class="gd-box-tape"></span></span>
        <span class="gd-tag">Einreichen</span>
      </a>
    </div>
  </div>

  <%# ================= Fenster ================= %>

  <%# Eingang: Warteschlange der Mitglieder-Aufträge %>
  <dialog class="gd-sheet" data-gd-sheet="auftraege" aria-labelledby="gd-auftraege-t">
    <%- sheetHead('auftraege', 'Eingang') %>
    <div class="gd-sheet-body">
      <% if (!players) { %>
        <p class="gd-locked"><span aria-hidden="true">🔒</span> Ab Stufe <%= orderLevel %></p>
      <% } else if (queue.length) { %>
        <p class="gd-chips"><span>Normal <%= orderDays %> T</span><span class="is-express">Express <%= expressDays %> T</span></p>
        <ul class="gr-done"><% queue.forEach((o) => { %><%- include('partials/grading-order-row', { o }) %><% }) %></ul>
      <% } else { %>
        <p class="gd-empty"><span aria-hidden="true">📭</span> Leer</p>
      <% } %>
    </div>
  </dialog>

  <%# Kassenzettel: heute erledigt, darunter ältere Mitglieder-Aufträge %>
  <dialog class="gd-sheet" data-gd-sheet="bons" aria-labelledby="gd-bons-t">
    <%- sheetHead('bons', 'Kassenzettel') %>
    <div class="gd-sheet-body">
      <p class="gd-sum-line"><span>Heute</span><b><%= euro(earnedToday) %></b></p>
      <% if (bons.length) { %>
        <ul class="gd-bons"><% bons.forEach((b) => { %><%- include('partials/grading-desk/bon', { b }) %><% }) %></ul>
      <% } else { %>
        <p class="gd-empty"><span aria-hidden="true">🧾</span> Noch kein Bon</p>
      <% } %>
      <% if (history.length) { %>
        <h3 class="gd-sheet-sub">Mitglieder</h3>
        <ul class="gd-bons">
          <% history.forEach((o) => {
            const done = o.status === 'fertig';
            const res = !done ? (o.status === 'abgelaufen' ? 'abgelaufen – erstattet' : 'storniert') : o.services.review ? (o.result.changed ? `Zweitprüfung: Note ${o.result.grade} statt ${o.result.before}` : `Zweitprüfung: Note ${o.result.grade} bestätigt`) : o.result && o.result.grade != null ? `Slab · Note ${o.result.grade}` : 'gebügelt';
          %>
            <%- include('partials/grading-desk/bon', { b: { card: o.cardInfo, title: o.cardInfo ? o.cardInfo.name : o.card, who: o.ownerName, at: o.doneAt, lines: linesOf(o.priceParts, true), total: done ? o.price : null, note: res + (o.stars ? ' · ' + '★'.repeat(o.stars) : ''), void: !done } }) %>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </dialog>

  <%# Vitrine einräumen: Schublade mit allen eigenen Slabs %>
  <% if (shop.code) { %>
  <dialog class="gd-sheet" data-gd-sheet="vitrine" aria-labelledby="gd-vitrine-t">
    <%- sheetHead('vitrine', `Vitrine <span class="gr-dim">${shown.length} / ${showcaseMax}</span>`) %>
    <div class="gd-sheet-body">
      <% if (showcase.length) { %>
        <form method="post" action="/grading/vitrine" class="gd-drawer" data-gd-drawer data-max="<%= showcaseMax %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="gd-drawer-grid">
            <% showcase.forEach((s) => { const rl = (rarityByKey[s.rarity] || { label: '' }).label; %>
              <label class="gd-drawer-item r-<%= s.rarity %><%= s.lock ? ' is-locked' : '' %>" title="<%= s.card.name %><%= s.lock ? ' – gesperrt' : '' %>">
                <input type="checkbox" name="doc" value="<%= s.id %>" <%= s.shown ? 'checked' : '' %> <%= s.lock ? 'disabled' : '' %> aria-label="<%= s.card.name %>, Note <%= s.slab.grade %><%= s.lock ? ', gesperrt' : '' %>">
                <span class="foil-card foil-card-slot"><%- include('partials/foil-mini', { card: s.card, rarityLabel: rl, slab: s.slab, id: s.id }) %></span>
                <% if (s.lock) { %><span class="gd-lock" aria-hidden="true">🔒</span><% } %>
              </label>
            <% }) %>
          </div>
          <div class="gd-sheet-actions">
            <a class="btn btn-ghost btn-sm" href="/grading/shop/<%= shop.code %>">Shop-Seite</a>
            <button class="btn btn-primary" type="submit">Speichern</button>
          </div>
        </form>
      <% } else { %>
        <p class="gd-empty"><span aria-hidden="true">🗄️</span> Noch kein Slab</p>
        <a class="btn btn-primary btn-block" href="/grading/einreichen">Karte graden lassen</a>
      <% } %>
    </div>
  </dialog>
  <% } %>

  <%# Bewertungen %>
  <dialog class="gd-sheet" data-gd-sheet="bewertungen" aria-labelledby="gd-bewertungen-t">
    <%- sheetHead('bewertungen', 'Bewertungen') %>
    <div class="gd-sheet-body">
      <% if (r) { %>
        <dl class="gd-review-facts">
          <dt>Qualität</dt><dd><%= r.quality != null ? Math.round(r.quality) + ' %' : '–' %></dd>
          <dt>Treffsicher</dt><dd><%= r.hitRate != null ? Math.round(r.hitRate) + ' %' : '–' %></dd>
          <dt>Aufträge</dt><dd><%= shop.jobsDone %></dd>
        </dl>
        <%- include('partials/grading-desk/reviews', { r, histogram, reviews }) %>
      <% } %>
    </div>
  </dialog>

  <%# Preise: Festpreise je Baustein im Rahmen aus dem Admin-Panel %>
  <dialog class="gd-sheet" data-gd-sheet="preise" aria-labelledby="gd-preise-t">
    <%- sheetHead('preise', 'Preisliste') %>
    <div class="gd-sheet-body">
      <% if (players) { %>
        <form method="post" action="/grading/preis" class="form gd-prices" data-gh-prices>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- tabInput('preise') %>
          <% services.forEach((sv) => { const pr = servicePrice[sv.key]; %>
            <label class="gd-price-row"><span><%= sv.label %><small><%= euro(pr.min) %> – <%= euro(pr.max) %></small></span>
              <input type="text" name="<%= sv.key %>" inputmode="decimal" value="<%= (shopPrices[sv.key] / 100).toFixed(2).replace('.', ',') %>" data-min="<%= pr.min %>" data-max="<%= pr.max %>" required aria-label="<%= sv.label %> in Euro"></label>
          <% }) %>
          <div class="gs-shop gh-preview" aria-label="So sehen Kunden dich">
            <span class="gs-shop-head"><b><%= shop.name %></b> <span class="gr-shop-code"><%= shop.code %></span></span>
            <span class="gs-shop-price"><b data-gh-sum><%= euro(shopPrices.base + shopPrices.slab) %></b> Reinigung + Slab</span>
            <span class="gs-shop-list muted small">mit Bügeln <b data-gh-sum-iron><%= euro(shopPrices.base + shopPrices.iron + shopPrices.slab) %></b> · Express +<span data-gh-express><%= euro(shopPrices.express) %></span></span>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Speichern</button>
        </form>
      <% } else { %>
        <p class="gd-locked"><span aria-hidden="true">🔒</span> Ab Stufe <%= orderLevel %></p>
      <% } %>
    </div>
  </dialog>

  <%# Werkstatt: Ausbau, Werkzeuge, Shop, Vertrag %>
  <dialog class="gd-sheet" data-gd-sheet="werkstatt" aria-labelledby="gd-werkstatt-t">
    <%- sheetHead('werkstatt', 'Werkstatt') %>
    <div class="gd-sheet-body">
      <ol class="gr-tree">
        <% levels.forEach((l) => { const done = l.level <= info.level; %>
          <li class="<%= done ? 'is-done' : '' %> <%= next && l.level === next.level ? 'is-next' : '' %>">
            <span class="gr-tree-dot"><%= done ? '✓' : l.level %></span>
            <span class="gr-tree-body">
              <span class="gr-tree-name"><%= l.name %><% if (l.cost) { %><span><%= euro(l.cost) %></span><% } %></span>
              <span class="gr-tree-perk"><%= l.perk %></span>
            </span>
          </li>
        <% }) %>
      </ol>
      <% if (next) { %>
        <form method="post" action="/grading/ausbauen" data-confirm="Für <%= euro(next.cost) %> auf Stufe <%= next.level %> („<%= next.name %>“) ausbauen?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- tabInput('werkstatt') %>
          <button class="btn btn-primary btn-block" type="submit" <%= currentUser.balance < next.cost ? 'disabled' : '' %>>Ausbauen · <%= euro(next.cost) %></button>
        </form>
      <% } %>

      <h3 class="gd-sheet-sub">Werkzeuge</h3>
      <ul class="gh-tools">
        <% tools.forEach((t) => { %>
          <li class="gh-tool<%= t.owned ? ' is-owned' : '' %><%= !t.available ? ' is-locked' : '' %>">
            <span class="gh-tool-icon" aria-hidden="true"><%= { tuch: '🧽', schablone: '📐', eisen: '♨️', uv: '🔦' }[t.key] %></span>
            <span class="gh-tool-text"><b><%= t.name %></b><small><%= t.perk %></small></span>
            <% if (t.owned) { %>
              <span class="gh-tool-state">✓</span>
            <% } else if (!t.available) { %>
              <span class="gh-tool-state">🔒 Stufe <%= t.level %></span>
            <% } else { %>
              <form method="post" action="/grading/werkzeug" data-confirm="<%= t.name %> für <%= euro(t.cost) %> kaufen?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <%- tabInput('werkstatt') %>
                <input type="hidden" name="tool" value="<%= t.key %>">
                <button class="btn btn-sm" type="submit" <%= currentUser.balance < t.cost ? 'disabled' : '' %>><%= euro(t.cost) %></button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>

      <h3 class="gd-sheet-sub">Shop</h3>
      <form method="post" action="/grading/name" class="form gd-shopform">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- tabInput('werkstatt') %>
        <label class="field"><span>Name</span><input type="text" name="name" minlength="3" maxlength="30" value="<%= shop.name %>" required></label>
        <label class="field"><span>Kürzel</span><input type="text" name="code" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" autocomplete="off" value="<%= shop.code %>" required></label>
        <button class="btn btn-sm" type="submit">Speichern</button>
        <% if (shop.codeRequest) { %><p class="small">⏳ <b><%= shop.codeRequest.code %></b> wartet auf Freigabe</p><% } %>
      </form>
      <dl class="gr-facts">
        <dt>Aufträge pro Tag</dt><dd><%= info.jobs %><% if (players) { %> + <%= playerLimit %> Mitglieder<% } %></dd>
        <dt>Erledigt</dt><dd><%= shop.jobsDone %> · <%= euro(shop.earned) %></dd>
        <dt>Vertrag</dt><dd><%= locked ? 'bis ' + date(shop.lockedUntil) : 'kündbar' %></dd>
      </dl>
      <% if (!locked) { %>
        <form method="post" action="/grading/kuendigen" data-confirm="Wirklich kündigen? Ab morgen gibt es wieder den Tagesbonus.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-ghost btn-sm" type="submit">Kündigen</button>
        </form>
      <% } %>
    </div>
  </dialog>

  <%# Eigene Karten mit Knick bügeln %>
  <% if (ironable.length) { %>
  <dialog class="gd-sheet" data-gd-sheet="buegeln" aria-labelledby="gd-buegeln-t">
    <%- sheetHead('buegeln', 'Bügeln') %>
    <div class="gd-sheet-body">
      <div class="gd-iron-grid">
        <% ironable.forEach((x) => { %>
          <form method="post" action="/grading/eigene/<%= x.id %>/start" class="gd-iron-item r-<%= x.info.rarity %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" aria-label="<%= x.info.name %> bügeln">
              <img src="<%= x.info.image %>" alt="" width="90" height="126" loading="lazy">
              <span><%= x.info.name %></span>
            </button>
          </form>
        <% }) %>
      </div>
    </div>
  </dialog>
  <% } %>

  <%# Meilensteine %>
  <% if (milestones.length) { %>
  <dialog class="gd-sheet" data-gd-sheet="meilensteine" aria-labelledby="gd-meilensteine-t">
    <%- sheetHead('meilensteine', `Erfolge <span class="gr-dim">${milesDone} / ${milestones.length}</span>`) %>
    <div class="gd-sheet-body">
      <ul class="gh-miles">
        <% milestones.forEach((m) => { %>
          <li class="<%= m.done ? 'is-done' : '' %>">
            <span class="gh-mile-head"><b><%= m.done ? '🏆 ' : '' %><%= m.name %></b><% if (m.progress) { %><small><%= m.progress.text %></small><% } %></span>
            <small class="muted"><%= m.text %></small>
            <% if (m.progress && !m.done) { %><span class="gh-bar" aria-hidden="true"><span style="width: <%= m.progress.pct %>%"></span></span><% } %>
          </li>
        <% }) %>
      </ul>
      <a class="small" href="/profil/<%= encodeURIComponent(currentUser.username) %>">Alle Erfolge →</a>
    </div>
  </dialog>
  <% } %>
<% } %>
</div>

<% if (active) { %>
  <script src="/js/grading-desk.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/grading-tour.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/grading-hub.js?v=<%= assetVersion %>" defer></script>
<% } %>
<%- include('partials/foil-modal') %>
<%- include('partials/foot') %>
