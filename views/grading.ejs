<%- include('partials/head') %>
<%#
  Grading-Shop (#204): ohne Job das Stellenangebot, mit Job der Shop-Hub – Kopf (Stufe, Reputation, Tageszähler),
  „Jetzt dran“ mit genau einer Hauptaktion (Werkbank) und Reiter für Übersicht, Aufträge, Vitrine, Preise, Werkstatt.
%>
<% const locked = active && shop.lockedUntil && new Date(shop.lockedUntil) > new Date(); %>
<% const tabInput = (t) => `<input type="hidden" name="reiter" value="${t}">`; %>

<div class="gr-page">
<% if (closedForOthers) { %><p class="muted small">Nur für Admins sichtbar – im Admin-Panel für alle freigeben.</p><% } %>

<% if (!active) { %>
  <div class="gr-head">
    <h1>Grading-Shop</h1>
    <a class="btn btn-ghost btn-sm gr-submit-link" href="/grading/einreichen">Eigene Karte graden lassen →</a>
  </div>
  <%# ---------- Noch kein Job: Vorstellung und Vertrag ---------- %>
  <section class="gr-hero">
    <div class="gr-hero-text">
      <p class="gr-kicker">Stellenangebot</p>
      <h2>Karten putzen, benoten, versiegeln.</h2>
      <p class="gr-lead">Sammler schicken dir ihre Karten. Du drehst sie unter der Lampe, wischst jeden Fleck weg, findest Kratzer und bestoßene Ecken – und schickst sie perfekt verpackt zurück. Je weiter du deinen Shop ausbaust, desto mehr Arbeitsschritte und desto mehr Lohn.</p>
      <ul class="gr-terms">
        <li><b>Kein Tagesbonus</b>, solange du hier arbeitest – dafür Lohn für jeden Auftrag</li>
        <li><b><%= contractDays %> Tage Vertrag</b> – so lange keine Kündigung</li>
        <li>Deine Ausbaustufe bleibt nach einer Kündigung erhalten</li>
      </ul>
      <form method="post" action="/grading/annehmen" class="gr-hire" data-confirm="Job im Grading-Shop annehmen? <%= contractDays %> Tage kein Tagesbonus und keine Kündigung.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check"><input type="checkbox" name="confirm" value="1" required> <span>Verstanden: <%= contractDays %> Tage gebunden, kein Tagesbonus.</span></label>
        <button class="btn btn-primary btn-lg gr-glow" type="submit">Job annehmen</button>
      </form>
    </div>
    <div class="gr-hero-card" aria-hidden="true">
      <% if (heroCard) { %>
        <%# Versiegelte Karte im Slab – wie nach einem Auftrag (Etikett oben, Note 10) %>
        <div class="gr-hero-slab">
          <div class="gr-hero-slab-label">
            <div class="gr-slab-info"><strong><%= locals.shopCode || 'BfW' %></strong><span><%= heroCard.name %> · <%= heroCard.rarityLabel %></span></div>
            <div class="gr-slab-score"><span class="gr-slab-word">GEM MINT</span><span class="gr-slab-grade">10</span></div>
          </div>
          <span class="tcg-slot gr-hero-slab-slot r-<%= heroCard.rarity %>">
            <span class="tcg-art">
              <img src="<%= heroCard.image %>" alt="" width="720" height="1008">
              <% if (heroCard.rarity === 'glitch') { %><img class="tcg-glitch-a" src="<%= heroCard.image %>" alt="" width="720" height="1008"><img class="tcg-glitch-b" src="<%= heroCard.image %>" alt="" width="720" height="1008"><span class="tcg-fx tcg-fx-glitch"></span><% } %>
            </span>
          </span>
          <span class="gr-hero-slab-shine"></span>
        </div>
      <% } %>
    </div>
  </section>
<% } else { %>
  <%# ---------- Kopf: Shop, Stufe, Reputation, Tageszähler ---------- %>
  <header class="gh-head">
    <div class="gh-id">
      <p class="gr-kicker">Stufe <%= info.level %> · <%= info.name %></p>
      <h1 class="gh-name"><%= shop.name || 'Grading-Shop' %><% if (shop.code) { %> <span class="gr-shop-code"><%= shop.code %></span><% } %></h1>
      <% if (rating && shop.code) { const t = rating.tier; const span = t.next ? t.next - t.min : 1; const pct = t.next ? Math.min(100, Math.round(((rating.reputation - t.min) / span) * 100)) : 100; %>
        <div class="gh-rep">
          <span><b><%= t.label %></b> · Reputation <%= Math.round(rating.reputation) %><% if (t.next) { %> <span class="gr-dim">/ <%= t.next %></span><% } %></span>
          <span class="gh-bar" role="progressbar" aria-label="Reputation bis zur nächsten Stufe" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= pct %>%"></span></span>
        </div>
      <% } %>
    </div>
    <div class="gh-today">
      <div class="gh-count"><span>NPC heute</span><b><%= used %> / <%= limit %></b>
        <span class="gr-pips" aria-hidden="true"><% for (let i = 0; i < limit; i++) { %><span class="<%= i < used ? 'is-on' : '' %>"></span><% } %></span></div>
      <% if (players) { %><div class="gh-count"><span>Mitglieder heute</span><b><%= playerUsed %> / <%= playerLimit %></b>
        <span class="gr-pips" aria-hidden="true"><% for (let i = 0; i < playerLimit; i++) { %><span class="<%= i < playerUsed ? 'is-on' : '' %>"></span><% } %></span></div><% } %>
      <div class="gh-count"><span>Heute verdient</span><b><%= euro(earnedToday) %></b></div>
    </div>
  </header>

  <%# ---------- Jetzt dran: genau eine Hauptaktion ---------- %>
  <section class="gh-now">
    <% if (openJob) { %>
      <% if (openJob.card) { %><img class="gh-now-card r-<%= openJob.card.rarity %>" src="<%= openJob.card.image %>" alt="" width="72" height="100"><% } %>
      <div class="gh-now-text">
        <p class="gr-kicker">Auf der Werkbank</p>
        <h2><%= openJob.card ? openJob.card.name : 'Karte' %> <span class="gr-dim">für <%= openJob.customer %></span></h2>
        <% if (openJob.services) { %><%- include('partials/grading-services', { sv: openJob.services }) %><% } %>
      </div>
      <a class="btn btn-primary btn-lg gr-glow" href="/grading/werkbank">Weiterarbeiten →</a>
    <% } else if (!shop.code) { %>
      <%# Ohne Namen und Kürzel keine Aufträge – das Kürzel steht auf jedem Slab %>
      <div class="gh-now-text">
        <p class="gr-kicker">Erster Schritt</p>
        <h2>Wie heißt dein Shop?</h2>
        <p class="muted">Bevor die ersten Karten kommen: Gib deinem Shop einen Namen und ein Kürzel. Das Kürzel steht auf jedem Slab, das du versiegelst.</p>
        <form method="post" action="/grading/name" class="form gr-name-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field"><span>Name</span><input type="text" name="name" minlength="3" maxlength="30" placeholder="z. B. Günthers Kartenklinik" required></label>
          <label class="field"><span>Kürzel <em>(2–5 Zeichen)</em></span><input type="text" name="code" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" autocomplete="off" placeholder="GKK" required></label>
          <button class="btn btn-primary btn-lg gr-glow" type="submit">Shop eröffnen</button>
        </form>
      </div>
    <% } else if (used < limit || (waiting && playerUsed < playerLimit)) { const next = waiting && playerUsed < playerLimit ? queue[0] : null; %>
      <% if (next && next.cardInfo) { %><img class="gh-now-card r-<%= next.cardInfo.rarity %>" src="<%= next.cardInfo.image %>" alt="" width="72" height="100"><% } else { %><span class="gh-now-mail" aria-hidden="true">✉</span><% } %>
      <div class="gh-now-text">
        <p class="gr-kicker"><%= next ? (next.services.express ? 'Express wartet' : 'Karte eines Mitglieds') : 'Briefkasten' %></p>
        <% if (next) { %>
          <h2><%= next.cardInfo ? next.cardInfo.name : next.card %> <span class="gr-dim">von <%= next.ownerName %></span></h2>
          <p class="small"><%- include('partials/grading-services', { sv: next.services }) %> +<%= euro(next.price) %> · bis <%= date(next.expiresAt) %><% if (waiting > 1) { %> · <%= waiting - 1 %> weitere warten<% } %></p>
        <% } else { %>
          <h2>Noch <%= limit - used %> <%= limit - used === 1 ? 'Karte' : 'Karten' %> für heute</h2>
          <p class="muted small">NPC-Kunden zahlen Lohn je Arbeitsschritt – je sauberer und genauer, desto mehr.</p>
        <% } %>
      </div>
      <form method="post" action="/grading/auftrag">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary btn-lg gr-glow" type="submit">Auftrag annehmen →</button>
      </form>
    <% } else { %>
      <span class="gh-now-mail" aria-hidden="true">☕</span>
      <div class="gh-now-text">
        <p class="gr-kicker">Feierabend</p>
        <h2>Alle Aufträge für heute erledigt</h2>
        <p class="muted small">Morgen ab <%= bonusTime %> Uhr kommen neue.<% if (waiting) { %> <%= waiting %> <%= waiting === 1 ? 'Karte eines Mitglieds wartet' : 'Karten von Mitgliedern warten' %> bis morgen.<% } %></p>
      </div>
    <% } %>
  </section>

  <% if (shop.code) { %>
  <nav class="tabs gh-tabs" aria-label="Bereiche des Shops">
    <% tabs.forEach((t) => { const badge = t.key === 'auftraege' ? queue.length : 0; %>
      <a class="tab <%= tab === t.key ? 'active' : '' %>" href="<%= hubUrl(t.key) %>" <% if (tab === t.key) { %>aria-current="page"<% } %>><%= t.label %><% if (badge) { %><span class="tab-count"><%= badge %></span><% } %></a>
    <% }) %>
  </nav>
  <% } %>

  <% if (tab === 'uebersicht' || !shop.code) { %>
    <%# ---------- Übersicht ---------- %>
    <% if (rating && shop.code) { %>
      <div class="gh-kpis">
        <div class="gh-kpi"><span>Bewertung</span><b><%= rating.stars != null ? '★ ' + rating.stars.toLocaleString('de-DE', { maximumFractionDigits: 1 }) : '–' %></b><small><%= rating.starCount %> Bewertung<%= rating.starCount === 1 ? '' : 'en' %></small></div>
        <div class="gh-kpi"><span>Qualität</span><b><%= rating.quality != null ? Math.round(rating.quality) + ' %' : '–' %></b><small>Ø Sauberkeit, Versiegelung, Glätte</small></div>
        <div class="gh-kpi"><span>Treffsicherheit</span><b><%= rating.hitRate != null ? Math.round(rating.hitRate) + ' %' : '–' %></b><small><%= rating.graded %> benotet</small></div>
        <div class="gh-kpi"><span>Aufträge</span><b><%= shop.jobsDone %></b><small><%= euro(shop.earned) %> verdient</small></div>
      </div>
    <% } %>

    <div class="gh-grid">
      <% if (players) { %>
        <section class="gh-card">
          <h2>Warteschlange <a class="small" href="<%= hubUrl('auftraege') %>">alle →</a></h2>
          <% if (queue.length) { %>
            <ul class="gr-done">
              <% queue.slice(0, 4).forEach((o) => { %><%- include('partials/grading-order-row', { o }) %><% }) %>
            </ul>
          <% } else { %>
            <p class="muted small">Gerade wartet keine Karte. Mitglieder finden dich unter <a href="/grading/einreichen">Karte graden lassen</a> – Rating, Preise und Vitrine entscheiden mit.</p>
          <% } %>
        </section>
      <% } %>

      <section class="gh-card">
        <h2>Heute erledigt</h2>
        <% if (doneCards.length) { %>
          <ul class="gr-done">
            <% doneCards.forEach((j) => { %><%- include('partials/grading-done-row', { j }) %><% }) %>
          </ul>
        <% } else { %>
          <p class="muted small">Noch nichts – der erste Auftrag wartet oben.</p>
        <% } %>
      </section>

      <% if (ironable.length) { %>
        <section class="gh-card">
          <h2>Eigene Karten bügeln</h2>
          <p class="muted small">Knicke aus Quests, Dungeon und Turm. Je glatter, desto höher die Obergrenze der Note (bis 9) – aber Vorsicht vor Brandflecken. Ein Versuch je Karte.</p>
          <ul class="gr-done">
            <% ironable.forEach((x, i) => { %>
              <% if (i === 4) { %></ul><details class="gh-more"><summary><%= ironable.length - 4 %> weitere</summary><ul class="gr-done"><% } %>
              <li class="r-<%= x.info.rarity %>">
                <span class="gr-done-thumb"><img src="<%= x.info.image %>" alt="" width="36" height="50" loading="lazy"></span>
                <span class="gr-done-info"><span><b><%= x.info.name %></b> <span class="gr-dim"><%= x.info.rarityLabel %> · Knick</span></span></span>
                <form method="post" action="/grading/eigene/<%= x.id %>/start">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm" type="submit">Bügeln</button>
                </form>
              </li>
            <% }) %>
          </ul><% if (ironable.length > 4) { %></details><% } %>
        </section>
      <% } %>

      <% if (shop.code) { const shown = showcase.filter((s) => s.shown); %>
        <section class="gh-card">
          <h2>Vitrine <span class="gr-dim"><%= shown.length %> / <%= showcaseMax %></span> <a class="small" href="<%= hubUrl('vitrine') %>">verwalten →</a></h2>
          <% if (shown.length) { %>
            <div class="gh-vitrine-mini">
              <% shown.slice(0, 6).forEach((s) => { const r = rarityByKey[s.rarity] || { label: '' }; %>
                <span class="foil-card foil-card-slot"><%- include('partials/foil-mini', { card: s.card, rarityLabel: r.label, slab: s.slab, id: s.id }) %></span>
              <% }) %>
            </div>
          <% } else { %>
            <p class="muted small">Leer. Ausgestellte Slabs boosten deine Reputation je Auftrag – je seltener und besser benotet, desto mehr.</p>
          <% } %>
        </section>
      <% } %>
    </div>

  <% } else if (tab === 'auftraege') { %>
    <%# ---------- Aufträge: Warteschlange und Verlauf ---------- %>
    <% if (players) { %>
      <section class="gh-card">
        <h2>Warteschlange</h2>
        <p class="muted small">Express zuerst, dann die ältesten. Normal hast du <%= orderDays %> Tage, mit Express <%= expressDays %> – sonst geht die Karte samt Geld zurück. Die echte Note bleibt geheim: auf den Slab kommt deine.</p>
        <% if (queue.length) { %>
          <ul class="gr-done"><% queue.forEach((o) => { %><%- include('partials/grading-order-row', { o }) %><% }) %></ul>
        <% } else { %>
          <p class="muted small">Gerade wartet keine Karte.</p>
        <% } %>
      </section>
    <% } else { %>
      <section class="gh-card"><p class="muted">Ab Stufe <%= orderLevel %> (Slab-Werkstatt) schicken dir auch Mitglieder ihre Karten – zu deinen Preisen.</p></section>
    <% } %>
    <section class="gh-card">
      <h2>Heute erledigt</h2>
      <% if (doneCards.length) { %>
        <ul class="gr-done"><% doneCards.forEach((j) => { %><%- include('partials/grading-done-row', { j }) %><% }) %></ul>
      <% } else { %>
        <p class="muted small">Heute noch nichts erledigt.</p>
      <% } %>
    </section>
    <% if (history.length) { %>
      <section class="gh-card">
        <h2>Aufträge von Mitgliedern</h2>
        <ul class="gr-done">
          <% history.forEach((o) => { const c = o.cardInfo; %>
            <li class="<%= c ? 'r-' + c.rarity : '' %>">
              <span class="gr-done-thumb"><% if (c) { %><img src="<%= c.image %>" alt="" width="36" height="50" loading="lazy"><% } %></span>
              <span class="gr-done-info">
                <span><b><%= c ? c.name : o.card %></b> <span class="gr-dim">von <%= o.ownerName %> · <%= date(o.doneAt) %></span></span>
                <span class="gr-done-meta"><%- include('partials/grading-services', { sv: o.services }) %>
                  <% if (o.status === 'fertig') { %><%= o.result && o.result.grade != null ? 'Note ' + o.result.grade : 'gebügelt' %><%= o.stars ? ' · ' + '★'.repeat(o.stars) : '' %><% } else { %><%= o.status === 'abgelaufen' ? 'abgelaufen – erstattet' : 'storniert' %><% } %></span>
              </span>
              <b class="gr-pay"><%= o.status === 'fertig' ? '+' + euro(o.price) : '–' %></b>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>

  <% } else if (tab === 'vitrine') { %>
    <%# ---------- Vitrine: eigene Slabs ausstellen; Seltenheit × Note boostet die Reputation je Auftrag ---------- %>
    <section class="gh-card gr-vitrine" id="vitrine">
      <h2>Vitrine <span class="gr-dim"><%= showcase.filter((s) => s.shown).length %> / <%= showcaseMax %></span></h2>
      <% if (showcase.length) { %>
        <p class="muted small">Ausgestellte Slabs sehen alle auf deiner <a href="/grading/shop/<%= shop.code %>">Shop-Seite</a>. Je seltener und besser benotet, desto schneller wächst deine Reputation. Ausgestellt lassen sie sich nicht handeln.</p>
        <form method="post" action="/grading/vitrine" class="gr-vitrine-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="gr-vitrine-grid">
            <% showcase.forEach((s) => { const r = rarityByKey[s.rarity] || { label: '' }; %>
              <label class="gr-vitrine-item r-<%= s.rarity %><%= s.lock ? ' is-locked' : '' %>">
                <input type="checkbox" name="doc" value="<%= s.id %>" <%= s.shown ? 'checked' : '' %> <%= s.lock ? 'disabled' : '' %>>
                <span class="foil-card foil-card-slot"><%- include('partials/foil-mini', { card: s.card, rarityLabel: r.label, slab: s.slab, id: s.id }) %></span>
                <span class="small"><%= s.card.name %><%= s.lock ? ' · gesperrt' : '' %></span>
              </label>
            <% }) %>
          </div>
          <button class="btn btn-primary btn-sm" type="submit">Vitrine speichern</button>
        </form>
      <% } else { %>
        <p class="muted small">Du hast noch keinen Slab. Lass eine Karte bei einem anderen Shop graden – dann kannst du sie hier ausstellen.</p>
      <% } %>
    </section>

  <% } else if (tab === 'preise') { %>
    <%# ---------- Preise: Festpreise je Baustein im Rahmen aus dem Admin-Panel ---------- %>
    <% if (players) { %>
      <div class="gh-grid">
        <section class="gh-card">
          <h2>Festpreise für Mitglieder</h2>
          <p class="muted small">Kunden buchen Bausteine und zahlen die Summe. Neue Preise gelten für neue Aufträge – offene behalten ihren Preis.</p>
          <form method="post" action="/grading/preis" class="form gr-price-form" data-gh-prices>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%- tabInput('preise') %>
            <% services.forEach((sv) => { const r = servicePrice[sv.key]; %>
              <label class="field gh-price-field"><span><%= sv.label %> <em><%= euro(r.min) %> – <%= euro(r.max) %></em></span>
                <input type="text" name="<%= sv.key %>" inputmode="decimal" value="<%= (shopPrices[sv.key] / 100).toFixed(2).replace('.', ',') %>" data-min="<%= r.min %>" data-max="<%= r.max %>" required></label>
            <% }) %>
            <button class="btn btn-primary btn-sm" type="submit">Preise speichern</button>
          </form>
        </section>
        <section class="gh-card">
          <h2>So sehen Kunden dich</h2>
          <div class="gs-shop gh-preview">
            <span class="gs-shop-head"><b><%= shop.name %></b> <span class="gr-shop-code"><%= shop.code %></span></span>
            <%- include('partials/grading-rating', { r: rating }) %>
            <span class="gs-shop-price"><b data-gh-sum><%= euro(shopPrices.base + shopPrices.slab) %></b> für Reinigung + Slab</span>
            <span class="gs-shop-list muted small">mit Bügeln <b data-gh-sum-iron><%= euro(shopPrices.base + shopPrices.iron + shopPrices.slab) %></b> · Express +<span data-gh-express><%= euro(shopPrices.express) %></span></span>
          </div>
          <p class="muted small">Ein typischer Auftrag ist Reinigung + Slab. Günstige Preise füllen die Warteschlange, gute Bewertungen rechtfertigen höhere.</p>
        </section>
      </div>
    <% } else { %>
      <section class="gh-card"><p class="muted">Ab Stufe <%= orderLevel %> (Slab-Werkstatt) schicken dir auch Mitglieder ihre Karten – dann legst du hier deine Preise fest.</p></section>
    <% } %>

  <% } else if (tab === 'werkstatt') { %>
    <%# ---------- Werkstatt: Ausbau, Name/Kürzel, Vertrag ---------- %>
    <div class="gh-grid">
      <section class="gh-card gr-tree-wrap">
        <h2>Ausbau</h2>
        <ol class="gr-tree">
          <% levels.forEach((l) => { const done = l.level <= info.level; %>
            <li class="<%= done ? 'is-done' : '' %> <%= next && l.level === next.level ? 'is-next' : '' %>">
              <span class="gr-tree-dot"><%= done ? '✓' : l.level %></span>
              <span class="gr-tree-body">
                <span class="gr-tree-name"><%= l.name %><% if (l.cost) { %><span><%= euro(l.cost) %></span><% } %></span>
                <span class="gr-tree-perk"><%= l.perk %></span>
              </span>
            </li>
          <% }) %>
        </ol>
        <% if (next) { %>
          <form method="post" action="/grading/ausbauen" data-confirm="Für <%= euro(next.cost) %> auf Stufe <%= next.level %> („<%= next.name %>“) ausbauen?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%- tabInput('werkstatt') %>
            <button class="btn btn-primary btn-block" type="submit" <%= currentUser.balance < next.cost ? 'disabled' : '' %>>Ausbauen für <%= euro(next.cost) %></button>
            <p class="muted small">Danach heute noch einmal <%= next.jobs %> Aufträge.</p>
          </form>
        <% } %>
      </section>

      <section class="gh-card">
        <h2>Werkzeuge</h2>
        <p class="muted small">Machen die Arbeit am Tisch angenehmer – mehr Lohn gibt es dafür nicht. Einmal gekauft, gehören sie dir.</p>
        <ul class="gh-tools">
          <% tools.forEach((t) => { %>
            <li class="gh-tool<%= t.owned ? ' is-owned' : '' %><%= !t.available ? ' is-locked' : '' %>">
              <span class="gh-tool-icon" aria-hidden="true"><%= { tuch: '🧽', schablone: '📐', eisen: '♨️', uv: '🔦' }[t.key] %></span>
              <span class="gh-tool-text"><b><%= t.name %></b><small><%= t.perk %></small></span>
              <% if (t.owned) { %>
                <span class="gh-tool-state">✓ vorhanden</span>
              <% } else if (!t.available) { %>
                <span class="gh-tool-state">ab Stufe <%= t.level %></span>
              <% } else { %>
                <form method="post" action="/grading/werkzeug" data-confirm="<%= t.name %> für <%= euro(t.cost) %> kaufen?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <%- tabInput('werkstatt') %>
                  <input type="hidden" name="tool" value="<%= t.key %>">
                  <button class="btn btn-sm" type="submit" <%= currentUser.balance < t.cost ? 'disabled' : '' %>><%= euro(t.cost) %></button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="gh-card">
        <h2>Shop</h2>
        <form method="post" action="/grading/name" class="form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- tabInput('werkstatt') %>
          <label class="field"><span>Name</span><input type="text" name="name" minlength="3" maxlength="30" value="<%= shop.name %>" required></label>
          <label class="field"><span>Kürzel</span><input type="text" name="code" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" autocomplete="off" value="<%= shop.code %>" required></label>
          <button class="btn btn-sm" type="submit">Speichern</button>
          <p class="muted small">Den Namen kannst du jederzeit ändern. Ein neues Kürzel muss ein Admin oder Dev freigeben – es steht auf deinen Slabs. Ältere Slabs behalten das alte.</p>
          <% if (shop.codeRequest) { %><p class="small">Beantragt: <b><%= shop.codeRequest.code %></b> – wartet auf Freigabe.</p><% } %>
        </form>
        <a class="small" href="/grading/shop/<%= shop.code %>">Öffentliche Shop-Seite ansehen →</a>
        <dl class="gr-facts">
          <dt>NPC-Aufträge pro Tag</dt><dd><%= info.jobs %></dd>
          <% if (players) { %><dt>Aufträge von Mitgliedern</dt><dd><%= playerLimit %> pro Tag</dd><% } %>
          <dt>Erledigt insgesamt</dt><dd><%= shop.jobsDone %></dd>
          <dt>Verdient insgesamt</dt><dd><%= euro(shop.earned) %></dd>
          <dt>Vertrag</dt><dd><%= locked ? 'bis ' + date(shop.lockedUntil) : 'kündbar' %></dd>
        </dl>
        <% if (locked) { %>
          <p class="gr-note">Kündigen möglich ab <%= date(shop.lockedUntil) %></p>
        <% } else { %>
          <form method="post" action="/grading/kuendigen" data-confirm="Wirklich kündigen? Ab morgen gibt es wieder den Tagesbonus.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-sm" type="submit">Kündigen</button>
          </form>
        <% } %>
      </section>
    </div>
  <% } %>

  <p class="gh-foot"><a href="/grading/einreichen">Eigene Karte bei einem anderen Shop graden lassen →</a></p>
<% } %>
</div>

<script src="/js/grading-hub.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foil-modal') %>
<%- include('partials/foot') %>
