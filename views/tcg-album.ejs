<%- include('partials/head') %>
<%
  // Eine Kachel je Karte: alle Versionen (Seltenheiten) einer Person bzw. eines Gegenstands zusammen. Die Kachel zeigt die
  // beste eigene Version; ein Klick entfaltet alle Versionen (public/js/tcg.js, Album: Versionen). Fortschritt in Karten.
  const rankOf = (c) => (rarityByKey[c.rarity] || {}).rank || 0;
  const isHidden = (c) => !!(rarityByKey[c.rarity] || {}).hidden;
  const fxFor = (rarity) => ({ bfwler: 'shine', gold: 'shine', icon: 'shine', sith: 'shine', holo: 'holo', bockhaber: 'bock', glitch: 'glitch', arcane: 'arcane' })[rarity] || '';
  const groupMap = new Map();
  for (const c of cards.filter((x) => x.rarity !== 'test-item').concat(unreleased)) {
    const key = groupKeyOf(c.id);
    if (!groupMap.has(key)) groupMap.set(key, { key, season: c.season, cards: [] });
    groupMap.get(key).cards.push(c);
  }
  const groups = [...groupMap.values()].map((g) => {
    const list = g.cards.filter((c) => !isHidden(c) || counts[c.id]).sort((a, b) => rankOf(a) - rankOf(b));
    const owned = list.filter((c) => counts[c.id] || (foiledCopies[c.id] || []).length);
    const seen = list.filter((c) => seenIds.has(c.id));
    const best = owned.length ? owned[owned.length - 1] : null;
    const shownCard = best || (seen.length ? seen[seen.length - 1] : null);
    // Name der Karte: der Name der häufigsten Version (Boss-Versionen heißen oft anders, z. B. „St. Ivan, the Forsaken“)
    return { ...g, list, owned, best, shownCard, name: list.length ? list[0].name : g.cards[0].name, soon: list.every((c) => c.unreleased), copies: list.reduce((n, c) => n + (counts[c.id] || 0), 0) };
  }).filter((g) => g.list.length).sort((a, b) => a.name.localeCompare(b.name, 'de'));
%>

<div class="album-head">
  <div class="album-title">
    <h1>Album</h1>
    <div class="tcg-progress">
      <span class="progress album-progress"><span style="width: <%= totalCards ? Math.round(uniqueOwned / totalCards * 100) : 0 %>%"></span></span>
      <span class="tcg-progress-num" title="Eine Karte zählt, sobald du sie in irgendeiner Seltenheit besitzt"><%= uniqueOwned %> / <%= totalCards %> Karten · Händlerwert <%= euro(collectionValue) %></span>
    </div>
    <%- include('partials/grade-stats', { graded, own: true }) %>
  </div>
  <%# Duplikate: an die Bank verkaufen (Geld) oder zerkleinern (Konfetti für den Kosmetik-Shop) – dieselben Karten %>
  <div class="album-dupes" title="Von jeder Karte behältst du eine. Geschützte Karten (Schloss) werden nicht angefasst – auch ihre Duplikate nicht.">
    <span><%= dupCount ? dupCount + (dupCount === 1 ? ' Duplikat' : ' Duplikate') : 'Keine Duplikate' %><% if (dupCount) { %> · <strong><%= euro(dupValue) %></strong><% } %></span>
    <form method="post" action="/tcg/duplikate-verkaufen" data-confirm="<%= dupCount %> doppelte <%= dupCount === 1 ? 'Karte' : 'Karten' %> für <%= euro(dupValue) %> verkaufen? Von jeder Karte bleibt eine übrig, geschützte Karten bleiben komplett.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-primary btn-sm" type="submit" <%= dupCount ? '' : 'disabled' %>>Verkaufen</button>
    </form>
    <form method="post" action="/tcg/duplikate-zerkleinern" data-confirm="<%= dupCount %> doppelte <%= dupCount === 1 ? 'Karte' : 'Karten' %> zu <%= dupKonfetti.toLocaleString('de-DE') %> <%= konfettiName() %> zerkleinern? Von jeder Karte bleibt eine übrig, geschützte Karten bleiben komplett.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost btn-sm" type="submit" <%= dupCount && dupKonfetti ? '' : 'disabled' %>>Zerkleinern<% if (dupKonfetti) { %> · +<%= dupKonfetti.toLocaleString('de-DE') %> <%= konfettiName() %><% } %></button>
    </form>
    <a class="album-konfetti" href="/kosmetik" title="Zum Kosmetik-Shop"><%= konfetti.toLocaleString('de-DE') %> <%= konfettiName() %></a>
  </div>
</div>

<div class="album-body" id="sammlung">
  <%# Eine Sektion je Season, die neueste oben. Die Nummer (#01 …) zählt je Season. %>
  <%# Test-Karten stehen nicht in ihrer Season, sondern (nur für Admins) im Abschnitt "Test" ganz unten.
      Noch nicht erhältliche Karten kommen als "?" ans Ende ihrer Season und zählen nicht mit. %>
  <% const seasonList = seasons.slice().reverse().map((s) => ({ ...s, list: cards.filter((c) => c.season === s.key && c.rarity !== 'test-item'), soon: unreleased.filter((c) => c.season === s.key) })).filter((s) => s.list.length || s.soon.length); %>
  <% const seasonOpts = (slabCopies.length ? [{ key: 'slabs', label: 'Slabs' }] : []).concat(seasonList.map((s) => ({ key: s.key, label: s.label })), testCards.length ? [{ key: 'test', label: 'Test' }] : []); %>
  <div class="album-filter-row"><%- include('partials/tcg-filter', { seasonOpts }) %></div>
  <% if (!cardCount) { %>
    <p class="muted">Du hast noch keine Karten. Kauf und öffne dein erstes Booster Pack im <a href="/tcg">TCG</a>!</p>
  <% } %>
  <%# Slabs: ganz oben als einzelne Karten. Karten im Sleeve stehen unten in den Seasons neben ihren Varianten ohne Sleeve. %>
  <%- include('partials/slab-shelf') %>
  <% seasonList.forEach((s) => { const sg = groups.filter((g) => g.season === s.key); if (!sg.length) return; const counted = sg.filter((g) => !g.soon); %>
    <section class="album-season" data-album-season-section="<%= s.key %>" aria-labelledby="season-<%= s.key %>">
      <div class="album-season-head">
        <h2 id="season-<%= s.key %>"><%= s.label %></h2>
        <span class="tcg-progress-num"><%= counted.filter((g) => g.owned.length).length %> / <%= counted.length %> Karten</span>
      </div>
      <div class="tcg-grid tcg-album album-groups">
        <% sg.forEach((g) => { const c = g.shownCard; const fx = c && g.best ? c.fx || fxFor(c.rarity) : ''; const many = g.list.length > 1; %>
          <% if (g.soon) { %>
            <%# noch nicht erhältlich: eine Farbe für alle, Seltenheiten nicht verraten %>
            <div class="tcg-slot tcg-locked tcg-soon album-group" data-rarity="soon" title="Noch nicht erhältlich">
              <div class="tcg-locked-inner"><span>?</span></div>
              <span class="tcg-slot-label"><span class="tcg-dot"></span>???</span>
            </div>
          <% } else { %>
            <button type="button" class="tcg-slot album-group<%= many ? ' is-stack' : '' %><%= g.best ? ' r-' + g.best.rarity : c ? ' tcg-seen r-' + c.rarity : ' tcg-locked' %>"
              data-album-group="<%= g.key %>" data-name="<%= g.name %>" data-rarities="<%= g.list.map((x) => x.rarity).join(' ') %>"
              aria-label="<%= g.name %>: <%= g.owned.length %> von <%= g.list.length %> Versionen<%= g.best ? ', beste: ' + rarityByKey[g.best.rarity].label : '' %> – Versionen ansehen">
              <% if (c) { %>
                <span class="tcg-art">
                  <img src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008">
                  <% if (fx === 'glitch') { %><img class="tcg-glitch-a" src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008"><img class="tcg-glitch-b" src="<%= c.image %>" alt="" loading="lazy" width="720" height="1008"><% } %>
                  <% if (fx) { %><span class="tcg-fx tcg-fx-<%= fx %>"></span><% } %>
                  <% if (g.copies > 1) { %><span class="tcg-count">×<%= g.copies %></span><% } %>
                </span>
              <% } else { %>
                <div class="tcg-locked-inner"><span>?</span></div>
              <% } %>
              <span class="tcg-slot-label"><span class="tcg-dot"></span><%= g.name %><% if (many) { %> <span class="album-group-n"><%= g.owned.length %>/<%= g.list.length %></span><% } %></span>
            </button>
            <%# alle Versionen – werden beim Anklicken in die Übersicht geholt; dort öffnet jede Version wie gewohnt die Großansicht %>
            <div class="album-versions" data-album-versions="<%= g.key %>" data-title="<%= g.name %>" data-sub="<%= g.owned.length %> von <%= g.list.length %> <%= g.list.length === 1 ? 'Version' : 'Versionen' %><%= g.best ? ' · beste: ' + rarityByKey[g.best.rarity].label : ' · noch keine' %>" hidden>
              <%- include('partials/tcg-grid', { mode: 'album', cards: g.list, slabsAbove: true }) %>
            </div>
          <% } %>
        <% }) %>
      </div>
    </section>
  <% }) %>
  <% if (testCards.length) { %>
    <section class="album-season" data-album-season-section="test" aria-labelledby="season-test">
      <div class="album-season-head">
        <h2 id="season-test">Test</h2>
        <span class="tcg-progress-num"><%= testCards.filter((c) => counts[c.id]).length %> / <%= testCards.length %></span>
      </div>
      <%- include('partials/tcg-grid', { mode: 'album', cards: testCards, slabsAbove: true }) %>
    </section>
  <% } %>
</div>

<%# Versionen einer Karte: Hintergrund unscharf, die Versionen entfalten sich aus der Kachel (public/js/tcg.js) %>
<div class="album-unfold" data-album-unfold hidden>
  <div class="album-unfold-stage" role="dialog" aria-modal="true" aria-labelledby="album-unfold-title">
    <button type="button" class="tcg-close album-unfold-close" data-album-unfold-close aria-label="Schließen">×</button>
    <div class="album-unfold-head">
      <h2 id="album-unfold-title" data-album-unfold-title></h2>
      <p class="muted" data-album-unfold-sub></p>
    </div>
    <div class="album-unfold-cards" data-album-unfold-cards></div>
  </div>
</div>

<!-- Karte vergrößern -->
<dialog class="tcg-modal" data-tcg-modal aria-label="Karte ansehen">
  <button type="button" class="tcg-close" data-tcg-close aria-label="Schließen">×</button>
  <div class="tcg-modal-body">
    <div class="tcg-zoom" data-tcg-tilt>
      <div class="tcg-card-3d">
        <img alt="" data-tcg-modal-img width="720" height="1008">
        <span class="tcg-shine"></span>
      </div>
    </div>
    <div class="tcg-modal-info">
      <span class="tcg-modal-rarity"><span class="tcg-dot" data-tcg-modal-dot></span><span data-tcg-modal-rarity></span></span>
      <h2 data-tcg-modal-name></h2>
      <p class="tcg-modal-status" data-tcg-modal-count></p>
      <%# Meldung der letzten Aktion (Favorit, Schützen, Verkaufen) – nach dem Neuladen hier statt oben auf der Seite (#131) %>
      <p class="tcg-modal-note" data-tcg-modal-note role="status" hidden></p>
      <div class="tcg-modal-actions" data-tcg-owned-actions>
        <form method="post" action="/tcg/favorit" data-tcg-favorite>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="card" value="">
          <button class="btn btn-ghost btn-block" type="submit"></button>
        </form>
        <form method="post" action="/tcg/schuetzen" data-tcg-protect>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="card" value="">
          <button class="btn btn-ghost btn-block" type="submit"></button>
        </form>
        <form method="post" action="/tcg/verkaufen" data-tcg-sell-dupes>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="card" value="">
          <input type="hidden" name="mode" value="duplikate">
          <button class="btn btn-ghost btn-block" type="submit"></button>
        </form>
        <%# Zerkleinern (Konfetti): auch Boss-Karten, nur folierte nicht %>
        <form method="post" action="/tcg/zerkleinern" data-tcg-shred-dupes>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="card" value="">
          <input type="hidden" name="mode" value="duplikate">
          <button class="btn btn-ghost btn-block" type="submit"></button>
        </form>
        <form method="post" action="/tcg/zerkleinern" data-tcg-shred-one data-konfetti-name="<%= konfettiName() %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="card" value="">
          <input type="hidden" name="mode" value="eins">
          <button class="btn btn-ghost btn-block" type="submit"></button>
        </form>
        <form method="post" action="/tcg/verkaufen" data-tcg-sell-one>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="card" value="">
          <input type="hidden" name="mode" value="eins">
          <button class="btn btn-primary btn-block" type="submit">Verkaufen · <span data-tcg-sell-text></span></button>
        </form>
        <p class="muted small" data-tcg-protect-note hidden>Geschützt: Die Duplikate dieser Karte werden nicht verkauft. Einzeln verkaufen geht weiterhin.</p>
      </div>
      <a class="btn btn-primary btn-block" href="/handel" data-tcg-former-action hidden>Im Handel suchen</a>
    </div>
  </div>
</dialog>

<%- include('partials/foil-modal', { favForm: true }) %>
<script src="/js/tcg.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
