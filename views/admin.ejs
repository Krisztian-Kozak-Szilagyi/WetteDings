<%- include('partials/head') %>
<%
  const current = sections.find((s) => s.key === tab);
  // Symbole der Reiter (Linien-Icons wie in der Statistik)
  const ICONS = {
    grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
    shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z"/><path d="M9 12l2 2 4-4"/>',
    sliders: '<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>',
    users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7"/><path d="M18 14.8c1.9.7 3.1 2.5 3.5 5.2"/>',
    list: '<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="18" r="1"/>',
    trend: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  };
  const icon = (name) => `<svg class="stats-icon" viewBox="0 0 24 24" aria-hidden="true">${ICONS[name] || ''}</svg>`;
  // Zähler offener Aufgaben am Reiter
  const badgeOf = { moderation: counts.moderation, protokolle: counts.protokolle };
  // Kopf eines Themenblocks
  const blockHead = (title, text) => `<header class="stats-block-head"><div><h2>${title}</h2>${text ? `<p class="muted">${text}</p>` : ''}</div></header>`;
%>

<header class="stats-hero">
  <div>
    <h1><%= currentUser.isAdmin ? 'Admin' : 'Dev' %>-Panel</h1>
    <p class="muted"><%= current.description %></p>
  </div>
  <div class="stats-period">
    <span class="stats-period-main"><%= currentUser.username %><%- roleBadge(currentUser.username, { realName: false }) %></span>
    <span class="muted small">angemeldet als <%= currentUser.isAdmin ? 'Admin' : 'Dev' %></span>
  </div>
</header>

<div class="stats-toolbar">
  <nav class="stats-sections panel-sections" aria-label="Bereich des Panels">
    <% sections.forEach((s) => { %>
      <a class="stats-section <%= s.key === tab ? 'active' : '' %>" href="<%= panelUrl(s.key) %>" title="<%= s.description %>" <% if (s.key === tab) { %>aria-current="page"<% } %>>
        <%- icon(s.icon) %><span><%= s.label %></span>
        <% if (badgeOf[s.key]) { %><span class="panel-badge" aria-label="<%= badgeOf[s.key] %> offen"><%= badgeOf[s.key] > 99 ? '99+' : badgeOf[s.key] %></span><% } %>
      </a>
    <% }) %>
    <a class="stats-section panel-section-link" href="/admin/statistik" title="Kennzahlen und Verläufe für das Balancing"><%- icon('trend') %><span>Statistik</span><span aria-hidden="true">↗</span></a>
  </nav>
</div>

<%- include('admin/' + tab, { icon, blockHead }) %>

<%- include('partials/foot') %>
