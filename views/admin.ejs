<%- include('partials/head') %>

<div class="page-head">
  <h1><%= currentUser.isAdmin ? 'Admin' : 'Dev' %>-Panel</h1>
  <span class="muted">Angemeldet als <%= currentUser.username %></span>
</div>

<% if (currentUser.isAdmin) { %>
<div class="stats stats-3">
  <div class="stat card"><span class="stat-label">Nutzer</span><span class="stat-value"><%= stats.userCount %></span></div>
  <div class="stat card"><span class="stat-label">Offene Wetten</span><span class="stat-value"><%= stats.openBets %></span></div>
  <div class="stat card"><span class="stat-label">Wetten gesamt</span><span class="stat-value"><%= stats.totalBets %></span></div>
</div>
<% } %>

<div class="card" id="streitfaelle">
  <h2>Streitfälle <%= betDisputes ? '(' + betDisputes + ')' : '' %></h2>
  <p class="muted">Wetten, bei denen Wettersteller und Schiedsrichter unterschiedliche Ergebnisse eingetragen haben. Dort wird nichts ausgezahlt, bis ein Dev mit seiner Stimme entscheidet.</p>
  <% if (betDisputes) { %>
    <p><a class="btn btn-primary" href="/admin/streitfaelle"><%= betDisputes %> <%= betDisputes === 1 ? 'Streitfall' : 'Streitfälle' %> entscheiden</a></p>
  <% } else { %>
    <p><a class="btn btn-ghost" href="/admin/streitfaelle">Streitfälle ansehen</a> <span class="muted small">Aktuell gibt es keine.</span></p>
  <% } %>
</div>

<% if (currentUser.isAdmin) { %>
<%
  const openAlerts = deviceMatches.filter((a) => !a.doneAt);
  const doneAlerts = deviceMatches.filter((a) => a.doneAt);
  const urgent = openAlerts.filter((a) => a.level >= 2).length;
%>
<div class="card" id="geraete">
  <h2>Mehrfach-Konten <%= urgent ? '(' + urgent + ')' : '' %></h2>
  <p class="muted">Konten, die vom selben Gerät aus benutzt wurden. <strong>Sicher</strong> = derselbe Browser (Geräte-Kennung). <strong>Wahrscheinlich</strong> = gleiche Geräte-Merkmale und gleiche IP-Adresse (z. B. anderer Browser oder privates Fenster). <strong>Möglich</strong> = nur gleiche Geräte-Merkmale – das kommt auch bei baugleichen Geräten vor (Schulrechner, gleiches Handymodell) und zählt nicht fürs Abzeichen.</p>
  <% if (!openAlerts.length) { %>
    <p class="muted">Aktuell gibt es keine offenen Hinweise.</p>
  <% } %>
  <% const alertList = (list) => { %>
    <ul class="code-list">
      <% list.forEach((a) => { %>
        <li class="code-item device-alert <%= a.doneAt ? 'is-used' : '' %>">
          <div class="code-main">
            <span class="badge device-level-<%= a.level %>"><%= a.label %></span>
            <% a.users.forEach((u, i) => { %><%= i ? ' ↔ ' : '' %><strong><%- userLink(u.username, { realName: false }) %></strong><% if (u.banned) { %> <span class="badge badge-entschieden">gebannt</span><% } %><% }) %>
          </div>
          <div class="code-meta small">
            <% if (!a.shared.length) { %><span class="muted">Die Geräte-Daten dazu sind nicht mehr vorhanden.</span><% } %>
            <% a.shared.forEach((s) => { %>
              <div class="device-shared">
                <div class="muted"><%= s.label %> · <%= s.ua || 'Gerät' %></div>
                <% a.users.forEach((u, i) => { %>
                  <div><strong><%= u.username %>:</strong> <%= s.logins[i].times.length ? 'Anmeldungen ' + s.logins[i].times.map((t) => date(t)).join(' · ') : 'zuletzt gesehen ' + date(s.logins[i].lastAt) %></div>
                <% }) %>
              </div>
            <% }) %>
            <div class="muted">Konten erstellt: <%= a.users.map((u) => u.username + ' ' + date(u.createdAt)).join(' · ') %></div>
          </div>
          <div class="code-actions">
            <% a.users.filter((u) => !u.banned).forEach((u) => { %>
              <a class="btn btn-danger btn-sm" href="/admin?ban=<%= u._id %>#ban"><%= u.username %> bannen</a>
            <% }) %>
            <form method="post" action="/admin/geraete/<%= a._id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="action" value="<%= a.doneAt ? 'oeffnen' : 'erledigt' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= a.doneAt ? 'Wieder öffnen' : 'Erledigt' %></button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% if (openAlerts.length) alertList(openAlerts); %>
  <% if (doneAlerts.length) { %>
    <details class="history device-done">
      <summary>Erledigte Hinweise (<%= doneAlerts.length %>)</summary>
      <% alertList(doneAlerts); %>
    </details>
  <% } %>
</div>

<details class="card fold" id="ban">
  <summary><h2>Ban</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Ein gebanntes Mitglied wird sofort abgemeldet und kann sich nicht mehr anmelden. Der Ban gilt auch für <strong>alle Geräte</strong>, mit denen das Konto benutzt wurde: von dort aus ist weder eine Anmeldung mit einem anderen Konto noch eine Registrierung möglich. Guthaben, Karten, Wetten und Angebote bleiben unverändert.</p>
  <form method="post" action="/admin/sperren" class="form admin-tcg-form" data-confirm="Dieses Mitglied und alle seine Geräte wirklich bannen?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field admin-tcg-pack">
      <span>Mitglied</span>
      <select name="user" required>
        <option value="">– auswählen –</option>
        <% bannable.forEach((u) => { %><option value="<%= u._id %>" <%= String(u._id) === banPreselect ? 'selected' : '' %>><%= u.username %></option><% }) %>
      </select>
    </label>
    <label class="field admin-tcg-pack">
      <span>Dauer in Stunden <em>(0 = dauerhaft)</em></span>
      <input type="number" name="hours" min="0" max="<%= maxBanHours %>" step="1" value="24" inputmode="numeric" required>
    </label>
    <label class="field">
      <span>Grund <em>(freiwillig – steht im Profil und beim Anmeldeversuch)</em></span>
      <input type="text" name="reason" maxlength="200">
    </label>
    <button class="btn btn-danger" type="submit">Ban</button>
  </form>
</details>

<div class="card" id="banliste">
  <h2>Ban-Liste <%= bans.length ? '(' + bans.length + ')' : '' %></h2>
  <% if (!bans.length) { %>
    <p class="muted">Aktuell ist niemand gebannt.</p>
  <% } else { %>
    <ul class="code-list">
      <% bans.forEach((b) => { %>
        <li class="code-item">
          <div class="code-main"><strong><%- userLink(b.username, { realName: false }) %></strong> <span class="badge badge-entschieden"><%= b.forever ? 'dauerhaft' : 'bis ' + date(b.bannedUntil) %></span></div>
          <div class="code-meta muted small">
            <%= b.banReason ? 'Grund: ' + b.banReason + ' · ' : '' %>gebannt von <%= b.bannedByName || '–' %> · <%= date(b.bannedAt) %> · <%= b.devices %> <%= b.devices === 1 ? 'Gerät' : 'Geräte' %> mitgebannt
          </div>
          <div class="code-actions">
            <form method="post" action="/admin/sperren/<%= b._id %>/aufheben" data-confirm="<%= b.username %> wirklich entbannen?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-ghost btn-sm" type="submit">Unban</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<details class="card fold" id="tcg">
  <summary><h2>TCG: Chancen &amp; Preise</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Packpreis, Chancen und Verkaufspreise der Seltenheiten. Änderungen gelten sofort. Neue Chancen gelten für alle ab jetzt geöffneten Packs; neue Preise auch für schon gezogene Karten (der Wert hängt nur von der Seltenheit ab). Die Chancen müssen zusammen genau 100 % ergeben.</p>
  <%
    const toInput = (c) => (c / 100).toFixed(2).replace('.', ',');
    const pctInput = (w) => (w / 100).toFixed(2).replace('.', ',');
  %>
  <form method="post" action="/admin/tcg" class="form admin-tcg-form" data-confirm="TCG-Einstellungen wirklich ändern?" data-tcg-admin>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field admin-tcg-pack">
      <span>Packpreis (3 Karten)</span>
      <input type="text" name="pack" inputmode="decimal" value="<%= toInput(tcg.packPrice) %>" required>
    </label>
    <div class="table-wrap">
      <table class="table admin-tcg-table">
        <thead><tr><th>Seltenheit</th><th>Chance (%)</th><th>Verkaufspreis (€)</th><th class="num hide-sm">Standard</th></tr></thead>
        <tbody>
          <% tcg.rarities.forEach((r) => { %>
            <tr class="r-<%= r.key %>">
              <td><span class="tcg-dot"></span> <%= r.label %><%= r.hidden ? ' (geheim)' : '' %></td>
              <td><input type="text" name="weight_<%= r.key %>" inputmode="decimal" value="<%= pctInput(r.weight) %>" required aria-label="Chance <%= r.label %> in Prozent"></td>
              <td><input type="text" name="sell_<%= r.key %>" inputmode="decimal" value="<%= toInput(r.sell) %>" required aria-label="Verkaufspreis <%= r.label %>"></td>
              <td class="num hide-sm muted nowrap"><%= pctInput(tcg.defaultWeights[r.key]) %> % · <%= euro(tcg.defaults[r.key]) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="admin-tcg-summary" data-tcg-summary>
      Summe der Chancen: <strong data-tcg-sum><%= pctInput(tcg.rarities.reduce((s, r) => s + r.weight, 0)) %> %</strong> ·
      Ein Pack ist im Schnitt <strong data-tcg-ev><%= euro(tcg.expectedPack) %></strong> wert
      (<strong data-tcg-ratio class="<%= tcg.expectedPack >= tcg.packPrice ? 'neg' : 'pos' %>"><%= Math.round((tcg.expectedPack / tcg.packPrice) * 100) %> %</strong> vom Packpreis)
      <span class="neg small" data-tcg-warn <%= tcg.expectedPack >= tcg.packPrice ? '' : 'hidden' %>><br>Packs wären im Schnitt profitabel – es kommt mehr Spielgeld in Umlauf, als ausgegeben wird.</span>
    </p>
    <button class="btn btn-primary" type="submit">Speichern</button>
    <% if (tcg.lastUpdate) { %>
      <p class="muted small">Zuletzt geändert von <%= tcg.lastUpdate.updatedByName %> · <%= date(tcg.lastUpdate.updatedAt) %></p>
    <% } %>
  </form>
</details>

<% } %>

<details class="card fold" id="packs">
  <summary><h2>TCG: Booster Packs vergeben<% if (packLogNew) { %> <span class="muted small">(<%= packLogNew > 99 ? '99+' : packLogNew %> neu im Pack-Log)</span><% } %></h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Schenkt einem Mitglied ungeöffnete Booster Packs. Sie landen in seinem Inventar auf der TCG-Seite („Meine Packs“). Jede Vergabe wird im Pack-Log festgehalten (wer, wem, wann).</p>
  <form method="post" action="/admin/tcg/packs" class="form admin-tcg-form" data-confirm="Booster Packs wirklich vergeben?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field admin-tcg-pack">
      <span>Mitglied</span>
      <select name="user" required>
        <option value="">– auswählen –</option>
        <% users.forEach((u) => { %><option value="<%= u._id %>"><%= u.username %></option><% }) %>
      </select>
    </label>
    <label class="field admin-tcg-pack">
      <span>Booster Pack</span>
      <select name="type" required>
        <% packTypes.forEach((p) => { %><option value="<%= p.key %>"><%= p.label %></option><% }) %>
      </select>
    </label>
    <label class="field admin-tcg-pack">
      <span>Anzahl (1–50)</span>
      <input type="number" name="count" min="1" max="50" step="1" value="1" required>
    </label>
    <button class="btn btn-primary" type="submit">Packs vergeben</button>
    <a class="btn btn-ghost nav-badge-link" href="/admin/pack-log">Pack-Log ansehen<% if (packLogNew) { %><span class="nav-badges"><span class="nav-badge" title="Neue Vergaben" aria-label="<%= packLogNew %> neue Vergaben"><%= packLogNew > 99 ? '99+' : packLogNew %></span></span><% } %></a>
  </form>
</details>

<% if (currentUser.isAdmin) { %>
<details class="card fold" id="devs">
  <summary><h2>Devs</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Devs schreiben im Team-Bereich des Forums (z. B. Patchnotes), können alle Wetten entscheiden oder annullieren, Booster Packs vergeben und überall moderieren. Sie sehen statt des Admin-Panels ein Dev-Panel und tragen ein grünes DEV-Abzeichen.</p>
  <% { const list = users.filter((u) => u.role === 'dev'); %>
  <% if (!list.length) { %>
    <p class="muted">Aktuell gibt es keine Devs.</p>
  <% } else { %>
    <ul class="code-list">
      <% list.forEach((u) => { %>
        <li class="code-item code-item-single">
          <div class="code-main"><strong><%= u.username %></strong><%- roleBadge(u.username, { realName: false }) %></div>
          <div class="code-actions">
            <form method="post" action="/admin/rollen" data-confirm="<%= u.username %> die Dev-Rolle entziehen?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="user" value="<%= u._id %>">
              <input type="hidden" name="role" value="dev">
              <input type="hidden" name="action" value="entfernen">
              <button class="btn btn-danger btn-sm" type="submit">Entfernen</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% } %>
  <form method="post" action="/admin/rollen" class="form admin-tcg-form" data-confirm="Dieses Mitglied zum Dev machen?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="role" value="dev">
    <label class="field admin-tcg-pack">
      <span>Mitglied zum Dev machen</span>
      <select name="user" required>
        <option value="">– auswählen –</option>
        <% users.filter((u) => u.role !== 'dev').forEach((u) => { %><option value="<%= u._id %>"><%= u.username %><%= u.role ? ' (bisher ' + u.role + ')' : '' %></option><% }) %>
      </select>
    </label>
    <button class="btn btn-primary" type="submit">Zum Dev machen</button>
  </form>
</details>

<details class="card fold" id="mods">
  <summary><h2>Mods</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Mods moderieren das Forum und die Kommentare bei Wetten: Beiträge löschen oder bearbeiten, Themen anpinnen, schließen oder entfernen und Bereiche anlegen, ändern oder löschen – außer im Team-Bereich „Admin & Dev“. Sonst haben sie keine Sonderrechte und kein Panel. Sie tragen ein oranges MOD-Abzeichen. Ein Mitglied hat immer nur eine Rolle.</p>
  <% { const list = users.filter((u) => u.role === 'mod'); %>
  <% if (!list.length) { %>
    <p class="muted">Aktuell gibt es keine Mods.</p>
  <% } else { %>
    <ul class="code-list">
      <% list.forEach((u) => { %>
        <li class="code-item code-item-single">
          <div class="code-main"><strong><%= u.username %></strong><%- roleBadge(u.username, { realName: false }) %></div>
          <div class="code-actions">
            <form method="post" action="/admin/rollen" data-confirm="<%= u.username %> die Mod-Rolle entziehen?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="user" value="<%= u._id %>">
              <input type="hidden" name="role" value="mod">
              <input type="hidden" name="action" value="entfernen">
              <button class="btn btn-danger btn-sm" type="submit">Entfernen</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% } %>
  <form method="post" action="/admin/rollen" class="form admin-tcg-form" data-confirm="Dieses Mitglied zum Mod machen?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="role" value="mod">
    <label class="field admin-tcg-pack">
      <span>Mitglied zum Mod machen</span>
      <select name="user" required>
        <option value="">– auswählen –</option>
        <% users.filter((u) => u.role !== 'mod').forEach((u) => { %><option value="<%= u._id %>"><%= u.username %><%= u.role ? ' (bisher ' + u.role + ')' : '' %></option><% }) %>
      </select>
    </label>
    <button class="btn btn-primary" type="submit">Zum Mod machen</button>
  </form>
</details>
<% } %>

<details class="card fold" id="handellog" <%= trades.q || trades.page > 1 || trades.onlySuspicious || newSuspicious ? 'open' : '' %>>
  <summary><h2>Handel-Log<% if (newSuspicious) { %> <span class="nav-badge nav-badge-inline nav-badge-suspicious" title="Neue Geschäfte zwischen Mehrfach-Konten"><%= newSuspicious %></span><% } %></h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Alle abgeschlossenen Geschäfte, neueste zuerst: wer wem welche Karte gegeben hat, was zurückkam und wann. „Von“ hat die Karte abgegeben, „An“ hat sie bekommen. Geschäfte zwischen Konten, die vom selben Gerät aus benutzt werden (Mehrfach-Konten, „sicher“ oder „wahrscheinlich“), sind rot markiert – neue lösen ein Abzeichen am Menüpunkt aus.</p>
  <form method="get" action="/admin#handellog" class="leader-search" role="search">
    <label class="sr-only" for="handel-suche">Im Handel-Log suchen</label>
    <input type="search" id="handel-suche" name="handelsuche" value="<%= trades.q %>" maxlength="40" placeholder="Name oder Karte suchen …">
    <label class="check bm-filter"><input type="checkbox" name="verdacht" value="1" <%= trades.onlySuspicious ? 'checked' : '' %>> <span>nur Mehrfach-Konten</span></label>
    <button class="btn btn-ghost btn-sm" type="submit">Suchen</button>
    <% if (trades.q || trades.onlySuspicious) { %><a class="btn btn-ghost btn-sm" href="/admin#handellog">Alle</a><% } %>
  </form>
  <p class="muted small"><%= trades.total %> <%= trades.total === 1 ? 'Geschäft' : 'Geschäfte' %><%= trades.onlySuspicious ? ' zwischen Mehrfach-Konten' : '' %><%= trades.q ? ' für „' + trades.q + '“' : '' %> · Seite <%= trades.page %> von <%= trades.pages %></p>
  <% if (!trades.rows.length) { %>
    <p class="muted"><%= trades.q ? 'Nichts gefunden.' : 'Es gibt noch keine abgeschlossenen Geschäfte.' %></p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table trade-log">
        <thead><tr><th>Zeitpunkt</th><th>Von</th><th>An</th><th>Karte</th><th>Gegenleistung</th><th>Art</th></tr></thead>
        <tbody>
          <% trades.rows.forEach((t) => { %>
            <tr class="<%= t.flagged ? 'trade-flagged' : '' %>">
              <td class="nowrap"><%= dateSec(t.at) %><% if (t.flagged) { %><br><span class="badge trade-flag" title="Beide Konten werden vom selben Gerät aus benutzt">Mehrfach-Konto</span><% } %><% if (t.isNew) { %> <span class="badge badge-offen">Neu</span><% } %></td>
              <td><%- userLink(t.from, { realName: false }) %></td>
              <td><%- userLink(t.to, { realName: false }) %></td>
              <td><%= t.card %></td>
              <td><%= t.back %><% if (t.tax) { %> <span class="muted small">(Steuer <%= euro(t.tax) %>)</span><% } %></td>
              <td class="nowrap"><%= t.kind %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <% if (trades.pages > 1) { const link = (p) => '/admin?' + new URLSearchParams({ ...(trades.q ? { handelsuche: trades.q } : {}), ...(trades.onlySuspicious ? { verdacht: '1' } : {}), handelseite: p }) + '#handellog'; %>
    <div class="log-pager">
      <% if (trades.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= link(trades.page - 1) %>">← Neuere</a><% } %>
      <span class="muted small">Seite <%= trades.page %> / <%= trades.pages %></span>
      <% if (trades.page < trades.pages) { %><a class="btn btn-ghost btn-sm" href="<%= link(trades.page + 1) %>">Ältere →</a><% } %>
    </div>
  <% } %>
</details>

<% if (currentUser.isAdmin) { %>
<div class="card" id="handel">
  <h2>Handel: Steuer</h2>
  <p class="muted">Anteil, der dem Verkäufer bei jedem Handel (privat und Markt) vom Erlös abgezogen wird. Die Spieler sehen den aktuellen Satz auf der Handelsseite.</p>
  <form method="post" action="/admin/handel" class="form admin-tcg-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field admin-tcg-pack">
      <span>Handelssteuer in % (0–50)</span>
      <input type="text" name="tax" inputmode="decimal" value="<%= String(tradeTax).replace('.', ',') %>" required>
    </label>
    <button class="btn btn-primary" type="submit">Speichern</button>
  </form>
</div>

<details class="card fold" id="bonus">
  <summary><h2>Tagesbonus &amp; Grading</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Der Tagesbonus gilt für alle Mitglieder gleich (unabhängig vom Vermögen) – außer für die, die gerade im Grading-Shop arbeiten. Gilt ab dem nächsten Bonustag (<%= bonusTime %> Uhr).</p>
  <form method="post" action="/admin/bonus" class="form admin-tcg-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field admin-tcg-pack">
      <span>Tagesbonus in € (0 = keiner)</span>
      <input type="text" name="amount" inputmode="decimal" value="<%= (dailyBonus() / 100).toFixed(2).replace('.', ',') %>" required>
    </label>
    <label class="check admin-ihk-open">
      <input type="checkbox" name="gradingOpen" value="1" <%= gradingOpen() ? 'checked' : '' %>>
      <span><strong>Grading-Shop für alle Mitglieder verfügbar</strong> – sonst sehen nur Admins den Menüpunkt „Grading“.</span>
    </label>
    <h3 class="admin-ihk-sub">Grading-Shop: Lohn &amp; Preise</h3>
    <p class="muted small">Lohn pro Auftrag: Putzen (bei 100 % sauber, sonst anteilig) + Benoten (exakte Note, ±1 = halb, ab Stufe 2) + Versiegeln (bei 100 %, ab Stufe 3). Stufe 4 bekommt den Premium-Aufschlag auf alles.</p>
    <div class="admin-gr-grid">
      <label class="field"><span>Aufträge pro Tag</span><input type="number" name="gr_jobs" min="0" max="100" step="1" value="<%= gradingSettings.jobs %>" required></label>
      <label class="field"><span>Lohn Putzen in €</span><input type="text" name="gr_pay_clean" inputmode="decimal" value="<%= (gradingSettings.pay.clean / 100).toFixed(2).replace('.', ',') %>" required></label>
      <label class="field"><span>Lohn Benoten in €</span><input type="text" name="gr_pay_grade" inputmode="decimal" value="<%= (gradingSettings.pay.grade / 100).toFixed(2).replace('.', ',') %>" required></label>
      <label class="field"><span>Lohn Versiegeln in €</span><input type="text" name="gr_pay_slab" inputmode="decimal" value="<%= (gradingSettings.pay.slab / 100).toFixed(2).replace('.', ',') %>" required></label>
      <% gradingLevels.slice(1).forEach((l, i) => { %>
        <label class="field"><span>Ausbau auf Stufe <%= l.level %> („<%= l.name %>“) in €</span><input type="text" name="gr_cost_<%= l.level %>" inputmode="decimal" value="<%= (gradingSettings.costs[i] / 100).toFixed(2).replace('.', ',') %>" required></label>
      <% }) %>
      <label class="field"><span>Premium-Aufschlag Stufe 4 in %</span><input type="number" name="gr_premium" min="0" max="500" step="1" value="<%= gradingSettings.premium %>" required></label>
    </div>
    <button class="btn btn-primary" type="submit">Speichern</button>
  </form>
</details>

<details class="card fold" id="ihk">
  <summary><h2>IHK: Limit &amp; Lohn</h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <p class="muted">Quests pro Tag, Dauer, Ziel-Punkte, Lohn und Chance auf ein Booster Pack je Schwierigkeit (Lohn und Pack nur bei Erfolg) – getrennt für normale und Hybrid-Quests. Gilt sofort für neu gestartete Quests.</p>
  <form method="post" action="/admin/ihk" class="form admin-tcg-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="check admin-ihk-open">
      <input type="checkbox" name="open" value="1" <%= ihk.settings.open ? 'checked' : '' %>>
      <span><strong>Für alle Mitglieder verfügbar</strong> – sonst sehen nur Admins die IHK, alle anderen bekommen „derzeit nicht verfügbar“.</span>
    </label>
    <label class="field admin-tcg-pack">
      <span>Quests pro Tag</span>
      <input type="number" name="dailyLimit" min="0" max="100" step="1" value="<%= ihk.settings.dailyLimit %>" required>
    </label>
    <% [
         { title: 'Normale Quests (FIA, FIS oder BWL)', prefix: '', values: ihk.settings },
         { title: 'Hybrid-Quests (zwei Fachrichtungen, es zählt der Durchschnitt)', prefix: 'hybrid_', values: ihk.settings.hybrid },
       ].forEach((t) => { %>
      <h3 class="admin-ihk-sub"><%= t.title %></h3>
      <div class="table-wrap">
        <table class="table admin-tcg-table">
          <thead><tr><th>Schwierigkeit</th><th>Ziel (Punkte)</th><th>Dauer (Min., 0 = sofort)</th><th>Lohn (€)</th><th>Pack-Chance (%)</th></tr></thead>
          <tbody>
            <% ihk.difficulties.forEach((d, i) => { %>
              <tr class="r-<%= tcg.rarities[i].key %>">
                <td><span class="tcg-dot"></span> <%= d.level %> · <%= d.label %> <span class="muted small hide-sm">(Standard <%= d.required %>)</span></td>
                <td><input type="number" name="<%= t.prefix %>required_<%= d.level %>" min="1" max="100000" step="1" value="<%= t.values.required[i] %>" required aria-label="Ziel-Punkte Schwierigkeit <%= d.level %>"></td>
                <td><input type="number" name="<%= t.prefix %>duration_<%= d.level %>" min="0" max="1440" step="1" value="<%= t.values.durations[i] %>" required aria-label="Dauer Schwierigkeit <%= d.level %>"></td>
                <td><input type="text" name="<%= t.prefix %>reward_<%= d.level %>" inputmode="decimal" value="<%= (t.values.rewards[i] / 100).toFixed(2).replace('.', ',') %>" required aria-label="Lohn Schwierigkeit <%= d.level %>"></td>
                <td><input type="text" name="<%= t.prefix %>pack_<%= d.level %>" inputmode="decimal" value="<%= String(t.values.packChances[i]).replace('.', ',') %>" required aria-label="Chance auf ein Booster Pack, Schwierigkeit <%= d.level %>"></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>
    <button class="btn btn-primary" type="submit">Speichern</button>
  </form>
</details>

<div class="card" id="codes">
  <h2>Registrierungscodes</h2>
  <p class="muted">Neue Mitglieder können sich nur mit einem Code registrieren. Jeder Code gilt <strong><%= ttlMinutes %> Minuten</strong> und für <strong>genau eine Person</strong> – danach wird er automatisch gelöscht.</p>

  <form method="post" action="/admin/codes" class="admin-generate">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-primary" type="submit">+ Neuen Code erzeugen</button>
  </form>

  <% if (!codes.length) { %>
    <p class="muted">Aktuell gibt es keine gültigen Codes.</p>
  <% } else { %>
    <ul class="code-list">
      <% codes.forEach((c) => {
           const minutesLeft = Math.max(0, Math.ceil((new Date(c.expiresAt).getTime() - now) / 60000));
           const used = !!c.usedAt; %>
        <li class="code-item <%= used ? 'is-used' : '' %>">
          <div class="code-main">
            <code class="code-value"><%= formatCode(c.code) %></code>
            <% if (used) { %>
              <span class="badge badge-entschieden">Benutzt von <%= c.usedByName %></span>
            <% } else { %>
              <span class="badge badge-offen">Gültig · noch <%= minutesLeft %> Min.</span>
            <% } %>
          </div>
          <div class="code-meta muted small">
            erstellt von <%= c.createdByName %> · <%= date(c.createdAt) %> · läuft ab <%= date(c.expiresAt) %>
          </div>
          <div class="code-actions">
            <% if (!used) { %>
              <button type="button" class="btn btn-ghost btn-sm" data-copy="<%= formatCode(c.code) %>">Kopieren</button>
            <% } %>
            <form method="post" action="/admin/codes/<%= c._id %>/loeschen" data-confirm="Diesen Code löschen?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger btn-sm" type="submit">Löschen</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<% } %>

<%- include('partials/foot') %>
