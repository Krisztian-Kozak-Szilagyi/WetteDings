<%- include('partials/head') %>

<div class="page-head">
  <h1>Mein Konto</h1>
  <span class="muted"><%= currentUser.username %> · <%= currentUser.email %> · registriert am <%= date(currentUser.createdAt) %></span>
</div>

<div class="stats stats-auto">
  <div class="stat card"><span class="stat-label">Verfügbar</span><span class="stat-value"><%= euro(currentUser.balance) %></span></div>
  <div class="stat card"><span class="stat-label">In offenen Wetten</span><span class="stat-value"><%= euro(inPlay) %></span></div>
  <div class="stat card"><span class="stat-label">In Samantha Coin</span><span class="stat-value"><%= euro(coinValue) %></span><a class="small" href="/coin-exchange">Zur Coin Exchange</a></div>
  <div class="stat card"><span class="stat-label">In TCG-Karten</span><span class="stat-value"><%= euro(cardValue) %></span><span class="muted small">inkl. ungeöffneter Packs</span><a class="small" href="/tcg/album">Zum Album</a></div>
  <div class="stat card"><span class="stat-label">Gesamt</span><span class="stat-value"><%= euro(total) %></span></div>
  <div class="stat card"><span class="stat-label">Bilanz seit Start</span><span class="stat-value <%= net > 0 ? 'pos' : (net < 0 ? 'neg' : '') %>"><%= net > 0 ? '+' : '' %><%= euro(net) %></span>
    <span class="muted small"><%= stats.won %> gewonnen · <%= stats.lost %> verloren</span></div>
</div>

<details class="card fold" id="wetten" <%= bets.open ? 'open' : '' %>>
  <summary><h2>Meine Wetten <span class="muted small">(<%= bets.total %>)</span></h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <% if (!positions.length) { %>
    <p class="muted">Du hast noch nichts gesetzt. <a href="/">Zu den Wetten</a></p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Wette</th><th>Option</th><th class="num">Einsatz</th><th>Status</th><th class="num">Ergebnis</th></tr></thead>
        <tbody>
          <% positions.forEach((p) => { const st = statusInfo(p.bet); %>
            <tr>
              <td><a href="/wetten/<%= p.bet._id %>"><%= p.bet.title %></a></td>
              <td><span class="pill <%= optClass(p.bet, p.side) %>"><%= optionLabel(p.bet, p.side) %></span></td>
              <td class="num"><%= euro(p.amount) %></td>
              <td><span class="badge badge-<%= st.key %>"><%= st.label %></span></td>
              <td class="num">
                <% if (p.payout === null) { %><span class="muted">offen</span>
                <% } else { const diff = p.payout - p.amount; %>
                  <span class="<%= diff > 0 ? 'pos' : (diff < 0 ? 'neg' : '') %>"><%= diff > 0 ? '+' : '' %><%= euro(diff) %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <% if (bets.pages > 1) { const link = (p) => '/konto?' + new URLSearchParams({ wetten: p, ...(led.open ? { auszug: led.page } : {}) }) + '#wetten'; %>
    <div class="log-pager">
      <% if (bets.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= link(bets.page - 1) %>">← Neuere</a><% } %>
      <span class="muted small">Seite <%= bets.page %> / <%= bets.pages %></span>
      <% if (bets.page < bets.pages) { %><a class="btn btn-ghost btn-sm" href="<%= link(bets.page + 1) %>">Ältere →</a><% } %>
    </div>
  <% } %>
</details>

<details class="card fold" id="auszug" <%= led.open ? 'open' : '' %>>
  <summary><h2>Kontoauszug <span class="muted small">(<%= led.total %>)</span></h2><span class="fold-arrow" aria-hidden="true"></span></summary>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Datum</th><th>Buchung</th><th class="num">Betrag</th></tr></thead>
      <tbody>
        <% ledger.forEach((l) => { %>
          <tr>
            <td class="nowrap"><%= date(l.createdAt) %></td>
            <td><%= ledgerLabels[l.type] %><% if (l.bet) { %> · <a href="/wetten/<%= l.bet %>"><%= l.betTitle %></a><% } else if (l.betTitle) { %> · <span class="muted"><%= l.betTitle %></span><% } %></td>
            <td class="num <%= l.amount > 0 ? 'pos' : 'neg' %>"><%= l.amount > 0 ? '+' : '' %><%= euro(l.amount) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (led.pages > 1) { const link = (p) => '/konto?' + new URLSearchParams({ auszug: p, ...(bets.open ? { wetten: bets.page } : {}) }) + '#auszug'; %>
    <div class="log-pager">
      <% if (led.page > 1) { %><a class="btn btn-ghost btn-sm" href="<%= link(led.page - 1) %>">← Neuere</a><% } %>
      <span class="muted small">Seite <%= led.page %> / <%= led.pages %></span>
      <% if (led.page < led.pages) { %><a class="btn btn-ghost btn-sm" href="<%= link(led.page + 1) %>">Ältere →</a><% } %>
    </div>
  <% } %>
</details>

<div class="account-grid">
<div class="card" id="name">
  <h2>Benutzernamen ändern</h2>
  <% if (currentUser.isAdmin) { %>
    <p class="muted">Admin-Konten können ihren Namen nicht ändern – die Admin-Rechte hängen am Benutzernamen.</p>
  <% } else if (nextRenameAt) { %>
    <p class="muted">Du hast deinen Namen vor Kurzem geändert. Die nächste Änderung ist ab <%= date(nextRenameAt) %> möglich.</p>
  <% } else { %>
    <form method="post" action="/konto/name" class="form" data-confirm="Benutzernamen wirklich ändern? Der neue Name erscheint überall – auch bei deinen bisherigen Wetten und Kommentaren.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Neuer Benutzername</span><input type="text" name="username" minlength="3" maxlength="20" pattern="[A-Za-z0-9_.\-]{3,20}" autocomplete="off" required placeholder="<%= currentUser.username %>"></label>
      <p class="muted small">3–20 Zeichen (Buchstaben, Zahlen, _ . -). Danach kannst du den Namen <%= renameDays %> Tage lang nicht erneut ändern. Mit dem neuen Namen meldest du dich auch an.</p>
      <button class="btn btn-primary" type="submit">Namen ändern</button>
    </form>
  <% } %>
</div>

<div class="card" id="echter-name">
  <h2>Echter Name <span class="muted small">(freiwillig)</span></h2>
  <p class="muted">Wenn du möchtest, erscheint dein echter Name überall in Klammern neben deinem Benutzernamen – für alle angemeldeten Mitglieder sichtbar. Leer lassen und speichern entfernt ihn wieder.</p>
  <form method="post" action="/konto/echter-name" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field"><span>Echter Name</span><input type="text" name="realName" maxlength="<%= realNameMax %>" autocomplete="name" value="<%= currentUser.realName || '' %>" placeholder="z. B. Max Mustermann"></label>
    <p class="muted small">Vorschau: <strong><%= currentUser.username %></strong><%- roleBadge(currentUser.username) %></p>
    <button class="btn btn-primary" type="submit">Speichern</button>
  </form>
</div>

<div class="card" id="passwort">
  <h2>Passwort ändern</h2>
  <form method="post" action="/konto/passwort" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field"><span>Aktuelles Passwort</span><input type="password" name="current" autocomplete="current-password" required></label>
    <label class="field"><span>Neues Passwort</span><input type="password" name="password" autocomplete="new-password" minlength="8" maxlength="200" required></label>
    <label class="field"><span>Neues Passwort wiederholen</span><input type="password" name="password2" autocomplete="new-password" minlength="8" maxlength="200" required></label>
    <button class="btn btn-primary" type="submit">Passwort speichern</button>
  </form>
</div>

<div class="card" id="datenschutz">
  <h2>Datenschutz</h2>
  <p class="muted">Was über dich gespeichert wird und was andere sehen, steht in der <a href="/datenschutz">Datenschutzerklärung</a>.</p>

  <h3>Support-Chat</h3>
  <% if (currentUser.supportConsentAt) { %>
    <p>Du hast am <%= date(currentUser.supportConsentAt) %> eingewilligt, dass deine Chat-Nachrichten an den KI-Dienst Groq (USA) übermittelt werden.</p>
    <form method="post" action="/konto/support-einwilligung/widerrufen">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost btn-sm" type="submit">Einwilligung widerrufen</button>
    </form>
  <% } else { %>
    <p class="muted">Du hast der Übermittlung von Chat-Nachrichten an den KI-Dienst nicht zugestimmt. Der Support-Chat fragt dich danach, bevor du ihn nutzen kannst.</p>
  <% } %>

  <h3>Konto löschen</h3>
  <% if (currentUser.isAdmin) { %>
    <p class="muted">Admin-Konten können nicht gelöscht werden.</p>
  <% } else { %>
    <p>Dein Konto wird sofort und endgültig gelöscht: Benutzername, E-Mail-Adresse, Spielgeld, Coins, Karten, Packs, Quests, Kontoauszug und der Text deiner Kommentare. Deine Einsätze in gemeinsamen Wetten bleiben ohne deinen Namen bestehen, damit die Wetten für die anderen abgerechnet werden können.</p>
    <form method="post" action="/konto/loeschen" class="form" data-confirm="Konto wirklich endgültig löschen? Das kann nicht rückgängig gemacht werden.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Passwort zur Bestätigung</span><input type="password" name="password" autocomplete="current-password" required></label>
      <label class="check"><input type="checkbox" name="confirm" required><span>Ich möchte mein Konto endgültig löschen.</span></label>
      <button class="btn btn-danger" type="submit">Konto endgültig löschen</button>
    </form>
  <% } %>
</div>
</div>

<%- include('partials/foot') %>
