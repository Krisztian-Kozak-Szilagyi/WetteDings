<%- include('partials/head') %>

<div class="forum-page forum-thread">
<nav class="forum-crumbs" aria-label="Pfad">
  <a href="/forum">Forum</a><span>›</span>
  <a href="/forum/t/<%= thread._id %>#b-<%= post._id %>"><%= thread.title %></a>
</nav>

<div class="forum-head">
  <div class="forum-head-text">
    <h1>Beitrag bearbeiten</h1>
  </div>
</div>

<% if (!own) { %>
  <p class="forum-hint">Du bearbeitest den Beitrag von <b><%= post.authorName %></b>. Danach kann <%= post.authorName %> ihn nicht mehr selbst ändern. Dein Name erscheint nicht am Beitrag – kennzeichne deine Änderung mit <% myTags.forEach((t, i) => { %><%= i ? ' oder ' : '' %><code>&lt;<%= t %>&gt;…&lt;/<%= t %>&gt;</code><% }) %>.</p>
<% } %>

<form method="post" action="/forum/b/<%= post._id %>/bearbeiten" class="forum-write">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (post.isFirst) { %>
    <label class="forum-field"><span class="forum-label">Titel des Themas</span><input class="input" type="text" name="title" minlength="3" maxlength="<%= titleMax %>" value="<%= thread.title %>" required></label>
  <% } %>
  <div class="forum-field">
    <label class="forum-label" for="edit-text">Text</label>
    <%- include('partials/forum-editor', { id: 'edit-text', rows: 12, max: bodyMax, myTags, value: post.body }) %>
  </div>
  <div class="forum-write-actions">
    <a class="btn btn-ghost" href="/forum/t/<%= thread._id %>#b-<%= post._id %>">Abbrechen</a>
    <button class="btn btn-primary" type="submit">Speichern</button>
  </div>
</form>
</div>

<%- include('partials/foot') %>
