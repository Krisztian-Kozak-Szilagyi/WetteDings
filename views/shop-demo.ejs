<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · <%= appName %></title>
  <meta name="theme-color" content="#14161f">
  <link rel="icon" href="/favicon-32.png?v=<%= assetVersion %>" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-64.png?v=<%= assetVersion %>" sizes="64x64" type="image/png">
  <link rel="stylesheet" href="/css/shop-demo.css?v=<%= assetVersion %>">
</head>
<%# Shop-Demo – eigener Laden in 2:1-Isometrie mit Figur (WASD, E). Bestellt wird am PC (Kassentheke), die Kartons
    landen auf dem Gehweg und müssen eingeräumt/aufgebaut werden. Gezeichnet wird mit Phaser (public/js/shop-demo.js),
    Regeln in src/shop/layout.js (/js/shop-layout.js), Kunden in src/shop/customers.js (/js/shop-customers.js). Kanacoin = Demo-Geld, getrennt vom Kontostand. %>
<body class="sd-body" data-shop-root data-csrf="<%= csrfToken %>">
  <div class="sd-stage" data-shop-stage></div>

  <div class="sd-hud">
    <a class="sd-back" href="/" title="Zurück zur Seite">←</a>
    <button type="button" class="sd-coins" data-shop-coins title="Kanacoin festlegen">
      <span class="sd-coin-dot"></span><span data-shop-coins-value>–</span> Kanacoin
    </button>
    <div class="sd-hand" data-shop-hand hidden></div>
  </div>
  <div class="sd-clock" data-shop-clock></div>
  <div class="sd-note" data-shop-note hidden></div>
  <%# TEST-KNÖPFE – nur für die Demo, im fertigen Spiel entfernen (public/js/shop-demo.js „TEST-KNÖPFE“, CSS .sd-dev) %>
  <div class="sd-dev" aria-label="Test">
    <span class="sd-dev-tag">TEST</span>
    <button type="button" data-shop-dev="kunde">+ Kunde</button>
    <button type="button" data-shop-dev="auftrag">+ Kunde mit Karte</button>
    <button type="button" data-shop-dev="ruf">+100 Ruf</button>
    <button type="button" data-shop-dev="arcade">+ Spielautomat</button>
    <button type="button" data-shop-dev="dungeon">+ Dungeon-Karte</button>
  </div>
  <div class="sd-hud sd-hud-right">
    <button type="button" class="sd-reset" data-shop-reset>Neu starten</button>
  </div>

  <div class="sd-panel" data-shop-panel hidden>
    <div class="sd-panel-name" data-shop-panel-name></div>
    <div class="sd-panel-info" data-shop-panel-info></div>
    <div class="sd-panel-btns">
      <button type="button" data-shop-do="rotate">Drehen (R)</button>
      <button type="button" data-shop-do="move">Verschieben</button>
      <button type="button" data-shop-do="inhalt" hidden>Inhalt</button>
      <button type="button" data-shop-do="remove">Zurückgeben <span data-shop-panel-refund></span></button>
    </div>
  </div>

  <div class="sd-hint" data-shop-hint>WASD laufen · E benutzen · Q Karton abstellen · R drehen · Tab Werkzeug-Rad · I Inventar · O Notiz (QA) · Esc Menü · Mausrad Zoom · Möbel anklicken = verschieben/drehen</div>
  <div class="sd-toast" data-shop-toast hidden></div>
  <%# Werkzeug-Rad (Tab gedrückt halten): public/js/shop-demo.js „Werkzeug in der Hand“ %>
  <div class="sd-wheel" data-shop-wheel hidden></div>

  <dialog class="sd-win sd-pc" data-shop-pc>
    <div class="sd-win-head">
      <strong>PC</strong>
      <span class="sd-win-coins"><span class="sd-coin-dot"></span><span data-shop-pc-coins></span></span>
      <form method="dialog"><button type="submit" class="sd-x" aria-label="Schließen">×</button></form>
    </div>
    <div class="sd-pc-body">
      <nav class="sd-tabs" data-shop-tabs></nav>
      <div class="sd-tab-body" data-shop-tab-body></div>
    </div>
  </dialog>

  <dialog class="sd-win sd-shelf" data-shop-shelf>
    <div class="sd-win-head">
      <strong data-shop-shelf-name></strong>
      <span class="sd-shelf-used" data-shop-shelf-used></span>
      <form method="dialog"><button type="submit" class="sd-x" aria-label="Schließen">×</button></form>
    </div>
    <div class="sd-shelf-body" data-shop-shelf-body></div>
  </dialog>

  <dialog class="sd-win sd-bench" data-shop-bench>
    <div class="sd-win-head">
      <strong>Arbeitstisch</strong>
      <form method="dialog"><button type="submit" class="sd-x" aria-label="Schließen">×</button></form>
    </div>
    <iframe class="sd-bench-frame" data-shop-bench-frame title="Arbeitstisch" src="about:blank"></iframe>
  </dialog>

  <dialog class="sd-win sd-shelf" data-shop-inv>
    <div class="sd-win-head">
      <strong>Inventar</strong>
      <span class="sd-shelf-used" data-shop-inv-used></span>
      <form method="dialog"><button type="submit" class="sd-x" aria-label="Schließen">×</button></form>
    </div>
    <div class="sd-shelf-body" data-shop-inv-body></div>
  </dialog>

  <%# Spielautomat und Schwarzes Brett: public/js/shop-demo.js „Spielautomat“ / „Schwarzes Brett“ %>
  <dialog class="sd-win sd-shelf" data-shop-misc>
    <div class="sd-win-head">
      <strong data-shop-misc-name></strong>
      <form method="dialog"><button type="submit" class="sd-x" aria-label="Schließen">×</button></form>
    </div>
    <div class="sd-shelf-body" data-shop-misc-body></div>
  </dialog>

  <%# QA-Notiz (Taste O): public/js/shop-demo.js „QA-Notiz“, Server: POST /api/shop-demo/notiz, Admin: /shop-demo/notizen %>
  <dialog class="sd-win sd-notiz" data-shop-notiz>
    <div class="sd-win-head">
      <strong>Notiz für die Entwicklung</strong>
      <form method="dialog"><button type="submit" class="sd-x" aria-label="Schließen">×</button></form>
    </div>
    <div class="sd-notiz-body">
      <p class="sd-later">Was ist dir aufgefallen? Fehler, zu teuer, nervt, unklar … Der Moment im Spiel wird mitgespeichert. Das Spiel pausiert solange.</p>
      <textarea maxlength="1000" rows="6" data-shop-notiz-text></textarea>
      <p class="sd-menu-msg" data-shop-notiz-msg hidden></p>
      <div class="sd-dialog-btns">
        <button type="button" data-shop-notiz-cancel>Abbrechen</button>
        <button type="button" class="is-main" data-shop-notiz-save>Speichern</button>
      </div>
    </div>
  </dialog>

  <%# Hauptmenü beim Start und Pause (Esc): public/js/shop-demo.js „Menü“, Spielstände: /api/shop-demo/spielstaende %>
  <dialog class="sd-win sd-menu" data-shop-menu>
    <div class="sd-menu-body" data-shop-menu-body></div>
  </dialog>

  <dialog class="sd-dialog" data-shop-dialog>
    <form method="dialog" data-shop-dialog-form>
      <p data-shop-dialog-text></p>
      <input type="number" min="0" max="10000000" step="1" data-shop-dialog-input hidden>
      <div class="sd-dialog-btns">
        <button value="cancel" type="submit" formnovalidate>Abbrechen</button>
        <button value="ok" type="submit" class="is-main" data-shop-dialog-ok>OK</button>
      </div>
    </form>
  </dialog>

  <script src="/vendor/phaser.min.js" defer></script>
  <script src="/js/shop-layout.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/shop-customers.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/shop-turnier.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/shop-sound.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/shop-kasse.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/shop-werkbank-phaser.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/shop-demo.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
