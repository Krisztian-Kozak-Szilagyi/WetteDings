<%
  const openAlerts = deviceMatches.filter((a) => !a.doneAt);
  const doneAlerts = deviceMatches.filter((a) => a.doneAt);
  const count = (n) => (n ? ` <span class="panel-badge panel-badge-inline">${n > 99 ? '99+' : n}</span>` : '');
%>

<% if (sub === 'streit') { %>
<section class="stats-block" id="streitfaelle">
  <%- blockHead('Streitfälle', 'Ersteller und Schiedsrichter haben unterschiedliche Ergebnisse eingetragen – bis ein Dev entscheidet, wird nichts ausgezahlt. Deine Stimme schließt die Wette sofort und rechnet ab. Ohne Entscheidung werden die Einsätze ' + autoVoidDays + ' Tage nach dem Auswertungstermin automatisch erstattet.') %>
  <%- include('../partials/dispute-list', { bets: disputes }) %>
</section>
<% } else if (sub === 'meldungen') { %>
<section class="stats-block" id="meldungen">
  <%- blockHead('Gemeldete Beiträge', 'Prüfe den Beitrag im Forum, greife dort ein (bearbeiten, löschen, Thema schließen) und markiere die Meldung dann als erledigt.') %>
  <div class="card">
    <% if (!reports.length) { %>
      <p class="muted">Keine offenen Meldungen.</p>
    <% } else { %>
      <ul class="code-list">
        <% reports.forEach((r) => { %>
          <li class="code-item">
            <div class="code-main">
              <span>Gemeldet von <%- userLink(r.byName, { realName: false }) %> · <%= dateSec(r.createdAt) %></span>
            </div>
            <div class="code-meta small">
              <% if (r.reason) { %><div><strong>Grund:</strong> <%= r.reason %></div><% } %>
              <div class="muted">
                <% if (r.postDoc) { %>
                  Beitrag von <%= r.postDoc.authorName %>: <%= r.postDoc.deleted ? '(inzwischen gelöscht)' : r.postDoc.body.slice(0, 220) + (r.postDoc.body.length > 220 ? ' …' : '') %>
                <% } else { %>Beitrag nicht mehr vorhanden<% } %>
              </div>
            </div>
            <div class="code-actions">
              <a class="btn btn-ghost btn-sm" href="/forum/t/<%= r.thread %>#b-<%= r.post %>">Zum Beitrag</a>
              <form method="post" data-reauth action="/forum/meldungen/<%= r._id %>/erledigt" data-confirm="Meldung von <%= r.byName %> als erledigt markieren?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="zurueck" value="panel">
                <button class="btn btn-primary btn-sm" type="submit">Erledigt</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
<% } else if (sub === 'bans') { %>
<section class="stats-block" id="ban">
  <%- blockHead('Bannen', 'Das Mitglied wird sofort abgemeldet. Der Ban gilt auch für alle Geräte des Kontos: von dort ist weder eine Anmeldung mit einem anderen Konto noch eine Registrierung möglich. Guthaben, Karten, Wetten und Angebote bleiben unverändert.' + (currentUser.isAdmin ? '' : '<br><br>Als Dev bannst du für 1 bis ' + maxBanHours + ' Stunden, nicht den Admin und keine anderen Devs, und änderst keinen laufenden Ban eines anderen.')) %>
  <div class="card">
    <form method="post" data-reauth action="/admin/sperren" class="form panel-ban-form" data-confirm="Dieses Mitglied und alle seine Geräte wirklich bannen?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span>Mitglied</span>
        <select name="user" required>
          <option value="">– auswählen –</option>
          <% bannable.forEach((u) => { %><option value="<%= u._id %>" <%= String(u._id) === banPreselect ? 'selected' : '' %>><%= u.username %><%= u.role ? ' (' + u.role + ')' : '' %></option><% }) %>
        </select>
      </label>
      <label class="field">
        <span>Dauer in Stunden <em><%= currentUser.isAdmin ? '(0 = dauerhaft)' : '(1–' + maxBanHours + ')' %></em></span>
        <input type="number" name="hours" min="<%= currentUser.isAdmin ? 0 : 1 %>" max="<%= maxBanHours %>" step="1" value="24" inputmode="numeric" required>
      </label>
      <label class="field panel-ban-reason">
        <span>Grund <em>(freiwillig – steht im Profil und beim Anmeldeversuch)</em></span>
        <input type="text" name="reason" maxlength="200">
      </label>
      <button class="btn btn-danger" type="submit">Bannen</button>
    </form>
  </div>
</section>

<section class="stats-block" id="banliste">
  <%- blockHead('Ban-Liste' + count(bans.length), currentUser.isAdmin ? '' : 'Aufheben kannst du die Bans, die du selbst vergeben hast.') %>
  <div class="card">
    <% if (!bans.length) { %>
      <p class="muted">Aktuell ist niemand gebannt.</p>
    <% } else { %>
      <ul class="code-list">
        <% bans.forEach((b) => { %>
          <li class="code-item">
            <div class="code-main"><strong><%- userLink(b.username, { realName: false }) %></strong> <span class="badge badge-entschieden"><%= b.forever ? 'dauerhaft' : 'bis ' + date(b.bannedUntil) %></span></div>
            <div class="code-meta muted small">
              <%= b.banReason ? 'Grund: ' + b.banReason + ' · ' : '' %>gebannt von <%= b.bannedByName || '–' %> · <%= date(b.bannedAt) %> · <%= b.devices %> <%= b.devices === 1 ? 'Gerät' : 'Geräte' %> mitgebannt
            </div>
            <div class="code-actions">
              <% if (b.canUnban) { %>
                <form method="post" data-reauth action="/admin/sperren/<%= b._id %>/aufheben" data-confirm="<%= b.username %> wirklich entbannen?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-ghost btn-sm" type="submit">Ban aufheben</button>
                </form>
              <% } else { %>
                <span class="muted small" title="Aufheben kann nur der Admin oder wer den Ban vergeben hat">nur Admin oder <%= b.bannedByName || 'Vergeber' %></span>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
<% } else if (sub === 'auffaelligkeiten') { %>
<%
  const openSusp = suspicions.filter((a) => !a.doneAt);
  const doneSusp = suspicions.filter((a) => a.doneAt);
%>
<section class="stats-block" id="auffaelligkeiten">
  <%- blockHead('Auffälligkeiten', 'Muster, die nach Skript oder Geldverschiebung aussehen. Alle 10 Minuten neu ausgewertet. Das ist nur ein Verdacht, gebannt wird dadurch niemand: Schau dir die Aktionen im Protokoll an und entscheide selbst.<br><strong>Tempo</strong>: mehrere Aktionen in Folge schneller, als man von Hand klicken kann.<br><strong>Takt</strong>: viele Aktionen in fast exakt gleichen Abständen.<br><strong>IHK sekundengenau</strong>: Quests fast immer direkt bei Ablauf abgeholt und sofort neu gestartet.<br><strong>Broker-Scalping</strong>: viele schnelle Kauf-Verkauf-Runden mit ungewöhnlich hoher Trefferquote.<br><strong>Wertverschiebung</strong>: Geschäfte mit sehr ungleichem Wert, z. B. eine teure Karte für 1 €.') %>
  <div class="card">
    <% if (!openSusp.length) { %>
      <p class="muted">Aktuell gibt es keine offenen Auffälligkeiten.</p>
    <% } %>
    <% const suspList = (list) => { %>
      <ul class="code-list">
        <% list.forEach((a) => { %>
          <li class="code-item device-alert <%= a.doneAt ? 'is-used' : '' %>">
            <div class="code-main">
              <span class="badge device-level-<%= a.level %>"><%= a.levelLabel %></span>
              <strong><%= a.kindLabel %></strong><%= a.actionLabel ? ' · ' + a.actionLabel : '' %> ·
              <% a.users.forEach((u, i) => { %><%= i ? ' ↔ ' : '' %><strong><%- userLink(u.username, { realName: false }) %></strong><% if (u.banned) { %> <span class="badge badge-entschieden">gebannt</span><% } %><% }) %>
            </div>
            <div class="code-meta small">
              <div><%= a.summary %></div>
              <% if (a.details && Array.isArray(a.details.trades)) { %>
                <ul class="susp-trades">
                  <% a.details.trades.forEach((t) => { %><li><%= t %></li><% }) %>
                </ul>
              <% } %>
              <div class="muted"><%= a.from && dateSec(a.from) !== dateSec(a.evidenceAt) ? dateSec(a.from) + ' – ' : '' %><%= dateSec(a.evidenceAt) %><%= a.doneAt ? ' · erledigt ' + date(a.doneAt) + (a.doneByName ? ' von ' + a.doneByName : '') : '' %></div>
            </div>
            <div class="code-actions">
              <% a.users.forEach((u) => { %>
                <a class="btn btn-ghost btn-sm" href="<%= panelUrl('protokolle', 'protokoll', { log: a.log, spieler: u.username }) %>">Protokoll <%= a.users.length > 1 ? u.username : '' %></a>
              <% }) %>
              <form method="post" data-reauth action="/admin/auffaelligkeiten/<%= a._id %>" data-confirm="<%= a.doneAt ? 'Hinweis wieder öffnen?' : 'Hinweis als erledigt markieren?' %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="<%= a.doneAt ? 'oeffnen' : 'erledigt' %>">
                <button class="btn btn-ghost btn-sm" type="submit"><%= a.doneAt ? 'Wieder öffnen' : 'Erledigt' %></button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% if (openSusp.length) suspList(openSusp); %>
    <% if (doneSusp.length) { %>
      <details class="history device-done">
        <summary>Erledigte Auffälligkeiten (<%= doneSusp.length %>)</summary>
        <% suspList(doneSusp); %>
      </details>
    <% } %>
  </div>
</section>
<% } else { %>
<section class="stats-block" id="geraete">
  <%- blockHead('Mehrfach-Konten', 'Konten, die vom selben Gerät aus benutzt wurden.<br><strong>Sicher</strong>: derselbe Browser (Geräte-Kennung).<br><strong>Wahrscheinlich</strong>: gleiche Geräte-Merkmale und gleiche IP-Adresse.<br><strong>Möglich</strong>: nur gleiche Geräte-Merkmale – kommt auch bei baugleichen Geräten vor und zählt nicht fürs Abzeichen.') %>
  <div class="card">
    <% if (!openAlerts.length) { %>
      <p class="muted">Aktuell gibt es keine offenen Hinweise.</p>
    <% } %>
    <% const alertList = (list) => { %>
      <ul class="code-list">
        <% list.forEach((a) => { %>
          <li class="code-item device-alert <%= a.doneAt ? 'is-used' : '' %>">
            <div class="code-main">
              <span class="badge device-level-<%= a.level %>"><%= a.label %></span>
              <% a.users.forEach((u, i) => { %><%= i ? ' ↔ ' : '' %><strong><%- userLink(u.username, { realName: false }) %></strong><% if (u.banned) { %> <span class="badge badge-entschieden">gebannt</span><% } %><% }) %>
            </div>
            <div class="code-meta small">
              <% if (!a.shared.length) { %><span class="muted">Die Geräte-Daten dazu sind nicht mehr vorhanden.</span><% } %>
              <% a.shared.forEach((s) => { %>
                <div class="device-shared">
                  <div class="muted"><%= s.label %> · <%= s.ua || 'Gerät' %></div>
                  <% a.users.forEach((u, i) => { %>
                    <div><strong><%= u.username %>:</strong> <%= s.logins[i].times.length ? 'Anmeldungen ' + s.logins[i].times.map((t) => date(t)).join(' · ') : 'zuletzt gesehen ' + date(s.logins[i].lastAt) %></div>
                  <% }) %>
                </div>
              <% }) %>
              <div class="muted">Konten erstellt: <%= a.users.map((u) => u.username + ' ' + date(u.createdAt)).join(' · ') %></div>
            </div>
            <div class="code-actions">
              <% a.users.filter((u) => !u.banned && bannable.some((b) => String(b._id) === String(u._id))).forEach((u) => { %>
                <a class="btn btn-danger btn-sm" href="<%= subUrl('moderation', 'bans', { ban: String(u._id) }) %>"><%= u.username %> bannen</a>
              <% }) %>
              <form method="post" data-reauth action="/admin/geraete/<%= a._id %>" data-confirm="<%= a.doneAt ? 'Hinweis wieder öffnen?' : 'Hinweis als erledigt markieren?' %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="<%= a.doneAt ? 'oeffnen' : 'erledigt' %>">
                <button class="btn btn-ghost btn-sm" type="submit"><%= a.doneAt ? 'Wieder öffnen' : 'Erledigt' %></button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <% if (openAlerts.length) alertList(openAlerts); %>
    <% if (doneAlerts.length) { %>
      <details class="history device-done">
        <summary>Erledigte Hinweise (<%= doneAlerts.length %>)</summary>
        <% alertList(doneAlerts); %>
      </details>
    <% } %>
  </div>
</section>
<% } %>
