<%
  const openAlerts = deviceMatches.filter((a) => !a.doneAt);
  const doneAlerts = deviceMatches.filter((a) => a.doneAt);
  const count = (n) => (n ? ` <span class="panel-badge panel-badge-inline">${n > 99 ? '99+' : n}</span>` : '');
%>

<% if (sub === 'streit') { %>
<section class="stats-block" id="streitfaelle">
  <%- blockHead('Streitfälle', 'Ersteller und Schiedsrichter haben unterschiedliche Ergebnisse eingetragen – bis ein Dev entscheidet, wird nichts ausgezahlt. Deine Stimme schließt die Wette sofort und rechnet ab. Ohne Entscheidung werden die Einsätze ' + autoVoidDays + ' Tage nach dem Auswertungstermin automatisch erstattet.') %>
  <%- include('../partials/dispute-list', { bets: disputes }) %>
</section>
<% } else if (sub === 'meldungen') { %>
<section class="stats-block" id="meldungen">
  <%- blockHead('Gemeldete Beiträge', 'Prüfe den Beitrag im Forum, greife dort ein (bearbeiten, löschen, Thema schließen) und markiere die Meldung dann als erledigt.') %>
  <div class="card">
    <% if (!reports.length) { %>
      <p class="muted">Keine offenen Meldungen.</p>
    <% } else { %>
      <ul class="code-list">
        <% reports.forEach((r) => { %>
          <li class="code-item">
            <div class="code-main">
              <span>Gemeldet von <%- userLink(r.byName, { realName: false }) %> · <%= dateSec(r.createdAt) %></span>
            </div>
            <div class="code-meta small">
              <% if (r.reason) { %><div><strong>Grund:</strong> <%= r.reason %></div><% } %>
              <div class="muted">
                <% if (r.postDoc) { %>
                  Beitrag von <%= r.postDoc.authorName %>: <%= r.postDoc.deleted ? '(inzwischen gelöscht)' : r.postDoc.body.slice(0, 220) + (r.postDoc.body.length > 220 ? ' …' : '') %>
                <% } else { %>Beitrag nicht mehr vorhanden<% } %>
              </div>
            </div>
            <div class="code-actions">
              <a class="btn btn-ghost btn-sm" href="/forum/t/<%= r.thread %>#b-<%= r.post %>">Zum Beitrag</a>
              <form method="post" data-reauth action="/forum/meldungen/<%= r._id %>/erledigt" data-confirm="Meldung von <%= r.byName %> als erledigt markieren?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="zurueck" value="panel">
                <button class="btn btn-primary btn-sm" type="submit">Erledigt</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
<% } else if (sub === 'bans') { %>
<section class="stats-block" id="ban">
  <%- blockHead('Bannen', 'Das Mitglied wird sofort abgemeldet. Der Ban gilt auch für alle Geräte des Kontos: von dort ist weder eine Anmeldung mit einem anderen Konto noch eine Registrierung möglich. Guthaben, Karten, Wetten und Angebote bleiben unverändert.' + (currentUser.isAdmin ? '' : '<br><br>Als Dev bannst du für 1 bis ' + maxBanHours + ' Stunden, nicht den Admin und keine anderen Devs, und änderst keinen laufenden Ban eines anderen.')) %>
  <div class="card">
    <form method="post" data-reauth action="/admin/sperren" class="form panel-ban-form" data-confirm="Dieses Mitglied und alle seine Geräte wirklich bannen?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span>Mitglied</span>
        <select name="user" required>
          <option value="">– auswählen –</option>
          <% bannable.forEach((u) => { %><option value="<%= u._id %>" <%= String(u._id) === banPreselect ? 'selected' : '' %>><%= u.username %><%= u.role ? ' (' + u.role + ')' : '' %></option><% }) %>
        </select>
      </label>
      <label class="field">
        <span>Dauer in Stunden <em><%= currentUser.isAdmin ? '(0 = dauerhaft)' : '(1–' + maxBanHours + ')' %></em></span>
        <input type="number" name="hours" min="<%= currentUser.isAdmin ? 0 : 1 %>" max="<%= maxBanHours %>" step="1" value="24" inputmode="numeric" required>
      </label>
      <label class="field panel-ban-reason">
        <span>Grund <em>(freiwillig – steht im Profil und beim Anmeldeversuch)</em></span>
        <input type="text" name="reason" maxlength="200">
      </label>
      <button class="btn btn-danger" type="submit">Bannen</button>
    </form>
  </div>
</section>

<section class="stats-block" id="banliste">
  <%- blockHead('Ban-Liste' + count(bans.length), currentUser.isAdmin ? '' : 'Aufheben kannst du die Bans, die du selbst vergeben hast.') %>
  <div class="card">
    <% if (!bans.length) { %>
      <p class="muted">Aktuell ist niemand gebannt.</p>
    <% } else { %>
      <ul class="code-list">
        <% bans.forEach((b) => { %>
          <li class="code-item">
            <div class="code-main"><strong><%- userLink(b.username, { realName: false }) %></strong> <span class="badge badge-entschieden"><%= b.forever ? 'dauerhaft' : 'bis ' + date(b.bannedUntil) %></span></div>
            <div class="code-meta muted small">
              <%= b.banReason ? 'Grund: ' + b.banReason + ' · ' : '' %>gebannt von <%= b.bannedByName || '–' %> · <%= date(b.bannedAt) %> · <%= b.devices %> <%= b.devices === 1 ? 'Gerät' : 'Geräte' %> mitgebannt
            </div>
            <div class="code-actions">
              <% if (b.canUnban) { %>
                <form method="post" data-reauth action="/admin/sperren/<%= b._id %>/aufheben" data-confirm="<%= b.username %> wirklich entbannen?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-ghost btn-sm" type="submit">Ban aufheben</button>
                </form>
              <% } else { %>
                <span class="muted small" title="Aufheben kann nur der Admin oder wer den Ban vergeben hat">nur Admin oder <%= b.bannedByName || 'Vergeber' %></span>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
<% } else if (sub === 'karten') { %>
<%# Kartensperren: zu starke Karten bis zum Balance-Patch aus einzelnen Spielmodi nehmen (src/tcg/cardBans.js) %>
<% const modeChecks = (active) => cardBanModes.map((m) => `<label class="check"><input type="checkbox" name="modes" value="${m.key}"${active.includes(m.key) ? ' checked' : ''}><span>${m.label}</span></label>`).join(''); %>
<section class="stats-block" id="kartensperre">
  <%- blockHead('Karte sperren', 'Eine gesperrte Karte ist im gewählten Modus weder als Charakter noch als Boost spielbar, Bots nehmen sie auch nicht. Spieler sehen sie in der Auswahl grau mit „Gesperrt“.<br><br>Was schon läuft, läuft zu Ende. Wer die Karte für einen noch nicht gestarteten Dungeon gewählt hat, bekommt einen Hinweis und muss tauschen – sonst startet der Dungeon ohne ihn. Im Mage Tower kann der Leiter erst starten, wenn niemand mehr eine gesperrte Karte hat.<br><br>Jede Änderung steht im Protokoll „Einstellungen“.') %>
  <div class="card">
    <form method="post" data-reauth action="/admin/kartensperre" class="form" data-confirm="Diese Karte in den gewählten Modi sperren?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span>Karte</span>
        <select name="card" required>
          <option value="">– auswählen –</option>
          <% cardBanCards.forEach((g) => { %><optgroup label="<%= g.rarity.label %>"><% g.cards.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></optgroup><% }) %>
        </select>
      </label>
      <div class="field"><span>Gesperrt in</span><%- modeChecks(cardBanModes.map((m) => m.key)) %></div>
      <button class="btn btn-danger" type="submit">Sperren</button>
    </form>
  </div>
</section>

<section class="stats-block" id="kartensperren">
  <%- blockHead('Gesperrte Karten' + count(cardBanList.length), 'Haken ändern und speichern; ohne Haken ist die Sperre aufgehoben.') %>
  <div class="card">
    <% if (!cardBanList.length) { %>
      <p class="muted">Aktuell ist keine Karte gesperrt.</p>
    <% } else { %>
      <ul class="code-list">
        <% cardBanList.forEach((b) => { %>
          <li class="code-item">
            <div class="code-main"><strong><%= b.card.name %></strong> <span class="muted small"><%= b.rarityLabel %></span></div>
            <div class="code-actions">
              <form method="post" data-reauth action="/admin/kartensperre" class="form" data-confirm="Sperren von <%= b.card.name %> ändern?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="card" value="<%= b.card.id %>">
                <%- modeChecks(b.modes.map((m) => m.key)) %>
                <button class="btn btn-ghost btn-sm" type="submit">Speichern</button>
              </form>
              <form method="post" data-reauth action="/admin/kartensperre" data-confirm="Sperre von <%= b.card.name %> überall aufheben?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="card" value="<%= b.card.id %>">
                <button class="btn btn-ghost btn-sm" type="submit">Aufheben</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
<% } else if (sub === 'auffaelligkeiten') { %>
<%
  const openGroups = suspicionGroups.filter((g) => g.open);
  // beurteilt, aber erneut aufgetreten und noch nicht auf "Gesehen": eigener Block statt im Erledigt-Archiv
  const repeatOf = (g) => g.alerts.filter((a) => a.doneAt && a.repeatPending);
  const repeatGroups = suspicionGroups.filter((g) => !g.open && repeatOf(g).length);
  const doneGroups = suspicionGroups.filter((g) => !g.open && !repeatOf(g).length);
  const meId = String(currentUser._id);
  const isOwn = (users) => users.some((u) => String(u._id) === meId); // eigene Fälle beurteilt man nicht selbst
  const openAlertCount = openGroups.reduce((s, g) => s + g.open, 0);
  const stageAtLeast = (n) => openGroups.filter((g) => g.rating && g.rating.stage >= n).length;
  const AREA_LABEL = { verhalten: 'Spielverhalten', technik: 'Technik', ergebnis: 'Ergebnis' };
  const VERDICT_LABEL = { bestaetigt: 'Bestätigt', fehlalarm: 'Fehlalarm' };
%>
<%# Formular für einen Hinweis bzw. eine Gruppe (ids); action: erledigt, oeffnen, bestaetigt, fehlalarm %>
<% const alertForm = (id, action, label, confirm, ids) => { %>
  <form method="post" data-confirm-dialog action="/admin/auffaelligkeiten/<%= ids ? 'gruppe' : id %>" data-confirm="<%= confirm %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (ids) { %><input type="hidden" name="ids" value="<%= ids %>"><% } %>
    <input type="hidden" name="action" value="<%= action %>">
    <button class="btn btn-ghost btn-sm" type="submit"><%= label %></button>
  </form>
<% } %>
<section class="stats-block" id="auffaelligkeiten">
  <%- blockHead('Auffälligkeiten', 'Muster, die nach Skript oder Geldverschiebung aussehen. Alle 10 Minuten neu ausgewertet. Das ist nur ein Verdacht, gebannt wird dadurch niemand: Schau dir die Aktionen im Protokoll an und entscheide selbst.<br><strong>Gesamtbewertung</strong> je Spieler aus drei Bereichen – Spielverhalten (Tempo, Takt, IHK, Dungeon, Grading, Scalping, Rund um die Uhr, Kurssprünge), Technik (Browser, Reaktionszeit, Eingabe, Falle, Rechenzentrum, zwei Geräte) und Ergebnis (Einnahmen, Wertverschiebung, Kartenkreislauf, Platz 1 mit geliehenem Wert, Sammelkonto, Mehrfach-Konto). Muster aus demselben Bereich bestätigen sich kaum, Belege aus verschiedenen Bereichen stark. <em>Beobachten</em>: einzelne schwache Hinweise. <em>Verdacht</em>: ein klares Muster oder schwache aus mehreren Bereichen. <em>Starker Verdacht</em>: mindestens zwei Bereiche, davon einer „Wahrscheinlich“. <em>Eindeutig</em>: alle drei Bereiche oder Falle. Das Menü-Abzeichen zählt Spieler ab „Verdacht“.<br><strong>Urteil</strong>: Markiere geprüfte Hinweise als <em>Bestätigt</em> (war Manipulation) oder <em>Fehlalarm</em> statt nur als erledigt. Daraus entsteht unten die Trefferquote je Muster und Stufe, mit der sich die Schwellen nachjustieren lassen. Jedes Urteil landet mit einer Kopie des Hinweises im Protokoll „Erkennungs-Urteile“ (dauerhaft, bei Kontolöschung anonymisiert, Export als CSV oder JSON).<br><strong>Tempo</strong>: mehrere Aktionen in Folge schneller, als man von Hand klicken kann.<br><strong>Takt</strong>: viele Aktionen in fast exakt gleichen Abständen.<br><strong>IHK sekundengenau</strong>: Quests fast immer direkt bei Ablauf abgeholt und sofort neu gestartet.<br><strong>Broker-Scalping</strong>: viele schnelle Kauf-Verkauf-Runden mit ungewöhnlich hoher Trefferquote.<br><strong>Wertverschiebung</strong>: Geschäfte mit sehr ungleichem Wert, z. B. eine teure Karte für 1 €.<br><strong>Dungeon-Automatik</strong>: an jedem Termin dabei (auch nachts), immer sofort nach Öffnen der Anmeldung angemeldet oder die Beute nie angeschaut.<br><strong>Grading zur Mindestzeit</strong>: Aufträge fast genau zur frühestmöglichen Zeit fertig gemeldet.<br><strong>Rund um die Uhr</strong>: über 20 Stunden ohne Pause von mehr als 3 Stunden aktiv, auch nachts.<br><strong>Kein normaler Browser</strong>: Spiel-Aktionen aus einem ferngesteuerten Browser, mit dem User-Agent eines Skript-Werkzeugs oder ohne Fingerabdruck und Browser-Kopfzeilen.<br><strong>Ungewöhnliche Einnahmen</strong>: in 24 Stunden mindestens das Fünffache des Üblichen aus IHK, Dungeon, Grading und Bank-Verkäufen (allein nur „Möglich“).<br><strong>Reaktionszeit</strong>: Aktionen weniger als 0,4 s nach dem Laden der Seite oder immer fast gleich lange danach; wiederverwendete Seiten-Kennzeichen; Aktionen ohne vorher geladene Seite.<br><strong>Ohne echte Eingabe</strong>: vor den Aktionen keine Maus-, Touch- oder Tastatureingabe, nur künstliche Klicks (Userscript, Auto-Klicker).<br><strong>Falle ausgelöst</strong>: einen unsichtbaren Link aufgerufen, den nur ein Programm findet.<br><strong>Aus einem Rechenzentrum</strong>: Spiel-Aktionen von einem gemieteten Server (auch manche VPNs, daher nur „Möglich“).<br><strong>Gleichzeitig von zwei Geräten</strong>: Aktionen wechseln innerhalb von 10 Minuten mehrmals zwischen zwei Geräten und zwei Netzen hin und her.<br><strong>Reaktion auf Kurssprünge</strong>: beim Broker immer wieder wenige Sekunden nach einem Kurssprung im selben Wert gehandelt.<br><strong>Kartenkreislauf</strong>: ein wertvolles Exemplar (ab 500 €) wandert durch mindestens drei Konten oder kommt zu einem früheren Besitzer zurück; „Wahrscheinlich“, wenn dabei jemand einen Erfolg freischaltet.<br><strong>Platz 1 mit geliehenem Wert</strong>: auf Platz 1 nur dank Werten, die das Konto vorher per Handel geschenkt oder billig bekommen hat.<br><strong>Sammelkonto</strong>: bekommt von mindestens drei Konten über ungleiche Geschäfte netto viel Wert und gibt kaum etwas zurück.') %>
  <% if (!openGroups.length) { %>
    <div class="card"><p class="muted">Aktuell gibt es keine offenen Auffälligkeiten.</p></div>
  <% } else { %>
    <div class="susp-overview">
      <div class="susp-stat"><span class="susp-stat-value"><%= openGroups.length %></span><span class="susp-stat-label">betroffene Spieler · <%= openAlertCount %> Hinweise</span></div>
      <div class="susp-stat susp-stat-likely"><span class="susp-stat-value"><%= stageAtLeast(2) %></span><span class="susp-stat-label">mit Verdacht oder mehr</span></div>
      <div class="susp-stat susp-stat-sure"><span class="susp-stat-value"><%= stageAtLeast(3) %></span><span class="susp-stat-label">starker Verdacht oder eindeutig</span></div>
    </div>
  <% } %>

  <% const finding = (a) => { %>
    <% const own = isOwn(a.users); %>
    <li class="susp-finding susp-lvl-<%= a.doneAt ? 0 : a.level %>">
      <div class="susp-finding-body">
        <div class="susp-finding-title">
          <strong><%= a.kindLabel %></strong><% if (a.actionLabel) { %><span class="muted"> · <%= a.actionLabel %></span><% } %>
          <span class="susp-pill susp-lvl-<%= a.doneAt ? 0 : a.level %>"><%= a.doneAt ? (VERDICT_LABEL[a.verdict] || 'Erledigt') : a.levelLabel %></span>
        </div>
        <% if (a.facts.length) { %>
          <div class="susp-facts">
            <% a.facts.forEach((f) => { %><span class="susp-fact"><b><%= f.value %></b> <%= f.label %></span><% }) %>
          </div>
        <% } %>
        <p class="susp-summary"><%= a.summary %></p>
        <% if (a.verdict && a.verdictSummary && a.verdictSummary !== a.summary) { %>
          <p class="susp-summary muted small">Beurteilt wurde (<%= a.verdictLevel === 2 ? 'Wahrscheinlich' : 'Möglich' %>): <%= a.verdictSummary %></p>
        <% } %>
        <% if (a.extras.length) { %>
          <ul class="susp-extras"><% a.extras.forEach((t) => { %><li><%= t %></li><% }) %></ul>
        <% } %>
        <div class="susp-time" title="<%= (a.from ? dateSec(a.from) + ' – ' : '') + dateSec(a.evidenceAt) %>">
          <%= timeSpan(a.from, a.evidenceAt) %>
          <% if (a.doneAt) { %> · <%= a.verdict ? VERDICT_LABEL[a.verdict].toLowerCase() : 'erledigt' %> <%= date(a.doneAt) %><%= a.doneByName ? ' von ' + a.doneByName : '' %><% } %>
          <% if (a.doneAt && a.repeatLastAt && new Date(a.repeatLastAt) > new Date(a.doneAt)) { %> · <span class="susp-repeat">erneut aufgetreten, zuletzt <%= relTime(a.repeatLastAt) %><%= a.repeatSeenAt && !a.repeatPending ? ' (gesehen)' : '' %></span><% } %>
        </div>
      </div>
      <div class="susp-finding-actions">
        <% (a.cardLinks || []).forEach((l) => { %>
          <a class="btn btn-ghost btn-sm" href="<%= l.href %>"><%= l.label %></a>
        <% }) %>
        <% a.users.forEach((u) => { %>
          <a class="btn btn-ghost btn-sm" href="<%= panelUrl('protokolle', 'protokoll', { log: a.log, spieler: u.username }) %>">Protokoll<%= a.users.length > 1 ? ' ' + u.username : '' %></a>
        <% }) %>
        <% if (own) { %>
          <span class="muted small" title="Hinweise zu deinem eigenen Konto kann jemand anderes beurteilen.">Eigener Fall</span>
        <% } else if (a.doneAt) { %>
          <% if (a.repeatPending) alertForm(a._id, 'gesehen', 'Gesehen', '') %>
          <% alertForm(a._id, 'oeffnen', 'Wieder öffnen', 'Hinweis wieder öffnen?' + (a.verdict ? ' Das Urteil wird dabei zurückgenommen.' : '')) %>
        <% } else { %>
          <% alertForm(a._id, 'bestaetigt', 'Bestätigt', 'Als bestätigt markieren? Das Muster war tatsächlich Manipulation.') %>
          <% alertForm(a._id, 'fehlalarm', 'Fehlalarm', 'Als Fehlalarm markieren? Das Muster hatte eine harmlose Ursache.') %>
          <% alertForm(a._id, 'erledigt', 'Erledigt', 'Ohne Urteil als erledigt markieren?') %>
        <% } %>
      </div>
    </li>
  <% } %>

  <% const groupCard = (g) => { %>
    <% const openAlerts = g.alerts.filter((a) => !a.doneAt); const doneAlerts = g.alerts.filter((a) => a.doneAt); %>
    <article class="card susp-group susp-stage-<%= g.rating ? g.rating.stage : 0 %>">
      <header class="susp-group-head">
        <div class="susp-who">
          <span class="susp-avatar" aria-hidden="true"><%= g.users[0].username.charAt(0).toUpperCase() %></span>
          <div>
            <div class="susp-who-label"><%= g.users.length > 2 ? g.users.length + ' Konten' : g.users.length > 1 ? 'Konten-Paar' : 'Spieler' %></div>
            <div class="susp-names">
              <% g.users.forEach((u, i) => { %><%= i ? ' ↔ ' : '' %><strong><%- userLink(u.username, { realName: false }) %></strong><% if (u.banned) { %> <span class="badge badge-entschieden">gebannt</span><% } %><% }) %>
            </div>
            <div class="susp-group-sub">
              <%= g.open ? g.open + (g.open === 1 ? ' offener Hinweis' : ' offene Hinweise') : repeatOf(g).length ? 'beurteilt, aber erneut aufgetreten' : 'alles erledigt' %> · zuletzt <%= relTime(g.lastAt) %>
            </div>
          </div>
        </div>
        <div class="susp-group-actions">
          <% if (g.users.length === 1) { %>
            <a class="btn btn-ghost btn-sm" href="<%= panelUrl('protokolle', 'protokoll', { log: 'gesamt', spieler: g.users[0].username }) %>">Alle Aktionen</a>
          <% } %>
          <% if (!isOwn(g.users) && repeatOf(g).length) { %>
            <% alertForm(null, 'gesehen', 'Gesehen', '', repeatOf(g).map((a) => a._id).join(',')) %>
          <% } %>
          <% if (isOwn(g.users)) { %>
            <span class="muted small" title="Hinweise zu deinem eigenen Konto kann jemand anderes beurteilen.">Eigener Fall</span>
          <% } else if (openAlerts.length > 1) { %>
            <% const ids = openAlerts.map((a) => a._id).join(','); %>
            <% alertForm(null, 'bestaetigt', 'Alle bestätigt', `Alle ${openAlerts.length} offenen Hinweise als bestätigt markieren?`, ids) %>
            <% alertForm(null, 'erledigt', 'Alle erledigt', `Alle ${openAlerts.length} offenen Hinweise als erledigt markieren?`, ids) %>
          <% } %>
        </div>
      </header>
      <% if (g.rating) { %>
        <div class="susp-rating susp-stage-<%= g.rating.stage %>">
          <div class="susp-rating-main">
            <span class="susp-rating-label">Gesamtbewertung</span>
            <span class="susp-pill susp-stage-<%= g.rating.stage %>"><%= g.rating.label %></span>
            <span class="susp-rating-reason"><%= g.rating.reason %></span>
          </div>
          <div class="susp-rating-areas" title="Punkte je Bereich: stärkster Hinweis 1 (möglich) bzw. 3 (wahrscheinlich), jeder weitere +1, höchstens 5">
            <% Object.entries(g.rating.areas).forEach(([k, p]) => { %>
              <span class="susp-area <%= p ? 'is-hit' : '' %>"><span class="susp-area-name"><%= AREA_LABEL[k] %></span><span class="susp-area-bar"><i style="width: <%= p * 20 %>%"></i></span></span>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (openAlerts.length) { %>
        <ul class="susp-findings"><% openAlerts.forEach(finding) %></ul>
      <% } %>
      <% if (doneAlerts.length) { %>
        <details class="susp-done">
          <summary><%= doneAlerts.length %> <%= doneAlerts.length === 1 ? 'erledigter Hinweis' : 'erledigte Hinweise' %></summary>
          <ul class="susp-findings"><% doneAlerts.forEach(finding) %></ul>
        </details>
      <% } %>
    </article>
  <% } %>

  <div class="susp-groups">
    <% openGroups.forEach(groupCard) %>
  </div>
  <% if (repeatGroups.length) { %>
    <h3 class="susp-repeat-title">Erneut aufgetreten (<%= repeatGroups.length %>)</h3>
    <p class="muted small">Bereits beurteilte Fälle, bei denen es seit dem Urteil neue Belege gibt. Sie öffnen sich nicht mehr von selbst, nur bei höherer Stufe. Mit „Gesehen“ verschwindet der Hinweis, bis es wieder neue Belege gibt.</p>
    <div class="susp-groups"><% repeatGroups.forEach(groupCard) %></div>
  <% } %>
  <% if (suspicionPrecision.some((r) => r.confirmed || r.falseAlarms)) { %>
    <div class="card susp-precision">
      <h3>Trefferquote je Muster</h3>
      <p class="muted small">Aus allen Urteilen im Protokoll (je Hinweis das letzte, mit der Stufe, die er beim Urteil hatte). Eine niedrige Quote bei „Möglich“ heißt: Diese Schwelle meldet zu viele Harmlose. Liegt „Wahrscheinlich“ nahe 100 %, ist die Stufe verlässlich. Ohne Fehlalarme lässt sich eine Schwelle eher lockern. <a href="<%= panelUrl('protokolle', 'protokoll', { log: 'urteile' }) %>">Alle Urteile im Protokoll</a> (Export als CSV oder JSON).</p>
      <% const quote = (c) => (c.rate === null ? '–' : `${Math.round(c.rate * 100)} % <span class="muted">(${c.confirmed}/${c.confirmed + c.falseAlarms})</span>`); %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Muster</th><th class="num">Hinweise</th><th class="num">Bestätigt</th><th class="num">Fehlalarm</th><th class="num">Trefferquote</th><th class="num">bei „Möglich“</th><th class="num">bei „Wahrscheinlich“</th></tr></thead>
          <tbody>
            <% suspicionPrecision.forEach((r) => { %>
              <tr>
                <td><%= r.label %></td>
                <td class="num"><%= r.total %></td>
                <td class="num"><%= r.confirmed %></td>
                <td class="num"><%= r.falseAlarms %></td>
                <td class="num"><strong><%= r.rate === null ? '–' : Math.round(r.rate * 100) + ' %' %></strong></td>
                <td class="num"><%- quote(r.levels[1]) %></td>
                <td class="num"><%- quote(r.levels[2]) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
  <% if (doneGroups.length) { %>
    <details class="history device-done susp-done-groups">
      <summary>Erledigt (<%= doneGroups.length %> <%= doneGroups.length === 1 ? 'Spieler' : 'Spieler bzw. Paare' %>)</summary>
      <div class="susp-groups"><% doneGroups.forEach(groupCard) %></div>
    </details>
  <% } %>
</section>
<% } else { %>
<section class="stats-block" id="geraete">
  <%- blockHead('Mehrfach-Konten', 'Konten, die vom selben Gerät aus benutzt wurden.<br><strong>Sicher</strong>: derselbe Browser (Geräte-Kennung).<br><strong>Wahrscheinlich</strong>: gleiche Geräte-Merkmale und gleiche IP-Adresse.<br><strong>Möglich</strong>: gleiche Geräte-Merkmale und gleiche IP-Adresse, aber gleichzeitig benutzt – kommt auch bei baugleichen Geräten vor und zählt nicht fürs Abzeichen.<br>Gleiche Geräte-Merkmale allein oder ein geteiltes Netz (z. B. Schule) ergeben keinen Hinweis.') %>
  <%
    const shortTime = (t) => timeSpan(null, t).replace(' Uhr', '');
    const sureCount = openAlerts.filter((a) => a.level >= 3).length;
    const likelyPairs = openAlerts.filter((a) => a.level === 2).length;
  %>
  <% if (!openAlerts.length) { %>
    <div class="card"><p class="muted">Aktuell gibt es keine offenen Hinweise.</p></div>
  <% } else { %>
    <div class="susp-overview">
      <div class="susp-stat"><span class="susp-stat-value"><%= openAlerts.length %></span><span class="susp-stat-label">offene Konten-Paare</span></div>
      <div class="susp-stat susp-stat-sure"><span class="susp-stat-value"><%= sureCount %></span><span class="susp-stat-label">davon sicher</span></div>
      <div class="susp-stat susp-stat-likely"><span class="susp-stat-value"><%= likelyPairs %></span><span class="susp-stat-label">davon wahrscheinlich</span></div>
    </div>
  <% } %>

  <% const pairCard = (a) => { %>
    <article class="card susp-group susp-lvl-<%= a.doneAt ? 0 : a.level %>">
      <header class="susp-group-head">
        <div class="susp-who">
          <span class="susp-avatar" aria-hidden="true">⇄</span>
          <div>
            <div class="susp-who-label">Konten-Paar</div>
            <div class="susp-names">
              <% a.users.forEach((u, i) => { %><%= i ? ' ↔ ' : '' %><strong><%- userLink(u.username, { realName: false }) %></strong><% if (u.banned) { %> <span class="badge badge-entschieden">gebannt</span><% } %><% }) %>
            </div>
            <div class="susp-group-sub">
              Konten erstellt: <%= a.users.map((u) => u.username + ' ' + dayDate(u.createdAt)).join(' · ') %>
              <% if (a.doneAt) { %> · <%= a.verdict ? ({ bestaetigt: 'bestätigt', fehlalarm: 'Fehlalarm' }[a.verdict]) : 'erledigt' %> <%= date(a.doneAt) %><%= a.doneByName ? ' von ' + a.doneByName : '' %><% } %>
            </div>
          </div>
        </div>
        <div class="susp-group-actions">
          <span class="susp-pill susp-lvl-<%= a.doneAt ? 0 : a.level %>"><%= a.doneAt ? ({ bestaetigt: 'Bestätigt', fehlalarm: 'Fehlalarm' }[a.verdict] || 'Erledigt') : a.label %></span>
          <% a.users.filter((u) => !u.banned && bannable.some((b) => String(b._id) === String(u._id))).forEach((u) => { %>
            <a class="btn btn-danger btn-sm" href="<%= subUrl('moderation', 'bans', { ban: String(u._id) }) %>"><%= u.username %> bannen</a>
          <% }) %>
          <%# Urteil (bestätigt/Fehlalarm) erledigt zugleich und steht im Protokoll "Erkennungs-Urteile"; eigene Fälle beurteilt man nicht selbst %>
          <% const deviceForm = (action, label, confirm) => { %>
            <form method="post" data-confirm-dialog action="/admin/geraete/<%= a._id %>" data-confirm="<%= confirm %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="action" value="<%= action %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= label %></button>
            </form>
          <% } %>
          <% if (a.users.some((u) => String(u._id) === String(currentUser._id))) { %>
            <span class="muted small" title="Hinweise zu deinem eigenen Konto kann jemand anderes beurteilen.">Eigener Fall</span>
          <% } else if (a.doneAt) { %>
            <% deviceForm('oeffnen', 'Wieder öffnen', 'Hinweis wieder öffnen?' + (a.verdict ? ' Das Urteil wird dabei zurückgenommen.' : '')) %>
          <% } else { %>
            <% deviceForm('bestaetigt', 'Bestätigt', 'Als bestätigt markieren? Die Konten gehören tatsächlich zusammen (Mehrfach-Konto).') %>
            <% deviceForm('fehlalarm', 'Fehlalarm', 'Als Fehlalarm markieren? Die Konten teilen sich das Gerät aus harmlosem Grund.') %>
            <% deviceForm('erledigt', 'Erledigt', 'Ohne Urteil als erledigt markieren?') %>
          <% } %>
        </div>
      </header>
      <% if (!a.shared.length) { %>
        <p class="susp-empty muted">Die Geräte-Daten dazu sind nicht mehr vorhanden.</p>
      <% } else { %>
        <ul class="susp-findings">
          <% a.shared.forEach((sh) => { %>
            <li class="susp-finding dev-shared susp-lvl-<%= a.doneAt ? 0 : sh.level %>">
              <div class="susp-finding-body">
                <div class="susp-finding-title">
                  <strong><%= sh.ua || 'Gerät' %></strong>
                  <span class="susp-pill susp-lvl-<%= a.doneAt ? 0 : sh.level %>"><%= sh.label %></span>
                </div>
                <div class="dev-users">
                  <% a.users.forEach((u, i) => { const l = sh.logins[i]; %>
                    <div class="dev-user">
                      <div class="dev-user-head"><strong><%= u.username %></strong><span class="muted">zuletzt <%= shortTime(l.lastAt) %></span></div>
                      <% if (l.times.length) { %>
                        <div class="susp-facts"><% l.times.forEach((t) => { %><span class="susp-fact"><%= shortTime(t) %></span><% }) %></div>
                      <% } else { %>
                        <div class="susp-time">keine Anmeldezeiten gespeichert</div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </article>
  <% } %>

  <div class="susp-groups">
    <% openAlerts.forEach(pairCard) %>
  </div>
  <% if (doneAlerts.length) { %>
    <details class="history device-done susp-done-groups">
      <summary>Erledigt (<%= doneAlerts.length %> <%= doneAlerts.length === 1 ? 'Konten-Paar' : 'Konten-Paare' %>)</summary>
      <div class="susp-groups"><% doneAlerts.forEach(pairCard) %></div>
    </details>
  <% } %>
</section>
<% } %>
