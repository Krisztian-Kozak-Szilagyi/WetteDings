<%
  const playerQ = player.q;
  const playerMissing = !!(playerQ && !player.user);
  const data = log ? log.data : null;
  const current = logs.find((l) => l.key === logKey);
  // Adresse im Protokoll-Reiter: Spieler-Filter und gewählter Log bleiben erhalten
  const logUrl = (extra = {}, key = logKey) => panelUrl('protokolle', 'protokoll', { log: key, ...(playerQ ? { spieler: playerQ } : {}), ...extra });
  // Export: gleicher Log und gleiche Filter, ohne Seite
  const exportLink = (format) => '/admin/protokolle/export?' + new URLSearchParams({ log: logKey, ...(playerQ ? { spieler: playerQ } : {}), ...(data && data.q ? { handelsuche: data.q } : {}), ...(data && data.onlySuspicious ? { verdacht: '1' } : {}), ...(data && data.type ? { buchung: data.type } : {}), ...(format ? { format } : {}) });
  const kontoLink = (extra) => logUrl({ ...(data && data.type ? { buchung: data.type } : {}), ...extra });
  const handelLink = (extra) => logUrl({ ...(data && data.q ? { handelsuche: data.q } : {}), ...(data && data.onlySuspicious ? { verdacht: '1' } : {}), ...extra });
  // Seiten blättern (jeder Log hat seinen eigenen Seiten-Parameter)
  const pager = (d, link) => d.pages > 1
    ? `<div class="log-pager">${d.page > 1 ? `<a class="btn btn-ghost btn-sm" href="${link({ [current.page]: d.page - 1 })}">← Neuere</a>` : ''}<span class="muted small">Seite ${d.page} / ${d.pages}</span>${d.page < d.pages ? `<a class="btn btn-ghost btn-sm" href="${link({ [current.page]: d.page + 1 })}">Ältere →</a>` : ''}</div>`
    : '';
  const countLine = (d, one, many) => `${d.total} ${d.total === 1 ? one : many}${player.user ? ' von ' + player.user.username : ''} · Seite ${d.page} von ${d.pages}`;
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  // Kartenliste: "2× Name (Seltenheit)", seltene ab Holo hervorgehoben
  const cardList = (items) => items.length
    ? items.map((c) => `<span class="nowrap">${c.count > 1 ? c.count + '× ' : ''}${c.rare ? '<strong>' + esc(c.label) + '</strong>' : esc(c.label)}</span>`).join(', ')
    : '<span class="muted">–</span>';
  // Erklärung je Protokoll (hinter dem ?)
  const LOG_HELP = {
    handel: 'Alle abgeschlossenen Geschäfte: „Von“ hat die Karte abgegeben, „An“ hat sie bekommen. Geschäfte zwischen Konten, die vom selben Gerät aus benutzt werden (Mehrfach-Konten, „sicher“ oder „wahrscheinlich“), sind rot markiert.',
    packs: 'Jedes geöffnete Booster Pack mit allen gezogenen Karten (seltene ab Holo fett). Pack-Art und Herkunft gibt es erst für Packs, die seit diesem Update geöffnet wurden.',
    verkauf: 'Karten und Gegenstände, die an die Bank verkauft wurden, und Karten aus dem Black Market. Verkäufe zwischen Spielern stehen im Handel-Log.',
    ihk: 'Jede gestartete IHK-Quest mit eingesetzten Karten, Ergebnis, Lohn und Pack-Fund. Bei laufenden Quests steht das Ergebnis schon fest, wird hier aber erst nach Ablauf gezeigt.',
    dungeon: 'Jeder Dungeon-Durchlauf mit Gruppe, eingesetzten Karten und Beute je Spieler. Bots sind kursiv, ein gesuchter Spieler ist fett.',
    wetten: 'Jede Wette mit Ersteller, Schiedsrichter, Topf und wie sie ausgegangen ist – wer sie entschieden hat und mit welcher Begründung. Mit einem Spieler: alle Wetten, die er erstellt, geschiedst oder mitgewettet hat.',
    einsaetze: 'Jeder Einsatz: wer auf welche Option gesetzt hat, wie viel und was nach der Auswertung ausgezahlt wurde.',
    broker: 'Jeder Kauf und Verkauf beim Broker (Coins und ETF) mit Menge, Kurs und Betrag – bei Verkäufen der Erlös nach Steuer auf den Gewinn.',
    lotterie: 'Gekaufte Lose und Gewinne aller Lotterien. Losanzahl, Runde und Gewinnlos werden erst seit diesem Update gespeichert.',
    grading: 'Jeder Grading-Auftrag mit Karte, Kunde, echter und geschätzter Note, Sauberkeit, Versiegelung und Lohn.',
    konto: 'Jede Buchung auf den Spielgeldkonten – der Kontoauszug aller Spieler: Tagesbonus, Erfolge, Provisionen, Grading-Ausbau, Startguthaben und alles andere. Oben lässt sich die Art der Buchung wählen.',
    vergaben: 'Jede Vergabe durch Admin oder Devs: Packs, Karten, Gegenstände und entfernte Karten – auch „an alle“. Mit Spieler: was er vergeben oder bekommen hat.',
    registrierungen: 'Jede Registrierung: Zeitpunkt, Benutzername, Klarname (falls angegeben), benutzter Einladungscode und wer ihn erzeugt hat. Code und Einladender werden erst seit diesem Update gespeichert – bei älteren Konten steht dort „–“.',
    einstellungen: 'Jede Änderung an Preisen, Chancen, Steuern, Bonus, Grading, Folie, Lotterie, IHK und Dungeon – mit altem und neuem Wert. Mit Spieler: seine Änderungen.',
  };
  const signedEuro = (c) => `<span class="${c < 0 ? 'neg' : 'pos'}">${c > 0 ? '+' : ''}${euro(c)}</span>`;
%>
<section class="stats-block" id="protokoll">
  <form method="get" action="/admin#protokoll" class="stats-toolbar log-toolbar" role="search" data-log-form>
    <input type="hidden" name="bereich" value="protokolle">
    <div class="stats-toolbar-row">
      <label class="log-field">
        <span class="stats-toolbar-label">Protokoll</span>
        <select name="log" data-autosubmit>
          <% logGroups.forEach((g) => { %>
            <optgroup label="<%= g.label %>">
              <% logs.filter((l) => l.group === g.key).forEach((l) => { %><option value="<%= l.key %>" <%= l.key === logKey ? 'selected' : '' %>><%= l.label %></option><% }) %>
            </optgroup>
          <% }) %>
        </select>
      </label>
      <label class="log-field log-field-grow">
        <span class="stats-toolbar-label">Spieler</span>
        <input type="search" name="spieler" list="log-members" autocomplete="off" maxlength="40" placeholder="Alle Spieler" value="<%= playerQ %>">
      </label>
      <% if (data && logKey === 'konto') { %>
        <label class="log-field">
          <span class="stats-toolbar-label">Buchung</span>
          <select name="buchung" data-autosubmit>
            <option value="">Alle Arten</option>
            <% data.types.forEach((t) => { %><option value="<%= t.key %>" <%= t.key === data.type ? 'selected' : '' %>><%= t.label %></option><% }) %>
          </select>
        </label>
      <% } %>
      <% if (data && logKey === 'handel') { %>
        <label class="log-field log-field-grow">
          <span class="stats-toolbar-label">Suche</span>
          <input type="search" name="handelsuche" value="<%= data.q %>" maxlength="40" placeholder="Name oder Karte">
        </label>
        <label class="check bm-filter log-check"><input type="checkbox" name="verdacht" value="1" <%= data.onlySuspicious ? 'checked' : '' %> data-autosubmit> <span>nur Mehrfach-Konten</span></label>
      <% } %>
      <div class="log-actions">
        <button class="btn btn-primary btn-sm" type="submit">Anzeigen</button>
        <% if (playerQ || (data && (data.q || data.onlySuspicious || data.type))) { %><a class="btn btn-ghost btn-sm" href="<%= panelUrl('protokolle', 'protokoll', { log: logKey }) %>">Zurücksetzen</a><% } %>
        <% if (data) { %>
          <details class="stats-menu" data-dropdown>
            <summary class="btn btn-ghost btn-sm"><%- icon('download') %> Export</summary>
            <div class="stats-menu-panel">
              <a class="stats-menu-item" href="<%= exportLink() %>" download>
                <strong>CSV für Excel</strong>
                <span class="muted small">„<%= current.label %>“<%= player.user ? ' von ' + player.user.username : '' %>, alle <%= data.total %> Einträge<%= data.total > exportMax ? ' (höchstens ' + exportMax + ')' : '' %></span>
              </a>
              <a class="stats-menu-item" href="<%= exportLink('json') %>" download>
                <strong>JSON</strong>
                <span class="muted small">Rohwerte (Beträge in Cent)</span>
              </a>
            </div>
          </details>
        <% } %>
      </div>
    </div>
  </form>
  <datalist id="log-members"><% users.forEach((u) => { %><option value="<%= u.username %>"><% }) %></datalist>

  <% if (player.user) { %>
    <p class="log-player muted small">Nur <%- userLink(player.user.username, { realName: false }) %> · <a href="/admin/statistik?bereich=mitglied&amp;spieler=<%= encodeURIComponent(player.user.username) %>">Statistik</a></p>
  <% } %>
  <% if (newSuspicious) { %><p class="panel-warning-line"><span aria-hidden="true">!</span> <%= newSuspicious %> neue Geschäfte zwischen Mehrfach-Konten (rot markiert).</p><% } %>

  <div class="card">
    <% if (playerMissing) { %>
      <p class="muted">Es gibt kein Mitglied „<%= playerQ %>“. Bitte einen Namen aus der Liste wählen.</p>
    <% } %>
    <% if (data && logKey === 'handel') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Geschäft', 'Geschäfte') %><%= data.onlySuspicious ? ' · nur Mehrfach-Konten' : '' %><%= data.q ? ' · Suche „' + data.q + '“' : '' %></p>
      <% if (!data.rows.length) { %>
        <p class="muted"><%= data.q || player.user ? 'Nichts gefunden.' : 'Es gibt noch keine abgeschlossenen Geschäfte.' %></p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Von</th><th>An</th><th>Karte</th><th>Gegenleistung</th><th>Art</th></tr></thead>
            <tbody>
              <% data.rows.forEach((t) => { %>
                <tr class="<%= t.flagged ? 'trade-flagged' : '' %>">
                  <td class="nowrap"><%= dateSec(t.at) %><% if (t.flagged) { %><br><span class="badge trade-flag" title="Beide Konten werden vom selben Gerät aus benutzt">Mehrfach-Konto</span><% } %><% if (t.isNew) { %> <span class="badge badge-offen">Neu</span><% } %></td>
                  <td><%- userLink(t.from, { realName: false }) %></td>
                  <td><%- userLink(t.to, { realName: false }) %></td>
                  <td><%= t.card %></td>
                  <td><%= t.back %><% if (t.tax) { %> <span class="muted small">(Steuer <%= euro(t.tax) %>)</span><% } %></td>
                  <td class="nowrap"><%= t.kind %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, handelLink) %>

    <% } else if (data && logKey === 'packs') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Pack', 'Packs') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine geöffneten Packs.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Spieler</th><th>Pack</th><th>Gezogene Karten</th><th>Beste</th></tr></thead>
            <tbody>
              <% data.rows.forEach((o) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(o.at) %></td>
                  <td><%- userLink(o.player, { realName: false }) %></td>
                  <td><%= o.pack %><br><span class="muted small"><%= o.source %><%= o.cost ? ' · ' + euro(o.cost) : '' %></span></td>
                  <td><%- cardList(o.cards) %></td>
                  <td class="nowrap"><%= o.best || '–' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'verkauf') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Buchung', 'Buchungen') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Verkäufe.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Spieler</th><th>Art</th><th>Karten / Gegenstände</th><th class="num">Betrag</th></tr></thead>
            <tbody>
              <% data.rows.forEach((l) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(l.at) %></td>
                  <td><%- userLink(l.player, { realName: false }) %></td>
                  <td class="nowrap"><%= l.kind %></td>
                  <td><%- cardList(l.items) %></td>
                  <td class="num nowrap"><%- signedEuro(l.amount) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'ihk') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Quest', 'Quests') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine IHK-Quests.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Gestartet</th><th>Spieler</th><th>Quest</th><th>Karten</th><th>Ergebnis</th><th class="num">Lohn</th></tr></thead>
            <tbody>
              <% data.rows.forEach((r) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(r.at) %></td>
                  <td><%- userLink(r.player, { realName: false }) %></td>
                  <td><%= r.quest %><br><span class="muted small"><%= r.difficulty %></span></td>
                  <td><%= r.card %><% if (r.boosts.length) { %><br><span class="muted small">Boost: <%= r.boosts.join(', ') %></span><% } %></td>
                  <td class="nowrap">
                    <% if (r.state === 'laeuft') { %><span class="badge badge-wartend">Läuft</span><br><span class="muted small">bis <%= dateSec(r.endsAt) %></span>
                    <% } else { %><span class="badge <%= r.state === 'geschafft' ? 'badge-entschieden' : 'badge-streitig' %>"><%= r.state === 'geschafft' ? 'Geschafft' : 'Gescheitert' %></span><% if (r.pack) { %><br><span class="muted small">+ <%= r.pack %></span><% } %><% } %>
                  </td>
                  <td class="num nowrap"><%= r.state === 'laeuft' ? '–' : r.reward ? euro(r.reward) : '–' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'dungeon') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Durchlauf', 'Durchläufe') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Dungeon-Durchläufe.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Gestartet</th><th>Dungeon</th><th>Ergebnis</th><th>Gruppe und Beute</th></tr></thead>
            <tbody>
              <% data.rows.forEach((r) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(r.startedAt) %></td>
                  <td><%= r.dungeon %></td>
                  <td class="nowrap">
                    <% if (r.running) { %><span class="badge badge-wartend">Läuft</span><br><span class="muted small">bis <%= dateSec(r.at) %></span>
                    <% } else { %><span class="badge <%= r.success ? 'badge-entschieden' : 'badge-streitig' %>"><%= r.success ? 'Boss besiegt' : 'Rückzug' %></span><br><span class="muted small"><%= r.progress %> Kämpfe<%= r.failedAt ? ' · gescheitert an ' + r.failedAt : '' %></span><% } %>
                  </td>
                  <td>
                    <% r.members.forEach((m) => {
                      const loot = [m.reward ? euro(m.reward) : null, m.foil ? 'Folie' : null, m.bossCard ? 'Boss-Karte' : null].filter(Boolean); %>
                      <div>
                        <% if (m.bot) { %><em><%= m.name %></em> <span class="muted small">(Bot)</span><% } else if (m.highlight) { %><strong><%- userLink(m.name, { realName: false }) %></strong><% } else { %><%- userLink(m.name, { realName: false }) %><% } %><%= m.leader ? ' ★' : '' %>
                        <span class="muted small">– <%= m.card %><%= m.boost ? ' + ' + m.boost : '' %></span>
                        <% if (!m.bot && !r.running) { %><span class="small"> · <%= loot.length ? loot.join(', ') : 'keine Beute' %></span><% } %>
                      </div>
                    <% }) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>
    <% } else if (data && logKey === 'wetten') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Wette', 'Wetten') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Wetten.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Erstellt</th><th>Wette</th><th>Ersteller / Schiri</th><th>Ergebnis</th><th class="num">Topf</th></tr></thead>
            <tbody>
              <% data.rows.forEach((b) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(b.at) %></td>
                  <td><a href="/wetten/<%= b.id %>"><%= b.title %></a><% if (b.duel) { %> <span class="badge badge-duell">Duell</span><% } %><br><span class="muted small"><%= b.options.join(' / ') %><%= b.group ? ' · Gruppe ' + b.group : '' %></span></td>
                  <td><%- userLink(b.creator, { realName: false }) %><% if (b.referee) { %><br><span class="muted small">Schiri:</span> <%- userLink(b.referee, { realName: false }) %><% } %></td>
                  <td>
                    <span class="badge <%= b.status === 'entschieden' ? 'badge-entschieden' : b.status === 'annulliert' ? 'badge-annulliert' : b.result === 'Strittig' ? 'badge-streitig' : 'badge-offen' %>"><%= b.result %></span>
                    <% if (b.resolvedAt) { %><br><span class="muted small"><%= b.via ? b.via : '' %><%= b.resolvedBy ? ' · ' + b.resolvedBy : '' %> · <%= dateSec(b.resolvedAt) %></span><% } %>
                    <% if (b.note) { %><br><span class="muted small">„<%= b.note %>“</span><% } %>
                  </td>
                  <td class="num nowrap"><%= euro(b.pot) %><br><span class="muted small"><%= b.participants %> Teilnehmer</span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'einsaetze') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Einsatz', 'Einsätze') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Einsätze.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Spieler</th><th>Wette</th><th>Gesetzt auf</th><th class="num">Einsatz</th><th class="num">Ergebnis</th></tr></thead>
            <tbody>
              <% data.rows.forEach((p) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(p.at) %></td>
                  <td><%- userLink(p.player, { realName: false }) %></td>
                  <td><a href="/wetten/<%= p.betId %>"><%= p.bet %></a></td>
                  <td><%= p.side %></td>
                  <td class="num nowrap"><%= euro(p.amount) %></td>
                  <td class="num nowrap"><% if (p.state === 'offen') { %><span class="badge badge-offen">Offen</span><% } else { %><%- signedEuro(p.net) %><br><span class="muted small"><%= p.state === 'gewonnen' ? 'Gewonnen' : p.state === 'erstattet' ? 'Erstattet' : 'Verloren' %> · <%= euro(p.payout) %> zurück</span><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'broker') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Auftrag', 'Aufträge') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Käufe oder Verkäufe.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Spieler</th><th>Wert</th><th>Art</th><th class="num">Menge</th><th class="num">Kurs</th><th class="num">Betrag</th></tr></thead>
            <tbody>
              <% data.rows.forEach((t) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(t.at) %></td>
                  <td><%- userLink(t.player, { realName: false }) %></td>
                  <td><%= t.asset %></td>
                  <td class="nowrap"><span class="badge <%= t.side === 'Kauf' ? 'badge-offen' : 'badge-entschieden' %>"><%= t.side %></span></td>
                  <td class="num nowrap"><%= t.unitsText %></td>
                  <td class="num nowrap"><%= coinPrice(t.price) %></td>
                  <td class="num nowrap"><%- signedEuro(t.cents) %><% if (t.tax) { %><br><span class="muted small">Steuer <%= euro(t.tax) %></span><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'lotterie') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Buchung', 'Buchungen') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Lose gekauft.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Spieler</th><th>Lotterie</th><th>Art</th><th class="num">Betrag</th></tr></thead>
            <tbody>
              <% data.rows.forEach((l) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(l.at) %></td>
                  <td><%- userLink(l.player, { realName: false }) %></td>
                  <td><%= l.lottery %><%= l.round ? ' · Runde ' + l.round : '' %></td>
                  <td><% if (l.kind === 'Gewinn') { %><span class="badge badge-entschieden">Gewinn</span><%= l.ticket ? ' mit Los ' + l.ticket : '' %><% } else { %><%= l.count ? l.count + (l.count === 1 ? ' Los' : ' Lose') : 'Lose' %> gekauft<% } %></td>
                  <td class="num nowrap"><%- signedEuro(l.amount) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'grading') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Auftrag', 'Aufträge') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Grading-Aufträge.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Angenommen</th><th>Spieler</th><th>Karte</th><th>Bewertung</th><th class="num">Lohn</th></tr></thead>
            <tbody>
              <% data.rows.forEach((j) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(j.startedAt) %></td>
                  <td><%- userLink(j.player, { realName: false }) %><br><span class="muted small"><%= j.shop %></span></td>
                  <td><%= j.card %><br><span class="muted small">für <%= j.customer %></span></td>
                  <td>
                    <% if (!j.done) { %><span class="badge badge-wartend">In Arbeit</span>
                    <% } else { %>
                      <span class="small">Note <%= j.grade %><%= j.guess !== null && j.guess !== undefined ? ' · geschätzt ' + j.guess : '' %><%= j.clean !== null && j.clean !== undefined ? ' · sauber ' + j.clean + ' %' : '' %><%= j.seal !== null && j.seal !== undefined ? ' · Siegel ' + j.seal : '' %></span><% if (j.foil) { %><br><span class="muted small">+ Folie gefunden</span><% } %>
                    <% } %>
                  </td>
                  <td class="num nowrap"><%= j.done ? euro(j.pay) : '–' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'konto') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Buchung', 'Buchungen') %><%= data.type ? ' · ' + data.types.find((t) => t.key === data.type).label : '' %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Keine Buchungen gefunden.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Spieler</th><th>Buchung</th><th class="num">Betrag</th></tr></thead>
            <tbody>
              <% data.rows.forEach((l) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(l.at) %></td>
                  <td><%- userLink(l.player, { realName: false }) %></td>
                  <td><%= l.kind %><% if (l.text) { %><br><span class="muted small"><% if (l.betId) { %><a href="/wetten/<%= l.betId %>"><%= l.text %></a><% } else { %><%= l.text %><% } %></span><% } %></td>
                  <td class="num nowrap"><%- signedEuro(l.amount) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, kontoLink) %>
    <% } else if (data && logKey === 'vergaben') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Vergabe', 'Vergaben') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Vergaben.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Von</th><th>An</th><th>Was</th><th class="num">Anzahl</th></tr></thead>
            <tbody>
              <% data.rows.forEach((g) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(g.at) %></td>
                  <td><%- userLink(g.by, { realName: false }) %></td>
                  <td><% if (g.all) { %><strong><%= g.to %></strong><% } else { %><%- userLink(g.to, { realName: false }) %><% } %></td>
                  <td><span class="badge <%= /entzug|abzug/.test(g.kind) ? 'badge-streitig' : g.kind === 'pack' ? 'badge-offen' : 'badge-entschieden' %>"><%= g.kindLabel %></span> <%= g.what %></td>
                  <td class="num"><%= g.count %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'registrierungen') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Registrierung', 'Registrierungen') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Registrierungen.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Benutzername</th><th>Klarname</th><th>Code</th><th>Eingeladen von</th></tr></thead>
            <tbody>
              <% data.rows.forEach((r) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(r.at) %></td>
                  <td><% if (r.deleted) { %><span class="muted"><%= r.name %></span> <span class="badge badge-streitig">gelöscht</span><% } else { %><%- userLink(r.name, { realName: false }) %><% } %></td>
                  <td><%= r.realName || '–' %></td>
                  <td class="nowrap"><% if (r.code) { %><code><%= r.code %></code><% } else { %><span class="muted">–</span><% } %></td>
                  <td><% if (r.invitedBy) { %><%- userLink(r.invitedBy, { realName: false }) %><% } else { %><span class="muted">–</span><% } %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>

    <% } else if (data && logKey === 'einstellungen') { %>
      <p class="muted small log-count"><%- help(LOG_HELP[logKey]) %><%= countLine(data, 'Änderung', 'Änderungen') %></p>
      <% if (!data.rows.length) { %>
        <p class="muted">Noch keine Änderungen.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="table trade-log">
            <thead><tr><th>Zeitpunkt</th><th>Von</th><th>Bereich</th><th>Geändert</th></tr></thead>
            <tbody>
              <% data.rows.forEach((c) => { %>
                <tr>
                  <td class="nowrap"><%= dateSec(c.at) %></td>
                  <td><%= c.by %></td>
                  <td class="nowrap"><%= c.area %></td>
                  <td class="small">
                    <% c.changes.slice(0, 8).forEach((x) => { %><div><code><%= x.path %></code> <span class="muted"><%= x.from %> →</span> <%= x.to %></div><% }) %>
                    <% if (c.changes.length > 8) { %><div class="muted">… und <%= c.changes.length - 8 %> weitere</div><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
      <%- pager(data, logUrl) %>
    <% } %>
  </div>
</section>
