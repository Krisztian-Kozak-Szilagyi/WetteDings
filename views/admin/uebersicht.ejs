<%
  // Offene Aufgaben: was gerade jemand aus dem Team erledigen sollte
  const tasks = [
    { n: counts.disputes, title: 'Streitfälle', text: 'Wettersteller und Schiedsrichter sind sich uneinig – ein Dev entscheidet.', href: '/admin/streitfaelle', action: 'Entscheiden' },
    { n: counts.reports, title: 'Gemeldete Beiträge', text: 'Mitglieder haben Forenbeiträge gemeldet, die noch niemand geprüft hat.', href: panelUrl('moderation', 'meldungen'), action: 'Prüfen' },
    { n: counts.deviceAlerts, title: 'Mehrfach-Konten', text: 'Konten, die sich sicher oder wahrscheinlich ein Gerät teilen.', href: panelUrl('moderation', 'geraete'), action: 'Ansehen' },
    { n: counts.suspicious, title: 'Handel zwischen Mehrfach-Konten', text: 'Neue Geschäfte zwischen Konten, die dasselbe Gerät benutzen.', href: panelUrl('protokolle', 'handellog', { verdacht: '1' }), action: 'Im Handel-Log' },
    ...(currentUser.isAdmin ? [{ n: counts.packLogNew, title: 'Neue Vergaben', text: 'Packs und Karten, die Devs seit deinem letzten Blick vergeben oder entfernt haben.', href: '/admin/pack-log', action: 'Vergabe-Log' }] : []),
  ];
  const open = tasks.filter((t) => t.n);
%>

<section class="stats-block" id="aufgaben">
  <%- blockHead('Offene Aufgaben', open.length ? 'Was gerade auf das Team wartet.' : '') %>
  <% if (!open.length) { %>
    <div class="card panel-done">
      <span class="panel-done-icon" aria-hidden="true">✓</span>
      <div><strong>Alles erledigt.</strong> <span class="muted">Keine Streitfälle, Meldungen oder neuen Hinweise.</span></div>
    </div>
  <% } else { %>
    <ul class="panel-tasks">
      <% open.forEach((t) => { %>
        <li class="card panel-task">
          <span class="panel-task-count"><%= t.n > 99 ? '99+' : t.n %></span>
          <div class="panel-task-text"><strong><%= t.title %></strong><span class="muted small"><%= t.text %></span></div>
          <a class="btn btn-primary btn-sm" href="<%= t.href %>"><%= t.action %></a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="stats-block" id="zahlen">
  <%- blockHead('Auf einen Blick', '') %>
  <div class="stats-kpis stats-kpis-4">
    <a class="stats-kpi card" href="/rangliste"><span class="stat-label">Mitglieder</span><span class="stat-value"><%= stats.userCount %></span></a>
    <a class="stats-kpi card" href="/wetten"><span class="stat-label">Offene Wetten</span><span class="stat-value"><%= stats.openBets %></span></a>
    <div class="stats-kpi card"><span class="stat-label">Wetten gesamt</span><span class="stat-value"><%= stats.totalBets %></span></div>
    <a class="stats-kpi card" href="<%= panelUrl('moderation', 'banliste') %>"><span class="stat-label">Aktive Bans</span><span class="stat-value"><%= counts.bans %></span></a>
  </div>
  <a class="card panel-link-card" href="/admin/statistik">
    <%- icon('trend') %>
    <div><strong>Statistik öffnen</strong><span class="muted small">Wirtschaft, Aktivität, TCG &amp; Handel, Wetten &amp; Spiele und Einzelspieler – mit Verläufen und Export.</span></div>
    <span aria-hidden="true">→</span>
  </a>
</section>

<% if (!currentUser.isAdmin) { %>
  <section class="stats-block" id="rechte">
    <%- blockHead('Deine Rechte als Dev', '') %>
    <div class="card">
      <ul class="panel-rights">
        <li><strong>Streitfälle entscheiden</strong> – außer bei Wetten, an denen du selbst als Ersteller oder Schiedsrichter beteiligt bist.</li>
        <li><strong>Bannen</strong> – für 1 bis 168 Stunden (7 Tage), nicht den Admin und keine anderen Devs. Aufheben kannst du nur Bans, die du selbst vergeben hast; dauerhafte Bans vergibt der Admin.</li>
        <li><strong>Moderieren</strong> – gemeldete Beiträge prüfen, Hinweise auf Mehrfach-Konten abhaken, im Forum und bei Kommentaren eingreifen.</li>
        <li><strong>Packs und Karten vergeben, Karten entfernen</strong> – nur für Bugfixes, Tests und Aktionen; alles steht im Vergabe-Log, der Admin bekommt einen Hinweis.</li>
        <li><strong>Passwort</strong> – jede Aktion in Moderation und Spielwerten bestätigst du mit deinem Passwort.</li>
        <li><strong>Mitglieder einladen</strong> – Einladungscodes erzeugen (Reiter „Team &amp; Einladungen“) und deine eigenen wieder löschen.</li>
        <li><strong>Einsehen</strong> – Handel-Log, Vergabe-Log und die Statistik.</li>
      </ul>
      <p class="muted small">Preise, Chancen, Steuer, Tagesbonus, IHK und die Rollen (Devs, Mods) stellt der Admin ein.</p>
    </div>
  </section>
<% } %>
