<%
  // Offene Aufgaben: was gerade jemand aus dem Team erledigen sollte
  const tasks = [
    { n: counts.disputes, title: 'Streitfälle', text: 'Ersteller und Schiedsrichter sind sich uneinig.', href: subUrl('moderation', 'streit'), action: 'Entscheiden' },
    { n: counts.reports, title: 'Gemeldete Beiträge', text: 'Noch nicht geprüfte Meldungen aus dem Forum.', href: subUrl('moderation', 'meldungen'), action: 'Prüfen' },
    { n: counts.deviceAlerts, title: 'Mehrfach-Konten', text: 'Konten, die sicher oder wahrscheinlich ein Gerät teilen.', href: subUrl('moderation', 'geraete'), action: 'Ansehen' },
    { n: counts.suspicious, title: 'Handel zwischen Mehrfach-Konten', text: 'Neue Geschäfte zwischen Konten desselben Geräts.', href: panelUrl('protokolle', 'protokoll', { log: 'handel', verdacht: '1' }), action: 'Ansehen' },
    ...(currentUser.isAdmin ? [{ n: counts.packLogNew, title: 'Neue Vergaben', text: 'Von Devs vergeben oder entfernt seit deinem letzten Blick.', href: panelUrl('vergaben'), action: 'Ansehen' }] : []),
  ];
  const open = tasks.filter((t) => t.n);
%>

<section class="stats-block" id="aufgaben">
  <%- blockHead('Offene Aufgaben', '') %>
  <% if (!open.length) { %>
    <div class="card panel-done">
      <span class="panel-done-icon" aria-hidden="true">✓</span>
      <div><strong>Alles erledigt.</strong> <span class="muted">Keine Streitfälle, Meldungen oder neuen Hinweise.</span></div>
    </div>
  <% } else { %>
    <ul class="panel-tasks">
      <% open.forEach((t) => { %>
        <li class="card panel-task">
          <span class="panel-task-count"><%= t.n > 99 ? '99+' : t.n %></span>
          <div class="panel-task-text"><strong><%= t.title %></strong><span class="muted small"><%= t.text %></span></div>
          <a class="btn btn-primary btn-sm" href="<%= t.href %>"><%= t.action %></a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="stats-block" id="zahlen">
  <%- blockHead('Auf einen Blick', '') %>
  <div class="stats-kpis stats-kpis-4">
    <a class="stats-kpi card" href="/rangliste"><span class="stat-label">Mitglieder</span><span class="stat-value"><%= stats.userCount %></span></a>
    <a class="stats-kpi card" href="/wetten"><span class="stat-label">Offene Wetten</span><span class="stat-value"><%= stats.openBets %></span></a>
    <div class="stats-kpi card"><span class="stat-label">Wetten gesamt</span><span class="stat-value"><%= stats.totalBets %></span></div>
    <a class="stats-kpi card" href="<%= subUrl('moderation', 'bans') %>"><span class="stat-label">Aktive Bans</span><span class="stat-value"><%= counts.bans %></span></a>
  </div>
</section>

<% if (!currentUser.isAdmin) { %>
  <details class="card panel-rights-box">
    <summary><strong>Deine Rechte als Dev</strong></summary>
    <ul class="panel-rights">
      <li><strong>Streitfälle</strong> entscheiden – nicht bei Wetten, an denen du als Ersteller oder Schiedsrichter beteiligt bist.</li>
      <li><strong>Bannen</strong> für 1–168 Stunden, nicht den Admin und keine Devs. Aufheben nur eigene Bans.</li>
      <li><strong>Moderieren:</strong> Meldungen prüfen, Mehrfach-Konten abhaken, im Forum eingreifen.</li>
      <li><strong>Vergaben</strong> nur für Bugfixes, Tests und Aktionen – alles landet im Protokoll.</li>
      <li><strong>Einladen:</strong> Codes erzeugen und eigene löschen.</li>
      <li><strong>Einsehen:</strong> alle Protokolle und die Statistik.</li>
    </ul>
    <p class="muted small">Jede Aktion bestätigst du mit deinem Passwort. Spielwerte und Rollen stellt der Admin ein.</p>
  </details>
<% } %>
