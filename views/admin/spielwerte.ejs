<% if (currentUser.isAdmin) { %>
  <nav class="stats-subnav" aria-label="Abschnitte">
    <span class="muted small">Springe zu:</span>
    <a href="#packs">Packs vergeben</a><a href="#tcg">TCG-Chancen &amp; Preise</a><a href="#handel">Handelssteuer</a><a href="#ihk">IHK</a>
  </nav>
<% } %>

<section class="stats-block" id="packs">
  <%- blockHead('Booster Packs vergeben', 'Schenkt einem Mitglied ungeöffnete Booster Packs. Sie landen in seinem Inventar auf der TCG-Seite („Meine Packs“). Jede Vergabe wird im Pack-Log festgehalten (wer, wem, wann).') %>
  <div class="card">
    <form method="post" action="/admin/tcg/packs" class="form panel-inline-form" data-confirm="Booster Packs wirklich vergeben?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span>Mitglied</span>
        <select name="user" required>
          <option value="">– auswählen –</option>
          <% users.forEach((u) => { %><option value="<%= u._id %>"><%= u.username %></option><% }) %>
        </select>
      </label>
      <label class="field">
        <span>Booster Pack</span>
        <select name="type" required>
          <% packTypes.forEach((p) => { %><option value="<%= p.key %>"><%= p.label %></option><% }) %>
        </select>
      </label>
      <label class="field panel-field-sm">
        <span>Anzahl (1–50)</span>
        <input type="number" name="count" min="1" max="50" step="1" value="1" required>
      </label>
      <button class="btn btn-primary" type="submit">Packs vergeben</button>
    </form>
    <p class="small"><a href="<%= panelUrl('protokolle', 'packlog') %>">Zum Pack-Log</a></p>
  </div>
</section>

<% if (!currentUser.isAdmin) { %>
  <p class="muted small panel-hint">Preise, Chancen, Handelssteuer und IHK stellt der Admin ein. Änderungen daran siehst du in der Statistik unter „Änderungen“.</p>
<% } else { %>
  <%
    const toInput = (c) => (c / 100).toFixed(2).replace('.', ',');
    const pctInput = (w) => (w / 100).toFixed(2).replace('.', ',');
  %>
  <section class="stats-block" id="tcg">
    <%- blockHead('TCG: Chancen &amp; Preise', 'Packpreis, Chancen und Verkaufspreise der Seltenheiten. Änderungen gelten sofort. Neue Chancen gelten für alle ab jetzt geöffneten Packs; neue Preise auch für schon gezogene Karten (der Wert hängt nur von der Seltenheit ab). Die Chancen müssen zusammen genau 100 % ergeben.') %>
    <div class="card">
      <form method="post" action="/admin/tcg" class="form admin-tcg-form" data-confirm="TCG-Einstellungen wirklich ändern?" data-tcg-admin>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field admin-tcg-pack">
          <span>Packpreis (3 Karten)</span>
          <input type="text" name="pack" inputmode="decimal" value="<%= toInput(tcg.packPrice) %>" required>
        </label>
        <div class="table-wrap">
          <table class="table admin-tcg-table">
            <thead><tr><th>Seltenheit</th><th>Chance (%)</th><th>Verkaufspreis (€)</th><th class="num hide-sm">Standard</th></tr></thead>
            <tbody>
              <% tcg.rarities.forEach((r) => { %>
                <tr class="r-<%= r.key %>">
                  <td><span class="tcg-dot"></span> <%= r.label %><%= r.hidden ? ' (geheim)' : '' %></td>
                  <td><input type="text" name="weight_<%= r.key %>" inputmode="decimal" value="<%= pctInput(r.weight) %>" required aria-label="Chance <%= r.label %> in Prozent"></td>
                  <td><input type="text" name="sell_<%= r.key %>" inputmode="decimal" value="<%= toInput(r.sell) %>" required aria-label="Verkaufspreis <%= r.label %>"></td>
                  <td class="num hide-sm muted nowrap"><%= pctInput(tcg.defaultWeights[r.key]) %> % · <%= euro(tcg.defaults[r.key]) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="admin-tcg-summary" data-tcg-summary>
          Summe der Chancen: <strong data-tcg-sum><%= pctInput(tcg.rarities.reduce((s, r) => s + r.weight, 0)) %> %</strong> ·
          Ein Pack ist im Schnitt <strong data-tcg-ev><%= euro(tcg.expectedPack) %></strong> wert
          (<strong data-tcg-ratio class="<%= tcg.expectedPack >= tcg.packPrice ? 'neg' : 'pos' %>"><%= Math.round((tcg.expectedPack / tcg.packPrice) * 100) %> %</strong> vom Packpreis)
          <span class="neg small" data-tcg-warn <%= tcg.expectedPack >= tcg.packPrice ? '' : 'hidden' %>><br>Packs wären im Schnitt profitabel – es kommt mehr Spielgeld in Umlauf, als ausgegeben wird.</span>
        </p>
        <button class="btn btn-primary" type="submit">Speichern</button>
        <% if (tcg.lastUpdate) { %>
          <p class="muted small">Zuletzt geändert von <%= tcg.lastUpdate.updatedByName %> · <%= date(tcg.lastUpdate.updatedAt) %></p>
        <% } %>
      </form>
    </div>
  </section>

  <section class="stats-block" id="handel">
    <%- blockHead('Handelssteuer', 'Anteil, der dem Verkäufer bei jedem Handel (privat und Markt) vom Erlös abgezogen wird. Die Spieler sehen den aktuellen Satz auf der Handelsseite.') %>
    <div class="card">
      <form method="post" action="/admin/handel" class="form panel-inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field panel-field-sm">
          <span>Handelssteuer in % (0–50)</span>
          <input type="text" name="tax" inputmode="decimal" value="<%= String(tradeTax).replace('.', ',') %>" required>
        </label>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>

  <section class="stats-block" id="ihk">
    <%- blockHead('IHK: Limit &amp; Lohn', 'Quests pro Tag, Dauer, Ziel-Punkte, Lohn und Chance auf ein Booster Pack je Schwierigkeit (Lohn und Pack nur bei Erfolg) – getrennt für normale und Hybrid-Quests. Gilt sofort für neu gestartete Quests.') %>
    <div class="card">
      <form method="post" action="/admin/ihk" class="form admin-tcg-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check admin-ihk-open">
          <input type="checkbox" name="open" value="1" <%= ihk.settings.open ? 'checked' : '' %>>
          <span><strong>Für alle Mitglieder verfügbar</strong> – sonst sehen nur Admins die IHK, alle anderen bekommen „derzeit nicht verfügbar“.</span>
        </label>
        <label class="field admin-tcg-pack">
          <span>Quests pro Tag</span>
          <input type="number" name="dailyLimit" min="0" max="100" step="1" value="<%= ihk.settings.dailyLimit %>" required>
        </label>
        <% [
             { title: 'Normale Quests (FIA, FIS oder BWL)', prefix: '', values: ihk.settings },
             { title: 'Hybrid-Quests (zwei Fachrichtungen, es zählt der Durchschnitt)', prefix: 'hybrid_', values: ihk.settings.hybrid },
           ].forEach((t) => { %>
          <h3 class="admin-ihk-sub"><%= t.title %></h3>
          <div class="table-wrap">
            <table class="table admin-tcg-table">
              <thead><tr><th>Schwierigkeit</th><th>Ziel (Punkte)</th><th>Dauer (Min., 0 = sofort)</th><th>Lohn (€)</th><th>Pack-Chance (%)</th></tr></thead>
              <tbody>
                <% ihk.difficulties.forEach((d, i) => { %>
                  <tr class="r-<%= tcg.rarities[i].key %>">
                    <td><span class="tcg-dot"></span> <%= d.level %> · <%= d.label %> <span class="muted small hide-sm">(Standard <%= d.required %>)</span></td>
                    <td><input type="number" name="<%= t.prefix %>required_<%= d.level %>" min="1" max="100000" step="1" value="<%= t.values.required[i] %>" required aria-label="Ziel-Punkte Schwierigkeit <%= d.level %>"></td>
                    <td><input type="number" name="<%= t.prefix %>duration_<%= d.level %>" min="0" max="1440" step="1" value="<%= t.values.durations[i] %>" required aria-label="Dauer Schwierigkeit <%= d.level %>"></td>
                    <td><input type="text" name="<%= t.prefix %>reward_<%= d.level %>" inputmode="decimal" value="<%= (t.values.rewards[i] / 100).toFixed(2).replace('.', ',') %>" required aria-label="Lohn Schwierigkeit <%= d.level %>"></td>
                    <td><input type="text" name="<%= t.prefix %>pack_<%= d.level %>" inputmode="decimal" value="<%= String(t.values.packChances[i]).replace('.', ',') %>" required aria-label="Chance auf ein Booster Pack, Schwierigkeit <%= d.level %>"></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% }) %>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>
<% } %>
