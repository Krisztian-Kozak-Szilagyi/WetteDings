
<%
  const toInput = (c) => (c / 100).toFixed(2).replace('.', ',');
  const pctInput = (w) => (w / 100).toFixed(2).replace('.', ',');
  // Schalter "für alle verfügbar" auf einen Blick; geändert werden sie im jeweiligen Unterreiter
  const FEATURES = [
    { key: 'ihk', label: 'IHK-Quests', on: ihk.settings.open },
    { key: 'dungeon', label: 'Dungeon', on: dungeon.settings.open },
    { key: 'grading', label: 'Grading-Shop', on: gradingOpen() },
  ];
%>
<div class="panel-features" aria-label="Für alle Mitglieder verfügbar">
  <span class="stats-toolbar-label">Für alle sichtbar</span>
  <% FEATURES.forEach((f) => { %>
    <a class="panel-feature <%= f.on ? 'is-on' : '' %>" href="<%= subUrl('spielwerte', f.key) %>"><span class="panel-feature-dot" aria-hidden="true"></span><%= f.label %> <span class="muted small"><%= f.on ? 'an' : 'aus' %></span></a>
  <% }) %>
</div>
  <% if (sub === 'tcg') { %>
  <section class="stats-block" id="tcg">
    <%- blockHead('TCG: Chancen &amp; Preise', 'Änderungen gelten sofort: neue Chancen für alle ab jetzt geöffneten Packs, neue Preise auch für schon gezogene Karten (der Wert hängt nur von der Seltenheit ab). Die Chancen müssen zusammen genau 100 % ergeben – die nicht festgehaltenen gleichen sich dafür automatisch an.') %>
    <div class="card">
      <form method="post" data-reauth action="/admin/tcg" class="form panel-form" data-confirm="TCG-Einstellungen wirklich ändern?" data-tcg-admin data-cards-per-pack="<%= tcg.cardsPerPack %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field admin-tcg-pack">
          <span>Packpreis (<%= tcg.cardsPerPack %> Karten)</span>
          <input type="text" name="pack" inputmode="decimal" value="<%= toInput(tcg.packPrice) %>" required>
        </label>
        <div class="table-wrap">
          <table class="table admin-tcg-table">
            <thead><tr><th>Seltenheit</th><th>Chance (%)</th><th title="Festgehaltene Chancen bleiben, die übrigen gleichen sich auf 100 % an">Fest</th><th>Verkaufspreis (€)</th><th class="num hide-sm">Standard</th></tr></thead>
            <tbody>
              <% tcg.rarities.forEach((r) => { %>
                <tr class="r-<%= r.key %>">
                  <td><span class="tcg-dot"></span> <%= r.label %><%= r.hidden ? ' (geheim)' : '' %></td>
                  <td><input type="text" name="weight_<%= r.key %>" inputmode="decimal" value="<%= pctInput(r.weight) %>" data-default="<%= tcg.defaultWeights[r.key] %>" required aria-label="Chance <%= r.label %> in Prozent"></td>
                  <%# #102: festgehalten = bleibt beim Ausgleichen unverändert (wird beim Ändern automatisch gesetzt, public/js/app.js) %>
                  <td><label class="admin-lock" title="Chance festhalten – sie ändert sich beim Ausgleichen nicht"><input type="checkbox" data-tcg-lock="<%= r.key %>" aria-label="Chance <%= r.label %> festhalten"><svg class="admin-lock-on" viewBox="0 0 256 256" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96Z"/></svg><svg class="admin-lock-off" viewBox="0 0 256 256" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M208,80H96V56a32,32,0,0,1,62.15-10.73,8,8,0,1,0,15.08-5.34A48,48,0,0,0,80,56V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80Z"/></svg></label></td>
                  <td><input type="text" name="sell_<%= r.key %>" inputmode="decimal" value="<%= toInput(r.sell) %>" required aria-label="Verkaufspreis <%= r.label %>"></td>
                  <td class="num hide-sm muted nowrap"><%= pctInput(tcg.defaultWeights[r.key]) %> % · <%= euro(tcg.defaults[r.key]) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="muted small admin-tcg-hint">Geänderte Chancen werden festgehalten (Schloss), alle übrigen gleichen sich automatisch auf 100 % an – im gleichen Verhältnis zueinander. Ein Klick aufs Schloss löst oder hält einen Wert fest. <button type="button" class="link-btn link-btn-muted" data-tcg-unlock-all>Alle lösen</button></p>
        <p class="neg small" data-tcg-over hidden>Die festgehaltenen Chancen ergeben zusammen schon mehr als 100 % – bitte eine davon senken oder lösen.</p>
        <p class="admin-tcg-summary" data-tcg-summary>
          Summe der Chancen: <strong data-tcg-sum><%= pctInput(tcg.rarities.reduce((s, r) => s + r.weight, 0)) %> %</strong> ·
          Ein Pack ist im Schnitt <strong data-tcg-ev><%= euro(tcg.expectedPack) %></strong> wert
          (<strong data-tcg-ratio class="<%= tcg.expectedPack >= tcg.packPrice ? 'neg' : 'pos' %>"><%= Math.round((tcg.expectedPack / tcg.packPrice) * 100) %> %</strong> vom Packpreis)
          <span class="neg small" data-tcg-warn <%= tcg.expectedPack >= tcg.packPrice ? '' : 'hidden' %>><br>Packs wären im Schnitt profitabel – es kommt mehr Spielgeld in Umlauf, als ausgegeben wird.</span>
        </p>
        <button class="btn btn-primary" type="submit">Speichern</button>
        <% if (tcg.lastUpdate) { %>
          <p class="muted small">Zuletzt geändert von <%= tcg.lastUpdate.updatedByName %> · <%= date(tcg.lastUpdate.updatedAt) %></p>
        <% } %>
      </form>
    </div>
  </section>
<% } %>

  <% if (sub === 'steuer') { %>
  <section class="stats-block" id="steuer">
    <%- blockHead('Steuern', 'Je Bereich ein Satz (0–50 %).<br><strong>Handel:</strong> wird dem abgezogen, der das Geld bekommt (beim Tausch nur auf den Aufpreis).<br><strong>Broker:</strong> nur auf den Gewinn beim Verkauf; neue Coins oder ETFs fallen automatisch unter ihre Kategorie.<br>Die Spieler sehen die Sätze auf der Handels- bzw. Broker-Seite.') %>
    <div class="card">
      <form method="post" data-reauth action="/admin/steuer" class="form admin-tax-form" data-confirm="Steuersätze wirklich ändern?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% ['Handel', 'Broker'].forEach((group) => { %>
          <fieldset class="admin-tax-group">
            <legend><%= group %></legend>
            <% taxCategories.filter((c) => c.group === group).forEach((c) => { %>
              <label class="field">
                <span><%= c.label %> in %</span>
                <input type="text" name="<%= c.key %>" inputmode="decimal" value="<%= String(taxRates[c.key]).replace('.', ',') %>" required>
                <small class="muted"><%= c.hint %></small>
              </label>
            <% }) %>
          </fieldset>
        <% }) %>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>
<% } %>

  <% if (sub === 'bonus') { %>
  <section class="stats-block" id="bonus">
    <%- blockHead('Tagesbonus', `Gilt für alle Mitglieder gleich – außer für die, die gerade im Grading-Shop arbeiten. Gilt ab dem nächsten Bonustag (${bonusTime} Uhr).`) %>
    <div class="card">
      <form method="post" data-reauth action="/admin/bonus" class="form panel-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="teil" value="bonus">
        <label class="field admin-tcg-pack">
          <span>Tagesbonus in € (0 = keiner)</span>
          <input type="text" name="amount" inputmode="decimal" value="<%= (dailyBonus() / 100).toFixed(2).replace('.', ',') %>" required>
        </label>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>
<% } %>
<% if (sub === 'grading') { %>
  <section class="stats-block" id="grading">
    <%- blockHead('Grading-Shop', 'Lohn pro Auftrag: Putzen (bei 100 % sauber, sonst anteilig) + Benoten (exakte Note, ±1 = halb, ab Stufe 2) + Versiegeln (bei 100 %, ab Stufe 3). Stufe 4 bekommt den Premium-Aufschlag auf alles.<br><br>Die Schätzung rechnet beim Tippen mit den Werten im Formular – vor dem Speichern ausprobieren.') %>
    <div class="card">
      <form method="post" data-reauth action="/admin/bonus" class="form panel-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="teil" value="grading">
        <label class="check admin-ihk-open">
          <input type="checkbox" name="gradingOpen" value="1" <%= gradingOpen() ? 'checked' : '' %>>
          <span><strong>Für alle Mitglieder verfügbar</strong> <span class="muted small">(sonst nur für Admins)</span></span>
        </label>
        <div class="admin-gr-grid">
          <label class="field"><span>Aufträge pro Tag</span><input type="number" name="gr_jobs" min="0" max="100" step="1" value="<%= gradingSettings.jobs %>" required></label>
          <label class="field"><span>Lohn Putzen in €</span><input type="text" name="gr_pay_clean" inputmode="decimal" value="<%= (gradingSettings.pay.clean / 100).toFixed(2).replace('.', ',') %>" required></label>
          <label class="field"><span>Lohn Benoten in €</span><input type="text" name="gr_pay_grade" inputmode="decimal" value="<%= (gradingSettings.pay.grade / 100).toFixed(2).replace('.', ',') %>" required></label>
          <label class="field"><span>Lohn Versiegeln in €</span><input type="text" name="gr_pay_slab" inputmode="decimal" value="<%= (gradingSettings.pay.slab / 100).toFixed(2).replace('.', ',') %>" required></label>
          <% gradingLevels.slice(1).forEach((l, i) => { %>
            <label class="field"><span>Ausbau auf Stufe <%= l.level %> („<%= l.name %>“) in €</span><input type="text" name="gr_cost_<%= l.level %>" inputmode="decimal" value="<%= (gradingSettings.costs[i] / 100).toFixed(2).replace('.', ',') %>" required></label>
          <% }) %>
          <label class="field"><span>Premium-Aufschlag Stufe 4 in %</span><input type="number" name="gr_premium" min="0" max="500" step="1" value="<%= gradingSettings.premium %>" required></label>
        </div>
        <button class="btn btn-primary" type="submit">Speichern</button>
        <% if (gradingCalc) { const gc = gradingCalc; const pct = (v) => Math.round(v * 100) + ' %'; %>
          <details class="admin-gr-calc" data-grading-calc="<%= JSON.stringify(gc.input) %>" open>
            <summary><strong>Verdienst pro Tag</strong> <span class="muted small">Schätzung und tatsächliche Werte</span></summary>
            <p class="muted small"><strong>Jede Zeile ist der gesamte Tagesverdienst, wenn der Shop auf dieser Stufe steht</strong> (Putzen, Benoten und Versiegeln zusammen) – nicht zusätzlich zur Stufe davor; man arbeitet immer nur auf einer Stufe. Rechnet beim Tippen mit den Werten oben – vor dem Speichern ausprobieren. Alle Aufträge des Tages erledigt; inkl. Seltenheits-Zuschlag der Kundenkarten (Ø +<%= Math.round((gc.input.factor - 1) * 100) %> %) und ab Stufe 3 Folienfunde (Ø <%= euro(Math.round(gc.input.foilValue)) %> pro Auftrag).</p>
            <div class="table-wrap">
              <table class="table admin-gr-calc-table">
                <thead><tr><th>Stufe</th><th class="num">Ausbau</th><% gc.input.profiles.forEach((p) => { %><th class="num"><%= p.label %></th><% }) %><th class="num">Mehr als Stufe davor</th><th class="num">Ausbau bezahlt nach</th></tr></thead>
                <tbody>
                  <% const ref = gc.input.profiles[gc.input.profiles.length - 1].key; gc.rows.forEach((r, i) => { %>
                    <tr>
                      <td><%= r.level %> · <%= r.name %></td>
                      <td class="num" data-gc-cost="<%= r.level %>"><%= r.cost ? euro(r.cost) : '–' %></td>
                      <% gc.input.profiles.forEach((p) => { %><td class="num" data-gc-day="<%= r.level %>-<%= p.key %>"><%= euro(r.perDay[p.key]) %></td><% }) %>
                      <td class="num" data-gc-gain="<%= r.level %>"><% const g = i ? r.perDay[ref] - gc.rows[i - 1].perDay[ref] : 0; %><%= i ? (g >= 0 ? '+' : '') + euro(g) : '–' %></td>
                      <td class="num" data-gc-payback="<%= r.level %>"><%= r.payback ? r.payback + ' Tagen' : '–' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <p class="muted small">Zum Vergleich: Tagesbonus <strong data-gc-bonus><%= euro(dailyBonus()) %></strong> pro Tag – entfällt, solange man im Grading-Shop arbeitet. „Mehr als Stufe davor“ und „Ausbau bezahlt nach“ (= Ausbaukosten ÷ Mehrverdienst) (Profil „<%= gc.input.profiles[gc.input.profiles.length - 1].label %>“).</p>
            <p class="muted small">Annahmen: <%= gc.input.profiles.map((p) => p.label + ' = ' + p.clean + ' % sauber, ' + pct(p.exact) + ' Noten exakt' + (p.near ? ' + ' + pct(p.near) + ' um 1 daneben' : '') + ', ' + p.seal + ' % versiegelt').join(' · ') %>.</p>
            <h3 class="admin-ihk-sub">Tatsächlich verdient (letzte 30 Tage, ohne Folien)</h3>
            <% if (gc.actual.length) { %>
              <div class="table-wrap">
                <table class="table admin-gr-calc-table">
                  <thead><tr><th>Stufe</th><th class="num">Mitglieder</th><th class="num">Aufträge</th><th class="num">Ø pro Auftrag</th><th class="num">Ø Aufträge/Tag</th><th class="num">Ø pro Arbeitstag</th></tr></thead>
                  <tbody>
                    <% gc.actual.forEach((a) => { const l = gradingLevels.find((x) => x.level === a.level); %>
                      <tr>
                        <td><%= a.level %><%= l ? ' · ' + l.name : '' %></td>
                        <td class="num"><%= a.users %></td>
                        <td class="num"><%= a.jobs %></td>
                        <td class="num"><%= euro(a.perJob) %></td>
                        <td class="num"><%= a.jobsPerDay.toFixed(1).replace('.', ',') %></td>
                        <td class="num"><%= euro(a.perWorkDay) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="muted small">In den letzten 30 Tagen wurden noch keine Aufträge erledigt.</p>
            <% } %>
          </details>
        <% } %>
      </form>
    </div>
  </section>
<% } %>

  <% if (sub === 'folie') { %>
  <section class="stats-block" id="folie">
    <%- blockHead('Folie', 'Wer im Grading-Shop eine Karte versiegelt (ab Stufe 3), findet mit dieser Chance eine Folie. Folierte Karten steigen im Wert (bezogen auf den Verkaufswert, linear) – das zählt in der Rangliste und im Handel, die Bank zahlt aber nur ohne Folie.') %>
    <div class="card">
      <form method="post" data-reauth action="/admin/folie" class="form panel-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-gr-grid">
          <label class="field"><span>Fundchance pro versiegelter Karte in %</span><input type="text" name="chance" inputmode="decimal" value="<%= String(foilSettings.gradingChance / 100).replace('.', ',') %>" required></label>
          <label class="field"><span>Wertsteigerung beim Folieren in %</span><input type="text" name="bonus" inputmode="decimal" value="<%= String(foilSettings.bonusPercent).replace('.', ',') %>" required></label>
          <label class="field"><span>Wertsteigerung pro Tag in %</span><input type="text" name="daily" inputmode="decimal" value="<%= String(foilSettings.dailyPercent).replace('.', ',') %>" required></label>
        </div>
        <p class="muted small">Beispiel: Eine Karte mit 100 € Verkaufswert ist nach 30 Tagen <%= euro(Math.floor(10000 * (100 + foilSettings.bonusPercent + 30 * foilSettings.dailyPercent) / 100)) %> wert. Änderungen gelten sofort für alle folierten Karten.</p>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>
<% } %>

  <% if (sub === 'lotterie') { %>
  <section class="stats-block" id="lotterie">
    <%- blockHead('Lotterien', 'Der Gewinner bekommt alle Einsätze plus den Bank-Gewinn (Geld, Booster Packs, Folien). Ohne verkaufte Lose verfällt der Bank-Gewinn. Änderungen gelten sofort, auch für die laufende Runde.') %>
    <% const cents = (v) => (v / 100).toFixed(2).replace('.', ','); %>
    <div class="panel-cols">
    <% [['taeglich', 'Tages-Lotterie'], ['woche', 'Wochen-Lotterie (sonntags)'], ['monat', 'Monats-Lotterie (am 28.)']].forEach(([key, label]) => { const ls = lottoSettings[key]; %>
      <div class="card">
        <form method="post" data-reauth action="/admin/lotterie" class="form panel-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="kind" value="<%= key %>">
          <h4><%= label %></h4>
          <div class="admin-gr-grid">
            <label class="field"><span>Lospreis in €</span><input type="text" name="price" inputmode="decimal" value="<%= cents(ls.ticketPrice) %>" required></label>
            <label class="field"><span>Geld aus der Bank in €</span><input type="text" name="cash" inputmode="decimal" value="<%= cents(ls.prizeCash) %>" required></label>
            <label class="field"><span>Booster Packs</span><input type="number" name="packs" min="0" max="500" step="1" value="<%= ls.prizePacks %>" required></label>
            <label class="field"><span>Folien</span><input type="number" name="foils" min="0" max="100" step="1" value="<%= ls.prizeFoils %>" required></label>
          </div>
          <button class="btn btn-primary" type="submit">Speichern</button>
        </form>
      </div>
    <% }) %>
    </div>
  </section>
<% } %>

  <% if (sub === 'ihk') { %>
  <section class="stats-block" id="ihk">
    <%- blockHead('IHK: Limit &amp; Lohn', 'Quests pro Tag, Dauer, Ziel-Punkte, Lohn und Chance auf ein Booster Pack je Schwierigkeit (Lohn und Pack nur bei Erfolg) – getrennt für normale und Hybrid-Quests. Gilt sofort für neu gestartete Quests.') %>
    <div class="card">
      <form method="post" data-reauth action="/admin/ihk" class="form panel-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check admin-ihk-open">
          <input type="checkbox" name="open" value="1" <%= ihk.settings.open ? 'checked' : '' %>>
          <span><strong>Für alle Mitglieder verfügbar</strong> <span class="muted small">(sonst nur für Admins)</span></span>
        </label>
        <label class="field admin-tcg-pack">
          <span>Quests pro Tag</span>
          <input type="number" name="dailyLimit" min="0" max="100" step="1" value="<%= ihk.settings.dailyLimit %>" required>
        </label>
        <% [
             { title: 'Normale Quests (FIA, FIS oder BWL)', prefix: '', values: ihk.settings },
             { title: 'Hybrid-Quests (zwei Fachrichtungen, es zählt der Durchschnitt)', prefix: 'hybrid_', values: ihk.settings.hybrid },
           ].forEach((t) => { %>
          <h3 class="admin-ihk-sub"><%= t.title %></h3>
          <div class="table-wrap">
            <table class="table admin-tcg-table">
              <thead><tr><th>Schwierigkeit</th><th>Ziel (Punkte)</th><th>Dauer (Min., 0 = sofort)</th><th>Lohn (€)</th><th>Pack-Chance (%)</th></tr></thead>
              <tbody>
                <% ihk.difficulties.forEach((d, i) => { %>
                  <tr class="r-<%= tcg.rarities[i].key %>">
                    <td><span class="tcg-dot"></span> <%= d.level %> · <%= d.label %> <span class="muted small hide-sm">(Standard <%= d.required %>)</span></td>
                    <td><input type="number" name="<%= t.prefix %>required_<%= d.level %>" min="1" max="100000" step="1" value="<%= t.values.required[i] %>" required aria-label="Ziel-Punkte Schwierigkeit <%= d.level %>"></td>
                    <td><input type="number" name="<%= t.prefix %>duration_<%= d.level %>" min="0" max="1440" step="1" value="<%= t.values.durations[i] %>" required aria-label="Dauer Schwierigkeit <%= d.level %>"></td>
                    <td><input type="text" name="<%= t.prefix %>reward_<%= d.level %>" inputmode="decimal" value="<%= (t.values.rewards[i] / 100).toFixed(2).replace('.', ',') %>" required aria-label="Lohn Schwierigkeit <%= d.level %>"></td>
                    <td><input type="text" name="<%= t.prefix %>pack_<%= d.level %>" inputmode="decimal" value="<%= String(t.values.packChances[i]).replace('.', ',') %>" required aria-label="Chance auf ein Booster Pack, Schwierigkeit <%= d.level %>"></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% }) %>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>
<% } %>
  <% if (sub === 'dungeon') { %>
  <section class="stats-block" id="dungeon">
    <%- blockHead('Dungeon: Termine, Lohn &amp; Beute', 'Abstand der Starts, Ziel-Punkte und Lohn (pro Spieler) je Kampf, Beute-Chancen beim Boss, welche Karten Bots bekommen und die Werte des Mage Towers. Gilt ab dem nächsten Start.') %>
    <div class="card">
      <form method="post" data-reauth action="/admin/dungeon" class="form panel-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check admin-ihk-open">
          <input type="checkbox" name="open" value="1" <%= dungeon.settings.open ? 'checked' : '' %>>
          <span><strong>Für alle Mitglieder verfügbar</strong> <span class="muted small">(sonst nur für Admins)</span></span>
        </label>
        <label class="field admin-tcg-pack">
          <span>Start alle … Stunden (1, 2, 3, 4, 6, 8, 12, 24)</span>
          <input type="number" name="intervalHours" min="1" max="24" step="1" value="<%= dungeon.settings.intervalHours %>" required>
        </label>
        <div class="table-wrap">
          <table class="table admin-tcg-table">
            <thead><tr><th>Kampf</th><th>Ziel (Punkte)</th><th>Lohn pro Spieler (€)</th></tr></thead>
            <tbody>
              <% ['Trash-Kampf 1', 'Trash-Kampf 2', 'Boss'].forEach((label, i) => { %>
                <tr>
                  <td><%= label %> <span class="muted small hide-sm">(Standard <%= dungeon.defaults.required[i] %> / <%= euro(dungeon.defaults.rewards[i]) %>)</span></td>
                  <td><input type="number" name="required_<%= i %>" min="1" max="100000" step="1" value="<%= dungeon.settings.required[i] %>" required aria-label="Ziel-Punkte <%= label %>"></td>
                  <td><input type="text" name="reward_<%= i %>" inputmode="decimal" value="<%= (dungeon.settings.rewards[i] / 100).toFixed(2).replace('.', ',') %>" required aria-label="Lohn <%= label %>"></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <label class="field admin-tcg-pack">
          <span>Boss: Chance auf eine Folie pro Spieler (%)</span>
          <input type="text" name="foilChance" inputmode="decimal" value="<%= String(dungeon.settings.foilChance).replace('.', ',') %>" required>
        </label>
        <label class="field admin-tcg-pack">
          <span>Boss: Chance auf die Boss-Karte pro Spieler (%)</span>
          <input type="text" name="cardChance" inputmode="decimal" value="<%= String(dungeon.settings.cardChance).replace('.', ',') %>" required>
        </label>
        <h3 class="admin-ihk-sub">Bot-Karten: Gewicht je Seltenheit</h3>
        <p class="muted small">Fehlen Spieler, füllen Bots die Plätze mit einer zufälligen Charakterkarte. Die Gewichte werden in Prozent umgerechnet (z. B. 40 / 35 / 20 / 5).</p>
        <div class="table-wrap">
          <table class="table admin-tcg-table">
            <thead><tr><th>Seltenheit</th><th>Gewicht</th><th>Anteil</th></tr></thead>
            <tbody>
              <% const botTotal = tcg.rarities.reduce((s, r) => s + (dungeon.settings.botWeights[r.key] || 0), 0); %>
              <% tcg.rarities.forEach((r) => { const w = dungeon.settings.botWeights[r.key] || 0; %>
                <tr class="r-<%= r.key %>">
                  <td><span class="tcg-dot"></span> <%= r.label %></td>
                  <td><input type="number" name="bot_<%= r.key %>" min="0" max="10000" step="1" value="<%= w %>" required aria-label="Bot-Gewicht <%= r.label %>"></td>
                  <td class="muted"><%= botTotal ? (w / botTotal * 100).toLocaleString('de-DE', { maximumFractionDigits: 1 }) : 0 %> %</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% const tw = dungeon.settings.tower; const twd = dungeon.defaults.tower; const dec = (v) => String(v).replace('.', ','); const eur = (c) => (c / 100).toFixed(2).replace('.', ','); %>
        <h3 class="admin-ihk-sub">Mage Tower (einmal am Tag)</h3>
        <p class="muted small">Runde für Runde schwerer, bis die Gruppe scheitert. Ziel der Runde n = Ziel Runde 1 × (1 + Anstieg)<sup>n−1</sup>. Lohn und Beute-Chancen wachsen mit jeder geschafften Runde. Gilt ab dem nächsten Turm-Start.</p>
        <label class="check admin-ihk-open">
          <input type="checkbox" name="towerOpen" value="1" <%= tw.open ? 'checked' : '' %>>
          <span><strong>Mage Tower für alle Mitglieder</strong> <span class="muted small">(nur wenn auch der Dungeon freigegeben ist – sonst nur für Admins)</span></span>
        </label>
        <div class="table-wrap">
          <table class="table admin-tcg-table">
            <thead><tr><th>Wert</th><th>Einstellung</th></tr></thead>
            <tbody>
              <% [
                ['towerBaseRequired', 'Ziel Runde 1 (Punkte)', tw.baseRequired, twd.baseRequired, 'number'],
                ['towerGrowth', 'Anstieg pro Runde (%)', dec(tw.growth), dec(twd.growth)],
                ['towerRewardBase', 'Lohn Runde 1 pro Spieler (€)', eur(tw.rewardBase), eur(twd.rewardBase)],
                ['towerRewardStep', 'Mehr Lohn je weitere Runde (€)', eur(tw.rewardStep), eur(twd.rewardStep)],
                ['towerFoilPerRound', 'Folie: Chance je geschaffte Runde (%)', dec(tw.foilPerRound), dec(twd.foilPerRound)],
                ['towerFoilMax', 'Folie: höchstens (%)', dec(tw.foilMax), dec(twd.foilMax)],
                ['towerCardPerRound', 'Boss-Karte: Chance je geschaffte Runde (%)', dec(tw.cardPerRound), dec(twd.cardPerRound)],
                ['towerCardMax', 'Boss-Karte: höchstens (%)', dec(tw.cardMax), dec(twd.cardMax)],
                ['towerFightSeconds', 'Wiedergabe je Runde (Sekunden)', tw.fightSeconds, twd.fightSeconds, 'number'],
                ['towerPauseSeconds', 'Pause zwischen Runden (Sekunden)', tw.pauseSeconds, twd.pauseSeconds, 'number'],
              ].forEach(([name, label, value, def, type]) => { %>
                <tr>
                  <td><%= label %> <span class="muted small hide-sm">(Standard <%= def %>)</span></td>
                  <td><input type="<%= type === 'number' ? 'number' : 'text' %>" name="<%= name %>" <%- type === 'number' ? 'min="0" step="1"' : 'inputmode="decimal"' %> value="<%= value %>" required aria-label="<%= label %>"></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% const ch = dungeon.settings.chaos; const chd = dungeon.defaults.chaos; %>
        <h3 class="admin-ihk-sub">Chaos &amp; Demise (geheimes Event)</h3>
        <p class="muted small">Beim Start von „The Fall of St. Ivan“ erscheint mit dieser Chance ein neuer Teilnehmer: St. Ivan verschwindet und „Chaos &amp; Demise“ beginnt (je Gruppe ausgewürfelt). Nur hier gibt es seine Boss-Karte – solange sie noch nicht gezeichnet ist, wird sie den Gewinnern nachgereicht. Für Spieler steht das Event nirgends beschrieben.</p>
        <label class="field admin-tcg-pack">
          <span>Chance, dass ein St.-Ivan-Lauf zu „Chaos &amp; Demise“ wird (%) <span class="muted small">(Standard <%= dec(chd.chance) %>)</span></span>
          <input type="text" name="chaosChance" inputmode="decimal" value="<%= dec(ch.chance) %>" required>
        </label>
        <div class="table-wrap">
          <table class="table admin-tcg-table">
            <thead><tr><th>Kampf</th><th>Ziel (Punkte)</th><th>Lohn pro Spieler (€)</th></tr></thead>
            <tbody>
              <% ['Kampf 1', 'Kampf 2', 'Boss'].forEach((label, i) => { %>
                <tr>
                  <td><%= label %> <span class="muted small hide-sm">(Standard <%= chd.required[i] %> / <%= euro(chd.rewards[i]) %>)</span></td>
                  <td><input type="number" name="chaosRequired_<%= i %>" min="1" max="100000" step="1" value="<%= ch.required[i] %>" required aria-label="Chaos &amp; Demise: Ziel-Punkte <%= label %>"></td>
                  <td><input type="text" name="chaosReward_<%= i %>" inputmode="decimal" value="<%= eur(ch.rewards[i]) %>" required aria-label="Chaos &amp; Demise: Lohn <%= label %>"></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <label class="field admin-tcg-pack">
          <span>Boss: Chance auf eine Folie pro Spieler (%) <span class="muted small">(Standard <%= dec(chd.foilChance) %>)</span></span>
          <input type="text" name="chaosFoilChance" inputmode="decimal" value="<%= dec(ch.foilChance) %>" required>
        </label>
        <label class="field admin-tcg-pack">
          <span>Boss: Chance auf die Boss-Karte pro Spieler (%) <span class="muted small">(Standard <%= dec(chd.cardChance) %>)</span></span>
          <input type="text" name="chaosCardChance" inputmode="decimal" value="<%= dec(ch.cardChance) %>" required>
        </label>
        <button class="btn btn-primary" type="submit">Speichern</button>
      </form>
    </div>
  </section>
<% } %>
