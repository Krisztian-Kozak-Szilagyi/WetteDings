<%
  // Ein Formular für alle Vergaben (POST /admin/vergeben). Ohne JS sind alle Felder sichtbar; mit JS nur die zur Art
  // passenden (public/js/app.js, [data-grant-form]). data-for: bei welchen Arten ein Feld gebraucht wird.
  const ARTS = [
    { key: 'pack', label: 'Booster Pack', button: 'Packs vergeben' },
    { key: 'karte', label: 'Karte', button: 'Karte vergeben' },
    { key: 'item', label: 'Gegenstand', button: 'Gegenstand vergeben' },
    { key: 'entzug', label: 'Karte entfernen', button: 'Karte entfernen' },
  ];
  const KIND = { pack: ['Pack', 'badge-offen'], karte: ['Karte', 'badge-entschieden'], item: ['Gegenstand', 'badge-entschieden'], entzug: ['Entfernt', 'badge-streitig'] };
  const cardOptions = () => grantCards.map((g) => `<optgroup label="${g.rarity.label}${g.rarity.hidden ? ' (geheim)' : ''}">${g.cards.map((c) => `<option value="${c.id}">${c.name}</option>`).join('')}</optgroup>`).join('');
%>

<section class="stats-block" id="vergeben">
  <%- blockHead('Vergeben', 'Vergaben greifen direkt in die Spielwirtschaft ein. Nutze sie nur, um Fehler auszugleichen, Funktionen zu testen oder für angekündigte Aktionen – nicht, um einzelne Mitglieder zu bevorzugen. Jede Vergabe steht mit deinem Namen im Protokoll und muss mit deinem Passwort bestätigt werden.<br><br><strong>An alle:</strong> Packs 1–10, Karten 1–5, Gegenstände 1–5 je Mitglied. Karten entfernen geht nur bei einem Mitglied; gesperrte Exemplare (Quest, Handelsangebot) bleiben.') %>
  <p class="panel-warning-line"><span aria-hidden="true">!</span> Nur für Bugfixes, Tests und Aktionen – alles steht im Protokoll.</p>
  <form method="post" data-reauth action="/admin/vergeben" class="card form grant-form" data-grant-form data-confirm="Diese Vergabe wirklich ausführen?">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset class="field">
      <legend>Was?</legend>
      <div class="stats-range grant-arts" role="radiogroup">
        <% ARTS.forEach((a, i) => { %>
          <label class="grant-art"><input type="radio" name="art" value="<%= a.key %>" data-button="<%= a.button %>" <%= i === 0 ? 'checked' : '' %>><span><%= a.label %></span></label>
        <% }) %>
      </div>
    </fieldset>
    <div class="grant-fields">
      <label class="field" data-for="pack"><span>Booster Pack</span>
        <select name="pack"><% packTypes.forEach((p) => { %><option value="<%= p.key %>"><%= p.label %></option><% }) %></select>
      </label>
      <label class="field" data-for="karte entzug"><span>Karte</span>
        <select name="card"><option value="">– auswählen –</option><%- cardOptions() %></select>
      </label>
      <label class="field" data-for="item"><span>Gegenstand</span>
        <select name="item"><% itemTypes.forEach((t) => { %><option value="<%= t.key %>"><%= t.label %></option><% }) %></select>
      </label>
      <label class="field"><span>An</span>
        <input type="text" name="user" list="grant-members" autocomplete="off" maxlength="40" placeholder="Name tippen oder auswählen" required>
        <datalist id="grant-members">
          <option value="Alle Mitglieder (<%= users.length %>)" data-not="entzug"></option>
          <% users.forEach((u) => { %><option value="<%= u.username %>"></option><% }) %>
        </datalist>
      </label>
      <label class="field grant-count"><span>Anzahl</span><input type="number" name="count" min="1" max="50" step="1" value="1" required></label>
    </div>
    <div class="grant-submit"><button class="btn btn-primary" type="submit" data-grant-submit>Vergeben</button></div>
  </form>
</section>

<section class="stats-block" id="letzte">
  <%- blockHead('Letzte Vergaben', '') %>
  <div class="card">
    <% if (!grants.length) { %>
      <p class="muted">Es wurde noch nichts vergeben.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table trade-log">
          <thead><tr><th>Zeitpunkt</th><th>Von</th><th>An</th><th>Was</th><th class="num">Anzahl</th></tr></thead>
          <tbody>
            <% grants.forEach((g) => { const k = KIND[g.kind || 'pack'] || KIND.pack; %>
              <tr class="<%= g.isNew ? 'me' : '' %>">
                <td class="nowrap"><%= dateSec(g.createdAt) %><% if (g.isNew) { %> <span class="badge badge-offen">Neu</span><% } %></td>
                <td><%- userLink(g.byName, { realName: false }) %></td>
                <td><% if (g.all) { %><strong><%= g.toName %></strong><% } else { %><%- userLink(g.toName, { realName: false }) %><% } %></td>
                <td><span class="badge <%= k[1] %>"><%= k[0] %></span> <%= g.typeLabel %></td>
                <td class="num"><%= g.count %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <a class="btn btn-ghost btn-sm" href="<%= panelUrl('protokolle', 'protokoll', { log: 'vergaben' }) %>">Alle Vergaben im Protokoll</a>
    <% } %>
  </div>
</section>
