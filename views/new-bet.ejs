<%- include('partials/head') %>
<%
  // Assistent in Schritten (public/js/app.js, [data-wizard]): je Schritt eine Frage. Ohne JS stehen alle Schritte
  // untereinander und das Formular funktioniert wie eine normale Seite. errorStep: Schritt mit dem ersten Fehler.
  const STEPS = ['Frage', 'Antworten', 'Details', 'Schiedsrichter', 'Zeitplan', 'Prüfen'];
%>
<div class="new-bet">
  <div class="new-bet-head">
    <h1>Neue Wette</h1>
    <div class="wizard-progress" data-wizard-progress hidden>
      <span class="muted small" data-wizard-label></span>
      <span class="wizard-bar"><span data-wizard-bar></span></span>
    </div>
  </div>

  <% if (errors.length) { %>
    <div class="form-errors" role="alert"><ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>

  <form method="post" action="/wetten" class="form new-bet-form" data-wizard data-start-step="<%= errorStep %>" data-steps="<%= STEPS.join('|') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <section class="wizard-step" data-step>
      <label class="field">
        <span class="wizard-q">Worauf wird gewettet?</span>
        <input type="text" name="title" value="<%= values.title %>" minlength="5" maxlength="140" required placeholder="z. B. Gewinnt Bayern am Samstag gegen Dortmund?">
        <small class="muted">Eine Frage oder Aussage, die sich später eindeutig entscheiden lässt.</small>
      </label>
    </section>

    <section class="wizard-step" data-step>
      <fieldset class="field">
        <legend class="wizard-q">Welche Antworten gibt es?</legend>
        <div class="type-picker">
          <label class="type-option">
            <input type="radio" name="type" value="janein" <%= values.type !== 'optionen' ? 'checked' : '' %>>
            <span class="type-option-title">Ja / Nein</span>
          </label>
          <label class="type-option">
            <input type="radio" name="type" value="optionen" <%= values.type === 'optionen' ? 'checked' : '' %>>
            <span class="type-option-title">Eigene Optionen</span>
          </label>
        </div>
      </fieldset>

      <div class="field" data-type-panel="optionen" <%= values.type !== 'optionen' ? 'hidden' : '' %>>
        <div class="option-inputs" data-max="<%= maxOptions %>" data-min="<%= minOptions %>">
          <% values.options.forEach((o, i) => { %>
            <div class="option-input">
              <span class="option-num c-<%= i % 10 %>"></span>
              <input type="text" name="options" value="<%= o %>" maxlength="60" placeholder="Option <%= i + 1 %>" aria-label="Option <%= i + 1 %>">
              <button type="button" class="icon-btn" data-remove-option aria-label="Option entfernen">×</button>
            </div>
          <% }) %>
        </div>
        <button type="button" class="btn btn-ghost btn-sm add-option" data-add-option>+ Option hinzufügen</button>
        <small class="muted"><%= minOptions %> bis <%= maxOptions %> Optionen.</small>
      </div>
    </section>

    <section class="wizard-step" data-step>
      <label class="field">
        <span class="wizard-q">Regeln und Details <em class="muted">(optional)</em></span>
        <textarea name="description" rows="5" maxlength="2000" placeholder="Was gilt bei Verlängerung, Absage oder Gleichstand?"><%= values.description %></textarea>
      </label>
    </section>

    <section class="wizard-step" data-step>
      <label class="field">
        <span class="wizard-q">Wer entscheidet mit dir?</span>
        <select name="referee" required <%= candidates.length ? '' : 'disabled' %>>
          <option value="">Schiedsrichter wählen …</option>
          <% candidates.forEach((u) => { %>
            <option value="<%= u._id %>" <%= values.referee === String(u._id) ? 'selected' : '' %>><%= u.username %></option>
          <% }) %>
        </select>
        <% if (!candidates.length) { %><small class="neg">Es gibt noch kein weiteres Mitglied, das Schiedsrichter sein kann.</small><% } %>
      </label>
      <% if (groups.length) { %>
        <label class="field">
          <span>Sichtbar für</span>
          <select name="group">
            <option value="">Alle Mitglieder</option>
            <% groups.forEach((g) => { %>
              <option value="<%= g._id %>" <%= values.group === String(g._id) ? 'selected' : '' %>>Gruppe „<%= g.name %>“</option>
            <% }) %>
          </select>
          <small class="muted">In einer Gruppen-Wette muss auch der Schiedsrichter zur Gruppe gehören.</small>
        </label>
      <% } %>
    </section>

    <section class="wizard-step" data-step>
      <p class="wizard-q">Wann ist Schluss?</p>
      <div class="new-bet-grid">
        <label class="field">
          <span>Einsätze bis</span>
          <input type="datetime-local" name="deadline" value="<%= values.deadline %>" min="<%= minDeadline %>" required>
        </label>
        <label class="field">
          <span>Ergebnis steht fest am</span>
          <input type="datetime-local" name="resultAt" value="<%= values.resultAt %>" min="<%= minDeadline %>" required>
        </label>
      </div>
    </section>

    <section class="wizard-step" data-step>
      <p class="wizard-q" data-wizard-only hidden>Alles richtig?</p>
      <dl class="wizard-summary" data-wizard-summary hidden></dl>
      <p class="muted small">Du und dein Schiedsrichter setzt nicht mit und teilt euch <%= feePercent %> % vom Topf. Seid ihr euch beim Ergebnis nicht einig, entscheidet ein Dev. Frage, Antworten, Schiedsrichter und Gruppe lassen sich danach nicht mehr ändern.</p>
      <div class="new-bet-submit">
        <p>Mit dem Veröffentlichen bestätigst du die <a href="/regeln" target="_blank">Regeln</a>.</p>
        <button class="btn btn-primary btn-lg" type="submit">Wette veröffentlichen</button>
      </div>
    </section>

    <div class="wizard-nav" data-wizard-nav hidden>
      <button type="button" class="btn btn-ghost" data-wizard-back>Zurück</button>
      <button type="button" class="btn btn-primary" data-wizard-next>Weiter</button>
    </div>
  </form>
</div>

<%- include('partials/foot') %>
